+/* Opaque provider owners; the ramp occupies the first 0x44 bytes of fade. */
+extern void parInitColorRamp(ParColorRamp *, s32);
+extern ParTable *func_00159C08(s32 count, u16 pointCapacity, BillObj **billboardRef);
+extern u32 func_0015B220(u16 pointCapacity);
