+/* Allocate the common emitter resources selected by its kind. */
+void func_00153740(s32 address) {
+    EffTemplatePacketList *effect = (EffTemplatePacketList *)address;
+    EffTrackPolyParams params;
+
+    effect->templateSize = 0x150;
+    effect->buffer = effAllocateBuffer(effect->packetCount);
+    if (effect->billboardIndex != -1) {
+        effect->billboard = (BillObj *)effRetainResource(effect->billboardIndex);
+        billSetChildScaleComponents(effect->billboard, effect->x, effect->y);
+        billSetBillboardMode(effect->billboard, effect->billboardMode);
+    }
+    parInitColorRamp((ParColorRamp *)effect->fade, effect->packetTag);
+    switch (effect->kind) {
+    case 1:
+        effect->pointTable = func_00159C08(effect->packetCount, effect->subrecordCount, &effect->billboard);
+        break;
+    case 2:
+        effect->primaryCells = parAllocateCellSystem(effect->packetCount, effect->subrecordCount,
+                                                    func_0015B220(effect->subrecordCount), 0);
+        parDispatchSub(effect->primaryCells, 1, (void *)effect->primaryColor, (void *)effect->primaryColor);
+        func_0015D078((s32)effect->primaryCells, (u16)effect->billboardMode);
+        break;
+    case 3:
+        effect->secondaryCells = parAllocateCellSystem(effect->packetCount, effect->subrecordCount,
+                                                      func_0015B220(effect->subrecordCount), 1);
+        parDispatchSub(effect->secondaryCells, 1, (void *)effect->primaryColor, (void *)effect->secondaryColor);
+        func_0015D078((s32)effect->secondaryCells, (u16)effect->billboardMode);
+        break;
+    case 4:
+        /* This list receives endpoints manually. Its model/id/range prefix is
+         * not initialized or consumed by the emitter's reset/push/draw path. */
+        params.sampleInterval = 1;
+        params.historyLength = effect->subrecordCount;
+        params.unk1C = 10;
+        params.kind = (u16)effect->billboardMode;
+        params.gradientColors[0] = effect->primaryColor;
+        params.gradientColors[1] = effect->primaryColor;
+        params.gradientColors[2] = effect->secondaryColor;
+        params.gradientColors[3] = effect->secondaryColor;
+        effect->tracks = effTrackPolyCreateModelWorkList(&params, effect->packetCount);
+        break;
+    }
+    effect->pendingRestartSteps = effect->restartStepCount;
+    VU0_LOAD_MATRIX(effect->matrix);
+    VU0_STORE_MATRIX(effect->sourceMatrix);
+    effect->active = 1;
+    effect->colorMask = 0x80808080;
+}
 
