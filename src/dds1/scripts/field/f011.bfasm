    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Svadhisthana used to belong to"
      newline
      text "the Vanguards."
      newline
      control f1 04
    endpage
  endmessage
  message npc_002_01_02a speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Cyber Shaman?"
      newline
      control f1 04
    endpage
  endmessage
  message npc_002_01_02b speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I think I've heard that somewhere"
      newline
      text "before..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "But, I have a feeling it isn't"
      newline
      text "a very good memory..."
      newline
      control f1 04
    endpage
  endmessage
  message npc_002_01_03a speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "No... Cyb--er Shaman..."
      newline
      text "Cy...ber Sha...man...!"
      newline
      control f1 04
    endpage
  endmessage
  message npc_002_01_03b speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Ah... No, no..."
      newline
      text "Th-The sun...! The sun!"
      newline
      control f1 04
    endpage
  endmessage
  message npc_002_01_03c speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Yeaaarrrggghhh!!!"
      newline
      control f1 04
    endpage
  endmessage
  message npc_003_04_01a speaker=9
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Well, with that freaky red wall"
      newline
      text "there, I'm sure we'll be safe."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "But, I suppose it could disappear"
      newline
      text "at any time. At that point, I don't know"
      newline
      text "what will happen."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Hmm... Now I'm a little worried."
      newline
      control f1 04
    endpage
  endmessage
  message npc_003_04_01b speaker=9
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "*cough* Ah, sir..."
      newline
      text "What was I saying...?"
      newline
      control f1 04
    endpage
  endmessage
  message npc_003_04_01c speaker=9
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I'm sure it's nothing to be too"
      newline
      text "worried about... aheh..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "You shouldn't get too close to"
      newline
      text "Svadhisthana any more..."
      newline
      control f1 04
    endpage
  endmessage
