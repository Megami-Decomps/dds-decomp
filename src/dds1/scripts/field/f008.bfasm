      control f1 10
      control f2 08 ff ff
      control f1 04
    endpage
  endmessage
  message npc_04_02 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Have your memories returned?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "What about basic strategy?"
      newline
      control f1 04
    endpage
  endmessage
  select npc_04_02_SEL ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      text "I am fine."
    endoption
    option
      control f2 08 ff ff
      text "Do you have any suggestions?"
    endoption
  endselect
  message npc_04_02_ans0 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Oh, of course."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Without the basics, you cannot"
      newline
      text "hope to be victorious in later"
      newline
      text "battles."
      newline
      control f1 04
    endpage
  endmessage
  message npc_04_02_ans1 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Find an enemy's weakness, then"
      newline
      text "exploit it mercilessly."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "This will force the enemy into a"
      newline
      text "defensive position, allowing you"
      newline
      text "to continue on the offensive."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Do not forget the principles"
      newline
      text "of aggressive fighting."
      newline
      control f1 04
    endpage
  endmessage
  message npc_04_03 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Fighting is a combination of"
      newline
      text "defense and offense. Don't forget"
      newline
