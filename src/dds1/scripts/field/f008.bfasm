messages msg1
  message hungry speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Serph and the party feel hungry..."
      newline
      control f1 04
    endpage
  endmessage
  message hungry02 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> They grew weak from hunger."
      newline
      control f1 04
    endpage
  endmessage
  message heat_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Why was that woman here?"
      newline
      text "Is she related to this marking?"
      newline
      control f1 04
    endpage
  endmessage
  message heat_02 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Why was that woman here?"
      newline
      text "Is she related to this marking?"
      newline
      control f1 04
    endpage
  endmessage
  message heat_03 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "If I've never seen black hair like"
      newline
      text "that, then why...?"
      newline
      control f1 04
    endpage
  endmessage
  message heat_04a speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "What are you talking about?"
      newline
      text "It's the same old war."
      newline
      control f1 04
    endpage
  endmessage
  message heat_04b speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "There's no difference between"
      newline
      text "devouring and killing."
      newline
      control f1 04
    endpage
  endmessage
  message heat_05 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "No matter how many times we return,"
      newline
      text "there's no going back."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "You need to realize that."
      newline
      control f1 04
    endpage
  endmessage
  message arujila_01 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Something happened here."
      newline
      text "I want to know what that was."
      newline
      control f1 04
    endpage
  endmessage
  message arujila_02 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Rain... A black... pod?"
      newline
      text "And, then... a light..."
      newline
      control f1 04
    endpage
  endmessage
  message arujila_03b speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "It must have been the light..."
      newline
      text "That's why we..."
      newline
      control f1 04
    endpage
  endmessage
  message arujila_04a speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "So now, we don't just kill people,"
      newline
      text "we have to devour them too!?"
      newline
      control f1 04
    endpage
  endmessage
  message arujila_04b speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Eat... or be eaten..."
      newline
      control f1 04
    endpage
  endmessage
  message arujila_04c speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "How could we possibly deserve"
      newline
      text "something like this!?"
      newline
      control f1 04
    endpage
  endmessage
  message arujila_05 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I agree..."
      newline
      text "Staying here only brings back"
      newline
      text "bad memories."
      newline
      control f1 04
    endpage
  endmessage
  message npc_01_01 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "That light spread throughout the"
      newline
      text "Junkyard. Was it one of the"
      newline
      text "Vanguards' new weapons?"
      newline
      control f1 04
    endpage
  endmessage
  message npc_01_02 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "That light spread throughout the"
      newline
      text "Junkyard. Was it one of the"
      newline
      text "Vanguards' new weapons?"
      newline
      control f1 04
    endpage
  endmessage
  message npc_01_03 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The strange light was not a weapon"
      newline
      text "of the Vanguards."
      newline
      control f1 04
    endpage
  endmessage
  message npc_01_04 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The new law requires us to devour"
      newline
      text "our enemies to become stronger."
      newline
      control f1 04
    endpage
  endmessage
  message npc_01_05 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The new law requires us to devour"
      newline
      text "our enemies to become stronger."
      newline
      control f1 04
    endpage
  endmessage
  message npc_02_01 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "What is it, sir?"
      newline
      control f1 04
    endpage
  endmessage
  message npc_02_01_2 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Do you have any concerns, sir?"
      newline
      control f1 04
    endpage
  endmessage
  select npc_02_01_SEL ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      text "Nothing."
    endoption
    option
      control f2 08 ff ff
      text "Tell me about Nirvana."
    endoption
    option
      control f2 08 ff ff
      text "Tell me about Tribes."
    endoption
  endselect
  message npc_02_01_ans0 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I understand."
      newline
      text "That is good to hear."
      newline
      control f1 04
    endpage
  endmessage
  message npc_02_01_ans1 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "No specific information is known,"
      newline
      text "but it is often considered to be"
      newline
      text "a true paradise."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "We must strive to reach it."
      newline
      text "That is the law."
      newline
      control f1 04
    endpage
  endmessage
  message npc_02_01_ans2 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Each Tribe can be identified by"
      newline
      text "their color. Our color as the"
      newline
      text "Embryon is orange."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "If the leader is defeated, his"
      newline
      text "Tribe must follow the victor."
      newline
      text "That is the law."
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_01 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The Vanguards have gone into"
      newline
      text "hiding. What happened, boss?"
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_02 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Argilla is acting strangely."
      newline
      text "Did something happen at "
      newline
      text "Svadhisthana, sir?"
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_03 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Sir, I can feel... something..."
      newline
      text "My body... a monster..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "It... it's in my head!"
      newline
      text "I can hear it!"
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_04a speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "This power is that of a demon."
      newline
      text "The Temple issued information"
      newline
      text "on the subject."
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_04b speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Everyone's... confused, sir."
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_05 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "We've examined it thoroughly,"
      newline
      text "but it doesn't make sense, sir."
      newline
      control f1 04
    endpage
  endmessage
  message npc_04_01 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "There is no telling what lies"
      newline
      text "outside of our territory."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Take this with you, sir."
      newline
      control f1 04
    endpage
    page
