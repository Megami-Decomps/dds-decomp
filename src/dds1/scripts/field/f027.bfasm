  EQ
  IF _591
  PUSHIS 3
  COMM 0x0065
  GOTO _588
_591:
  PUSHIS 3
  PUSHLIX 0x0073
  EQ
  IF _588
  PUSHIS 1
  COMM 0x0065
  GOTO _588
_588:
  COMM FINISH_SCRIPT_MESSAGE_WINDOW
  PUSHIS 1
  COMM SET_SOLAR_OVERLAY_MODE
  COMM RELEASE_CURRENT_OBJECT
  GOTO _593
_593:
