set_fullnoise16:
  PROC set_fullnoise16
_595:
  PUSHIS 1
  IF _596
  PUSHIS 1
  PUSHIS 9
  COMM 0x005e
  PUSHREG
  EQ
  IF _603
  COMM RESTORE_CAMERA_NODE_MODE
