messages msg1
  message BLUE_SETUMEI speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> It is a member of the Brutes."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> He is in human form, so he must"
      newline
      text "have been killed before he could"
      newline
      text "transform."
      newline
      control f1 04
    endpage
  endmessage
  message BLUE_KANSOU_G speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "They must have fallen by Lupa's"
      newline
      text "hand. The corpses show no apparent"
      newline
      text "damage. His technique is brilliant."
      newline
      control f1 04
    endpage
  endmessage
  message BLUE_KANSOU_H speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "What? Is he too good to eat these"
      newline
      text "guys? I'm sick of that showoff."
      newline
      control f1 04
    endpage
  endmessage
  message AREA_04_2BANTAI_YATTA speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The Embryon...!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I see. Those damn Wolves are"
