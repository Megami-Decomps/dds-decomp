messages msg1
  message KEHAI_KIETA speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> The other's presence can"
      newline
      text "no longer be felt."
      newline
      control f1 04
    endpage
  endmessage
  message START_MESSAGE speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Hungry glances surround"
      newline
      text "the party..."
      newline
      control f1 04
    endpage
  endmessage
  message SOMEBODY_VOICE01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Voices are heard whispering."
      newline
      control f1 10
      control f2 08 ff ff
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "...At last. Our food is here..."
      newline
      control f1 04
    endpage
  endmessage
  message SOMEBODY_VOICE02 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Voices are heard whispering."
      newline
      control f1 10
      control f2 08 ff ff
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I'll devour her breasts..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Her ass is delicious..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I'm going to savor her legs."
      newline
      control f1 04
    endpage
  endmessage
  message BATTLE1_1_1 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The Embryon!"
      newline
      control f1 04
    endpage
  endmessage
  message BATTLE1_1_2 speaker=1
    page
      control f2 08 ff ff
      text "You want to fight the Solids with us?"
      newline
      text "I don't get it."
      newline
      control f1 04
    endpage
  endmessage
  message BATTLE1_1_3 speaker=1
    page
      control f2 08 ff ff
      text "It'd help a lot more if you let"
      newline
      text "us help ourselves to your"
      newline
      text "delicious bodies."
      newline
      control f1 04
    endpage
  endmessage
  message BATTLE1_1_ALG speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Get it, now?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "You'll be better off if you help us out."
      newline
      control f1 04
    endpage
  endmessage
  message HINT_01 speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Er, yeah..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I understand..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Everyone's starving, though."
      newline
      text "Watch your back, okay? The others"
      newline
      text "might just attack you."
      newline
      control f1 04
    endpage
  endmessage
  message SOMEBODY_VOICE03 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
