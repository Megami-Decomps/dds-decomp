      newline
      control f1 04
    endpage
  endmessage
  message AREA26_NPC01_02 speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Are you going up ahead, sir?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Be careful, He's no rookie."
      newline
      control f1 04
    endpage
  endmessage
  message AREA27_NPC01_01 speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Whoa, don't get any closer."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "There's a guy locked away..."
      newline
      text "He went crazy, and wouldn't stop"
      newline
      text "devouring people..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "He was delirious, going on about"
      newline
      text "the Wicked King... then began"
      newline
      text "eating his own allies."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "We need to isolate him until"
      newline
      text "he dies of starvation."
      newline
      control f1 04
    endpage
  endmessage
  message AREA29_NPC01_01 speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "You want to know why it's so dark?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "We tripped the breaker on B2"
      newline
      text "to deactivate the wall mechanism."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "It's inconvenient, but it's better than"
      newline
      text "letting that guy escape."
      newline
      control f1 04
    endpage
  endmessage
