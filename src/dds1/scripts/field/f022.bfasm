      control f2 08 ff ff
      control f2 07 07 ff
      text "> A red wall stands in the way."
      newline
      text "Serph cannot pass through it."
      newline
      control f1 04
    endpage
  endmessage
  message FLD_YERWICE speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> A yellow wall stands in the way."
      newline
