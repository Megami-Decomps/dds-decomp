messages msg1
  message TUTORIAL_MES_01 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Serph and Heat devoured the"
      newline
      text "defeated enemies."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> After the battle, their HP will"
      newline
      text "recover slightly because they"
      newline
      text "consumed their enemies."
      newline
      control f1 04
    endpage
  endmessage
  message HARRY_EVENT_01_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f2 02 01 ff
      text "Yeaargh!"
      newline
      control f1 04
    endpage
  endmessage
  message HARRY_EVENT_01_02 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f2 02 01 ff
      text "Raise the wall!"
      newline
      control f1 04
    endpage
  endmessage
  message BATTLE_01 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "There's a voice in my head..."
      newline
      text "It keeps saying... devour..."
      newline
      text "Keep devouring... Devour more..."
      newline
      control f1 04
    endpage
  endmessage
  message BATTLE_03 speaker=1
    page
      control f2 08 ff ff
      control f2 07 04 ff
      text "I'm...so hungry..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I'm starving... "
      control f2 07 09 ff
      text "Starving, starving..."
      newline
      control f2 07 0b ff
      text "Starving, starving... "
      control f2 07 0d ff
      text "STARVING STARVING!"
      newline
      control f1 04
    endpage
  endmessage
  message BATTLE_02 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "They've chased us this far..."
      newline
      text "The Embryon..."
      newline
      control f1 04
    endpage
  endmessage
  message HARRY_EVENT_02 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f2 02 01 ff
      text "G-Get away from me!"
      newline
      control f1 04
    endpage
  endmessage
  message PARTY_04 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f2 02 01 ff
      text "Try something new."
      newline
      text "Block the path and drive him"
      newline
      text "into a dead end."
      newline
      control f1 04
    endpage
  endmessage
  message HARRY_EVENT_03_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f2 02 01 ff
      text "I'll give you my territory"
      newline
      text "and my hideout..."
      newline
      text "Just leave me alone!"
      newline
      control f1 04
    endpage
  endmessage
  message BERU_ROOM_01 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f2 02 01 ff
      text "> An ominous air can be felt"
      newline
      text "from underneath."
      newline
      text "It's too dark to see into the room."
      newline
      control f1 04
    endpage
  endmessage
  message BERU_ROOM_02 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f2 02 01 ff
      text "> An ominous air can be felt"
      newline
      text "from underneath."
      newline
      control f1 04
    endpage
  endmessage
  message BATTLE_BERU_01 speaker=3
    page
      control f2 08 ff ff
      control f2 07 06 ff
      control f2 02 01 ff
      text "You know, Boss..."
      newline
      control f1 04
    endpage
  endmessage
  message BATTLE_BERU_02 speaker=3
    page
      control f2 08 ff ff
      control f2 07 06 ff
      text "Shouldn't there be absolute laws"
      newline
      text "over the Junkyard?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "We should only be subject to"
      newline
      text "the laws of nature."
      newline
      control f1 04
    endpage
  endmessage
  message BATTLE_BERU_03 speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f2 02 01 ff
      text "In other words..."
      newline
      text "Someone as weak as you doesn't deserve"
      newline
      text "to be in charge."
      newline
      control f1 04
    endpage
  endmessage
  message BATTLE_BERU_04 speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f2 02 01 ff
      text "Ugh..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Don't think that you've surpassed"
      newline
      text "me, Boss..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I... I'll devour others to"
      newline
      text "grow strong..."
      newline
      text "When next we meet, you will fall!"
      newline
      control f1 04
    endpage
  endmessage
  message BATTLE_BERU_05 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Beelzebub disappeared."
      newline
      control f1 04
    endpage
  endmessage
  message AREA45_NPC01_02 speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I tried stopping you."
      newline
      text "I'm not responsible for what"
      newline
      text "happens next!"
      newline
      control f1 04
    endpage
  endmessage
  message GIMMIC speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> A wall stands in the way."
      newline
      control f1 04
    endpage
  endmessage
  message SWITCH speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> This is a switch..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> Activate it?"
      newline
      control f1 04
    endpage
  endmessage
  select YES_NO ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      text "Yes."
    endoption
    option
      control f2 08 ff ff
      text "No."
    endoption
  endselect
  message SWITCH_DAME speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Nothing happened."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> It seems the electricity is cut."
      newline
      control f1 04
    endpage
  endmessage
  message HAIDEN speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> It is a circuit panel."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> Reset the circuit breaker?"
      newline
      control f1 04
    endpage
  endmessage
  message HAIDEN_YES speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Electricity was restored."
      newline
      control f1 04
    endpage
  endmessage
  message HAIDEN_UP speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> It is a circuit panel."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> The breaker has been reset."
      newline
      control f1 04
    endpage
  endmessage
  message WIN_SUZAKU_MES speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Obtained "
      control f2 02 05 ff
      text "Crimson Orb"
      control f2 02 01 ff
      text "."
      newline
      control f1 04
    endpage
  endmessage
  message SAVE speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> It is a Save Point."
      newline
      text "It's unavailable at this time."
      newline
      control f1 04
    endpage
  endmessage
  message KAIHUKU speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> It is a Healing Point."
      newline
      text "It's unavailable at this time."
      newline
      control f1 04
    endpage
  endmessage
  message DEBUG_01 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Clear the Vanguards' Hideout?"
      newline
      control f1 04
    endpage
  endmessage
  message DEBUG_02 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Reset the circuit breaker?"
      newline
      control f1 04
    endpage
  endmessage
  message BARRIER_BLUE speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> A blue wall stands in the way."
      newline
      control f1 04
    endpage
  endmessage
  message BARRIER_YELLOW speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> A yellow wall stands in the way."
      newline
      control f1 04
    endpage
  endmessage
  message BARRIER_RED speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> A red wall stands in the way."
      newline
      control f1 04
    endpage
  endmessage
  message heat_01a speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I can remember it in a vague sense."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Sweet fluid dripping from a torn"
      newline
      text "throat... splattering as I sink"
      newline
      text "my teeth into rich flesh..."
      newline
      control f1 04
    endpage
  endmessage
  message heat_01b speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "This is a good sensation."
      newline
      control f1 04
    endpage
  endmessage
  message arujila_01 speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Let us find Harley, Serph."
      newline
      text "Perhaps he can explain this"
      newline
      text "strange power..."
      newline
      control f1 04
    endpage
  endmessage
  message npc_018_01_01 speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "This belonged to Harley,"
      newline
      text "but he was defeated."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "The new leader inherits the"
      newline
      text "possessions of the old..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> Obtained "
      control f2 02 05 ff
      text "Blue Key"
      control f2 02 01 ff
      text "."
      newline
      control f1 10
      control f2 08 ff ff
      control f1 04
    endpage
  endmessage
  message npc_018_01_02 speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Have you seen a strange blue wall?"
