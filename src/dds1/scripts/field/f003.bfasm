messages msg1
  select YES_NO ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      text "Yes."
    endoption
    option
      control f2 08 ff ff
      text "No."
    endoption
  endselect
  message hungry speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Serph and the party feel hungry..."
      newline
      control f1 04
    endpage
  endmessage
  message hungry02 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> They grew weak from hunger."
      newline
      control f1 04
    endpage
  endmessage
  message BLUE_GET_KARI speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Obtained the Blue Clue skill."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "This skill comes after the"
      newline
      text "amplification of atma, but"
      newline
      text "suppose that you earned it."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Also, it's not necessary to"
      newline
      text "set a skill in order to"
      newline
      text "use it at this time."
      newline
      control f1 04
    endpage
  endmessage
  message sera_01a speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I'm alright."
      newline
      control f1 04
    endpage
  endmessage
  message sera_01b speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Please don't do anything"
      newline
      text "dangerous."
      newline
      control f1 04
    endpage
  endmessage
  message sera_02a speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Lupa is on the other side of town..."
      newline
      control f1 04
    endpage
  endmessage
  message sera_02b speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I don't know why I have this feeling,"
      newline
      text "but... I'm sure of it."
      newline
      control f1 04
    endpage
  endmessage
  message sera_03 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Serph, do you think that"
      newline
      text "Lupa is okay?"
      newline
      control f1 04
    endpage
  endmessage
  message sera_04a speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I couldn't save him..."
      newline
      control f1 04
    endpage
  endmessage
  message sera_04b speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I must really seem useless..."
      newline
      control f1 04
    endpage
  endmessage
  message heat_00 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "They fear us."
      newline
      control f1 04
    endpage
  endmessage
  select heat_00_SEL ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      control f2 07 07 ff
      text "Why?"
    endoption
    option
      control f2 08 ff ff
      text "What is fear?"
    endoption
  endselect
  message heat_00_ans0 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "We will find out soon."
      newline
      control f1 04
    endpage
  endmessage
  message heat_00_ans1 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Just look around."
      newline
      text "It cannot be explained."
      newline
      control f1 04
    endpage
  endmessage
  message heat_13 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Do you see \"fear\" now?"
      newline
      control f1 04
    endpage
  endmessage
  message heat_01a speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "What an annoying woman."
      newline
      control f1 04
    endpage
  endmessage
  message heat_01b speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Well, if she changes her mind,"
      newline
      text "I'll just grab that guy over there."
      newline
      control f1 04
    endpage
  endmessage
  message heat_02 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "What a buncha losers!"
      newline
      text "I'll never end up like them."
      newline
      control f1 04
    endpage
  endmessage
  message heat_03 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "What a buncha losers!"
      newline
      text "I'll never end up like them."
      newline
      control f1 04
    endpage
  endmessage
  message heat_04 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "These newbies have guts."
      newline
      text "I like that in a meal."
      newline
      control f1 04
    endpage
  endmessage
  message heat_05 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I know you're hungry, but try to"
      newline
      text "wait a little longer."
      newline
      control f1 04
    endpage
  endmessage
  message heat_06 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I know you're hungry, but try to"
      newline
      text "wait a little longer."
      newline
      control f1 04
    endpage
  endmessage
  message heat_08a speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "That chunky bastard!"
      newline
