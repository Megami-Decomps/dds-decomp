      text "I'll survive, and have it all"
      newline
      text "to myself."
      newline
      control f1 04
    endpage
  endmessage
  message heat_003_03 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I don't give a damn about souls"
      newline
      text "or recycled information."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Let's find Sera."
      newline
      control f1 04
    endpage
  endmessage
  message npc_05_01 speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "They came out of that hole."
      newline
      control f1 04
    endpage
  endmessage
  message npc_05_02 speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Varin defeated them by "
      newline
      text "himself!?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "What kind of monster is he?"
      newline
      control f1 04
    endpage
  endmessage
  message npc_05_03a speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "There may be a place underground..."
      newline
      control f1 04
    endpage
  endmessage
  message npc_05_03b speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The rain is so natural that I never"
      newline
      text "really noticed it."
      newline
      control f1 04
    endpage
  endmessage
  message sera_003_01a speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "A river of reincarnation flows"
      newline
      text "from the rain of the dead."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Within the egg's shell, lost souls"
      newline
      text "continue their circulation..."
      newline
      control f1 04
    endpage
  endmessage
  message sera_003_01b speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "No... It shouldn't be like this..."
      newline
      control f1 04
    endpage
  endmessage
  message sera_003_02 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I..."
      newline
      text "I don't want to go any further..."
      newline
      control f1 04
    endpage
  endmessage
  message sera_003_03 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Why did God establish this cycle?"
      newline
      text "It only multiplies sadness..."
      newline
      control f1 04
    endpage
  endmessage
  message arujila_003_01a speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Those who die are purified in the"
      newline
      text "clouds and become rain."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "The Karma Temple then grants them"
      newline
      text "a new life..."
      newline
      control f1 04
    endpage
  endmessage
  message arujila_003_01b speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "That must be why..."
      newline
      control f1 04
    endpage
  endmessage
  message arujila_003_02 speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "How does Varin know about Sera?"
      newline
      control f1 04
    endpage
  endmessage
  message arujila_003_03 speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I felt something from Jinana,"
      newline
      text "too... so I think I understand."
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_02 speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "We are all ships in the vast sea"
      newline
      text "of life. Hold your heads high like"
      newline
      text "wind-blown sails..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "The compass which shows us the way"
      newline
      text "lies in our hearts."
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_03 speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "We vowed service to Lupa. Forgive"
      newline
      text "us, but we will not abandon the color"
      newline
      text "of the Wolves."
      newline
      control f1 04
    endpage
  endmessage
  message npc_04_02 speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Cherish honor and believe in"
      newline
      text "yourself. That is the law of"
      newline
      text "the Wolves."
      newline
      control f1 04
    endpage
  endmessage
  message npc_04_03 speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Do you know of the soul?"
      newline
      text "It carries the information of"
      newline
      text "one's feelings."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "If someone inherits his soul, then"
      newline
      text "Lupa will not truly die. Just like..."
      newline
      control f1 04
    endpage
  endmessage
  message EXITWARP speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Leave the area?"
      newline
      control f1 04
    endpage
  endmessage
