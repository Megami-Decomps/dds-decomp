      text "testing us?"
      newline
      control f1 04
    endpage
  endmessage
  message gale_08_0_ans2 speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "That's true--if we knew the answer,"
      newline
      text "we wouldn't be in this mess."
      newline
      text "Let's ask them ourselves."
      newline
