      control f2 07 07 ff
      text "This is satisfactory."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Let us plant the explosive here."
      newline
      control f1 04
    endpage
  endmessage
  message SET_BOMB_02 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "As we ascend, we must plant explosives"
      newline
      text "on the floors above."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "One explosive is needed per floor,"
      newline
