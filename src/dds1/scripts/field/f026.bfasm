      newline
      control f1 04
    endpage
  endmessage
  message CHECK_EXIT_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Do you understand the operation?"
      newline
      text "Let us proceed to the bottom of"
      newline
      text "the ship."
      newline
      control f1 04
    endpage
  endmessage
  message CHECK_EXIT_02 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Do you understand the operation?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "After we plant an explosive on"
      newline
