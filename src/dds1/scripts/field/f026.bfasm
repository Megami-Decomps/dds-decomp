messages msg1
  message OPERATION_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "You understand the plan, correct?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "First, we will plant an explosive"
      newline
      text "at the bottom of the ship."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Let us proceed."
      newline
      control f1 04
    endpage
  endmessage
  message STOP_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Leave this sector to Argilla."
      newline
      text "We must proceed to the bottom"
      newline
      text "of the ship."
      newline
      control f1 04
    endpage
  endmessage
  message NOTOPEN_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "We shall enter that sector later."
      newline
      text "First, let us proceed to the bottom of"
      newline
      text "the ship."
      newline
      control f1 04
    endpage
  endmessage
  message NOTOPEN_02 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Serph, the bottom of the ship"
      newline
      text "lies in this direction."
      newline
      control f1 04
    endpage
  endmessage
  message WARNING speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> A message is written:"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "DANGER!"
      newline
      text "Engine Room ahead."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Employees only beyond this point."
      newline
      control f1 04
    endpage
  endmessage
  message CHECK_EXIT_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Do you understand the operation?"
      newline
      text "Let us proceed to the bottom of"
      newline
      text "the ship."
      newline
      control f1 04
    endpage
  endmessage
  message CHECK_EXIT_02 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Do you understand the operation?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "After we plant an explosive on"
      newline
      text "each floor, we will join Argilla"
      newline
      text "in the hall."
      newline
      control f1 04
    endpage
  endmessage
  message CHECK_EXIT_03 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "What are you doing?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Let us return to the hall."
      newline
      control f1 04
    endpage
  endmessage
  message SET_BOMB_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "This is satisfactory."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Let us plant the explosive here."
      newline
      control f1 04
    endpage
  endmessage
  message SET_BOMB_02 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "As we ascend, we must plant explosives"
      newline
      text "on the floors above."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "One explosive is needed per floor,"
      newline
      text "for a total of seven."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Expedience is required for this mission."
      newline
      text "Let us hurry."
      newline
      control f1 04
    endpage
  endmessage
  message FIRSTBATTLE_01 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "There they are! It's them!"
      newline
      control f1 04
    endpage
  endmessage
  message FIRSTBATTLE_02 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Capture the leader and the girl,"
      newline
      text "but kill everyone else!"
      newline
      control f1 04
    endpage
  endmessage
  message NOTUSE_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "As discussed previously..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "...we cannot return via the same"
      newline
      text "elevator we arrived in. Use the door"
      newline
      text "to the right, instead."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "You, Leader, are the bait."
      newline
      control f1 04
    endpage
  endmessage
  message NOTUSE_03 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Move quickly from place to place,"
      newline
      text "and draw our opponents inside."
      newline
      control f1 04
    endpage
  endmessage
  message NOTUSE_02 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Do not run too quickly, or your"
      newline
      text "role as bait will be jeopardized."
      newline
      text "Let us take the right aisle."
      newline
      control f1 04
    endpage
  endmessage
  message BATTLE_012_01 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "There they are..."
      newline
      control f1 04
    endpage
  endmessage
  message BATTLE_012_02 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The Silver Fox is on the move:"
      newline
      text "port side, toward the bow."
      newline
      text "Call for backup!"
      newline
      control f1 04
    endpage
  endmessage
  message BATTLE_012_03 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Dey took de bait!"
      newline
      text "It's just like we planned..."
      newline
      control f1 04
    endpage
  endmessage
  message BATTLE_012_04 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Do not speak hastily."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "We cannot allow them to believe"
      newline
      text "our leader is worth so few of"
      newline
      text "their soldiers."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Destroy them so we may continue."
      newline
      control f1 04
    endpage
  endmessage
  message SETBOMB_3F speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Alright, let us set one here."
      newline
      control f1 04
    endpage
  endmessage
  message SETBOMB_2F speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Alright, let us set one here."
      newline
      control f1 04
    endpage
  endmessage
  message SETBOMB_4F speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Alright, let us set one here."
      newline
      control f1 04
    endpage
  endmessage
  message SETBOMB_5F speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Alright, let us set one here."
      newline
      control f1 04
    endpage
  endmessage
  message SETBOMB_6F speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Alright, let us set one here."
      newline
      control f1 04
    endpage
  endmessage
  message SETBOMB_7F speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Alright, let us set one here."
      newline
      control f1 04
    endpage
  endmessage
  message SETBOMB_8F speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Alright, let us set one here."
      newline
      control f1 04
    endpage
  endmessage
  message SET_BOMB_OVER speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> The explosive has been set."
      newline
      control f1 04
    endpage
  endmessage
  message GO_NEXT speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Of the 8 explosives, we have"
      newline
      control f2 03 01 ff
      text " left to set. Let us proceed"
