proc_005b:
  PROC proc_005b
_699:
  while (1) {
    if (ACTION_WINDOW_REQUEST_AND_POLL(9) == 1) {
      RESTORE_CAMERA_NODE_MODE()
      SET_SOLAR_OVERLAY_MODE(0)
      SCREEN_FADE_B(1, 15)
      WAIT_FOR_TIMER_LIMIT(15)
      COMM 0x013d
      push 16
      COMM 0x000b
      SCREEN_FADE_A(1, 30)
      WAIT_FOR_TIMER_LIMIT(30)
      ACTIVATE_MESSAGE_PANEL()
      MESSAGE_REQUEST_AND_POLL(message(RECOVER_FREE))
      FINISH_SCRIPT_MESSAGE_WINDOW()
      SET_SOLAR_OVERLAY_MODE(1)
      RELEASE_CURRENT_OBJECT()
    }
  _701:
    WAIT_FOR_TIMER_START()
  }
_700:
  return
end

messages msg1
  message OPERATION_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "You understand the plan, correct?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "First, we will plant an explosive"
      newline
      text "at the bottom of the ship."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Let us proceed."
      newline
      control f1 04
    endpage
  endmessage
  message STOP_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Leave this sector to Argilla."
      newline
      text "We must proceed to the bottom"
      newline
      text "of the ship."
      newline
      control f1 04
    endpage
  endmessage
  message NOTOPEN_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "We shall enter that sector later."
      newline
      text "First, let us proceed to the bottom of"
      newline
      text "the ship."
      newline
      control f1 04
    endpage
  endmessage
  message NOTOPEN_02 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Serph, the bottom of the ship"
      newline
      text "lies in this direction."
      newline
      control f1 04
    endpage
  endmessage
  message WARNING speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
