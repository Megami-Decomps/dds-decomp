      control f1 04
    endpage
  endmessage
  message sera_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "This is so cool, Serph!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Can I... go up to the top?"
      newline
      control f1 04
    endpage
  endmessage
  select sera_01_SEL ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      control f2 07 07 ff
      text "Sure, why not?"
    endoption
    option
      control f2 08 ff ff
      text "Save it for later."
    endoption
  endselect
  message sera_01_ans0 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Thank you, Serph."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Ships like this are actually"
      newline
      text "supposed to float..."
      newline
      text "...in the ocean, I think."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "The ocean is so vast and"
      newline
      text "beautiful... the water gently"
      newline
      text "rocking back and forth..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Come on, let's go!"
      newline
      control f1 04
    endpage
  endmessage
  message sera_01_ans1 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Oh, okay..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I can be patient."
      newline
      control f1 04
    endpage
  endmessage
  message sera_02 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I'd love to go see... the ocean."
      newline
      control f1 04
    endpage
  endmessage
  message heat_01 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Hey, Serph... Does it feel like"
      newline
      text "you've seen this hunk of junk"
      newline
      text "before?"
      newline
      control f1 04
    endpage
  endmessage
  select heat_01_SEL ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      control f2 07 07 ff
      text "Actually, yeah..."
    endoption
