messages msg1
  message START_01 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The Maribel are attacking at"
      newline
      text "the Citadel's main gate. They seem"
      newline
      text "to be about 500 strong."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "They can't surround us,"
      newline
      text "or attack us from behind."
      newline
      text "Defend the main gate."
      newline
      control f1 04
    endpage
  endmessage
  message START_02 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Roger. Let's go!"
      newline
      control f1 04
    endpage
  endmessage
  message START_03 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "They never learn, do they?"
      newline
      control f1 04
    endpage
  endmessage
  message GUARD_ROOM speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> It appears to be a barrack."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> The room is empty."
      newline
      text "All the soldiers have left."
      newline
      control f1 04
    endpage
  endmessage
  message WALL_01 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> There are guns on the wall."
      newline
      control f1 04
    endpage
  endmessage
  message WALL_02 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> There are empty spaces on the"
      newline
      text "wall. Soldiers must have taken"
      newline
      text "some of the guns."
      newline
      control f1 04
    endpage
  endmessage
  message BEDROOM speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> It appears to be a resting room."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> The lingering remains of someone's"
      newline
      text "presence can be felt."
      newline
      control f1 04
    endpage
  endmessage
  message BED_01 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> There are beds."
      newline
      text "The members must use them."
      newline
      control f1 04
    endpage
  endmessage
  message BED_02 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> The beds are still warm."
      newline
      control f1 04
    endpage
  endmessage
  message BATTLE_005_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Th-The Embryon!?"
      newline
      text "You're not the Maribel!"
      newline
      control f1 04
    endpage
  endmessage
  message BATTLE_005_02 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Who cares? Food is food."
      newline
      text "Let's get rid of them."
      newline
      control f1 04
    endpage
  endmessage
  message FACE speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> The gaze of a giant red-eyed"
      newline
      text "statue is fixed in this direction."
      newline
      control f1 04
    endpage
  endmessage
  message TWURUDAKU speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Heh heh heh..."
      newline
      control f1 04
    endpage
  endmessage
  message GAS_01 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "First a pitfall, then toxic gas..."
      newline
      text "These traps are pretty elaborate."
      newline
      control f1 04
    endpage
  endmessage
  message GAS_02 speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "They add something to the charm"
      newline
      text "of the impregnable citadel,"
      newline
      text "don't you think?"
      newline
      control f1 04
    endpage
  endmessage
  message GAS_03 speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Not that it matters."
      newline
      text "Let's keep moving."
      newline
      control f1 04
    endpage
  endmessage
  message RIOT_DOOR_01 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> A commotion can be heard"
      newline
      text "in the room..."
      newline
      control f1 04
    endpage
  endmessage
  message RIOT_DOOR_02 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Enter?"
      newline
      control f1 04
    endpage
  endmessage
  message CORPSE_01 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> The dead body of a member"
      newline
      text "of the Maribel."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> Worn-out words can be seen at"
      newline
      text "the corpse's fingertip."
      newline
      control f1 04
    endpage
  endmessage
  message CORPSE_02 speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Don't stand in front of"
      newline
      text "the red-eyed statues..."
      newline
      control f1 04
    endpage
  endmessage
  message CORPSE_03 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> The dead body of a member"
      newline
      text "of the Maribel."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> Worn-out words can be seen at"
      newline
      text "the corpse's fingertip."
      newline
      control f1 04
    endpage
  endmessage
  message CORPSE_04 speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Left is right, but right is left."
      newline
      control f1 04
    endpage
  endmessage
  message CORPSE_05 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> The dead body of a member"
      newline
      text "of the Maribel."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> Worn-out words can be seen at"
      newline
      text "the corpse's fingertip."
      newline
      control f1 04
    endpage
  endmessage
  message CORPSE_06 speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Approach the yellow-eyed"
      newline
      text "ones with caution..."
      newline
      control f1 04
    endpage
  endmessage
  message CORPSE_07 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> The dead body of a member"
      newline
      text "of the Maribel."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> Worn-out words can be seen at"
      newline
      text "the corpse's fingertip."
      newline
      control f1 04
    endpage
  endmessage
  message CORPSE_08 speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Watch out for that woman."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "She will repel you..."
      newline
      control f1 04
    endpage
  endmessage
  message LEFT_KEY_BATTLE speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Aha... I thought the thong chick"
      newline
      text "had come back again..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "...but this is some bitch in a long,"
      newline
      text "ugly skirt."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Either way, you have horrible"
      newline
      text "taste, so you might as well die!"
      newline
      control f1 04
    endpage
  endmessage
  message CORPSE_09 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> The dead body of a member"
      newline
      text "of the Maribel."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> Worn-out words can be seen at"
      newline
      text "the corpse's fingertip."
      newline
      control f1 04
    endpage
  endmessage
  message CORPSE_10 speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Careful with the next one..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "It's tough..."
      newline
      control f1 04
    endpage
  endmessage
  message SETKEY_YET speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> The statue has red eyes."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> It looks like something can be"
      newline
      text "inserted in the statue's side."
      newline
      control f1 04
    endpage
  endmessage
  message SETKEY_QUES_RIGHT speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Insert the R Statue Key?"
      newline
      control f1 04
    endpage
  endmessage
  message SETKEY_QUES_LEFT speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Insert the L Statue Key?"
      newline
      control f1 04
    endpage
  endmessage
  message SETKEY_QUES_TURN speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> The key may be turned in"
      newline
      text "either direction."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> Turn it which direction?"
      newline
      control f1 04
    endpage
  endmessage
  select SETKEY_QUES_TURN_SEL ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      text "Right."
    endoption
    option
      control f2 08 ff ff
      text "Left."
    endoption
    option
      control f2 08 ff ff
      text "Cancel."
    endoption
  endselect
  message SETKEY_ALR speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> This statue's trap has"
      newline
      text "been deactivated."
      newline
      control f1 04
    endpage
  endmessage
  message SETKEY_OFF speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> The statue's eyes switched from"
      newline
      text "red to blue."
      newline
      control f1 04
    endpage
  endmessage
  message SETKEY_HAVENT speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> The key did not work."
      newline
      control f1 04
    endpage
  endmessage
  message ALLCLEAR_01 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "So much for the traps."
      newline
      text "Now, we need to find Mick..."
      newline
      control f1 04
    endpage
  endmessage
  message ALLCLEAR_02 speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Something's not right."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I smell a rat..."
      newline
      text "Let's be careful."
      newline
      control f1 04
    endpage
  endmessage
  message MEMAI speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Feeling dizzy..."
      newline
      control f1 04
    endpage
  endmessage
  message NOT_OPEN speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Jinana's at the main gate, now."
      newline
      text "You were listening, weren't you!?"
      newline
      control f1 04
    endpage
  endmessage
  message LOCK_DOOR speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> The door will not open."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> It must be locked from the other"
      newline
      text "side."
      newline
