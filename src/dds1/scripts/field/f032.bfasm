  message FLD_ICE_BREAK speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Destroy it?"
      newline
      control f1 04
    endpage
  endmessage
  select FLD_ICE_BREAK_SEL ext=0 pattern=0 reserved=0 trailing=00
    option
