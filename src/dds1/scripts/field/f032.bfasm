      text "Yes."
    endoption
    option
      control f2 08 ff ff
      text "No."
    endoption
  endselect
  message BROKEN_DOOR speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> The door is too misshapen"
      newline
      text "to open properly."
      newline
      control f1 04
    endpage
  endmessage
