messages msg1
  message s_tarminal speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "This is a Small Terminal."
      newline
      text "Here you may save, or"
      newline
      text "return to a Large Terminal."
      newline
      control f1 04
    endpage
  endmessage
  message AKUMAKA_SURU speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> The Oxygen Tank is required"
      newline
      text "to advance."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> Equip the Oxygen Tank?"
      newline
      control f1 04
    endpage
  endmessage
  select AKUMAKA_SURU_SEL ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      text "Yes."
    endoption
    option
      control f2 08 ff ff
      text "No."
    endoption
  endselect
  message AKUMAKA_OK speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Equipped the Oxygen Tank."
      newline
      control f1 04
    endpage
  endmessage
  message modori_01 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Water is surging in"
      newline
      text "this direction!"
      newline
      control f1 04
    endpage
  endmessage
  message waterhalf speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> The water's current is increasing..."
      newline
      control f1 04
    endpage
  endmessage
  message AREA_07MODOSARE speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Returned to start."
      newline
      control f1 04
    endpage
  endmessage
  message AREA_10_NPC02 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The passage below us is flooded,"
      newline
      text "too. There isn't much we can"
      newline
      text "do about it..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "There may be "
      control f2 02 02 ff
      text "something to"
      newline
      text "the north east"
      control f2 02 01 ff
      text ", but I'll"
      newline
      text "leave that to you, boss."
      newline
      control f1 04
    endpage
  endmessage
  message AREA_16_YAMATA_01 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "My prey escaped just as I was"
      newline
      text "about to devour it..."
      newline
      text "But, maybe my luck has changed."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "You look delicious. It must be"
      newline
      text "my lucky day, afterall."
      newline
      control f1 04
    endpage
  endmessage
  message AREA_16_YAMATA_02 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I'll repay my good fortune by"
      newline
      text "devouring you immediately!"
      newline
      control f1 04
    endpage
  endmessage
  message COUNT_03 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> The water's current is"
      newline
      text "moving faster..."
      newline
      control f1 04
    endpage
  endmessage
  message COUNT_02 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> The water's current is gradually"
      newline
      text "speeding up."
      newline
      control f1 04
    endpage
  endmessage
  message COUNT_01 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> An uneasy feeling pervades"
      newline
      text "the area..."
      newline
      control f1 04
    endpage
  endmessage
  select noisefullornot ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      text "Set Noise rate for 7(15)"
    endoption
    option
      control f2 08 ff ff
      text "Set Noise rate for 5(11)"
    endoption
    option
      control f2 08 ff ff
      text "Set Noise rate for 3(7)"
    endoption
    option
      control f2 08 ff ff
      text "Set Noise rate for 1(3)"
    endoption
    option
      control f2 08 ff ff
      text "Do nothing."
    endoption
  endselect
  message EXITWARP speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Leave the area?"
      newline
      control f1 04
    endpage
  endmessage
  select EXITWARP_SEL ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      text "Yes."
    endoption
    option
      control f2 08 ff ff
      text "No."
    endoption
  endselect
  message HOSEKI speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> A strange object hovers in midair."
      newline
      text "Touch it?"
      newline
      control f1 04
    endpage
  endmessage
  select HOSEKI_SEL ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      text "Yes."
    endoption
    option
