proc_0033:
  PROC proc_0033
  COMM RESTORE_CAMERA_NODE_MODE
  PUSHIS 0
  COMM SET_SOLAR_OVERLAY_MODE
  COMM ACTIVATE_MESSAGE_PANEL
  PUSHMSG HEAT_JOIN
  COMM MESSAGE_REQUEST_AND_POLL
  COMM FINISH_SCRIPT_MESSAGE_WINDOW
  PUSHIS 3
  COMM SET_SOLAR_OVERLAY_MODE
  COMM RELEASE_CURRENT_OBJECT
  END
end

messages msg1
  select YES_NO ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      text "Yes."
    endoption
    option
      control f2 08 ff ff
      text "No."
    endoption
  endselect
  message HEAT_JOIN speaker=none
    page
      control f2 08 ff ff
      text "> Heat joined the party."
      newline
      control f1 04
    endpage
  endmessage
  message ICE_DONTHAVE speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> A blue wall stands in the way."
      newline
      control f1 04
    endpage
  endmessage
  message ICE_DONTHAVE_Y speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> A yellow wall stands in the way."
      newline
      control f1 04
    endpage
  endmessage
  message BLUEICE speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> A blue wall stands in the way"
      newline
      text "to an extra area."
      newline
      control f1 04
    endpage
  endmessage
  message ICE_BREAK speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Eliminate the wall?"
      newline
      control f1 04
    endpage
  endmessage
  message npc_001_01_03 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Unknown objects have been"
      newline
      text "appearing ever since the light"
      newline
      text "flowed through the Junkyard."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "When you approach the objects,"
      newline
      text "items and equipment appear."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "If you see one, you should"
      newline
      text "probably take advantage of this"
      newline
      text "anomaly."
      newline
      control f1 04
    endpage
  endmessage
  message npc_001_01_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I have devoured several enemies,"
      newline
      text "as commanded by law. Some went"
      newline
      text "down easier than others."
      newline
      control f1 04
    endpage
  endmessage
  message npc_001_01_02 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I came face to face with a rare"
      newline
      text "demon."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "It was close, but I devoured it"
      newline
      text "in the end. I gained a lot of"
      newline
      text "Macca."
      newline
      control f1 04
    endpage
  endmessage
  message npc_001_02_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Have you recovered your memory,"
      newline
      text "sir?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Do you remember the Vendor?"
      newline
      control f1 04
    endpage
  endmessage
  select npc_001_02_01_SEL ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      control f2 07 07 ff
      text "Yes, I am fine."
    endoption
    option
      control f2 08 ff ff
      text "Please remind me."
    endoption
  endselect
  message npc_001_02_01_ans0 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Of course."
      newline
      text "That is good to hear."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Remember to stock up on items"
      newline
      text "from the Vendor periodically."
      newline
      control f1 04
    endpage
  endmessage
  message npc_001_02_01_ans1 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Each time you defeat an enemy,"
      newline
      text "Macca credits are recorded in"
      newline
      text "your Tag Ring."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "You can exchange Macca for items"
      newline
      text "and equipment at various Vendor"
      newline
      text "locations."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "There's a Vendor in our base,"
      newline
      text "as well. Why not pay it a visit?"
      newline
      control f1 04
    endpage
  endmessage
  message npc_05_02 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Sir, are you aware that the Temple"
      newline
      text "is looking for cells?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "You can exchange cells for Macca"
      newline
      text "at the Temple."
      newline
      control f1 04
    endpage
  endmessage
  select npc_05_02_SEL ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      control f2 07 07 ff
      text "I know."
    endoption
    option
      control f2 08 ff ff
      text "What is a cell?"
    endoption
  endselect
  message npc_05_02_ans0 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Of course."
      newline
      control f1 04
    endpage
  endmessage
  message npc_05_02_ans1 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The Temple has not defined its"
      newline
      text "properties, but that information"
      newline
      text "is not necessary for us."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Simply exchange it for Macca at"
      newline
      text "the Vendor whenever you find it."
      newline
      control f1 04
    endpage
  endmessage
  message npc_05_03 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Sir, it seems that a fresh stock"
      newline
      text "of ammunition is now available."
      newline
      control f1 04
    endpage
  endmessage
  select npc_05_03_SEL ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      control f2 07 07 ff
      text "I know."
    endoption
    option
      control f2 08 ff ff
      text "Is that right?"
    endoption
  endselect
  message npc_05_03_ans0 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Really?"
      newline
      text "How did you find out already?"
      newline
      control f1 04
    endpage
  endmessage
  message npc_05_03_ans1 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The regular bullets and explosives"
      newline
      text "have been replaced by anti-demon"
      newline
      text "rounds."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "They apparently have additional"
      newline
      text "effects as well, such as fire,"
      newline
      text "electricity, and so on."
      newline
      control f1 04
    endpage
    page
