messages msg1
  select YES_NO ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      text "Yes."
    endoption
    option
      control f2 08 ff ff
      text "No."
    endoption
  endselect
  message HEAT_JOIN speaker=none
    page
      control f2 08 ff ff
      text "> Heat joined the party."
      newline
      control f1 04
    endpage
  endmessage
  message ICE_DONTHAVE speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> A blue wall stands in the way."
      newline
      control f1 04
    endpage
  endmessage
  message ICE_DONTHAVE_Y speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> A yellow wall stands in the way."
      newline
      control f1 04
    endpage
  endmessage
  message BLUEICE speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> A blue wall stands in the way"
      newline
      text "to an extra area."
      newline
      control f1 04
    endpage
  endmessage
  message ICE_BREAK speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Eliminate the wall?"
      newline
      control f1 04
    endpage
  endmessage
  message npc_001_01_03 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Unknown objects have been"
      newline
      text "appearing ever since the light"
      newline
      text "flowed through the Junkyard."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "When you approach the objects,"
      newline
      text "items and equipment appear."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "If you see one, you should"
      newline
      text "probably take advantage of this"
      newline
      text "anomaly."
      newline
      control f1 04
    endpage
  endmessage
  message npc_001_01_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I have devoured several enemies,"
      newline
      text "as commanded by law. Some went"
      newline
      text "down easier than others."
      newline
      control f1 04
    endpage
  endmessage
  message npc_001_01_02 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I came face to face with a rare"
      newline
      text "demon."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "It was close, but I devoured it"
      newline
      text "in the end. I gained a lot of"
      newline
      text "Macca."
      newline
      control f1 04
    endpage
  endmessage
  message npc_001_02_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Have you recovered your memory,"
      newline
      text "sir?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Do you remember the Vendor?"
      newline
      control f1 04
    endpage
  endmessage
  select npc_001_02_01_SEL ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      control f2 07 07 ff
      text "Yes, I am fine."
    endoption
    option
      control f2 08 ff ff
      text "Please remind me."
    endoption
  endselect
  message npc_001_02_01_ans0 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Of course."
