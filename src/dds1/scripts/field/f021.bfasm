      control f1 04
    endpage
  endmessage
  message npc_021_02_03a speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I see. Bat's dead, too."
      newline
      control f1 04
    endpage
  endmessage
  message npc_021_02_03b speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I'm glad that you're safe."
      newline
      control f1 04
    endpage
  endmessage
  message npc_021_02_04a speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "We've all noticed what Gale was"
      newline
      text "talking about. The sun, "
      newline
      text "for example."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "We've never seen it, but it"
      newline
      text "affects us and we understand"
      newline
      text "what it is."
      newline
      control f1 04
    endpage
  endmessage
  message npc_021_02_04b speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "How could that be...?"
      newline
      control f1 04
    endpage
  endmessage
  message npc_021_03_01a speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "We'll guard this base even if"
      newline
      text "the rest of Embryon relocates."
      newline
      control f1 04
    endpage
  endmessage
  message npc_021_03_01b speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "...But, please come back to visit"
      newline
      text "from time to time."
      newline
      control f1 04
    endpage
  endmessage
  message npc_021_03_03a speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "It's interesting to watch you and"
      newline
      text "the others devour demons."
      newline
      text "It excites me..."
      newline
      control f1 04
    endpage
  endmessage
  message npc_021_03_03b speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "There are so many ways to devour:"
      newline
      text "Teeth, claws, epidermal absorption,"
      newline
      text "or Ms. Argilla..."
      newline
      control f1 04
    endpage
  endmessage
  message npc_021_03_03c speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "...All I can do is suck them"
      newline
      text "through my strawlike mouth..."
      newline
      control f1 04
    endpage
  endmessage
  message npc_021_03_02a speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Do I know what a child is?"
      newline
      text "Is that some kind of joke, sir?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I used to have two kids, you know."
      newline
      text "Heh, I may not look it, but--"
      newline
      control f1 04
    endpage
  endmessage
  message npc_021_03_02b speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "...wait. How can that be?"
      newline
      text "I confused myself, sir."
      newline
      control f1 04
    endpage
  endmessage
  message npc_021_03_02c speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Sir!"
      newline
      control f1 04
    endpage
  endmessage
