messages msg1
  select YES_NO ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      text "Yes."
    endoption
    option
      control f2 08 ff ff
      text "No."
    endoption
  endselect
  message start_mes speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Varin must be somewhere in"
      newline
      text "this building."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> Enmity is vibrating through"
      newline
      text "the entire structure."
      newline
      control f1 04
    endpage
  endmessage
  message switch01_01 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> A strange red object floats"
      newline
      text "inside a pillar of light."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> Touch it?"
      newline
      control f1 04
    endpage
  endmessage
  message switch01_02 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Red rings appeared and began"
      newline
      text "to spin around the object."
      newline
      control f1 04
    endpage
  endmessage
  message switch01_03 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Negative energy can be felt from"
      newline
      text "the west side of the mansion."
      newline
      control f1 04
    endpage
  endmessage
  message switch02_01 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> A strange green object floats"
      newline
      text "inside a pillar of light."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> Touch it?"
      newline
      control f1 04
    endpage
  endmessage
  message switch02_02 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Green rings appeared and began"
      newline
      text "to spin around the object."
      newline
      control f1 04
    endpage
  endmessage
  message switch02_03 speaker=none
