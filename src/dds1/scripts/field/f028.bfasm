  message HINT_01 speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Every door in this room is locked,"
      newline
      text "except for those leading to the city"
      newline
      text "and Large Karma Terminal."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "If only we had a way to reach"
      newline
      text "Varin, we'd have our revenge..."
      newline
      control f1 04
    endpage
  endmessage
  message HINT_02 speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I dunno how it all works, but"
      newline
      text "those objects seem to be linked"
      newline
      text "to the structure of this building."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Between them there's a... force."
      newline
      text "I'm not sure how to describe it."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Be careful."
      newline
      control f1 04
    endpage
  endmessage
  message HINT_03 speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Those shafts of light..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "They feel just like those strange"
      newline
      text "walls... and those cells that"
      newline
      text "the Temple is collecting..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Whatever those things are..."
      newline
      text "they don't feel like part of this world."
      newline
      control f1 04
    endpage
  endmessage
  message AREA016_NPC01_01 speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "One man... destroyed..."
      newline
      text "He destroyed... our entire platoon..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "He's... looking for you..."
      newline
      text "You... should withdraw... now..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "The wall meant... nothing to him."
      newline
      text "Please... You must listen..."
      newline
      control f1 04
    endpage
  endmessage
  message AREA016_NPC01_02 speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "One man... destroyed..."
      newline
      text "He destroyed... our entire platoon..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "He's... looking for you..."
      newline
      text "You... should withdraw... now..."
      newline
      control f1 04
    endpage
  endmessage
