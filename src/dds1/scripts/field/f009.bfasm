  COMM ADD_EFFECT_UNIT_TO_WORLD
  PUSHIS 60
  COMM WAIT_FOR_TIMER_LIMIT
  PUSHIS 1
  MINUS
  COMM ADD_EFFECT_UNIT_TO_WORLD
  COMM RELEASE_CURRENT_OBJECT
  END
proc_0013:
  PROC proc_0013
_167:
  PUSHIS 1
  IF _168
  PUSHIS 1
  PUSHIS 9
  COMM 0x005e
  PUSHREG
  EQ
  IF _169
  COMM RESTORE_CAMERA_NODE_MODE
  PUSHTYPE5 str_01pos_01_2
  COMM READ_SECONDARY_WORLD_ID_VALUE
  PUSHREG
  COMM READ_CURRENT_WORLD_OBJECT_ID
  PUSHREG
  COMM ATTACH_WORLD_OBJECT_TO_SOURCE_VECTOR
  PUSHTYPE5 str_01cam_01_3
  COMM READ_SECONDARY_WORLD_ID_VALUE
  PUSHREG
  COMM ADD_EFFECT_UNIT_TO_WORLD
  PUSHIS 60
  COMM WAIT_FOR_TIMER_LIMIT
  PUSHIS 1
  MINUS
  COMM ADD_EFFECT_UNIT_TO_WORLD
  COMM RELEASE_CURRENT_OBJECT
  END
  GOTO _169
_169:
  COMM WAIT_FOR_TIMER_START
  GOTO _167
_168:
  END
end

