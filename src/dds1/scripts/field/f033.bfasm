      local_int[54] = MESSAGE_SELECTION_REQUEST_AND_POLL(selection(noisefullornot))
      if (local_int[54] == 0) {
        push 15
        COMM 0x0065
      } else {
      _224:
        if (local_int[54] == 1) {
          push 11
          COMM 0x0065
        } else {
        _225:
          if (local_int[54] == 2) {
            push 7
            COMM 0x0065
          } else {
          _226:
            if (local_int[54] == 3) {
              push 3
              COMM 0x0065
            }
          }
        }
      }
    _223:
      FINISH_SCRIPT_MESSAGE_WINDOW()
      SET_SOLAR_OVERLAY_MODE(1)
      RELEASE_CURRENT_OBJECT()
    }
  _228:
    WAIT_FOR_TIMER_START()
  }
_222:
  return
end

