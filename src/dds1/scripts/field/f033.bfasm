  result = READ_SECONDARY_WORLD_ID_VALUE(string(str_01cam_03_2))
  ADD_FLAGGED_EFFECT_UNIT_TO_WORLD(result)
  ACTIVATE_MESSAGE_PANEL()
  MESSAGE_REQUEST_AND_POLL(message(AREA16_BERU_02))
  FINISH_SCRIPT_MESSAGE_WINDOW()
  result = READ_SECONDARY_WORLD_ID_VALUE(string(str_01cam_03_MOTION))
  push result
  push string(str_01cam_03_3)
  COMM READ_SECONDARY_WORLD_ID_VALUE
  PUSHREG
  COMM 0x0013
  PREPARE_UNIT_MOTION_STATE(local_int[52], 4, 10, 20, 0)
  WAIT_FOR_TIMER_LIMIT(30)
  push 18
  COMM 0x0217
  push 0
  push 18
  COMM 0x01f3
  WAIT_FOR_TIMER_LIMIT(20)
  DISABLE_FIELD_MODELS(0, 0, string(md_hoji_01), 0)
  push 500
  push 33
  push 1
  COMM 0x0097
  push 331
  COMM 0x0067
  return
  goto _210
_210:
  return
set_fullnoise8:
  PROC set_fullnoise8
_212:
  while (1) {
    push 1
    push 9
    COMM ACTION_WINDOW_REQUEST_AND_POLL
    PUSHREG
    EQ
    IF _219
    RESTORE_CAMERA_NODE_MODE()
    SET_SOLAR_OVERLAY_MODE(0)
    ACTIVATE_MESSAGE_PANEL()
    local_int[53] = MESSAGE_SELECTION_REQUEST_AND_POLL(selection(noisefullornot))
    if (local_int[53] == 0) {
      push 7
      COMM 0x0065
    } else {
    _215:
      if (local_int[53] == 1) {
        push 5
        COMM 0x0065
      } else {
      _216:
        if (local_int[53] == 2) {
          push 3
          COMM 0x0065
        } else {
        _217:
          if (local_int[53] == 3) {
            push 1
            COMM 0x0065
          }
        }
      }
    }
  _214:
    FINISH_SCRIPT_MESSAGE_WINDOW()
    SET_SOLAR_OVERLAY_MODE(1)
    RELEASE_CURRENT_OBJECT()
    goto _219
  _219:
    WAIT_FOR_TIMER_START()
  }
_213:
  return
set_fullnoise16:
  PROC set_fullnoise16
_221:
  while (1) {
    push 1
    push 9
    COMM ACTION_WINDOW_REQUEST_AND_POLL
    PUSHREG
    EQ
    IF _228
    RESTORE_CAMERA_NODE_MODE()
    SET_SOLAR_OVERLAY_MODE(0)
    ACTIVATE_MESSAGE_PANEL()
    local_int[54] = MESSAGE_SELECTION_REQUEST_AND_POLL(selection(noisefullornot))
    if (local_int[54] == 0) {
      push 15
      COMM 0x0065
    } else {
    _224:
      if (local_int[54] == 1) {
        push 11
        COMM 0x0065
      } else {
      _225:
        if (local_int[54] == 2) {
          push 7
          COMM 0x0065
        } else {
        _226:
          if (local_int[54] == 3) {
            push 3
            COMM 0x0065
          }
        }
      }
    }
  _223:
    FINISH_SCRIPT_MESSAGE_WINDOW()
    SET_SOLAR_OVERLAY_MODE(1)
    RELEASE_CURRENT_OBJECT()
    goto _228
  _228:
    WAIT_FOR_TIMER_START()
  }
_222:
  return
end

