    endpage
  endmessage
  message ENB speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Instead of killing foes and"
      newline
      text "splitting them with your allies..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "...I suggest using Hunt skills"
      newline
      text "to devour your enemy alive."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "You not only have a meal all to"
      newline
      text "yourself, but you will also gain"
      newline
      text "more AP."
      newline
      control f1 04
    endpage
  endmessage
