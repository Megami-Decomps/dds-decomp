    COMM 0x0016
    SCREEN_FADE_A(1, 20)
    WAIT_FOR_TIMER_LIMIT(20)
    SCREEN_FADE_B(0, 30)
    WAIT_FOR_TIMER_LIMIT(30)
    UPDATE_FIELD_LOOK_AT_SEGMENT()
    ADD_FLAGGED_EFFECT_UNIT_TO_WORLD(-(1))
    SCREEN_FADE_A(0, 30)
    WAIT_FOR_TIMER_LIMIT(30)
    ACTIVATE_MESSAGE_PANEL()
    MESSAGE_REQUEST_AND_POLL(message(SERA_ZAN_MIETA))
    FINISH_SCRIPT_MESSAGE_WINDOW()
    SET_SOLAR_OVERLAY_MODE(3)
    RELEASE_CURRENT_OBJECT()
    return
  }
_441:
  return
end

