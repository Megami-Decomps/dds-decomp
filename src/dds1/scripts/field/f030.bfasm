  message AYASIIKEHAI speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> An evil presence can be"
      newline
      text "felt beyond the door."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> Open the door?"
