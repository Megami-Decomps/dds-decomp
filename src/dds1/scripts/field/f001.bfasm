messages msg1
  message NOW_CAMERA speaker=none
    page
      control f2 08 ff ff
      font "現在、カメラ"
      control f2 03 01 ff
      font "です。"
      newline
    endpage
  endmessage
  select CHG_CAMERA ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      font "次のカメラ"
    endoption
    option
      control f2 08 ff ff
      font "前のカメラ"
    endoption
  endselect
  message EXITWARP speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Leave the area?"
      newline
      control f1 04
    endpage
  endmessage
  select EXITWARP_SEL ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      text "Yes."
    endoption
    option
      control f2 08 ff ff
      text "No."
    endoption
  endselect
  message HOSEKI speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> A strange object hovers"
      newline
      text "in midair. Touch it?"
      newline
      control f1 04
    endpage
  endmessage
  select HOSEKI_SEL ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      text "Yes."
    endoption
    option
      control f2 08 ff ff
      text "No."
    endoption
  endselect
  message HOSEKI_NOGET speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Serph decided not to touch it."
      newline
      control f1 04
    endpage
  endmessage
  message HOSEKI_GET speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Obtained "
      control f2 03 02 ff
      text " "
      control f2 02 05 ff
      newline
      control f2 03 01 ff
      control f2 02 01 ff
      text "."
      newline
      control f1 04
    endpage
  endmessage
  message TAKARA speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> A strange object lies on the"
      newline
      text "floor. Touch it?"
      newline
      control f1 04
    endpage
  endmessage
  select TAKARA_SEL ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      text "Yes."
    endoption
    option
      control f2 08 ff ff
      text "No."
    endoption
  endselect
  message TAKARA_NOGET speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Serph decided not to touch it."
