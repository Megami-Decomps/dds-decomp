messages msg1
  message NOW_CAMERA speaker=none
    page
      control f2 08 ff ff
      font "現在、カメラ"
      control f2 03 01 ff
      font "です。"
      newline
    endpage
  endmessage
  select CHG_CAMERA ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      font "次のカメラ"
    endoption
    option
      control f2 08 ff ff
      font "前のカメラ"
    endoption
  endselect
