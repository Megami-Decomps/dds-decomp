      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Can such a world really exist?"
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_10a speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "If we can kill Bat, then Jinana"
      newline
      text "will finally be avenged..."
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_10b speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I'll do anything I can to help,"
      newline
      text "sir."
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_11a speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
