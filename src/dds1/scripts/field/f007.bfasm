  message npc_04_11 speaker=10
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I heard the Wolves refused to"
      newline
      text "surrender, and were devoured."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "It amazes me they'd do that,"
      newline
      text "and accept a violent death."
      newline
      control f1 04
    endpage
  endmessage
  message npc_04_12 speaker=10
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I heard the Wolves refused to"
      newline
      text "surrender, and were devoured."
