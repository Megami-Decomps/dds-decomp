  endmessage
  message npc_04_01c speaker=9
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "You changed early like me,"
      newline
      text "didn't you?"
      newline
      control f1 04
    endpage
  endmessage
  message npc_04_02 speaker=9
    page
      control f2 08 ff ff
      control f2 07 07 ff
