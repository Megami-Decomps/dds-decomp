  endmessage
  message npc_04_05 speaker=9
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "You're asking around about Mick?"
      newline
      text "Take my word for it, don't"
      newline
      text "waste your time."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Sneaky tricks are what our boss"
      newline
      text "is best at. You're only wasting"
      newline
      text "your time."
      newline
      control f1 04
    endpage
  endmessage
  message npc_04_06a speaker=9
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "So her beautiful body is gone..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Hey, don't gimme that."
      newline
      text "I'm trying t'feel sorry for her."
      newline
      control f1 04
    endpage
  endmessage
  message npc_04_06b speaker=9
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "...Why would I pity her, anyway?"
