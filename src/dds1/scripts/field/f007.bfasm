  message npc_03_09 speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Jinana told us that Nirvana is a world"
      newline
      text "without war..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "She called it paradise..."
