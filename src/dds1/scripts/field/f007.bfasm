messages msg1
  select YES_NO ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      text "Yes."
    endoption
    option
      control f2 08 ff ff
      text "No."
    endoption
  endselect
  message GARD_BATTLE speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "All entry is forbidden."
      newline
      text "Leave now, or face termination."
      newline
      control f1 04
    endpage
  endmessage
  select GARDBT_OR_N ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      control f2 07 07 ff
      text "Get out of my way."
    endoption
    option
      control f2 08 ff ff
      text "...I understand."
    endoption
  endselect
  message arujila_01 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "What is this?"
      newline
      control f1 04
    endpage
  endmessage
  message arujila_05a speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Jinana's men will be heading out,"
      newline
      text "soon."
      newline
      control f1 04
    endpage
  endmessage
  message arujila_05b speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "If we don't hurry, we'll be left behind."
      newline
      control f1 04
    endpage
  endmessage
  message arujila_06 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I wonder if leaving Jinana there was"
      newline
      text "right..."
      newline
      control f1 04
    endpage
  endmessage
  select arujila_06_SEL ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      control f2 07 07 ff
      text "She's risen to the clouds by now."
    endoption
    option
      control f2 08 ff ff
      text "It seems we're forgetting something."
    endoption
  endselect
  message arujila_06_ans0 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Those who die rise to the clouds"
      newline
      text "and fall back to the Junkyard"
      newline
      text "as rain."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "That's natural..."
      newline
      text "But, it feels like I'm forgetting"
      newline
      text "something important."
      newline
      control f1 04
    endpage
  endmessage
  message arujila_06_ans1 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I know. Isn't there... something you do"
      newline
      text "when a person dies?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "And, why does my... chest hurt?"
      newline
      control f1 04
    endpage
  endmessage
  message arujila_08 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I'm an idiot for letting someone"
      newline
      text "like him trick me again..."
      newline
      control f1 04
    endpage
  endmessage
  message arujila_09 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I still don't like devouring..."
      newline
      text "But, how can we fight if we lose"
      newline
      text "our powers?"
      newline
      control f1 04
    endpage
  endmessage
  message schro_01 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> It's that animal."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> It peers at you through deep,"
      newline
      text "silver eyes."
      newline
      control f1 04
    endpage
  endmessage
  message schro_02 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> It's that animal."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> It peers at you through deep,"
      newline
      text "silver eyes."
      newline
      control f1 04
    endpage
  endmessage
  message schro_03 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> It's that animal."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> It peers at you through deep,"
      newline
      text "silver eyes."
      newline
      control f1 04
    endpage
  endmessage
  message schro_04 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> It's that animal."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> It peers at you through deep,"
      newline
      text "silver eyes."
      newline
      control f1 04
    endpage
  endmessage
  message schro_05 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> It's that animal."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> Looking closely, you can see"
      newline
      text "a strange bell around its neck."
      newline
      control f1 04
    endpage
  endmessage
  message schro_06 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> It's that animal."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> Its eyes seem to be filled with"
      newline
      text "compassion for Argilla."
