  message npc_03_08 speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Jinana named us all comrades..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "And then that bastard, Bat...!"
      newline
      control f1 04
