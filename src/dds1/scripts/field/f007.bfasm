      text "desires in humanity..."
      newline
      control f1 04
    endpage
  endmessage
  message sera_02_ans1 speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Argilla's feelings aren't unusual."
      newline
      text "It's a very considerate way to"
