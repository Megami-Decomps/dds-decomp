  message sera_01a speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "People have always raised their eyes"
      newline
      text "to the heavens."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Power, knowledge..."
      newline
      text "This tower is a monument to such"
      newline
      text "ignorant greed."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "If our destiny is to survive by"
      newline
