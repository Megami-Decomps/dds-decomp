      newline
      control f1 04
    endpage
  endmessage
  message npc_04_10 speaker=10
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "\"For shelter, a big tree is"
      newline
      text "better than a small one.\" That's"
