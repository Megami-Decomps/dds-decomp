      newline
      text "...and for Jinana."
      newline
      control f1 04
    endpage
  endmessage
  message npc_04_01a speaker=9
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I came here to size you up myself,"
      newline
      text "but you're just a skinny little"
      newline
      text "pretty boy."
      newline
      control f1 04
