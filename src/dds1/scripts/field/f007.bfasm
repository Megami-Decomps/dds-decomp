  endmessage
  message arujila_11a speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "All of life is a competition..."
      newline
      control f1 04
    endpage
  endmessage
  message arujila_11b speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "What's the point of surviving, then?"
      newline
      text "And... why do I feel like I must protect"
      newline
      text "my comrades?"
      newline
      control f1 04
    endpage
  endmessage
  message arujila_11c speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Something is wrong with this"
      newline
      text "world. Like reality is... twisted."
      newline
      control f1 04
    endpage
  endmessage
  message arujila_13 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "This will be the end..."
      newline
      text "Right, Serph?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Then we can say goodbye to these"
      newline
      text "bodies, and all the killing..."
      newline
      control f1 04
    endpage
  endmessage
  message arujila_14a speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Sera said that she came to"
      newline
      text "help us."
      newline
      control f1 04
    endpage
  endmessage
  message arujila_14b speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Is that where she went?"
      newline
      text "Is she going to accomplish what"
      newline
      text "she came for... alone?"
      newline
      control f1 04
    endpage
  endmessage
  message npc_06_01 speaker=9
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I know the truth, man with the"
      newline
      text "Water Crown brand."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "In demon form, you are weak to"
      newline
      text "fire attacks. There is no use"
      newline
      text "trying to hide it."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Having the ability to analyze an"
      newline
      text "enemy's weak point turns the"
      newline
      text "tide in many battles..."
      newline
      control f1 04
    endpage
  endmessage
  message gale_08a speaker=12
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "They clearly don't want us to"
      newline
      text "reach Nirvana."
      newline
      control f1 04
    endpage
  endmessage
  message gale_08b speaker=12
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "These probably aren't orders from"
      newline
      text "the Karma Temple. You saw what"
      newline
      text "Sera was capable of..."
      newline
      control f1 04
    endpage
  endmessage
  message ciero_05 speaker=13
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Dis is not what was s'posed"
      newline
      text "ta happen..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "We're like da kings of de Junkyard."
      newline
      text "Dey should bow to us!"
      newline
      text "We're de kings now, ja?"
      newline
      control f1 04
    endpage
  endmessage
