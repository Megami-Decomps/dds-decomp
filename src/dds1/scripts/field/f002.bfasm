  select npc_03_01_SEL ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      text "No."
    endoption
    option
      control f2 08 ff ff
      text "About the Tribes."
    endoption
    option
      control f2 08 ff ff
      text "About the Junkyard."
    endoption
    option
      control f2 08 ff ff
      text "About the war."
    endoption
  endselect
  message npc_03_ans0 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I see."
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_ans1 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "They are the 6 major groups who"
      newline
      text "divide and rule the Junkyard."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "\"The Embryon\" is one such group."
      newline
      text "We all follow you, sir."
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_ans2 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "That is the name of this world"
      newline
      text "we live in."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "It is divided into seven areas:"
      newline
      text "Muladhara, Svadhisthana, Manipura,"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Anahata, Vishudha, Ajna, and"
      newline
      text "Sahasrara. "
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_ans3 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The Tribes of the Junkyard are all"
      newline
      text "fighting to rule over the other"
      newline
      text "Tribes."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "The triumphant group will be"
      newline
      text "allowed into Nirvana."
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_03 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The Karma Temple is located in the"
      newline
      text "Sahasrara area in the very center"
      newline
      text "of the Junkyard, sir."
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_05 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Did the Temple send that light?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Why would they not simply issue a"
      newline
      text "summons?"
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_06 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Devour others to survive and"
      newline
      text "steal their power..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "That seems different from simply"
      newline
      text "killing our enemies."
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_07 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I am not as hungry when I hear Sera"
      newline
      text "singing."
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_08 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "When I hear Sera's song, I forget"
      newline
      text "about my hunger."
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_11a speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Sir...?"
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_11b speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Why do we need to kill each other"
      newline
      text "in order to earn a place in paradise?"
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_11c speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "...*cough* Never mind."
      newline
      text "Forget I said anything."
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_12a speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "*sigh* ...Who do we have to kill next?"
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_12b speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I don't mean any disrespect, sir..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "But, the way we live right now..."
      newline
      text "It doesn't make sense to me."
      newline
      text "What about the laws of nature?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I can't really explain it."
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_13a speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "*sigh* ...Who do we have to kill next?"
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_13b speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I don't mean any disrespect, sir..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "But, the way we live right now..."
      newline
      text "It doesn't make sense to me."
      newline
      text "What about the laws of nature?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I can't really explain it."
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_14a speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "We've killed so many..."
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_14b speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I know it wasn't your decision,"
      newline
      text "sir."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "It would be the same if another"
      newline
      text "Tribe had won... I just don't feel"
      newline
      text "any joy in our victory."
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_15 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "A-Am I going to die... again?"
      newline
      text "I'm... tired of dying... Mother..."
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_09a speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I wonder what Nirvana's like."
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_09b speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Is it really worth all this"
      newline
      text "trouble?"
      newline
      control f1 04
    endpage
  endmessage
  message npc_04_01 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I see that you are departing"
      newline
      text "for Svadhisthana."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "The Vanguards are at an advantage."
      newline
      text "Be careful, sir."
      newline
      control f1 04
    endpage
  endmessage
  message npc_04_02 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Were you able to learn anything"
      newline
      text "from the Vanguards?"
      newline
      control f1 04
    endpage
  endmessage
  message npc_04_09a speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Harley has been defeated?"
      newline
      control f1 04
    endpage
  endmessage
  message npc_04_09b speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Our leader is truly strong."
      newline
      text "The Vanguards fell to only three"
      newline
      text "members of the Embryon."
      newline
      control f1 04
    endpage
  endmessage
  message npc_04_03 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The Karma Temple is the tallest"
      newline
      text "structure in the Junkyard."
      newline
      control f1 04
    endpage
  endmessage
  message npc_04_04 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Boss, did you experience the"
      newline
      text "Solar Noise at the Temple?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "...I know that term refers to the sun,"
      newline
      text "though I have never seen it..."
      newline
      control f1 04
    endpage
  endmessage
  message npc_04_05 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The Maribel's territory lies to"
      newline
      text "the north, in Manipura. They are"
      newline
      text "stronger than the Vanguards."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Do not relax your guard, sir."
      newline
      control f1 04
    endpage
  endmessage
  message npc_04_06 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The Citadel is a mighty fortress"
      newline
      text "in the Solids' territory of"
      newline
      text "Anahata."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "It is considered impregnable."
      newline
      text "Be ever vigilant, sir."
      newline
      control f1 04
    endpage
  endmessage
  message npc_04_07 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Do not worry about Sera's safety."
      newline
      text "None of the other Tribes should"
      newline
      text "know she is here."
      newline
      control f1 04
    endpage
  endmessage
  message npc_04_08 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Do not worry about Sera's safety."
      newline
      text "None of the other Tribes should"
      newline
      text "know she is here."
      newline
      control f1 04
    endpage
  endmessage
  message npc_001_04_04 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Do you have adequate medical"
      newline
      text "supplies, boss?"
      newline
      control f1 04
    endpage
  endmessage
  select npc_001_04_04_SEL ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      text "No need to remind me."
    endoption
    option
      control f2 08 ff ff
      text "I'm low on supplies."
    endoption
  endselect
  message npc_001_04_04_ans0 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "That is good to hear."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Be sure to heal your wounds"
      newline
      text "before going into battle."
      newline
      control f1 04
    endpage
  endmessage
  message npc_001_04_04_ans1 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "There are many threats in battle"
      newline
      text "besides normal wounds, such as"
      newline
      text "poison and paralysis."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "If your curative stock is low,"
      newline
      text "replenish at the Vendor."
      newline
      control f1 04
    endpage
  endmessage
  message npc_001_04_01 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Pay attention to battle formation."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Formation changes will alter your"
      newline
      text "battle strategy."
      newline
      control f1 04
    endpage
  endmessage
  message npc_001_04_02 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The Macca results are assessed"
      newline
      text "by the Karma Temple."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "The rating is based on efficient"
      newline
      text "actions during battle."
      newline
      control f1 04
    endpage
  endmessage
  select npc_001_04_02_SEL ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      text "I understand."
    endoption
    option
      control f2 08 ff ff
      text "What does that mean?"
    endoption
  endselect
  message npc_001_04_02_ans0 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Of course you do, sir."
      newline
      control f1 04
    endpage
  endmessage
  message npc_001_04_02_ans1 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "During a battle, the Temple keeps"
      newline
      text "track of how many turns pass."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "The fewer turns a battle lasts,"
      newline
      text "the more Macca is added to your"
      newline
      text "Tag Ring."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Kill enemies as swiftly as possible."
      newline
      control f1 04
    endpage
  endmessage
  message npc_001_04_09 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Though we have modified them to"
      newline
      text "harm demons..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "...firearms still are not one hundred"
      newline
      text "percent effective."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "They may be effective in"
      newline
      text "emergencies, however. Do not"
      newline
      text "neglect your weapon equipment."
      newline
      control f1 04
    endpage
  endmessage
  message npc_001_04_06 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Certain demons seem to be weak"
      newline
      text "to gunfire."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Your method of attack should take"
      newline
      text "your opponent into consideration."
      newline
      control f1 04
    endpage
  endmessage
  message npc_001_04_06a speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I... I didn't run away!"
      newline
      text "That was part of my strategy."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "If you know you're outclassed in"
      newline
      text "battle, escape and rearrange your"
      newline
      text "forces."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "That's a basic tenet of warfare!"
      newline
      text "Don't blame me!"
      newline
      control f1 04
    endpage
  endmessage
  message npc_001_04_07a speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "With my Atma powers..."
      newline
      control f1 04
    endpage
  endmessage
  message npc_001_04_07b speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "...and my gunfire..."
      newline
      control f1 04
    endpage
  endmessage
  message npc_001_04_07c speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "...we're the perfect couple!"
      newline
      text "No rival Tribe can withstand the might"
      newline
      text "of our combined powers!"
      newline
      control f1 04
    endpage
  endmessage
  message npc_001_04_07d speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Next time, they won't stand"
      newline
      text "a chance."
      newline
      control f1 04
    endpage
  endmessage
  message npc_001_04_08a speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I'm sick and tired of this."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Why do you always get to devour"
      newline
      text "the enemies that *I* weaken!?"
      newline
      control f1 04
    endpage
  endmessage
  message npc_001_04_08b speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I need to gain power somehow."
      newline
      text "What's wrong with that?"
      newline
      control f1 04
    endpage
  endmessage
  message npc_001_04_08c speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "So you benefit from all my hard"
      newline
      text "work? No, I'm done with this!"
      newline
      control f1 04
    endpage
  endmessage
  message npc_001_04_03a speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "During battle the other day,"
      newline
      text "I got reverted to human form."
      newline
      control f1 04
    endpage
  endmessage
  message npc_001_04_03b speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I panicked..."
      newline
      text "I sooo thought I was dead for sure!"
      newline
      control f1 04
    endpage
  endmessage
  message npc_001_04_03c speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Apparently, some people have"
      newline
      text "the power to do that..."
      newline
      text "Creepy, huh?"
      newline
      control f1 04
    endpage
  endmessage
  message sera_01 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I'm sorry, Serph."
      newline
      text "It's all my fault that you have"
      newline
      text "to leave."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Are you going to miss it?"
      newline
      control f1 04
    endpage
  endmessage
  select sera_01_SEL ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      text "Just... a little."
    endoption
    option
      control f2 08 ff ff
      text "Miss it?"
    endoption
  endselect
  message sera_01_ans0 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "A place like this holds on to"
      newline
      text "everyone's memories."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Sad memories are thorns in the"
      newline
      text "searching eye. Happy ones are"
      newline
      text "droplets of gentle life."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I remember someone telling me that"
      newline
      text "our lives are journeys across an"
      newline
      text "endless wasteland of corpses..."
      newline
      control f1 04
    endpage
  endmessage
  message sera_01_ans1 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "You're leaving a place filled with"
      newline
      text "the memories of people who lived"
      newline
      text "here."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "It must feel sad, to reflect on"
      newline
      text "all the time that has passed here."
      newline
      control f1 04
    endpage
  endmessage
  message sera_02 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "A town of rusted metal..."
      newline
      text "The leaden sky..."
      newline
      text "No, it isn't like this..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "What color is the sky you remember,"
      newline
      text "Serph?"
      newline
      control f1 04
    endpage
  endmessage
  select sera_02_SEL ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      text "I think... it was clear blue."
    endoption
    option
