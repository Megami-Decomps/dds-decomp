messages msg1
  select YES_NO ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      text "Yes."
    endoption
    option
      control f2 08 ff ff
      text "No."
    endoption
  endselect
  message hungry speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Serph and the party feel hungry."
      newline
      control f1 04
    endpage
  endmessage
  message hungry02 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> They grew weak from hunger."
      newline
      control f1 04
    endpage
  endmessage
  message EMB_DEBUG_MES speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Which boss do you want to fight?"
      newline
      control f1 04
    endpage
  endmessage
  select BOSS_BTL ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      text "Ravana."
    endoption
    option
      control f2 08 ff ff
      text "Hari Hara."
    endoption
  endselect
  message npc_03_01 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Are you feeling any better?"
      newline
      text "Well, is there anything you would"
      newline
      text "like to know, sir?"
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_01_2 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Anything else, sir?"
      newline
      control f1 04
    endpage
  endmessage
  select npc_03_01_SEL ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      text "No."
    endoption
    option
      control f2 08 ff ff
      text "About the Tribes."
    endoption
    option
      control f2 08 ff ff
      text "About the Junkyard."
    endoption
    option
      control f2 08 ff ff
      text "About the war."
    endoption
  endselect
  message npc_03_ans0 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I see."
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_ans1 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "They are the 6 major groups who"
      newline
      text "divide and rule the Junkyard."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "\"The Embryon\" is one such group."
      newline
      text "We all follow you, sir."
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_ans2 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "That is the name of this world"
      newline
      text "we live in."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "It is divided into seven areas:"
      newline
      text "Muladhara, Svadhisthana, Manipura,"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Anahata, Vishudha, Ajna, and"
      newline
      text "Sahasrara. "
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_ans3 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The Tribes of the Junkyard are all"
      newline
      text "fighting to rule over the other"
      newline
      text "Tribes."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "The triumphant group will be"
      newline
      text "allowed into Nirvana."
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_03 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The Karma Temple is located in the"
      newline
      text "Sahasrara area in the very center"
      newline
      text "of the Junkyard, sir."
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_05 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Did the Temple send that light?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Why would they not simply issue a"
      newline
      text "summons?"
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_06 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Devour others to survive and"
      newline
      text "steal their power..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "That seems different from simply"
      newline
      text "killing our enemies."
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_07 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I am not as hungry when I hear Sera"
      newline
      text "singing."
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_08 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "When I hear Sera's song, I forget"
      newline
      text "about my hunger."
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_11a speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Sir...?"
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_11b speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Why do we need to kill each other"
      newline
      text "in order to earn a place in paradise?"
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_11c speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "...*cough* Never mind."
      newline
      text "Forget I said anything."
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_12a speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "*sigh* ...Who do we have to kill next?"
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_12b speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I don't mean any disrespect, sir..."
      newline
      control f1 04
