messages msg1
  message CIERO_JOIN speaker=none
    page
      control f2 08 ff ff
      text "> Cielo joined the party."
      newline
      control f1 04
    endpage
  endmessage
  message hungry speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Serph and the party feel hungry..."
      newline
      control f1 04
    endpage
  endmessage
  message hungry02 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> They grew weak from hunger."
      newline
      control f1 04
    endpage
  endmessage
  message ALJIRA_QUESTION speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Bat and the Brutes will"
      newline
      text "probably come after Sera again."
      newline
      text "What do we do, Serph?"
      newline
      control f1 04
    endpage
  endmessage
  message GAIL_DECIDE speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I have devised a plan."
      newline
      text "It is time that we trapped them."
      newline
      control f1 04
    endpage
  endmessage
  message GAIL_DECIDE2 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The problem is how we will ensure"
      newline
      text "Sera's safety. We must also choose"
      newline
      text "an ideal location for the trap."
      newline
      control f1 04
    endpage
  endmessage
  message CIERO_LOOK speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "An ideal location?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I know de perfect place!"
      newline
      text "I noticed it from de air on de way"
      newline
      text "here."
      newline
      control f1 04
    endpage
  endmessage
  message SHIP_INFO speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> They received information on"
      newline
      text "a huge vessel's remains."
      newline
      control f1 04
    endpage
  endmessage
  message sera_01a speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "What did I... do to Mick?"
      newline
      text "I don't know what you're talking"
      newline
      text "about."
      newline
      control f1 04
    endpage
  endmessage
  message sera_01b speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "But... I'm very sorry that you two were"
      newline
      text "hurt so badly."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "It's all my fault..."
      newline
      control f1 04
    endpage
  endmessage
  message sera_03a speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "A portrait that looks like me...?"
      newline
      control f1 04
    endpage
  endmessage
  message sera_03b speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I don't..."
      newline
      text "Oh, my head..."
      newline
      control f1 04
    endpage
  endmessage
  message heat_01a speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "What the hell..."
      newline
      text "I've never seen a building"
      newline
      text "like that..."
      newline
      control f1 04
    endpage
  endmessage
  message heat_01b speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "...Then, why do I feel like I know it?"
      newline
      control f1 04
    endpage
  endmessage
  message heat_03a speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Does Sera's power scare you?"
      newline
      control f1 04
    endpage
  endmessage
  message heat_03b speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "...Just to let you know, I don't give"
      newline
      text "a damn who she really is."
      newline
      control f1 04
    endpage
  endmessage
  message heat_05 speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Hey, Serph."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Do you remember that painting"
      newline
      text "we saw inside?"
      newline
      control f1 04
    endpage
  endmessage
  select heat_05_SEL ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      control f2 07 07 ff
      text "Of a woman, right? I remember."
    endoption
    option
      control f2 08 ff ff
      text "Twinklebell? ...She was cute."
    endoption
  endselect
  message heat_05_ans0 speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "It looked a lot like... Sera."
      newline
      text "Why would there be a painting"
      newline
      text "of her here?"
      newline
      control f1 04
    endpage
  endmessage
  message heat_05_ans1a speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "What are you, stupid!?"
      newline
      control f1 04
    endpage
  endmessage
  message heat_05_ans1b speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "...Tch. Now I feel like an idiot"
      newline
      text "for worrying about it at all."
      newline
      control f1 04
    endpage
  endmessage
  message heat_06 speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Dammit..."
      newline
      text "None of this makes sense."
      newline
      control f1 04
    endpage
  endmessage
  message gale_01 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "These must be the ruins."
      newline
      text "I assume they want us to proceed"
      newline
      text "inside."
      newline
      control f1 04
    endpage
  endmessage
  select gale_01_SEL ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      text "The ruins of what?"
    endoption
    option
      control f2 08 ff ff
      text "...Is this an amusement park?"
    endoption
  endselect
  message gale_01_ans0 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Many old cities are buried"
      newline
      text "underneath the Junkyard."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "This appears to be one such city,"
      newline
      text "though the style of architecture"
      newline
      text "is unlike others I have seen."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "There are no apparent uses for"
      newline
      text "such an odd style."
      newline
      text "I do not comprehend."
      newline
      control f1 04
    endpage
  endmessage
  message gale_01_ans1 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "What is an \"amusement park?\""
      newline
      control f1 04
    endpage
  endmessage
  select gale_01_1_SEL ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      text "It is a place to have fun."
    endoption
    option
      control f2 08 ff ff
      text "I am not exactly sure."
    endoption
  endselect
  message gale_01_1_ans0 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Fun? I do not comprehend."
      newline
      text "We should proceed with caution..."
      newline
      control f1 04
    endpage
  endmessage
  message gale_01_1_ans1 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Lately, I have trouble"
      newline
      text "understanding you."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "The world seems to ignore logic,"
      newline
      text "and people are acting irrationally."
      newline
      control f1 04
    endpage
  endmessage
  message gale_07a speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "If events proceed smoothly, we may"
      newline
      text "be able to eliminate some of"
      newline
      text "Varin's forces."
      newline
      control f1 04
    endpage
  endmessage
  message gale_07b speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "We will regain control of this"
      newline
      text "battle."
      newline
      control f1 04
    endpage
  endmessage
  message gale_09 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "You are forbidden to fight within"
      newline
      text "the Tribe. If you cannot follow"
      newline
      text "this rule, I will intervene."
      newline
      control f1 04
    endpage
  endmessage
  message gale_10a speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "So, the others received memories"
      newline
      text "which aren't their own..."
      newline
      control f1 04
    endpage
  endmessage
  message gale_10b speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "That would make sense. I am"
      newline
      text "certain that vision... isn't part of"
      newline
      text "my memory."
      newline
      control f1 04
    endpage
  endmessage
  message aljira_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "What's this building?"
      newline
      text "I've seen it somewhere before."
      newline
      control f1 04
