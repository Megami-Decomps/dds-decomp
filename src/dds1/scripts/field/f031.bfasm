messages msg1
  message SWITH_ORNOT speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> It is a switch."
      newline
      text "Activate it?"
      newline
      control f1 04
    endpage
  endmessage
  select SWITH_ORNOTSEL ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      text "Activate the switch."
    endoption
    option
      control f2 08 ff ff
      text "Don't activate it."
    endoption
  endselect
  message SWITH_NO speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Serph left it alone."
      newline
      control f1 04
    endpage
  endmessage
  message SERA_ZAN_MIE speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Sera's image is visible..."
      newline
      control f1 04
    endpage
  endmessage
  message SERA_ZAN_MIETA speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> The sad image of Sera"
      newline
      text "disappeared..."
      newline
      control f1 04
    endpage
  endmessage
  message GARU speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Here begins the battle with"
      newline
      text "Garuda. Field event included."
      newline
      control f1 04
    endpage
  endmessage
  message JTY speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The Cyber Shaman does not"
      newline
      text "wish to open the gate."
      newline
      control f1 04
    endpage
  endmessage
  message JTY_01 speaker=0
    page
      control f2 08 ff ff
      text "Leave at once."
      newline
      text "I repeat, leave at once."
      newline
      control f1 04
    endpage
  endmessage
  message ANANTA speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Replaying the Cyber Shaman's"
      newline
      text "recorded message:"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "\"I'm sorry, everyone."
      newline
      text "I remember everything, now.\""
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "\"I want you all to stay here."
      newline
      text "Please, don't come any closer.\""
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "\"Trust me, this is for the best."
      newline
      text "...Goodbye. Thank you for"
      newline
      text "everything you've done.\""
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "That is all."
      newline
      text "Leave immediately."
      newline
      control f1 04
    endpage
  endmessage
  message ANANTA_BT speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Then you face"
      newline
      text "immediate termination."
      newline
      control f1 04
    endpage
  endmessage
  select GO_ORNOTSEL ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      text "Alright..."
    endoption
    option
      control f2 08 ff ff
      text "My answer is no."
    endoption
  endselect
  message KOURYU_01 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "So you've defeated the four"
      newline
      text "Guardian Beasts... I see why"
      newline
      text "you're the strongest Tribe."
      newline
      control f1 04
    endpage
  endmessage
  message KOURYU_02 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Is it the members' strength..."
      newline
      text "Or is it the leader's...?"
      newline
      text "I will learn as we battle."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I shall devour you, and savor"
      newline
      text "the climb to Nirvana."
      newline
      text "Bring it on!"
      newline
      control f1 04
    endpage
  endmessage
  message GRD_DEAD speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> A Karma Temple guard"
      newline
      text "was brutally murdered."
      newline
      control f1 04
    endpage
  endmessage
  message KOURYUUNO_BIT speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Activated the fight with Kou-Ryo!"
      newline
      control f1 04
    endpage
  endmessage
  message gale_040_01 speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Their defenses are getting"
      newline
      text "noticeably stronger."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "If we continue, then we probably"
      newline
      text "won't be able to turn back."
      newline
      control f1 04
    endpage
  endmessage
  select gale_040_01_SEL ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      text "...Let me think."
    endoption
    option
      control f2 08 ff ff
      text "I'm ready."
    endoption
  endselect
  message gale_040_01_ans0 speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "So am I."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I'm sure Heat, Argilla, and Cielo"
      newline
      text "feel the same way."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Let's go, Serph."
      newline
      control f1 04
    endpage
  endmessage
  message gale_040_01_ans1 speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Is there something on your mind,"
      newline
      text "or are you afraid?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "There's a reason we've gotten"
      newline
      text "this far, and received the help"
      newline
      text "of so many others."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Don't forget that."
      newline
      control f1 04
    endpage
  endmessage
  message heat_038_01 speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "We can't turn back now."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "C'mon, Serph."
      newline
      control f1 04
    endpage
  endmessage
  message arujila_038_01a speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "You must be suffering..."
      newline
      control f1 04
    endpage
  endmessage
  message arujila_038_01b speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Hold on, Sera. We'll catch up with you,"
      newline
      text "no matter what happens."
      newline
      control f1 04
    endpage
  endmessage
  message gale_038_01 speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The guard is unusually strict."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Once we proceed, it may not be"
      newline
      text "possible to turn back."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Whenever you're ready, Serph."
      newline
      control f1 04
    endpage
  endmessage
  message ciero_038_01a speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Dat image of Sera on de way..."
      newline
      text "She was crying, ja?"
      newline
      control f1 04
    endpage
  endmessage
  message ciero_038_01b speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "We can't leave her alone now!"
      newline
      control f1 04
    endpage
  endmessage
  message heat_039_01a speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Sera's in trouble..."
      newline
      control f1 04
    endpage
  endmessage
  message heat_039_01b speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Can't you tell!?"
      newline
      control f1 04
    endpage
  endmessage
  message arujila_039_01a speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "No..."
      newline
      text "The Junkyard is... disappearing!"
      newline
      control f1 04
    endpage
  endmessage
  message arujila_039_01b speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Our comrades are still down there!"
      newline
      control f1 04
    endpage
  endmessage
  message gale_039_01 speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Is this also Sera's doing?"
      newline
      control f1 04
    endpage
  endmessage
  select gale_039_01_SEL ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      text "I trust Sera."
