      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Whenever you're ready, Serph."
      newline
      control f1 04
    endpage
  endmessage
  message ciero_038_01a speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
