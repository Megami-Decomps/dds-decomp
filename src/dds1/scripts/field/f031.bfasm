      control f1 04
    endpage
  endmessage
  message arujila_038_01b speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Hold on, Sera. We'll catch up with you,"
      newline
      text "no matter what happens."
      newline
      control f1 04
    endpage
  endmessage
