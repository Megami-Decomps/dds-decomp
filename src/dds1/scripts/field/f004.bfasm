messages msg1
  select YES_NO ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      text "Yes."
    endoption
    option
      control f2 08 ff ff
      text "No."
    endoption
  endselect
  message GAIL_JOIN speaker=none
    page
      control f2 08 ff ff
      text "> Gale joined the party."
      newline
      control f1 04
    endpage
  endmessage
  message hungry speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Serph and the party feel hungry..."
      newline
      control f1 04
    endpage
  endmessage
  message hungry02 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> They grew weak from hunger."
      newline
      control f1 04
    endpage
  endmessage
  message heat_02 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "She wants to see our skills?"
      newline
      text "Great, I'll give her an up-close"
      newline
      text "demonstration!"
      newline
      control f1 04
    endpage
  endmessage
  message heat_03 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Why don't we just devour them, now"
      newline
      text "that their leader is gone?"
      newline
      control f1 04
    endpage
  endmessage
  message arujila_02 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "We didn't come here to fight."
      newline
      text "We need to prove that to Jinana."
      newline
      control f1 04
    endpage
  endmessage
  message arujila_03 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I'll stop you if you even try it."
      newline
      control f1 04
    endpage
  endmessage
  message npc_01_02 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Only 3 people!?"
      newline
      text "You far underestimate the Maribel."
      newline
      control f1 04
    endpage
  endmessage
  message npc_01_03 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I will trust you..."
      newline
      text "...to take care of Jinana."
      newline
      control f1 04
    endpage
  endmessage
  message npc_02_02 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Leave now or you will die."
      newline
      control f1 04
    endpage
  endmessage
  message npc_02_03 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Jinana's main force is en route to"
      newline
      text "the Citadel. Leave now."
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_02 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "If we defeat you, the Maribel will"
      newline
      text "control 3 regions."
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_03 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "This gate will not be opened until"
      newline
      text "Jinana returns."
      newline
      control f1 04
    endpage
  endmessage
  message gale_04 speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "They still do not understand that"
      newline
      text "Mick has been defeated."
      newline
      text "This is troublesome."
      newline
      control f1 04
    endpage
  endmessage
  message gale_05 speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Of what do they speak?"
      newline
      text "I do not comprehend."
      newline
      control f1 04
    endpage
  endmessage
  message gale_06 speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I understand now, though I didn't"
      newline
      text "before."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "They are advocating different"
      newline
      text "types of music."
      newline
      control f1 04
    endpage
  endmessage
  message gale_07a speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Someone else..."
      newline
      control f1 04
    endpage
  endmessage
  message gale_07b speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Have I become similar to them?"
      newline
      control f1 04
    endpage
  endmessage
  message gale_SISEI_01a speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "They either fled, or were"
      newline
      text "devoured."
      newline
      control f1 04
    endpage
  endmessage
  message gale_SISEI_01b speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Whichever case, the report seems"
      newline
      text "to be true."
      newline
      control f1 04
    endpage
  endmessage
  message gale_SISEI_02a speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Dealing with them will not change"
      newline
      text "our situation."
      newline
      control f1 04
    endpage
  endmessage
  message gale_SISEI_02b speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "However, they did kill some"
      newline
      text "of our comrades."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "This could be considered revenge"
      newline
      text "for such needless killing."
      newline
      control f1 04
    endpage
  endmessage
  message gale_SISEI_03 speaker=3
    page
      control f2 08 ff ff
