      control f1 04
    endpage
  endmessage
  message npc_01_01 speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Varin Omega is dangerous. He must"
      newline
      text "not be allowed to reach Nirvana."
      newline
      control f1 04
    endpage
  endmessage
  message npc_07_01 speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
