  message npc_002_03_01_ans0a speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Have you seen a demon with"
      newline
      text "\"beautiful silver wings?\" He is"
      newline
      text "sooo dreamy."
      newline
      control f1 04
    endpage
  endmessage
  message npc_002_03_01_ans0b speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I want to meet him, but I totally"
      newline
      text "freeze up when I try to go inside."
      newline
      control f1 04
    endpage
  endmessage
  message npc_002_03_01_ans0c speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Squeee!"
      newline
      text "Maybe he'll give me his phone"
      newline
      text "number!"
      newline
      control f1 04
    endpage
  endmessage
  message npc_002_03_01_ans0d speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "--?"
      newline
      text "His what?"
      newline
      text "What are you talking about?"
      newline
      control f1 04
