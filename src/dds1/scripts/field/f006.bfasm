      newline
      text "inside that building."
      newline
      control f1 04
    endpage
  endmessage
  message npc_002_03_02a speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "So that demon hunk has a"
      newline
      text "girlfriend..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "*sigh* Major bummer."
      newline
