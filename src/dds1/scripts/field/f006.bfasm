messages msg1
  select YES_NO ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      text "Yes."
    endoption
    option
      control f2 08 ff ff
      text "No."
    endoption
  endselect
  message hungry speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Serph and the party feel hungry..."
      newline
      control f1 04
    endpage
  endmessage
  message hungry02 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> They grew weak from hunger."
      newline
      control f1 04
    endpage
  endmessage
  message sera_01a speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "No one can avoid the fate which"
      newline
      text "rains from the heavens..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "The only thing I can do... is pray."
      newline
      control f1 04
    endpage
  endmessage
