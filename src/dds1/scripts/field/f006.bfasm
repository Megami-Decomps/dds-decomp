  message ciero_01a speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Dat building..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "It looks like it's made a' digital"
      newline
      text "images or sumthin'."
