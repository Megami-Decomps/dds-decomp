  message ciero_SISEI_04 speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Three places down, ja?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Let's look for deir boss, then!"
      newline
      control f1 04
    endpage
  endmessage
  message ciero_SISEI_05 speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "All our comrades were s'posed ta"
      newline
      text "go to Nirvana wit' us..."
      newline
      control f1 04
    endpage
  endmessage
  message npc_03_01 speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Serph! I just remembered"
      newline
      text "everything!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I used to be in a Tribe called"
      newline
      text "\"Business.\""
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "It was so cutthroat... I couldn't"
      newline
      text "take it anymore... and..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "...I hung myself."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Please...!"
      newline
      text "Tell me what this means!"
      newline
      control f1 04
    endpage
  endmessage
  message gale_01a speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Ruling by power is effective"
      newline
      text "until people refuse to acknowledge"
      newline
      text "that power."
      newline
      control f1 04
    endpage
  endmessage
  message gale_01b speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "In us, the Karma Temple has"
      newline
      text "engineered its own demise."
      newline
      control f1 04
    endpage
  endmessage
  message gale_02 speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "It's obvious now that I'm different"
      newline
      text "from the rest of you."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I did not exist in Varin's memory."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "You five are special."
      newline
      control f1 04
    endpage
  endmessage
  select gale_02_SEL ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      control f2 07 07 ff
      text "What do you mean?"
    endoption
    option
      control f2 08 ff ff
      text "Yes... I agree."
    endoption
  endselect
  message gale_02_ans0a speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I speculate there are two types of"
      newline
      text "people in the Junkyard."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Those such as Heat, Argilla, Cielo"
      newline
      text "and yourself, who share memories"
      newline
      text "with Sera..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "...and those whose past memories"
      newline
      text "are lost, and who are not connected"
      newline
      text "with Sera--like Lupa and myself."
      newline
      control f1 04
    endpage
  endmessage
  message gale_02_ans0b speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "However, considering Sera's"
      newline
      text "house is here..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "It's still not clear if we all died"
      newline
      text "in Nirvana, as Varin said..."
      newline
      control f1 04
    endpage
  endmessage
  message gale_02_ans1a speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Let us hope that our theory"
      newline
      text "is correct."
      newline
      control f1 04
    endpage
  endmessage
  message gale_02_ans1b speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "We could be wrong."
      newline
      text "...There may be something else"
      newline
      text "behind all of this."
      newline
      control f1 04
    endpage
  endmessage
  message gale_SISEI_01a speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "They either fled, or were"
      newline
      text "devoured."
      newline
      control f1 04
    endpage
  endmessage
  message gale_SISEI_01b speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Whichever case, the report seems"
      newline
      text "to be true."
      newline
      control f1 04
    endpage
  endmessage
  message gale_SISEI_02a speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Dealing with them will not change"
      newline
      text "our situation."
      newline
      control f1 04
    endpage
  endmessage
  message gale_SISEI_02b speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "However, they did kill some"
      newline
      text "of our comrades."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "This could be considered revenge"
      newline
      text "for such needless killing."
      newline
      control f1 04
    endpage
  endmessage
  message gale_SISEI_03 speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "If we are victorious, then all"
      newline
      text "wars will end."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I truly hope that this comes"
      newline
      text "to pass."
      newline
      control f1 04
    endpage
  endmessage
  message gale_SISEI_04 speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "There isn't time to lose."
      newline
      text "If we're going to eliminate them,"
      newline
      text "let's do it quickly."
      newline
      control f1 04
    endpage
  endmessage
  message gale_SISEI_05a speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Sera knows all about this world,"
      newline
      text "and everything about us."
      newline
      control f1 04
    endpage
  endmessage
  message gale_SISEI_05b speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Let's head for the Temple, Serph."
      newline
      control f1 04
    endpage
  endmessage
  message npc_04_01a speaker=5
