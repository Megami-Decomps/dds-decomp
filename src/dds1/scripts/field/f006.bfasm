  endmessage
  message npc_05_01 speaker=9
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "One day, that building suddenly"
      newline
      text "sprang out of nowhere."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Colonel took a scouting party"
      newline
