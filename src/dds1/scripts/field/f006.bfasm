      control f1 04
    endpage
  endmessage
  message ciero_02a speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Yaah, I see it now."
      newline
      text "Dis was Sera's house..."
      newline
      control f1 04
    endpage
  endmessage
  message ciero_02b speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "But, we died in Nirvana, didn't we...?"
      newline
      control f1 04
    endpage
  endmessage
  message ciero_02c speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "What is Sera's house doin' here,"
      newline
      text "den?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "We ain't in Nirvana."
      newline
      text "This don't make sense, mon."
      newline
      control f1 04
    endpage
  endmessage
  message ciero_SISEI_01 speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "What de hell dey want now?"
      newline
      text "We already won, ja?"
      newline
      control f1 04
    endpage
  endmessage
  message ciero_SISEI_02 speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "What should we do, bro?"
