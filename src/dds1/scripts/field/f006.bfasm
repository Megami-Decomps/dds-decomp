  message npc_04_01 speaker=9
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "We didn't anticipate a cowardly"
      newline
      text "ambush because we assumed our"
      newline
      text "enemies were true soldiers."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "If we knew to think like cowards,"
      newline
      text "you would be prisoners by now."
      newline
      control f1 04
    endpage
  endmessage
  message npc_05_01 speaker=9
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "One day, that building suddenly"
      newline
      text "sprang out of nowhere."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Colonel took a scouting party"
      newline
      text "inside, and it's been our base"
      newline
      text "ever since."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "When he found the innermost room,"
      newline
      text "the Colonel flew into a rage."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Please, I'm giving you"
      newline
      text "information... Don't devour me..."
      newline
      control f1 04
    endpage
  endmessage
