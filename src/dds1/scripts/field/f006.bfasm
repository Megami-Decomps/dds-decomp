messages msg1
  select YES_NO ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      text "Yes."
    endoption
    option
      control f2 08 ff ff
      text "No."
    endoption
  endselect
  message hungry speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Serph and the party feel hungry..."
      newline
      control f1 04
    endpage
  endmessage
  message hungry02 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> They grew weak from hunger."
      newline
      control f1 04
    endpage
  endmessage
  message sera_01a speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "No one can avoid the fate which"
      newline
      text "rains from the heavens..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "The only thing I can do... is pray."
      newline
      control f1 04
    endpage
  endmessage
  message sera_01b speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "He had already been... overtaken"
      newline
      text "by the virus..."
      newline
      control f1 04
    endpage
  endmessage
  message heat_01a speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I don't think anything surprises"
      newline
      text "me anymore."
      newline
      control f1 04
    endpage
  endmessage
  message heat_01b speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Look at that building."
      newline
      text "Seen it before, haven't you?"
      newline
      control f1 04
    endpage
  endmessage
  message heat_02 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Don't waste time worrying about"
      newline
      text "things you can't change."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "We can't abandon Sera... our comrade."
      newline
      text "That's all you need to know."
      newline
      control f1 04
    endpage
  endmessage
  message heat_SISEI_01 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Damn these bastards!"
      newline
      text "Makin' us waste our time..."
      newline
      control f1 04
    endpage
  endmessage
  message heat_SISEI_02a speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "It's not like we can help people"
      newline
      text "who have already been devoured."
      newline
      control f1 04
    endpage
  endmessage
  message heat_SISEI_02b speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Hurry up! We need to find Sera!"
      newline
      control f1 04
    endpage
  endmessage
  message heat_SISEI_03a speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "You care too much about others,"
      newline
      text "y'know that?"
      newline
      control f1 04
    endpage
  endmessage
  message heat_SISEI_03b speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "If we're gonna do this,"
      newline
      text "then hurry the hell up, already!"
      newline
      control f1 04
    endpage
  endmessage
  message heat_SISEI_04 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Sera... don't do anything stupid."
      newline
      control f1 04
    endpage
  endmessage
  message heat_SISEI_05a speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "What a waste of time."
      newline
      control f1 04
    endpage
  endmessage
  message heat_SISEI_05b speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Okay, everyone's happy."
      newline
      text "Let's get going!"
      newline
      control f1 04
    endpage
  endmessage
  message arujila_01a speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "That's Varin's headquarters?"
