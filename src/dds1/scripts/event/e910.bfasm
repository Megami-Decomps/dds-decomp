flw0 2
profile dds1

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=0 float=0

procedure e910_main reserved=0x00000000
procedure e910_sera reserved=0x00000000
procedure e910_dead reserved=0x00000000

code
e910_main:
  PROC e910_main
  PUSHIS 0
  COMM MESSAGE_REQUEST_AND_POLL
  END
e910_sera:
  PROC e910_sera
  COMM 0x003e
  COMM ACTIVATE_MESSAGE_PANEL
  PUSHIS 0
  COMM MESSAGE_REQUEST_AND_POLL
  COMM FINISH_SCRIPT_MESSAGE_WINDOW
  COMM 0x003f
  END
e910_dead:
  PROC e910_dead
  COMM 0x003e
  PUSHIS 0
  COMM 0x01ce
  PUSHIS 100
  PUSHIS 271
  PUSHIS 1
  COMM 0x0197
  PUSHIS 24
  MINUS
  PUSHIS 100
  COMM 0x0198
  END
end

messages msg1
  message MSG_SERA_00 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Everyone, don't give in!"
      newline
      control f1 04
    endpage
  endmessage
  speaker 0
    text "Sera"
  endspeaker
end

strings
  zero 240
end
