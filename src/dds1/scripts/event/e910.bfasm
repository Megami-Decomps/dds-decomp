flw0 2
profile dds1

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=0 float=0

procedure e910_main reserved=0x00000000
procedure e910_sera reserved=0x00000000
procedure e910_dead reserved=0x00000000

code
e910_main:
  PROC e910_main
  MESSAGE_REQUEST_AND_POLL(message(MSG_SERA_00))
  return
e910_sera:
  PROC e910_sera
  COMM 0x003e
  ACTIVATE_MESSAGE_PANEL()
  MESSAGE_REQUEST_AND_POLL(message(MSG_SERA_00))
  FINISH_SCRIPT_MESSAGE_WINDOW()
  COMM 0x003f
  return
e910_dead:
  PROC e910_dead
  COMM 0x003e
  push 0
  COMM 0x01ce
  push 100
  push 271
  push 1
  COMM 0x0197
  push -(24)
  push 100
  COMM 0x0198
  return
end

messages msg1
  message MSG_SERA_00 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Everyone, don't give in!"
      newline
      control f1 04
    endpage
  endmessage
  speaker 0
    text "Sera"
  endspeaker
end

strings
  zero 240
end
