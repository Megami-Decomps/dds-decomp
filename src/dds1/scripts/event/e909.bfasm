messages msg1
  message MSG_START_TOUMEI speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Ravana is invisible."
      newline
      control f1 04
    endpage
  endmessage
  message MSG_START_00 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Wait! I might be able to help."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I think I can... feel his presence."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Hm..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Oh! He's--"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_HINT_00 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "...I'm sorry, I lost him."
      newline
      control f1 04
    endpage
  endmessage
  message MSG_HINT_L101 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "He's straight ahead... or to the left."
      newline
      text "Definitely not the right."
      newline
      control f1 04
    endpage
  endmessage
  message MSG_HINT_L102 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "He isn't in the center."
      newline
      text "Try the left or right."
      newline
      control f1 04
    endpage
  endmessage
  message MSG_HINT_L103 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "He's in the center... or to the right."
      newline
      text "Definitely not the left."
      newline
      control f1 04
    endpage
  endmessage
  message MSG_HINT_L201 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I can feel his presence on"
      newline
      text "the left side."
      newline
      control f1 04
    endpage
  endmessage
  message MSG_HINT_L202 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I can't feel his presence on either"
      newline
      text "side... Try the center."
      newline
      control f1 04
    endpage
  endmessage
  message MSG_HINT_L203 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "He's on the right somewhere."
      newline
      control f1 04
    endpage
  endmessage
  message MSG_HINT_L300 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "He's on the left. Found him!"
      newline
      text "The far left!"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_HINT_L301 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "To the left... There!"
      newline
      text "He's second to the left!"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_HINT_L302 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "To the left... Oh!"
      newline
      text "Just a little to the left!"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_HINT_L303 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "To the right... Oh!"
      newline
      text "Just a little to the right!"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_HINT_L304 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "To the right... There!"
      newline
      text "He's second to the right!"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_HINT_L305 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "He's on the right. Found him!"
      newline
      text "The far right!"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_HINT_L400 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I can sense..."
      newline
      text "His breathing... His power..."
      newline
      text "His hatred... I can feel him."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "He's all the way to the left!"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_HINT_L401 speaker=0
    page
      control f2 08 ff ff
