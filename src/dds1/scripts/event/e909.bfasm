    endpage
    page
      control f2 08 ff ff
      text "He's all the way to the right!"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_HINT_CHANGE speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "He moved!"
      newline
      text "Be careful, everyone..."
      newline
      control f1 04
    endpage
  endmessage
  message MSG_RAV_00 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Argh... Damn you!!"
      newline
      control f1 04
    endpage
  endmessage
  speaker 0
    text "Sera"
  endspeaker
  speaker 1
    text "Ravana"
  endspeaker
end

strings
  zero 240
end
