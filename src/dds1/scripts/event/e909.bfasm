  endmessage
  message MSG_HINT_L305 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "He's on the right. Found him!"
      newline
      text "The far right!"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_HINT_L400 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I can sense..."
      newline
      text "His breathing... His power..."
      newline
      text "His hatred... I can feel him."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "He's all the way to the left!"
      newline
      control f1 04
    endpage
  endmessage
