messages msg1
  message MSG_A01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "……我が塔を登らんとする"
      font "者よ。"
      newline
      font "光の中へ入りたる者よ。"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "おまえの心を見せよ……"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_A02_S speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "おお……おまえの内には"
      newline
      font "乱れなく息づくコトワリが"
      font "ある……"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_A02_Y speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "おお……おまえの内には"
      newline
      font "炎の如きコトワリがある…"
      font "…"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_A02_M speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "おお……おまえの内には"
      newline
      font "珠の硬さのコトワリがある"
      font "……"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_A03 speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "そのコトワリにて創世のか"
      font "なうや……"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "求めるなら、"
      control f2 02 02 ff
      font "3つのタカラの珠"
      control f2 02 01 ff
      font "を手に"
      newline
      font "我が元まで来るがよい!"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_B01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "……我が塔を登らんとする"
      font "者よ。"
      newline
      font "光の中へ入りたる者よ。"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "おまえの心を見せよ……"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_B02 speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "おお……"
      newline
      font "おまえの心の内や見えず…"
      font "…"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_B03 speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "汝、何者なるか…"
      newline
      font "我が意にかなう者なるか…"
      font "…"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "…恐れ無くば、"
      control f2 02 02 ff
      font "3つのタカラの珠"
      control f2 02 01 ff
      font "を手に"
      newline
      font "我が元まで来るがよい……"
      newline
      control f1 04
    endpage
  endmessage
  speaker 0
    font "声"
  endspeaker
end

