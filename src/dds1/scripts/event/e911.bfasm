flw0 2
profile dds1

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=0 float=0

procedure e911_main reserved=0x00000000
procedure e911_sera reserved=0x00000000
procedure e911_form reserved=0x00000000
procedure e911_dead reserved=0x00000000
jump_label _2 reserved=0x00000000
jump_label _1 reserved=0x00000000

code
e911_main:
  PROC e911_main
  MESSAGE_REQUEST_AND_POLL(message(MSG_SERA_00))
  return
e911_sera:
  PROC e911_sera
  COMM 0x003e
  ACTIVATE_MESSAGE_PANEL()
  MESSAGE_REQUEST_AND_POLL(message(MSG_SERA_00))
  FINISH_SCRIPT_MESSAGE_WINDOW()
  COMM 0x003f
  return
e911_form:
  PROC e911_form
  push 0
  COMM 0x01c2
  PUSHREG
  EQ
  IF _2
  push 15
  push 282
  push 1
  COMM 0x01b2
  push 80
  push 282
  push 1
  COMM 0x0197
  push 210
  push 282
  push 282
  push 1
  COMM 0x01a1
  push 0
  push 80
  COMM 0x0198
  COMM 0x01a4
  goto _1
_2:
  push 15
  push 281
  push 1
  COMM 0x01b2
  push 80
  push 281
  push 1
  COMM 0x0197
  push 210
  push 281
  push 281
  push 1
  COMM 0x01a1
  push 0
  push 80
  COMM 0x0198
  COMM 0x01a4
  goto _1
_1:
  return
e911_dead:
  PROC e911_dead
  COMM 0x003e
  push 99
  push 282
  push 1
  COMM 0x0197
  WAIT_FOR_TIMER_LIMIT(5)
  ACTIVATE_MESSAGE_PANEL()
  MESSAGE_REQUEST_AND_POLL(message(MSG_HARI_00))
  COMM 0x01d4
  MESSAGE_REQUEST_AND_POLL(message(MSG_HARI_01))
  push 0
  push 99
  COMM 0x0198
  FINISH_SCRIPT_MESSAGE_WINDOW()
  push 0
  COMM 0x01ce
  push 100
  push 282
  push 1
  COMM 0x0197
  WAIT_FOR_TIMER_LIMIT(5)
  push 16
  push 282
  push 1
  COMM 0x01b2
  push -(13)
  push 100
  COMM 0x0198
  SCREEN_FADE_B(1, 0)
  WAIT_FOR_TIMER_LIMIT(20)
  return
end

messages msg1
  message MSG_SERA_00 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "(Out of control again!? Geez...)"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_HARI_00 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Impressive... but it ends here!"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_HARI_01 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "You shall not escape this purgatory!"
      newline
      control f1 04
    endpage
  endmessage
  speaker 0
    text "Sera"
  endspeaker
  speaker 1
    text "Harihara"
  endspeaker
end

strings
  zero 240
end
