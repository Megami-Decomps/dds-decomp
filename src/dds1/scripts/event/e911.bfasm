flw0 2
profile dds1

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=0 float=0

procedure e911_main reserved=0x00000000
procedure e911_sera reserved=0x00000000
procedure e911_form reserved=0x00000000
procedure e911_dead reserved=0x00000000
jump_label _2 reserved=0x00000000
jump_label _1 reserved=0x00000000

code
e911_main:
  PROC e911_main
  PUSHMSG MSG_SERA_00
  COMM MESSAGE_REQUEST_AND_POLL
  END
e911_sera:
  PROC e911_sera
  COMM 0x003e
  COMM ACTIVATE_MESSAGE_PANEL
  PUSHMSG MSG_SERA_00
  COMM MESSAGE_REQUEST_AND_POLL
  COMM FINISH_SCRIPT_MESSAGE_WINDOW
  COMM 0x003f
  END
e911_form:
  PROC e911_form
  PUSHIS 0
  COMM 0x01c2
  PUSHREG
  EQ
  IF _2
  PUSHIS 15
  PUSHIS 282
  PUSHIS 1
  COMM 0x01b2
  PUSHIS 80
  PUSHIS 282
  PUSHIS 1
  COMM 0x0197
  PUSHIS 210
  PUSHIS 282
  PUSHIS 282
  PUSHIS 1
  COMM 0x01a1
  PUSHIS 0
  PUSHIS 80
  COMM 0x0198
  COMM 0x01a4
  GOTO _1
_2:
  PUSHIS 15
  PUSHIS 281
  PUSHIS 1
  COMM 0x01b2
  PUSHIS 80
  PUSHIS 281
  PUSHIS 1
  COMM 0x0197
  PUSHIS 210
  PUSHIS 281
  PUSHIS 281
  PUSHIS 1
  COMM 0x01a1
  PUSHIS 0
  PUSHIS 80
  COMM 0x0198
  COMM 0x01a4
  GOTO _1
_1:
  END
e911_dead:
  PROC e911_dead
  COMM 0x003e
  PUSHIS 99
  PUSHIS 282
  PUSHIS 1
  COMM 0x0197
  PUSHIS 5
  COMM WAIT_FOR_TIMER_LIMIT
  COMM ACTIVATE_MESSAGE_PANEL
  PUSHMSG MSG_HARI_00
  COMM MESSAGE_REQUEST_AND_POLL
  COMM 0x01d4
  PUSHMSG MSG_HARI_01
  COMM MESSAGE_REQUEST_AND_POLL
  PUSHIS 0
  PUSHIS 99
  COMM 0x0198
  COMM FINISH_SCRIPT_MESSAGE_WINDOW
  PUSHIS 0
  COMM 0x01ce
  PUSHIS 100
  PUSHIS 282
  PUSHIS 1
  COMM 0x0197
  PUSHIS 5
  COMM WAIT_FOR_TIMER_LIMIT
  PUSHIS 16
  PUSHIS 282
  PUSHIS 1
  COMM 0x01b2
  PUSHIS 13
  MINUS
  PUSHIS 100
  COMM 0x0198
  PUSHIS 0
  PUSHIS 1
  COMM SCREEN_FADE_B
  PUSHIS 20
  COMM WAIT_FOR_TIMER_LIMIT
  END
end

messages msg1
  message MSG_SERA_00 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "(Out of control again!? Geez...)"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_HARI_00 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Impressive... but it ends here!"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_HARI_01 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "You shall not escape this purgatory!"
      newline
      control f1 04
    endpage
  endmessage
  speaker 0
    text "Sera"
  endspeaker
  speaker 1
    text "Harihara"
  endspeaker
end

strings
  zero 240
end
