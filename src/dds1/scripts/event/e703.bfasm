messages msg1
  message MSG_010_1 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      font "おやまあ、悪魔なんぞが"
      newline
      font "カグツチへの道をつくりま"
      font "したか。"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_010_2 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      font "これには、婆も少々驚いて"
      font "おりますよ、"
      newline
      font "坊ちゃま……"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_010_3 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      font "カグツチが伸ばせし塔は"
      newline
      font "オベリスクを打ち、これを"
      font "従えた。"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_010_4 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      font "創世を望む者たちがゾロゾ"
      font "ロと、"
      newline
      font "ゾロゾロと……やってきま"
      font "すでしょうねぇ。"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_010_5 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      font "これまで貴方は、よく生き"
      font "延びて"
      newline
      font "坊ちゃまを楽しませてくれ"
      font "ました。"
      newline
      font "…それは誉めて遣わします"
      font "。"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "ですが、最後の肝心な一幕"
      font "はこれから。"
      newline
      font "気を抜かずに、しっかりや"
      font "ること……"
      newline
      font "それが大事ですよ。"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "……さて、悪魔が創り主に"
      font "なるなんて"
      newline
      font "結末があるんでございまし"
      font "ょうかねぇ、"
      newline
      font "坊ちゃま……"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_010_6 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      font ">子どもと老婆はいなくな"
      font "った……"
      newline
      control f1 04
    endpage
  endmessage
  speaker 0
    font "老婆"
  endspeaker
end

