flw0 2
profile dds1

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=0 float=0

procedure e920_main reserved=0x00000000

code
e920_main:
  PROC e920_main
  MESSAGE_REQUEST_AND_POLL(message(MSG_START_00))
  return
end

messages msg1
  message MSG_START_00 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      font "かり"
      newline
      control f1 04
    endpage
  endmessage
  speaker 0
    font "人修羅"
  endspeaker
end

strings
  zero 240
end
