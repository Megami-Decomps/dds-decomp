section 3 type=3 stride=0x1 count=1875 offset=0xaf0
  msg1
  message LILITH_001 speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "よくここまでたどりついた"
      font "な。"
      newline
      control f1 04
    endpage
  endmessage
  message LILITH_002 speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "・・・神でも悪魔でもない"
      font "男。"
      newline
      font "人である事を捨てたデビル"
      font "ハーツの所有者。"
      newline
      control f1 04
    endpage
  endmessage
  message LILITH_003 speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "お前がここに来る事は解っ"
      font "ていた。"
      newline
      control f1 04
    endpage
  endmessage
  message LILITH_004 speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "・・・この世界が産まれた"
      font "理由、"
      newline
      font "・・・お前自身の存在する"
      font "意味、"
      newline
      control f1 04
    endpage
  endmessage
  message LILITH_005 speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "・・・そして、この世界の"
      font "行く末"
      newline
      control f1 04
    endpage
  endmessage
  message LILITH_006 speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "全ての疑問はモナドに会え"
      font "ば"
      newline
      font "わかる・・・、そう信じて"
      font "るのだろう。"
      newline
      control f1 04
    endpage
  endmessage
  message LILITH_007 speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "・・・全てを知る事がお前"
      font "にとって"
      newline
      font "幸せとは限らぬがな・・・"
      newline
      control f1 04
    endpage
  endmessage
  message LILITH_008 speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "この道を抜ければ"
      newline
      font "モナドに会う事が出来る。"
      newline
      control f1 04
    endpage
  endmessage
  message LILITH_009 speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "ただし、"
      newline
      font "通り抜けれればの話だが・"
      font "・・"
      newline
      control f1 04
    endpage
  endmessage
  message LILITH_010 speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "それでもお前は"
      newline
      font "モナドの地に行く事を望む"
      font "のか?"
      newline
      control f1 04
    endpage
  endmessage
  message KAIWA speaker=1
    page
      control f2 08 ff ff
      font "どうしますか?"
      newline
    endpage
  endmessage
  select KAIWA_SEL
    option
      control f2 08 ff ff
      font "それでも進む"
    endoption
    option
      control f2 08 ff ff
      font "・・・引き返す"
    endoption
  endselect
  message LILITH_011 speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "・・・よかろう。"
      newline
      font "モナドへとつながる扉を開"
      font "いてやる。"
      newline
      control f1 04
    endpage
  endmessage
  message LILITH_012 speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "・・・そうか。だが気がか"
      font "わったら"
      newline
      font "ここに来るんだな。待って"
      font "いるぞ。"
      newline
      control f1 04
    endpage
  endmessage
  message ERROR speaker=0
    page
      control f2 08 ff ff
      font "スクリプトのエラーだっち"
      font "ゃ!"
      newline
      control f1 04
    endpage
  endmessage
  message MODE speaker=1
    page
      control f2 08 ff ff
      font "どのテストにしますか?"
      newline
    endpage
  endmessage
  select MODE_SEL
    option
      control f2 08 ff ff
      font "テストイベント1 スクリ"
      font "プト2リリスイベント"
    endoption
    option
      control f2 08 ff ff
      font "テストイベント2 じっき"
      font "ムービー"
    endoption
    option
      control f2 08 ff ff
      font "イベント2のかんせいよて"
      font "い(ムービー)"
    endoption
  endselect
  speaker 0
    font "リリス"
  endspeaker
  speaker 1
    font " "
  endspeaker
end

