messages msg1
  message MSG_001 speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "…邪教の館へようこそ。"
      newline
      control f1 04
    endpage
  endmessage
  message ISAMU_002 speaker=1
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "脅かすなよ、(主人公)。"
      newline
      font "何か出たのかと思ったよ"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "………それにしてもおかし"
      font "いだろ?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "この病院、誰もいないんだ"
      font "ぜ。"
      newline
      control f1 04
    endpage
  endmessage
  message ISAMU_003 speaker=1
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "お前、誰かに会ったか?"
      newline
      control f1 04
    endpage
  endmessage
  select KAIWA_SEL
    option
      control f2 08 ff ff
      font "会った"
    endoption
    option
      control f2 08 ff ff
      font "会ってない"
    endoption
  endselect
  message ISAMU_004 speaker=1
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "………………"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "チアキとか言うなのは無し"
      font "だぞ?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "……あ～ぁ。"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "先生に会えると思って来た"
      font "のにな。"
      newline
      font "ここに入院してるって話だ"
      font "よな?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "…先生、何処にいるんだろ"
      font "?"
      newline
      control f1 04
    endpage
  endmessage
  message ISAMU_005 speaker=1
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "……あ～ぁ。"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "先生に会えると思って来た"
      font "のにな。"
      newline
      font "ここに入院してるって話だ"
      font "よな?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "…先生、何処にいるんだろ"
      font "?"
      newline
      control f1 04
    endpage
  endmessage
  message ISAMU_006 speaker=1
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "さっき怪しい地下室見かけ"
      font "たけど…"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "まさかあんな不気味な所に"
      newline
      font "いるはずないよな?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "…あぁ!思い出しただけで"
      font "も寒気がする!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "チアキって、まだ下にいる"
      font "よな?"
      newline
      font "…とりあえず、俺戻るよ。"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "こんな不気味な病院、長居"
      font "はしたくないな…"
      newline
      control f1 04
    endpage
  endmessage
  speaker 0
    font "邪教の主"
  endspeaker
  speaker 1
    font "イサム"
  endspeaker
end

