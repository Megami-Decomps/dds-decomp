      font "よな?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "…先生、何処にいるんだろ"
      font "?"
      newline
      control f1 04
    endpage
  endmessage
  message ISAMU_006 speaker=1
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "さっき怪しい地下室見かけ"
      font "たけど…"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "まさかあんな不気味な所に"
      newline
      font "いるはずないよな?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "…あぁ!思い出しただけで"
      font "も寒気がする!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "チアキって、まだ下にいる"
      font "よな?"
      newline
      font "…とりあえず、俺戻るよ。"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "こんな不気味な病院、長居"
      font "はしたくないな…"
      newline
      control f1 04
    endpage
  endmessage
  speaker 0
    font "邪教の主"
  endspeaker
  speaker 1
    font "イサム"
  endspeaker
