flw0 2
profile dds1

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=0 float=0

procedure e907_main reserved=0x00000000
procedure e907_first reserved=0x00000000
procedure e907_dead reserved=0x00000000

code
e907_main:
  PROC e907_main
  MESSAGE_REQUEST_AND_POLL(message(MSG_000))
  return
e907_first:
  PROC e907_first
  COMM 0x003e
  COMM 0x01d4
  ACTIVATE_MESSAGE_PANEL()
  MESSAGE_REQUEST_AND_POLL(message(MSG_START_00))
  FINISH_SCRIPT_MESSAGE_WINDOW()
  COMM 0x003f
  return
e907_dead:
  PROC e907_dead
  COMM 0x003e
  push 0
  COMM 0x01ce
  push 100
  push 260
  push 1
  COMM 0x0197
  push -(24)
  push 100
  COMM 0x0198
  return
end

messages msg1
  message MSG_000 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Testing"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_START_00 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Argilla participates "
      newline
      text "in the battle."
      newline
      control f1 04
    endpage
  endmessage
end

strings
  zero 240
end
