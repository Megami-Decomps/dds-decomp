flw0 2
profile dds1

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=0 float=0

procedure e907_main reserved=0x00000000
procedure e907_first reserved=0x00000000
procedure e907_dead reserved=0x00000000

code
e907_main:
  PROC e907_main
  PUSHIS 0
  COMM MESSAGE_REQUEST_AND_POLL
  END
e907_first:
  PROC e907_first
  COMM 0x003e
  COMM 0x01d4
  COMM ACTIVATE_MESSAGE_PANEL
  PUSHIS 1
  COMM MESSAGE_REQUEST_AND_POLL
  COMM FINISH_SCRIPT_MESSAGE_WINDOW
  COMM 0x003f
  END
e907_dead:
  PROC e907_dead
  COMM 0x003e
  PUSHIS 0
  COMM 0x01ce
  PUSHIS 100
  PUSHIS 260
  PUSHIS 1
  COMM 0x0197
  PUSHIS 24
  MINUS
  PUSHIS 100
  COMM 0x0198
  END
end

messages msg1
  message MSG_000 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Testing"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_START_00 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Argilla participates "
      newline
      text "in the battle."
      newline
      control f1 04
    endpage
  endmessage
end

strings
  zero 240
end
