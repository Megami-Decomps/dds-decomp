messages msg1
  message LILITH_001 speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "よくここまでたどりついた"
      font "な。"
      newline
      control f1 04
    endpage
  endmessage
  message ERROR speaker=0
    page
      control f2 08 ff ff
      font "スクリプトのエラーだっち"
      font "ゃ!"
      newline
      control f1 04
    endpage
  endmessage
  message MODE speaker=1
    page
      control f2 08 ff ff
      font "どのテストにしますか?"
      newline
    endpage
  endmessage
  select MODE_SEL
    option
      control f2 08 ff ff
      font "テストイベント1 ブラー"
      font "テスト"
    endoption
    option
      control f2 08 ff ff
      font "テストイベント2 デ"
      glyphs 81b4
      font "ストーションブラー"
    endoption
    option
      control f2 08 ff ff
      font "テストイベント3 マルチ"
      font "ブラー"
    endoption
  endselect
  speaker 0
    font "リリス"
  endspeaker
  speaker 1
    font " "
  endspeaker
end

