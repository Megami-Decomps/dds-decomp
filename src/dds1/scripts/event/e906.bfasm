flw0 2
profile dds1

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=0 float=0

procedure e906_main reserved=0x00000000
procedure e906_dead reserved=0x00000000
jump_label _2 reserved=0x00000000
jump_label _1 reserved=0x00000000

code
e906_main:
  PROC e906_main
  PUSHIS 0
  COMM MESSAGE_REQUEST_AND_POLL
  END
e906_dead:
  PROC e906_dead
  PUSHIS 0
  COMM 0x01cf
  PUSHREG
  EQ
  IF _2
  COMM 0x003e
  PUSHIS 3
  COMM 0x01ce
  PUSHIS 83
  PUSHIS 264
  PUSHIS 1
  COMM 0x0197
  PUSHIS 24
  MINUS
  PUSHIS 83
  COMM 0x0198
  GOTO _1
_2:
  COMM 0x003e
  PUSHIS 2
  COMM 0x01ce
  PUSHIS 82
  PUSHIS 263
  PUSHIS 1
  COMM 0x0197
  PUSHIS 24
  MINUS
  PUSHIS 82
  COMM 0x0198
  GOTO _1
_1:
  END
end

messages msg1
  message MSG_000 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      glyphs 81d7 81ca 81d9 83ff 808e 808e 808e
      newline
      control f1 04
    endpage
  endmessage
end

strings
  zero 240
end
