flw0 2
profile dds1

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=0 float=0

procedure e917_main reserved=0x00000000

code
e917_main:
  PROC e917_main
  PUSHIS 0
  COMM MESSAGE_REQUEST_AND_POLL
  END
end

messages msg1
  message MSG_START_00 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      font "かり"
      newline
      control f1 04
    endpage
  endmessage
  speaker 0
    font "コウリュウ"
  endspeaker
end

strings
  zero 240
end
