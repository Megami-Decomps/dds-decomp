flw0 2
profile dds1

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=0 float=0

procedure e915_main reserved=0x00000000
procedure e915_dead reserved=0x00000000

code
e915_main:
  PROC e915_main
  PUSHMSG MSG_START_00
  COMM MESSAGE_REQUEST_AND_POLL
  END
e915_dead:
  PROC e915_dead
  COMM 0x003e
  PUSHIS 0
  COMM 0x01ce
  PUSHIS 100
  PUSHIS 277
  PUSHIS 1
  COMM 0x0197
  PUSHIS 24
  MINUS
  PUSHIS 100
  COMM 0x0198
  END
end

messages msg1
  message MSG_START_00 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      font "かり"
      newline
      control f1 04
    endpage
  endmessage
  speaker 0
    font "ヴ"
    glyphs 81b2
    font "スキ"
  endspeaker
end

strings
  zero 240
end
