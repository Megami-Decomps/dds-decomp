flw0 2
profile dds1

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=0 float=0

procedure e806_main reserved=0x00000000
jump_label _1 reserved=0x00000000
jump_label _2 reserved=0x00000000

code
e806_main:
  PROC e806_main
  PUSHIS 806
  COMM 0x00c8
  PUSHIS 3
  PUSHIS 806
  COMM 0x00ca
  PUSHIS 1
  PUSHIS 0
  COMM 0x0010
  PUSHIS 4
  PUSHIS 806
  COMM 0x00c9
  PUSHREG
  POPIX 0x0001
  PUSHIS 0
  PUSHIS 1
  PUSHIS 98
  COMM 0x0014
  PUSHIS 60
  MINUS
  PUSHIS 0
  COMM 0x0048
  PUSHIS 0
  PUSHF 0x3f7c6a7f
  PUSHF 0x3ca3d70a
  COMM 0x0129
  PUSHIS 60
  PUSHIS 128
  PUSHIS 128
  PUSHIS 170
  COMM 0x012a
  PUSHIS 0
  PUSHIS 0
  COMM 0x012b
  PUSHIS 0
  COMM 0x0041
  PUSHTYPE5 cam01
  COMM 0x0094
  PUSHREG
  COMM 0x0012
  PUSHTYPE5 cam01_MOTION
  COMM 0x0094
  PUSHREG
  PUSHTYPE5 cam01_2
  COMM 0x0094
  PUSHREG
  COMM 0x0013
  PUSHIS 15
  PUSHIS 0
  COMM SCREEN_FADE_A
  PUSHIS 15
  COMM WAIT_FOR_TIMER_LIMIT
_1:
  PUSHIS 1
  PUSHIS 0
  COMM 0x011a
  PUSHREG
  IF _2
  PUSHIS 1
  COMM WAIT_FOR_TIMER_LIMIT
  GOTO _1
_2:
  PUSHIS 15
  PUSHIS 0
  COMM 0x0010
  PUSHIS 15
  COMM WAIT_FOR_TIMER_LIMIT
  PUSHIX 0x0001
  COMM 0x0016
  COMM 0x004e
  PUSHIS 0
  COMM 0x0042
  COMM 0x002e
  END
end

messages msg1
  message ISAMU_001 speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "……っ!!"
      newline
      control f1 04
    endpage
  endmessage
  message ISAMU_002 speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "脅かすなよ、(主人公)。"
      newline
      font "何か出たのかと思ったよ"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "………それにしてもおかし"
      font "いだろ?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "この病院、誰もいないんだ"
      font "ぜ。"
      newline
      control f1 04
    endpage
  endmessage
  message ISAMU_003 speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "お前、誰かに会ったか?"
      newline
      control f1 04
    endpage
  endmessage
  select KAIWA_SEL
    option
      control f2 08 ff ff
      font "会った"
    endoption
    option
      control f2 08 ff ff
      font "会ってない"
    endoption
  endselect
  message ISAMU_004 speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "………………"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "チアキとか言うなのは無し"
      font "だぞ?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "……あ～ぁ。"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "先生に会えると思って来た"
      font "のにな。"
      newline
      font "ここに入院してるって話だ"
      font "よな?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "…先生、何処にいるんだろ"
      font "?"
      newline
      control f1 04
    endpage
  endmessage
  message ISAMU_005 speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "……あ～ぁ。"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "先生に会えると思って来た"
      font "のにな。"
      newline
      font "ここに入院してるって話だ"
      font "よな?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "…先生、何処にいるんだろ"
      font "?"
      newline
      control f1 04
    endpage
  endmessage
  message ISAMU_006 speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "さっき怪しい地下室見かけ"
      font "たけど…"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "まさかあんな不気味な所に"
      newline
      font "いるはずないよな?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "…あぁ!思い出しただけで"
      font "も寒気がする!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "チアキって、まだ下にいる"
      font "よな?"
      newline
      font "…とりあえず、俺戻るよ。"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "こんな不気味な病院、長居"
      font "はしたくないな…"
      newline
      control f1 04
    endpage
  endmessage
  speaker 0
    font "イサム"
  endspeaker
end

strings
  string cam01 "cam01"
  string cam01_2 "cam01"
  string cam01_MOTION "cam01_MOTION"
  zero 103
end
