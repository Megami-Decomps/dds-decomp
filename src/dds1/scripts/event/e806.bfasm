flw0 2
profile dds1

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=0 float=0

procedure e806_main reserved=0x00000000
jump_label _1 reserved=0x00000000
jump_label _2 reserved=0x00000000

code
e806_main:
  PROC e806_main
  WAIT_FOR_CAMP_TASK(806)
  push 3
  push 806
  COMM 0x00ca
  SCREEN_FADE_B(0, 1)
  global_int[1] = BIND_MODEL_MOTION_SOUND(806, 4)
  push 0
  push 1
  push 98
  COMM 0x0014
  push -(60)
  push 0
  COMM 0x0048
  push 0
  push float32(0.9860000014305115, bits=0x3f7c6a7f)
  push float32(0.019999999552965164, bits=0x3ca3d70a)
  COMM 0x0129
  push 60
  push 128
  push 128
  push 170
  COMM 0x012a
  push 0
  push 0
  COMM 0x012b
  push 0
  COMM 0x0041
  ADD_EFFECT_UNIT_TO_WORLD(READ_SECONDARY_WORLD_ID_VALUE(string(cam01)))
  push READ_SECONDARY_WORLD_ID_VALUE(string(cam01_MOTION))
  push READ_SECONDARY_WORLD_ID_VALUE(string(cam01_2))
  COMM 0x0013
  SCREEN_FADE_A(0, 15)
  WAIT_FOR_TIMER_LIMIT(15)
_1:
  push 1
  push 0
  COMM 0x011a
  PUSHREG
  IF _2
  WAIT_FOR_TIMER_LIMIT(1)
  goto _1
_2:
  SCREEN_FADE_B(0, 15)
  WAIT_FOR_TIMER_LIMIT(15)
  push global_int[1]
  COMM 0x0016
  COMM 0x004e
  push 0
  COMM 0x0042
  COMM 0x002e
  return
end

messages msg1
  message ISAMU_001 speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "……っ!!"
      newline
      control f1 04
    endpage
  endmessage
  message ISAMU_002 speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "脅かすなよ、(主人公)。"
      newline
      font "何か出たのかと思ったよ"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "………それにしてもおかし"
      font "いだろ?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "この病院、誰もいないんだ"
      font "ぜ。"
      newline
      control f1 04
    endpage
  endmessage
  message ISAMU_003 speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "お前、誰かに会ったか?"
      newline
      control f1 04
    endpage
  endmessage
  select KAIWA_SEL
    option
      control f2 08 ff ff
      font "会った"
    endoption
    option
      control f2 08 ff ff
      font "会ってない"
    endoption
  endselect
  message ISAMU_004 speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "………………"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "チアキとか言うなのは無し"
      font "だぞ?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "……あ～ぁ。"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "先生に会えると思って来た"
      font "のにな。"
      newline
      font "ここに入院してるって話だ"
      font "よな?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "…先生、何処にいるんだろ"
      font "?"
      newline
      control f1 04
    endpage
  endmessage
  message ISAMU_005 speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "……あ～ぁ。"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "先生に会えると思って来た"
      font "のにな。"
      newline
      font "ここに入院してるって話だ"
      font "よな?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "…先生、何処にいるんだろ"
      font "?"
      newline
      control f1 04
    endpage
  endmessage
  message ISAMU_006 speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "さっき怪しい地下室見かけ"
      font "たけど…"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "まさかあんな不気味な所に"
      newline
      font "いるはずないよな?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "…あぁ!思い出しただけで"
      font "も寒気がする!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "チアキって、まだ下にいる"
      font "よな?"
      newline
      font "…とりあえず、俺戻るよ。"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "こんな不気味な病院、長居"
      font "はしたくないな…"
      newline
      control f1 04
    endpage
  endmessage
  speaker 0
    font "イサム"
  endspeaker
end

strings
  string cam01 "cam01"
  string cam01_2 "cam01"
  string cam01_MOTION "cam01_MOTION"
  zero 103
end
