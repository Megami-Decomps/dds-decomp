section 3 type=3 stride=0x1 count=812 offset=0x46c
  msg1
  message TAKE_01 speaker=0
    page
      control f2 08 ff ff
      font "おおっ!"
      newline
      font "そ、それはーっ!"
      newline
      control f1 04
    endpage
  endmessage
  message TAKE_02 speaker=0
    page
      control f2 08 ff ff
      font "いやーっ、ついに見つかっ"
      font "たのですな!"
      newline
      font "お見事、お見事!"
      newline
      font "貴"
      glyphs 87f3
      font "に"
      glyphs 85d9
      font "せて"
      glyphs 87f8
      font "解でしたなあ!"
      newline
      control f1 04
    endpage
  endmessage
  message TAKE_03 speaker=0
    page
      control f2 08 ff ff
      font "さあっ!"
      newline
      font "あちらへ神"
      glyphs 85c3
      font "をかざしてくだされっ!"
      newline
      control f1 04
    endpage
  endmessage
  message AMA_01 speaker=1
    page
      control f2 08 ff ff
      font "ああ…"
      newline
      font "力が満ちてゆく…"
      newline
      font "これが、これが私の真の"
      glyphs 85d1
      font "なのだ!"
      newline
      control f1 04
    endpage
  endmessage
  message AMA_02 speaker=1
    page
      control f2 08 ff ff
      font "エーイチ"
      glyphs 87f3
      font "。"
      newline
      font "そなたのお"
      glyphs 88ac
      font "で私は目覚め、"
      newline
      font "日本の大地は再び"
      glyphs 88ad 88ae
      font "いた!"
      newline
      control f1 04
    endpage
  endmessage
  message AMA_03 speaker=1
    page
      control f2 08 ff ff
      font "こたびにおけるそなたの大"
      font "功、"
      newline
      font "我が"
      glyphs 88b3
      font "に深う"
      glyphs 88b4
      font "じようぞ…"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "そして"
      glyphs 859d 88b0 8685
      font "の神々は"
      newline
      font "そなたの名を"
      glyphs 8485
      font "代に"
      glyphs 8592
      font "り"
      glyphs 88b1
      font "ぐであろう…"
      newline
      control f1 04
    endpage
  endmessage
  speaker 0
    font "タ"
    glyphs 81c2
    font "ミカ"
    glyphs 81d6
    font "チ"
