flw0 2
profile dds1

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=0 float=0

procedure e905_main reserved=0x00000000
procedure e905_first reserved=0x00000000

code
e905_main:
  PROC e905_main
  MESSAGE_REQUEST_AND_POLL(message(MSG_START_00))
  return
e905_first:
  PROC e905_first
  COMM 0x003e
  WAIT_FOR_TIMER_LIMIT(25)
  AI_MOVE_CAMERA(float32(27.84000015258789, bits=0x41deb852), -float32(122.87999725341797, bits=0x42f5c28f), float32(65.52999877929688, bits=0x42830f5c), -float32(0.05000000074505806, bits=0x3d4ccccd), float32(0.18000000715255737, bits=0x3e3851ec), -float32(0.019999999552965164, bits=0x3ca3d70a), float32(0.9700000286102295, bits=0x3f7851ec))
  ACTIVATE_MESSAGE_PANEL()
  MESSAGE_REQUEST_AND_POLL(message(MSG_START_00))
  FINISH_SCRIPT_MESSAGE_WINDOW()
  push 3
  COMM 0x01ce
  push 99
  push 262
  push 1
  COMM 0x0197
  push 30
  push 262
  push 262
  push 1
  COMM 0x01a1
  WAIT_FOR_TIMER_LIMIT(5)
  push 16
  push 262
  push 1
  COMM 0x01b2
  push 0
  push 99
  COMM 0x0198
  COMM 0x01a4
  AI_MOVE_CAMERA(float32(98.61000061035156, bits=0x42c53852), -float32(46.36000061035156, bits=0x423970a4), -float32(90.9800033569336, bits=0x42b5f5c3), -float32(0.12999999523162842, bits=0x3e051eb8), float32(0.2199999988079071, bits=0x3e6147ae), -float32(0.03999999910593033, bits=0x3d23d70a), float32(0.9599999785423279, bits=0x3f75c28f))
  ACTIVATE_MESSAGE_PANEL()
  MESSAGE_REQUEST_AND_POLL(message(MSG_START_01))
  push 1
  COMM 0x01ce
  push 97
  push 262
  push 1
  COMM 0x0197
  MESSAGE_REQUEST_AND_POLL(message(MSG_START_02))
  push 0
  push 97
  COMM 0x0198
  FINISH_SCRIPT_MESSAGE_WINDOW()
  push 2
  COMM 0x01ce
  push 98
  push 1
  push 0
  COMM 0x0197
  push 30
  push 17
  push 1
  push 0
  COMM 0x01a1
  WAIT_FOR_TIMER_LIMIT(5)
  push 16
  push 1
  push 0
  COMM 0x01b2
  push 0
  push 98
  COMM 0x0198
  COMM 0x01a4
  COMM 0x003f
  return
end

messages msg1
  message MSG_START_00 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Dammit..."
      newline
      control f1 04
    endpage
  endmessage
  message MSG_START_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Don't wuss out now."
      newline
      text "This is serious!"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_START_02 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "C'mon! Fight me!!"
      newline
      control f1 04
    endpage
  endmessage
  speaker 0
    text "Heat"
  endspeaker
end

strings
  zero 240
end
