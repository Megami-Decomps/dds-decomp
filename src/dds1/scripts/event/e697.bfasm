messages msg1
  message MSG_001 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      font "……来ていたのか。"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "……意外な役者が現れたも"
      font "のだ。"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_002 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f1 12
      font "久しいな……少年。"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      control f1 12
      font "いや…………「人修羅」と"
      font "呼ぶべきか。"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      control f1 12
      font "よもや、君がそうだったと"
      font "はな……"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      control f1 12
      font "どうやら我々は、初めから"
      newline
      font "出会うべくして再会したら"
      font "しい。"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_003 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      font "我が創世の為のマガツヒは"
      font "、マントラを"
      newline
      font "減ぼした時に、ほぼ満ち足"
      font "りた。"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      control f1 12
      font "だから、君がオベリスクへ"
      font "向かうのを"
      newline
      font "敢えて止めはしなかった。"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      control f1 12
      font "人修羅として君が本物かど"
      font "うか……"
      newline
      font "見極める必要もあったから"
      font "な。"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      control f1 12
      font "しかし君は、刺客を退けた"
      font "だけでなく、"
      newline
      font "独力で巫女までも解き放っ"
      font "た。"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      control f1 12
      font "ミロク経典にも記されたそ"
      font "の力……"
      newline
      font "私の想像以上だ。"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      control f1 12
      font "君ならば、務まるかも知れ"
      font "ない。"
      newline
      font "ともに「シジマ」を啓く大"
      font "役がな……"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_004 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f1 12
      font "……ヒトの欲望とは灯火の"
      font "ようなものだ。"
      newline
      font "小さなうちは暖かで心地よ"
      font "い。"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_005 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f1 12
      font "だが、燃え続ける火はやが"
      font "て炎となる。"
      newline
      font "全てを焼き尽くすまで止ま"
      font "らぬ怪物にな……"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_005B speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f1 12
      font "ヒトはそんなものを愛しす"
      font "ぎた。"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      control f1 12
      font "その安易な温もりに依存し"
      font "、全てを灰に帰す"
      newline
      font "破壊者の本性には、目を背"
      font "けてきたのだ。"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_006 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f1 12
      font "ヒトは世界のために"
      newline
      font "尽くす存在であるべきなの"
      font "だ。"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      control f1 12
      font "それが、ひいてはヒト自身"
      font "の"
      newline
      font "安息をも約束する。"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_007 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f1 12
      font "何を求めるべきであり、"
      newline
      font "何を求めてはいけないのか"
      font "。"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      control f1 12
      font "その線を定めるのはヒトで"
      font "はない。"
      newline
      font "……世界だ。"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      control f1 12
      font "ヒトはただ、世界を照らす"
      newline
      font "信号台であればいい。"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_008 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f1 12
      font "穏やかに回り、明減し、"
      newline
      font "世界の意思の一部となる…"
      font "…"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      control f1 12
      font "それが最善にして最高の生"
      font "業なのだ。"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_009 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f1 12
      font "そうは、思わないかね?"
      newline
      font "世界はただ、静寂であれば"
      font "よいのだと……"
      newline
      control f1 04
    endpage
  endmessage
  select TUIKA_TOI01
    option
      control f2 08 ff ff
      font "はい"
    endoption
    option
      control f2 08 ff ff
      font "いいえ"
    endoption
  endselect
  message MSG_009_A speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f1 12
      font "そうか。"
      newline
      font "シジマの素晴らしさが分か"
      font "るか。"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      control f1 12
      font "……やはり、他の有象無象"
      font "どもとは"
      newline
      font "格が違うようだな。"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      control f1 12
      font "いずれ、君にも協力しても"
      font "らおう。"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_009_B speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f1 12
      font "……所詮は君も、ただの悪"
      font "魔か。"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      control f1 12
      font "我が理想……"
      newline
      font "理解出来るはずもなかった"
      font "ようだな。"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_009_C speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f1 12
      font "……さて、そろそろ私は行"
      font "かねばならん。"
      newline
      control f1 12
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "全てが終わるまで安心はで"
      font "きない。"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "君は気付いているかね、"
      newline
      font "この地に立ち込める妖しい"
      font "気配……"
      newline
      control f1 12
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "減んだゴズテンノウの残り"
      font "火に与ろうと"
      newline
      font "する者が、不気味に胎動を"
      font "始めている。"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_010 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      font "他の愚かなコトワリを啓こ"
      font "うとする者に"
      newline
      font "決して遅れを取る訳にはい"
      font "かない……"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "世界を創るのは……この私"
      font "なのだ!"
      newline
      control f1 04
    endpage
  endmessage
  speaker 0
    font "氷川"
  endspeaker
end

