messages msg1
  message SIE_TEST001 speaker=none
    page
      control f2 08 ff ff
      control f2 07 81 ff
      font "リーダーの判断は"
      newline
    endpage
  endmessage
  select TEST_SEL ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      font "協力はするが騙し討ちはし"
      font "ない"
    endoption
    option
      control f2 08 ff ff
      font "いい作戦だ"
    endoption
  endselect
  message HET_TEST001 speaker=none
    page
      control f2 08 ff ff
      control f2 07 81 ff
      font "甘ぇな"
      newline
      font "殺らなきゃ殺られるぜ"
      newline
    endpage
  endmessage
  message GIL_TEST001 speaker=none
    page
      control f2 08 ff ff
      control f2 07 81 ff
      font "テストは終了だ"
      newline
      font "お前は分岐"
      text "001"
      font "に成功した"
      newline
    endpage
  endmessage
  message BAKUHA_TEST001 speaker=none
