flw0 2
profile dds1

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=0 float=0

procedure e502_001 reserved=0x00000000
procedure e502_001_msg reserved=0x00000000
procedure e502_002 reserved=0x00000000
procedure e502_002_msg reserved=0x00000000
procedure e502_003 reserved=0x00000000
procedure e502_003_msg reserved=0x00000000
jump_label _1 reserved=0x00000000
jump_label _2 reserved=0x00000000
jump_label _4 reserved=0x00000000
jump_label _3 reserved=0x00000000
jump_label _6 reserved=0x00000000
jump_label _7 reserved=0x00000000
jump_label _8 reserved=0x00000000
jump_label _9 reserved=0x00000000

code
e502_001:
  PROC e502_001
  PUSHIS 1
  MINUS
  PUSHIS 1
  COMM 0x00a5
  PUSHIS 21
  COMM 0x0050
_1:
  COMM 0x0052
  PUSHREG
  IF _2
  COMM 0x000d
  GOTO _1
_2:
  PUSHIS 1
  COMM 0x01e3
  PUSHREG
  POPIX 0x0001
  COMM 0x0051
  PUSHIS 0
  PUSHIX 0x0001
  EQ
  IF _4
  PUSHIS 1
  MINUS
  PUSHIS 2
  COMM 0x00a5
  PUSHREG
  COMM WAIT_FOR_TASK_REMOVAL
  GOTO _3
_4:
  PUSHIS 1
  PUSHIX 0x0001
  EQ
  IF _3
  PUSHIS 1
  MINUS
  PUSHIS 4
  COMM 0x00a5
  PUSHREG
  COMM WAIT_FOR_TASK_REMOVAL
  GOTO _3
_3:
  COMM 0x002e
  END
e502_001_msg:
  PROC e502_001_msg
  PUSHIS 3
  COMM 0x013b
  PUSHIS 30
  COMM WAIT_FOR_TIMER_LIMIT
  COMM ACTIVATE_MESSAGE_PANEL
  PUSHIS 0
  COMM MESSAGE_REQUEST_AND_POLL
  PUSHIS 60
  COMM WAIT_FOR_TIMER_LIMIT
  COMM FINISH_SCRIPT_MESSAGE_WINDOW
  PUSHIS 60
  COMM WAIT_FOR_TIMER_LIMIT
  END
e502_002:
  PROC e502_002
  PUSHIS 1
  MINUS
  PUSHIS 3
  COMM 0x00a5
  PUSHIS 22
  COMM 0x0050
_6:
  COMM 0x0052
  PUSHREG
  IF _7
  COMM 0x000d
  GOTO _6
_7:
  COMM 0x0051
  COMM 0x002e
  END
e502_002_msg:
  PROC e502_002_msg
  PUSHIS 3
  COMM 0x013b
  COMM ACTIVATE_MESSAGE_PANEL
  PUSHIS 2
  COMM MESSAGE_REQUEST_AND_POLL
  PUSHIS 90
  COMM WAIT_FOR_TIMER_LIMIT
  COMM FINISH_SCRIPT_MESSAGE_WINDOW
  PUSHIS 30
  COMM WAIT_FOR_TIMER_LIMIT
  COMM ACTIVATE_MESSAGE_PANEL
  PUSHIS 3
  COMM MESSAGE_REQUEST_AND_POLL
  PUSHIS 120
  COMM WAIT_FOR_TIMER_LIMIT
  COMM FINISH_SCRIPT_MESSAGE_WINDOW
  END
e502_003:
  PROC e502_003
  PUSHIS 1
  MINUS
  PUSHIS 5
  COMM 0x00a5
  PUSHIS 23
  COMM 0x0050
_8:
  COMM 0x0052
  PUSHREG
  IF _9
  COMM 0x000d
  GOTO _8
_9:
  COMM 0x0051
  COMM 0x002e
  END
e502_003_msg:
  PROC e502_003_msg
  PUSHIS 3
  COMM 0x013b
  COMM ACTIVATE_MESSAGE_PANEL
  PUSHIS 4
  COMM MESSAGE_REQUEST_AND_POLL
  PUSHIS 45
  COMM WAIT_FOR_TIMER_LIMIT
  COMM FINISH_SCRIPT_MESSAGE_WINDOW
  COMM ACTIVATE_MESSAGE_PANEL
  PUSHIS 5
  COMM MESSAGE_REQUEST_AND_POLL
  PUSHIS 45
  COMM WAIT_FOR_TIMER_LIMIT
  COMM FINISH_SCRIPT_MESSAGE_WINDOW
  END
end

messages msg1
  message SIE_TEST001 speaker=none
    page
      control f2 08 ff ff
      control f2 07 81 ff
      font "リーダーの判断は"
      newline
    endpage
  endmessage
  select TEST_SEL ext=0 pattern=0 reserved=0 trailing=00
    option
      control f2 08 ff ff
      font "協力はするが騙し討ちはし"
      font "ない"
    endoption
    option
      control f2 08 ff ff
      font "いい作戦だ"
    endoption
  endselect
  message HET_TEST001 speaker=none
    page
      control f2 08 ff ff
      control f2 07 81 ff
      font "甘ぇな"
      newline
      font "殺らなきゃ殺られるぜ"
      newline
    endpage
  endmessage
  message GIL_TEST001 speaker=none
    page
      control f2 08 ff ff
      control f2 07 81 ff
      font "テストは終了だ"
      newline
      font "お前は分岐"
      text "001"
      font "に成功した"
      newline
    endpage
  endmessage
  message BAKUHA_TEST001 speaker=none
    page
      control f2 08 ff ff
      control f2 07 81 ff
      font "あぼーーーーーーん!!"
      newline
    endpage
  endmessage
  message BAKUHA_TEST002 speaker=none
    page
      control f2 08 ff ff
      control f2 07 81 ff
      font "分岐"
      text "002"
      font "に成功しました"
      newline
      font "テスト終了"
      newline
    endpage
  endmessage
end

strings
  zero 240
end
