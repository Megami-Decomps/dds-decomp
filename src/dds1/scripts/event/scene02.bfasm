section 3 type=3 stride=0x1 count=2194 offset=0x740
  msg1
  message TAKE_02_01 speaker=0
    page
      control f2 08 ff ff
      font "おうおうおうおう!"
      newline
      font "ゲセンの者が物欲しそうに"
      font "見上げよるわ!"
      newline
      control f1 04
    endpage
  endmessage
  message TAKE_02_02 speaker=0
    page
      control f2 08 ff ff
      font "んんっ?"
      newline
      font "ひょっとして貴様ら、小生"
      font "意気にも"
      newline
      font "アマテラスさまにお目通り"
      font "願いたいとか!"
      newline
      control f1 04
    endpage
  endmessage
  message TAKE_02_03 speaker=0
    page
      control f2 08 ff ff
      font "んー!"
      newline
      font "アマテラスさまにお会いし"
      font "たいのは解るが"
      newline
      font "あいにく…"
      newline
      control f1 04
    endpage
  endmessage
  message TAKE_02_04 speaker=0
    page
      control f2 08 ff ff
      font "あいにく、"
      newline
      font "あの中にお"
      glyphs 85cf
      font "れ中なのだ!"
      newline
      control f1 04
    endpage
  endmessage
  message TAKE_02_05 speaker=0
    page
      control f2 08 ff ff
      font "こうなったのもアナト!"
      newline
      font "あの女のせいなのだ!"
      newline
      glyphs 85d0
      font "の呪いで"
      glyphs 85d1
      font "を"
      glyphs 85d2
      font "され、心を"
      glyphs 85d3
      font "められた!"
      newline
      control f1 04
    endpage
  endmessage
  message TAKE_02_06 speaker=0
    page
      control f2 08 ff ff
      font "おお、そうだ!"
      newline
      font "ヒマそうな貴様らに"
      newline
      glyphs 85d4
      font "り入ってお"
      glyphs 85b0
      font "み"
      glyphs 83f9
      font "す!"
      newline
      control f1 04
    endpage
  endmessage
  message TAKE_02_07 speaker=0
    page
      control f2 08 ff ff
      font "アマテラスさまのお"
      glyphs 85d1
      font "を"
      newline
      font "元に戻すという"
      glyphs 82a8 85d5
      font "説の神"
      glyphs 85c3 82a9
      font "が"
      newline
      font "この動物園のどこかにある"
      font "らしい!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "それを"
      glyphs 85d7
      font "し出し"
      newline
      font "ここへ"
      glyphs 85d8
      font "けてもらいたい!"
      newline
      control f1 04
    endpage
  endmessage
  select TAKE_02_SEL_01
    option
      control f2 08 ff ff
      font "もちろんだ、"
      glyphs 85d9
      font "せてくれ"
    endoption
    option
      control f2 08 ff ff
      font "俺はアマテラスを殺しに来"
      font "た"
    endoption
  endselect
  message TAKE_02_Y_01 speaker=0
    page
      control f2 08 ff ff
      font "おお、そう来ると思ってま"
      font "したぞ!"
      newline
      font "いやいや、"
      glyphs 85ab
      font "くまでもなかったですなあ"
      font "!"
      newline
      control f1 04
    endpage
  endmessage
  message TAKE_02_Y_02 speaker=0
    page
      control f2 08 ff ff
      font "ところで"
      glyphs 82a8 85d5
      font "説の神"
      glyphs 85c3 82a9
      font "だが…"
      newline
      font "いったいどこにあるんでし"
      font "ょうなあ!"
      newline
      font "私にも皆目見"
      glyphs 8591
      font "が付かん!"
      newline
      control f1 04
    endpage
  endmessage
  message TAKE_02_Y_03 speaker=0
    page
      control f2 08 ff ff
      font "おおっ、そうだ!"
      newline
      font "こもれびの小"
      glyphs 85dc
      font "には"
      glyphs 82a8
      font "物知りな悪魔"
      glyphs 82a9
      font "が"
      newline
      font "多いと"
      glyphs 85ab
      font "く!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      glyphs 85df
      font "らなら"
      newline
      font "何か知っているかもしれま"
      font "せんぞ!"
      newline
      control f1 04
    endpage
  endmessage
  message TAKE_02_Y_04 speaker=0
    page
      control f2 08 ff ff
      font "こもれびの小"
      glyphs 85dc
      font "はこの"
      glyphs 8ac7
      font "手になります!"
      newline
      font "さっそく行ってみてはいか"
      font "がでしょう!"
      newline
      control f1 04
    endpage
  endmessage
  message TAKE_02_N_01 speaker=0
    page
      control f2 08 ff ff
      font "なっ、なんと!"
      newline
      font "貴様、アナトの刺客であっ"
      font "たか!"
      newline
      control f1 04
    endpage
  endmessage
  message TAKE_02_N_02 speaker=0
    page
      control f2 08 ff ff
      font "アマテラスさま! お逃げ"
      font "くだされーっ!"
      newline
      font "ここは私におまかせを～～"
      font "～～～～～っ!"
      newline
      control f1 04
    endpage
  endmessage
  message TAKE_02_N_03 speaker=0
    page
      control f2 08 ff ff
      font "追わせるものか!"
      newline
      font "貴様の"
      glyphs 85e4
      font "手は、この私だ!"
      newline
      control f1 04
    endpage
  endmessage
  message TAKE_LOSE speaker=0
    page
      control f2 08 ff ff
      control f2 09 02 ff
      font "ア…マテラス様は"
      newline
      glyphs 84df
      font "…所にお戻りだ…"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      glyphs 84df
      font "所で…とうに結界など"
      newline
      glyphs 86e9
      font "っておられよう…"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "貴…様ごとき"
      glyphs 85f3 8aa5
      font "にゃ…"
      newline
      font "あれは破…れんよ…"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "グ…"
      glyphs 81d4
      newline
      control f1 04
    endpage
  endmessage
  speaker 0
    font "タ"
    glyphs 81c2
    font "ミカ"
    glyphs 81d6
    font "チ"
  endspeaker
end
