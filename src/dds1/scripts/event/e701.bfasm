flw0 2
profile dds1

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=0 float=0

procedure e701_main reserved=0x00000000
jump_label _2 reserved=0x00000000
jump_label _1 reserved=0x00000000

code
e701_main:
  PROC e701_main
  WAIT_FOR_TIMER_START()
  push 0
  push 74
  COMM TEST_MODEL_FLAG
  PUSHREG
  EQ
  IF _2
  CALL_EVENT(event(e657))
  goto _1
_2:
  push 0
  push 75
  COMM TEST_MODEL_FLAG
  PUSHREG
  EQ
  push 1
  push 74
  COMM TEST_MODEL_FLAG
  PUSHREG
  EQ
  AND
  IF _1
  CALL_EVENT(event(e659))
  goto _1
_1:
  COMM 0x002e
  return
end

messages
end

strings
  zero 240
end
