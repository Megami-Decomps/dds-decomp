flw0 2
profile dds1

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=0 float=0

procedure e701_main reserved=0x00000000
jump_label _2 reserved=0x00000000
jump_label _1 reserved=0x00000000

code
e701_main:
  PROC e701_main
  COMM WAIT_FOR_TIMER_START
  PUSHIS 0
  PUSHIS 74
  COMM TEST_MODEL_FLAG
  PUSHREG
  EQ
  IF _2
  PUSHEVENT e657
  COMM CALL_EVENT
  GOTO _1
_2:
  PUSHIS 0
  PUSHIS 75
  COMM TEST_MODEL_FLAG
  PUSHREG
  EQ
  PUSHIS 1
  PUSHIS 74
  COMM TEST_MODEL_FLAG
  PUSHREG
  EQ
  AND
  IF _1
  PUSHEVENT e659
  COMM CALL_EVENT
  GOTO _1
_1:
  COMM 0x002e
  END
end

messages
end

strings
  zero 240
end
