flw0 2
profile dds1

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=0 float=0

procedure e710_main reserved=0x00000000

code
e710_main:
  PROC e710_main
  push 710
  COMM 0x00c8
  push 16
  push 710
  COMM 0x00ca
  SCREEN_FADE_B(0, 1)
  WAIT_FOR_TIMER_LIMIT(1000)
  return
end

messages msg1
  message MSG_001 speaker=none
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "  死の安らぎは 等しく"
      font "訪れよう"
      newline
    endpage
  endmessage
  message MSG_002 speaker=none
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "  死の安らぎは 等しく"
      font "訪れよう"
      newline
      font "  人に非ずとも 悪魔に"
      font "非ずとも"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_003 speaker=none
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "  大いなる意思の導きに"
      font "て"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_002B speaker=none
    page
      control f2 08 ff ff
      control f2 07 05 ff
      font "  死の安らぎは 等しく"
      font "訪れよう"
      newline
      font "  人に非ずとも 悪魔に"
      font "非ずとも"
      newline
    endpage
  endmessage
  message MSG_003B speaker=none
    page
      control f2 08 ff ff
      control f2 07 05 ff
      font "  大いなる意思の導きに"
      font "て"
      newline
    endpage
  endmessage
end

strings
  zero 240
end
