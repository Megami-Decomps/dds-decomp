flw0 2
profile dds1

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=0 float=0

procedure e501_001 reserved=0x00000000
procedure e501_001_msg reserved=0x00000000
jump_label _1 reserved=0x00000000
jump_label _2 reserved=0x00000000

code
e501_001:
  PROC e501_001
  result = CREATE_SCRIPT_TASK(procedure(e501_001_msg), -(1))
  push 20
  COMM 0x0050
_1:
  COMM 0x0052
  PUSHREG
  IF _2
  WAIT_FOR_TIMER_START()
  goto _1
_2:
  COMM 0x0051
  COMM 0x002e
  return
e501_001_msg:
  PROC e501_001_msg
  push 3
  COMM 0x013b
  WAIT_FOR_TIMER_LIMIT(720)
  ACTIVATE_MESSAGE_PANEL()
  MESSAGE_REQUEST_AND_POLL(message(NSIE0040))
  WAIT_FOR_TIMER_LIMIT(60)
  FINISH_SCRIPT_MESSAGE_WINDOW()
  WAIT_FOR_TIMER_LIMIT(1)
  ACTIVATE_MESSAGE_PANEL()
  MESSAGE_REQUEST_AND_POLL(message(NHET0140))
  WAIT_FOR_TIMER_LIMIT(120)
  FINISH_SCRIPT_MESSAGE_WINDOW()
  WAIT_FOR_TIMER_LIMIT(1550)
  ACTIVATE_MESSAGE_PANEL()
  MESSAGE_REQUEST_AND_POLL(message(NHET0150))
  WAIT_FOR_TIMER_LIMIT(120)
  FINISH_SCRIPT_MESSAGE_WINDOW()
  WAIT_FOR_TIMER_LIMIT(30)
  ACTIVATE_MESSAGE_PANEL()
  MESSAGE_REQUEST_AND_POLL(message(NSER0010))
  WAIT_FOR_TIMER_LIMIT(60)
  FINISH_SCRIPT_MESSAGE_WINDOW()
  WAIT_FOR_TIMER_LIMIT(10)
  ACTIVATE_MESSAGE_PANEL()
  MESSAGE_REQUEST_AND_POLL(message(NSIE0050))
  WAIT_FOR_TIMER_LIMIT(60)
  FINISH_SCRIPT_MESSAGE_WINDOW()
  WAIT_FOR_TIMER_LIMIT(30)
  ACTIVATE_MESSAGE_PANEL()
  MESSAGE_REQUEST_AND_POLL(message(NSER0020))
  WAIT_FOR_TIMER_LIMIT(60)
  FINISH_SCRIPT_MESSAGE_WINDOW()
  WAIT_FOR_TIMER_LIMIT(20)
  ACTIVATE_MESSAGE_PANEL()
  MESSAGE_REQUEST_AND_POLL(message(NGIL0050))
  WAIT_FOR_TIMER_LIMIT(60)
  FINISH_SCRIPT_MESSAGE_WINDOW()
  WAIT_FOR_TIMER_LIMIT(5)
  ACTIVATE_MESSAGE_PANEL()
  MESSAGE_REQUEST_AND_POLL(message(NSER0030))
  WAIT_FOR_TIMER_LIMIT(120)
  FINISH_SCRIPT_MESSAGE_WINDOW()
  WAIT_FOR_TIMER_LIMIT(20)
  ACTIVATE_MESSAGE_PANEL()
  MESSAGE_REQUEST_AND_POLL(message(NARU0170))
  WAIT_FOR_TIMER_LIMIT(90)
  FINISH_SCRIPT_MESSAGE_WINDOW()
  WAIT_FOR_TIMER_LIMIT(30)
  ACTIVATE_MESSAGE_PANEL()
  MESSAGE_REQUEST_AND_POLL(message(NSER0041))
  WAIT_FOR_TIMER_LIMIT(90)
  FINISH_SCRIPT_MESSAGE_WINDOW()
  WAIT_FOR_TIMER_LIMIT(30)
  ACTIVATE_MESSAGE_PANEL()
  MESSAGE_REQUEST_AND_POLL(message(NSER0042))
  WAIT_FOR_TIMER_LIMIT(150)
  FINISH_SCRIPT_MESSAGE_WINDOW()
  return
end

messages msg1
  message NSIE0040 speaker=none
    page
      control f2 08 ff ff
      control f2 07 81 ff
      font "ヒート"
      newline
      font "ゲイルが急に"
      newline
    endpage
  endmessage
  message NHET0140 speaker=none
    page
      control f2 08 ff ff
      control f2 07 81 ff
      font "飢えてんのか ゲイル"
      newline
      font "俺を喰いてぇか?"
      newline
    endpage
  endmessage
  message NGIL0040 speaker=0
  endmessage
  message NHET0150 speaker=none
    page
      control f2 08 ff ff
      control f2 07 81 ff
      font "今の言葉は 何だ"
      newline
    endpage
  endmessage
  message NSER0010 speaker=none
    page
      control f2 08 ff ff
      control f2 07 81 ff
      font "歌よ"
      newline
    endpage
  endmessage
  message NSIE0050 speaker=none
    page
      control f2 08 ff ff
      control f2 07 81 ff
      font "今のが 歌"
      newline
    endpage
  endmessage
  message NSER0020 speaker=none
    page
      control f2 08 ff ff
      control f2 07 81 ff
      font "そう 歌"
      newline
    endpage
  endmessage
  message NGIL0050 speaker=none
    page
      control f2 08 ff ff
      control f2 07 81 ff
      font "お前は 何者だ"
      newline
    endpage
  endmessage
  message NSER0030 speaker=none
    page
      control f2 08 ff ff
      control f2 07 81 ff
      font "私はセラ"
      newline
      font "皆を助けに来たの"
      newline
    endpage
  endmessage
  message NARU0170 speaker=none
    page
      control f2 08 ff ff
      control f2 07 81 ff
      font "助けに来たって"
      newline
      font "どこから?"
      newline
    endpage
  endmessage
  message NSER0041 speaker=none
    page
      control f2 08 ff ff
      control f2 07 81 ff
      font "わからない"
      newline
      font "何も覚えてないの"
      newline
    endpage
  endmessage
  message NSER0042 speaker=none
    page
      control f2 08 ff ff
      control f2 07 81 ff
      font "覚えてるのは"
      newline
      font "皆を助けたいってことだけ"
      newline
    endpage
  endmessage
end

strings
  zero 240
end
