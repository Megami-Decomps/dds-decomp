flw0 2
profile dds1

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=0 float=0

procedure e501_001 reserved=0x00000000
procedure e501_001_msg reserved=0x00000000
jump_label _1 reserved=0x00000000
jump_label _2 reserved=0x00000000

code
e501_001:
  PROC e501_001
  PUSHIS 1
  MINUS
  PUSHIS 1
  COMM 0x00a5
  PUSHIS 20
  COMM 0x0050
_1:
  COMM 0x0052
  PUSHREG
  IF _2
  COMM 0x000d
  GOTO _1
_2:
  COMM 0x0051
  COMM 0x002e
  END
e501_001_msg:
  PROC e501_001_msg
  PUSHIS 3
  COMM 0x013b
  PUSHIS 720
  COMM WAIT_FOR_TIMER_LIMIT
  COMM ACTIVATE_MESSAGE_PANEL
  PUSHIS 0
  COMM MESSAGE_REQUEST_AND_POLL
  PUSHIS 60
  COMM WAIT_FOR_TIMER_LIMIT
  COMM FINISH_SCRIPT_MESSAGE_WINDOW
  PUSHIS 1
  COMM WAIT_FOR_TIMER_LIMIT
  COMM ACTIVATE_MESSAGE_PANEL
  PUSHIS 1
  COMM MESSAGE_REQUEST_AND_POLL
  PUSHIS 120
  COMM WAIT_FOR_TIMER_LIMIT
  COMM FINISH_SCRIPT_MESSAGE_WINDOW
  PUSHIS 1550
  COMM WAIT_FOR_TIMER_LIMIT
  COMM ACTIVATE_MESSAGE_PANEL
  PUSHIS 3
  COMM MESSAGE_REQUEST_AND_POLL
  PUSHIS 120
  COMM WAIT_FOR_TIMER_LIMIT
  COMM FINISH_SCRIPT_MESSAGE_WINDOW
  PUSHIS 30
  COMM WAIT_FOR_TIMER_LIMIT
  COMM ACTIVATE_MESSAGE_PANEL
  PUSHIS 4
  COMM MESSAGE_REQUEST_AND_POLL
  PUSHIS 60
  COMM WAIT_FOR_TIMER_LIMIT
  COMM FINISH_SCRIPT_MESSAGE_WINDOW
  PUSHIS 10
  COMM WAIT_FOR_TIMER_LIMIT
  COMM ACTIVATE_MESSAGE_PANEL
  PUSHIS 5
  COMM MESSAGE_REQUEST_AND_POLL
  PUSHIS 60
  COMM WAIT_FOR_TIMER_LIMIT
  COMM FINISH_SCRIPT_MESSAGE_WINDOW
  PUSHIS 30
  COMM WAIT_FOR_TIMER_LIMIT
  COMM ACTIVATE_MESSAGE_PANEL
  PUSHIS 6
  COMM MESSAGE_REQUEST_AND_POLL
  PUSHIS 60
  COMM WAIT_FOR_TIMER_LIMIT
  COMM FINISH_SCRIPT_MESSAGE_WINDOW
  PUSHIS 20
  COMM WAIT_FOR_TIMER_LIMIT
  COMM ACTIVATE_MESSAGE_PANEL
  PUSHIS 7
  COMM MESSAGE_REQUEST_AND_POLL
  PUSHIS 60
  COMM WAIT_FOR_TIMER_LIMIT
  COMM FINISH_SCRIPT_MESSAGE_WINDOW
  PUSHIS 5
  COMM WAIT_FOR_TIMER_LIMIT
  COMM ACTIVATE_MESSAGE_PANEL
  PUSHIS 8
  COMM MESSAGE_REQUEST_AND_POLL
  PUSHIS 120
  COMM WAIT_FOR_TIMER_LIMIT
  COMM FINISH_SCRIPT_MESSAGE_WINDOW
  PUSHIS 20
  COMM WAIT_FOR_TIMER_LIMIT
  COMM ACTIVATE_MESSAGE_PANEL
  PUSHIS 9
  COMM MESSAGE_REQUEST_AND_POLL
  PUSHIS 90
  COMM WAIT_FOR_TIMER_LIMIT
  COMM FINISH_SCRIPT_MESSAGE_WINDOW
  PUSHIS 30
  COMM WAIT_FOR_TIMER_LIMIT
  COMM ACTIVATE_MESSAGE_PANEL
  PUSHIS 10
  COMM MESSAGE_REQUEST_AND_POLL
  PUSHIS 90
  COMM WAIT_FOR_TIMER_LIMIT
  COMM FINISH_SCRIPT_MESSAGE_WINDOW
  PUSHIS 30
  COMM WAIT_FOR_TIMER_LIMIT
  COMM ACTIVATE_MESSAGE_PANEL
  PUSHIS 11
  COMM MESSAGE_REQUEST_AND_POLL
  PUSHIS 150
  COMM WAIT_FOR_TIMER_LIMIT
  COMM FINISH_SCRIPT_MESSAGE_WINDOW
  END
end

messages msg1
  message NSIE0040 speaker=none
    page
      control f2 08 ff ff
      control f2 07 81 ff
      font "ヒート"
      newline
      font "ゲイルが急に"
      newline
    endpage
  endmessage
  message NHET0140 speaker=none
    page
      control f2 08 ff ff
      control f2 07 81 ff
      font "飢えてんのか ゲイル"
      newline
      font "俺を喰いてぇか?"
      newline
    endpage
  endmessage
  message NGIL0040 speaker=0
  endmessage
  message NHET0150 speaker=none
    page
      control f2 08 ff ff
      control f2 07 81 ff
      font "今の言葉は 何だ"
      newline
    endpage
  endmessage
  message NSER0010 speaker=none
    page
      control f2 08 ff ff
      control f2 07 81 ff
      font "歌よ"
      newline
    endpage
  endmessage
  message NSIE0050 speaker=none
    page
      control f2 08 ff ff
      control f2 07 81 ff
      font "今のが 歌"
      newline
    endpage
  endmessage
  message NSER0020 speaker=none
    page
      control f2 08 ff ff
      control f2 07 81 ff
      font "そう 歌"
      newline
    endpage
  endmessage
  message NGIL0050 speaker=none
    page
      control f2 08 ff ff
      control f2 07 81 ff
      font "お前は 何者だ"
      newline
    endpage
  endmessage
  message NSER0030 speaker=none
    page
      control f2 08 ff ff
      control f2 07 81 ff
      font "私はセラ"
      newline
      font "皆を助けに来たの"
      newline
    endpage
  endmessage
  message NARU0170 speaker=none
    page
      control f2 08 ff ff
      control f2 07 81 ff
      font "助けに来たって"
      newline
      font "どこから?"
      newline
    endpage
  endmessage
  message NSER0041 speaker=none
    page
      control f2 08 ff ff
      control f2 07 81 ff
      font "わからない"
      newline
      font "何も覚えてないの"
      newline
    endpage
  endmessage
  message NSER0042 speaker=none
    page
      control f2 08 ff ff
      control f2 07 81 ff
      font "覚えてるのは"
      newline
      font "皆を助けたいってことだけ"
      newline
    endpage
  endmessage
end

strings
  zero 240
end
