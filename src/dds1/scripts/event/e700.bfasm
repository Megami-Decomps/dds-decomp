jump_label _3 reserved=0x00000000
jump_label _1 reserved=0x00000000

code
e700_main:
  PROC e700_main
  WAIT_FOR_TIMER_START()
  push 0
  push 26
  COMM TEST_MODEL_FLAG
  PUSHREG
  EQ
  IF _2
  CALL_EVENT(event(e629))
  goto _1
_2:
  push 0
  push 38
  COMM TEST_MODEL_FLAG
  PUSHREG
  EQ
  push 1
  push 22
  COMM TEST_MODEL_FLAG
  PUSHREG
  EQ
  AND
  IF _3
  CALL_EVENT(event(e636))
  goto _1
_3:
  push 0
  push 79
  COMM TEST_MODEL_FLAG
  PUSHREG
  EQ
  push 1
  push 77
  COMM TEST_MODEL_FLAG
  PUSHREG
  EQ
