flw0 2
profile dds1

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=0 float=0

procedure e799_main reserved=0x00000000
procedure e799_010_1 reserved=0x00000000
procedure e799_010_2 reserved=0x00000000
jump_label _1 reserved=0x00000000
jump_label _2 reserved=0x00000000

code
e799_main:
  PROC e799_main
  SCREEN_FADE_B(1, 0)
  push 799
  COMM 0x008d
  WAIT_FOR_TIMER_LIMIT(60)
  result = CREATE_SCRIPT_TASK(procedure(e799_010_1), -(1))
  result = CREATE_SCRIPT_TASK(procedure(e799_010_2), -(1))
  push 0
  push 799
  COMM 0x008e
  push 7
  COMM 0x0050
  COMM 0x016b
  SCREEN_FADE_A(1, 40)
_1:
  COMM 0x0052
  PUSHREG
  IF _2
  WAIT_FOR_TIMER_START()
  goto _1
_2:
  COMM 0x0051
  WAIT_FOR_TIMER_LIMIT(60)
  push 35
  push 0
  COMM 0x0160
  push 1
  push 0
  COMM 0x0160
  ACTIVATE_MESSAGE_PANEL()
  push 220
  push 90
  COMM 0x0117
  MESSAGE_REQUEST_AND_POLL(message(MSG_003))
  FINISH_SCRIPT_MESSAGE_WINDOW()
  push 0
  COMM 0x0093
  push 0
  push 799
  COMM 0x0090
  push 0
  COMM 0x012d
  push 0
  push 0
  push 0
  push 0
  COMM 0x012e
  push 120
  COMM 0x012f
  WAIT_FOR_TIMER_LIMIT(130)
  RETURN_TO_TITLE()
  return
e799_010_1:
  PROC e799_010_1
  WAIT_FOR_TIMER_LIMIT(479)
  push 0
  COMM 0x012d
  push 128
  push 255
  push 255
  push 255
  COMM 0x012e
  push 1
  COMM 0x0130
  return
e799_010_2:
  PROC e799_010_2
  WAIT_FOR_TIMER_LIMIT(350)
  push 1
  COMM 0x0093
  push 1
  push 0
  COMM 0x0160
  push 220
  push 60
  COMM 0x0117
  ACTIVATE_MESSAGE_PANEL()
  MESSAGE_REQUEST_AND_POLL(message(MSG_002B))
  WAIT_FOR_TIMER_LIMIT(40)
  FINISH_SCRIPT_MESSAGE_WINDOW()
  WAIT_FOR_TIMER_LIMIT(30)
  push 0
  COMM 0x0093
  return
end

messages msg1
  message MSG_001 speaker=none
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "  死の安らぎは 等しく"
      font "訪れよう"
      newline
    endpage
  endmessage
  message MSG_002 speaker=none
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "  死の安らぎは 等しく"
      font "訪れよう"
      newline
      font "  人に非ずとも 悪魔に"
      font "非ずとも"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_003 speaker=none
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "  大いなる意思の導きに"
      font "て"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_002B speaker=none
    page
      control f2 08 ff ff
      control f2 07 05 ff
      font "  死の安らぎは 等しく"
      font "訪れよう"
      newline
      font "  人に非ずとも 悪魔に"
      font "非ずとも"
      newline
    endpage
  endmessage
  message MSG_003B speaker=none
    page
      control f2 08 ff ff
      control f2 07 05 ff
      font "  大いなる意思の導きに"
      font "て"
      newline
    endpage
  endmessage
end

strings
  zero 240
end
