flw0 2
profile dds1

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=0 float=0

procedure e799_main reserved=0x00000000
procedure e799_010_1 reserved=0x00000000
procedure e799_010_2 reserved=0x00000000
jump_label _1 reserved=0x00000000
jump_label _2 reserved=0x00000000

code
e799_main:
  PROC e799_main
  PUSHIS 0
  PUSHIS 1
  COMM SCREEN_FADE_B
  PUSHIS 799
  COMM 0x008d
  PUSHIS 60
  COMM WAIT_FOR_TIMER_LIMIT
  PUSHIS 1
  MINUS
  PUSHPROC e799_010_1
  COMM CREATE_SCRIPT_TASK
  PUSHIS 1
  MINUS
  PUSHPROC e799_010_2
  COMM CREATE_SCRIPT_TASK
  PUSHIS 0
  PUSHIS 799
  COMM 0x008e
  PUSHIS 7
  COMM 0x0050
  COMM 0x016b
  PUSHIS 40
  PUSHIS 1
  COMM SCREEN_FADE_A
_1:
  COMM 0x0052
  PUSHREG
  IF _2
  COMM WAIT_FOR_TIMER_START
  GOTO _1
_2:
  COMM 0x0051
  PUSHIS 60
  COMM WAIT_FOR_TIMER_LIMIT
  PUSHIS 35
  PUSHIS 0
  COMM 0x0160
  PUSHIS 1
  PUSHIS 0
  COMM 0x0160
  COMM ACTIVATE_MESSAGE_PANEL
  PUSHIS 220
  PUSHIS 90
  COMM 0x0117
  PUSHMSG MSG_003
  COMM MESSAGE_REQUEST_AND_POLL
  COMM FINISH_SCRIPT_MESSAGE_WINDOW
  PUSHIS 0
  COMM 0x0093
  PUSHIS 0
  PUSHIS 799
  COMM 0x0090
  PUSHIS 0
  COMM 0x012d
  PUSHIS 0
  PUSHIS 0
  PUSHIS 0
  PUSHIS 0
  COMM 0x012e
  PUSHIS 120
  COMM 0x012f
  PUSHIS 130
  COMM WAIT_FOR_TIMER_LIMIT
  COMM RETURN_TO_TITLE
  END
e799_010_1:
  PROC e799_010_1
  PUSHIS 479
  COMM WAIT_FOR_TIMER_LIMIT
  PUSHIS 0
  COMM 0x012d
  PUSHIS 128
  PUSHIS 255
  PUSHIS 255
  PUSHIS 255
  COMM 0x012e
  PUSHIS 1
  COMM 0x0130
  END
e799_010_2:
  PROC e799_010_2
  PUSHIS 350
  COMM WAIT_FOR_TIMER_LIMIT
  PUSHIS 1
  COMM 0x0093
  PUSHIS 1
  PUSHIS 0
  COMM 0x0160
  PUSHIS 220
  PUSHIS 60
  COMM 0x0117
  COMM ACTIVATE_MESSAGE_PANEL
  PUSHMSG MSG_002B
  COMM MESSAGE_REQUEST_AND_POLL
  PUSHIS 40
  COMM WAIT_FOR_TIMER_LIMIT
  COMM FINISH_SCRIPT_MESSAGE_WINDOW
  PUSHIS 30
  COMM WAIT_FOR_TIMER_LIMIT
  PUSHIS 0
  COMM 0x0093
  END
end

messages msg1
  message MSG_001 speaker=none
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "  死の安らぎは 等しく"
      font "訪れよう"
      newline
    endpage
  endmessage
  message MSG_002 speaker=none
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "  死の安らぎは 等しく"
      font "訪れよう"
      newline
      font "  人に非ずとも 悪魔に"
      font "非ずとも"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_003 speaker=none
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "  大いなる意思の導きに"
      font "て"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_002B speaker=none
    page
      control f2 08 ff ff
      control f2 07 05 ff
      font "  死の安らぎは 等しく"
      font "訪れよう"
      newline
      font "  人に非ずとも 悪魔に"
      font "非ずとも"
      newline
    endpage
  endmessage
  message MSG_003B speaker=none
    page
      control f2 08 ff ff
      control f2 07 05 ff
      font "  大いなる意思の導きに"
      font "て"
      newline
    endpage
  endmessage
end

strings
  zero 240
end
