      newline
      control f1 04
    endpage
  endmessage
  message MSG_006 speaker=1
    page
      control f2 08 ff ff
      control f2 07 04 ff
      font "…新たな世界を築く力、"
      newline
      font "しかと見せてもらった……"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_007 speaker=1
    page
      control f2 08 ff ff
      control f2 07 04 ff
      font "だが、まだおまえには"
      newline
      font "真の戦いが残っている。"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_008 speaker=1
    page
      control f2 08 ff ff
      control f2 07 04 ff
      font "創世という、敵のいない戦"
      font "いだ…"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_006_GOOD speaker=1
    page
      control f2 08 ff ff
      control f2 07 04 ff
      font "愚かな……"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "コトワリ無く我が力を解放"
      font "したとて、"
      newline
      font "何の救いがあろうか……"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_007_GOOD speaker=1
    page
      control f2 08 ff ff
      control f2 07 04 ff
      font "おまえはまた、新たな苦し"
      font "みの国を"
      newline
      font "生み出すのだ……"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_008_GOOD speaker=1
    page
      control f2 08 ff ff
      control f2 07 04 ff
      font "おお……"
      newline
      font "悪魔よ………ヒトよ………"
      font "…"
      newline
      control f1 04
    endpage
  endmessage
  speaker 0
    font "声"
  endspeaker
  speaker 1
    font "カグツチ"
