messages msg1
  message MSG_001 speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "…よくぞ、ここまでたどり"
      font "ついた。"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_001_GOOD speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "…おお、"
      newline
      font "おまえが此処にたどり着こ"
      font "うとは……"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_002_GOOD speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "何故におまえが選ばれたる"
      font "か……"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "定めに適わぬ心持つおまえ"
      font "……"
      newline
      font "名も無いコトワリのおまえ"
      font "が……"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_003_GOOD speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "おまえが心に望みたるは…"
      newline
      font "未来の定まらぬ……自由な"
      font "る国……"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "おお……"
      newline
      font "おまえは世界の過ちに学ぶ"
      font "ことなく"
      newline
      font "自由を求めるというのか…"
      font "…"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_004_GOOD speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "…大いなる意思は、"
      newline
      font "かつての世界に自由を与え"
      font "た。"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "そして、さらなる高みに上"
      font "ることを願った。"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "だが、自由はその意に背き"
      font "、"
      newline
      font "悪を生み、闇を興し、破減"
      font "を呼んだのだ……"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "自由とは災いの種。"
      newline
      font "それがもたらすは減びのみ"
      font "。"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "我は許さぬ!"
      newline
      font "減びのための世界など!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "我が力を与えるは"
      newline
      font "コトワリ定かなる、完全な"
      font "る創世のみぞ!"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_005_GOOD speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      control f2 0c 01 ff
      font "よ、おまえは自由に溺れた"
      font "!"
      newline
      font "あの天使が堕ちた時のよう"
      font "に!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "消えよ、悪魔!"
      newline
      font "我が怒りの光にて、その存"
      font "在を終えよ!"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_001_BAD speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
