      font "如何…"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_005 speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "我はおまえに解き放つ!"
      newline
      font "この身の光を! 創世の力"
      font "を!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "いざ、我を打ち倒し"
      newline
      font "世界を創り変える強さを見"
      font "せよ!!"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_006 speaker=1
