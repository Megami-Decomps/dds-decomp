  message MSG_004 speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "…我はおまえに、創世の時"
      font "を与えよう。"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "その創世の成るか否かは"
      newline
