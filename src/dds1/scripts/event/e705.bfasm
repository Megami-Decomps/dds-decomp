  message MSG_003_SIZIMA speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "おまえが心に望みたるは…"
      newline
      font "静寂にて時を刻みたる有衆"
      font "の国。"
      newline
      font "おお、良し……"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_003_MUSUBI speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "おまえが心に望みたるは…"
      newline
      font "孤高なる同胞の深々とする"
      font "国。"
      newline
      font "おお、良し……"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_003_YOSUGA speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "おまえが心に望みたるは…"
      newline
      font "争いにて高みに至る崇美た"
      font "る国。"
      newline
