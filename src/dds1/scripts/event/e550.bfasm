flw0 2
profile dds1

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=0 float=0

procedure e550_main reserved=0x00000000
procedure e550_010 reserved=0x00000000

code
e550_main:
  PROC e550_main
  push 1
  push 550
  COMM 0x004d
  SCREEN_FADE_B(0, 1)
  push 0
  push 1
  push 20
  COMM 0x0014
  push 50
  push 0
  COMM 0x0048
  push float32(0.800000011920929, bits=0x3f4ccccd)
  push float32(0.800000011920929, bits=0x3f4ccccd)
  push float32(0.800000011920929, bits=0x3f4ccccd)
  push 0
  COMM 0x00b4
  push float32(0.699999988079071, bits=0x3f333333)
  push float32(0.4000000059604645, bits=0x3ecccccd)
  push float32(0.699999988079071, bits=0x3f333333)
  push 0
  COMM 0x00b5
  push 0
  push float32(0.20000000298023224, bits=0x3e4ccccd)
  push float32(0.20000000298023224, bits=0x3e4ccccd)
  push 0
  COMM 0x00b6
  push 225
  push 250
  push 255
  push 0
  COMM 0x00bb
  push 20000
  push 150
  push 5000
  push 255
  push 0
  COMM 0x00bc
  push 63
  push 3
  COMM 0x0015
  PUSHREG
  POPIX 0x0002
  ATTACH_WORLD_OBJECT_TO_SOURCE_VECTOR(global_int[2], READ_SECONDARY_WORLD_ID_VALUE(string(p01)))
  PREPARE_UNIT_MOTION_STATE(global_int[2], 1, 0, 0, 2)
  WAIT_FOR_TIMER_START()
  WAIT_FOR_TASK_REMOVAL(CREATE_SCRIPT_TASK(procedure(e550_010), -(1)))
  SET_MODEL_FLAG(0)
  SCREEN_FADE_B(0, 45)
  WAIT_FOR_TIMER_LIMIT(45)
  push global_int[2]
  COMM 0x0016
  COMM 0x004e
  COMM 0x002e
  return
e550_010:
  PROC e550_010
  ADD_EFFECT_UNIT_TO_WORLD(READ_SECONDARY_WORLD_ID_VALUE(string(cam05)))
  push READ_SECONDARY_WORLD_ID_VALUE(string(cam05_MOTION))
  push READ_SECONDARY_WORLD_ID_VALUE(string(cam05_2))
  COMM 0x0013
  SCREEN_FADE_A(0, 30)
  WAIT_FOR_TIMER_LIMIT(0)
  push 64
  push 650
  COMM 0x008f
  SET_UNIT_VALUE(global_int[2], 1)
  PREPARE_UNIT_MOTION_STATE(global_int[2], 0, 0, 0, 0)
  WAIT_FOR_TIMER_LIMIT(80)
  ACTIVATE_MESSAGE_PANEL()
  MESSAGE_REQUEST_AND_POLL(message(MSG_010_1))
  MESSAGE_REQUEST_AND_POLL(message(MSG_010_2))
  MESSAGE_REQUEST_AND_POLL(message(MSG_010_3))
  FINISH_SCRIPT_MESSAGE_WINDOW()
  SCREEN_FADE_B(0, 30)
  WAIT_FOR_TIMER_LIMIT(30)
  push global_int[2]
  COMM 0x0016
  COMM 0x004e
  SCREEN_FADE_A(0, 10)
  WAIT_FOR_TIMER_LIMIT(10)
  push 1
  push 2
  COMM 0x0121
  SCREEN_FADE_B(0, 10)
  WAIT_FOR_TIMER_LIMIT(10)
  push 1
  push 550
  COMM 0x004d
  ADD_EFFECT_UNIT_TO_WORLD(READ_SECONDARY_WORLD_ID_VALUE(string(cam05_3)))
  push READ_SECONDARY_WORLD_ID_VALUE(string(cam05_MOTION_2))
  push READ_SECONDARY_WORLD_ID_VALUE(string(cam05_4))
  COMM 0x0013
  push 63
  push 3
  COMM 0x0015
  PUSHREG
  POPIX 0x0002
  ATTACH_WORLD_OBJECT_TO_SOURCE_VECTOR(global_int[2], READ_SECONDARY_WORLD_ID_VALUE(string(p01_2)))
  PREPARE_UNIT_MOTION_STATE(global_int[2], 1, 0, 0, 2)
  SCREEN_FADE_A(0, 35)
  WAIT_FOR_TIMER_LIMIT(35)
  ACTIVATE_MESSAGE_PANEL()
  MESSAGE_REQUEST_AND_POLL(message(MSG_010_4))
  FINISH_SCRIPT_MESSAGE_WINDOW()
  SET_UNIT_VALUE(global_int[2], 3)
  PREPARE_UNIT_MOTION_STATE(global_int[2], 2, 0, 10, 0)
  WAIT_FOR_TIMER_LIMIT(18)
  return
end

messages msg1
  message MSG_010_1 speaker=none
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font ">携帯電話がメールを受信"
      font "しました。"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_010_2 speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      control f2 02 01 ff
      font "(主人公)へ"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "今日だぞ、覚えてるか?"
      newline
      font "ユウコ先生のお見舞いに行"
      font "くの。"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "ずっと代々木公園で待って"
      font "るのに"
      newline
      font "何してるんだよ。"
      newline
      font "早くこいよ。"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_010_3 speaker=none
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font ">クラスの友人からのメー"
      font "ルのようだ。"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font ">クラスメイト(男)の"
      newline
      font "名前を入力して下さい。"
      newline
      control f2 02 01 ff
      control f1 04
    endpage
  endmessage
  message MSG_010_4 speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "…代々木公園で待ってるか"
      font "ら"
      newline
      font "早く来るんだぞ!"
      newline
      font "            "
      font " (勇)より"
      newline
      control f1 04
    endpage
  endmessage
  speaker 0
    font "クラスメイト"
  endspeaker
end

strings
  string p01 "p01"
  string cam05 "cam05"
  string cam05_2 "cam05"
  string cam05_MOTION "cam05_MOTION"
  string cam05_3 "cam05"
  string cam05_4 "cam05"
  string cam05_MOTION_2 "cam05_MOTION"
  string p01_2 "p01"
  zero 86
end
