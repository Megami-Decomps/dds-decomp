messages msg1
  message MSG_010_1 speaker=none
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font ">携帯電話がメールを受信"
      font "しました。"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_010_2 speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      control f2 02 01 ff
      font "(主人公)へ"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "今日だぞ、覚えてるか?"
      newline
      font "ユウコ先生のお見舞いに行"
      font "くの。"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "ずっと代々木公園で待って"
      font "るのに"
      newline
      font "何してるんだよ。"
      newline
      font "早くこいよ。"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_010_3 speaker=none
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font ">クラスの友人からのメー"
      font "ルのようだ。"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font ">クラスメイト(男)の"
      newline
      font "名前を入力して下さい。"
      newline
      control f2 02 01 ff
      control f1 04
    endpage
  endmessage
  message MSG_010_4 speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      font "…代々木公園で待ってるか"
      font "ら"
      newline
      font "早く来るんだぞ!"
      newline
      font "            "
      font " (勇)より"
      newline
      control f1 04
    endpage
  endmessage
  speaker 0
    font "クラスメイト"
  endspeaker
end

strings
  string p01 "p01"
  string cam05 "cam05"
  string cam05_2 "cam05"
  string cam05_MOTION "cam05_MOTION"
  string cam05_3 "cam05"
  string cam05_4 "cam05"
  string cam05_MOTION_2 "cam05_MOTION"
  string p01_2 "p01"
  zero 86
end
