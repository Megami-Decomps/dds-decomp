flw0 2
profile dds1

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=1 float=0

procedure e802_main reserved=0x00000000
jump_label _1 reserved=0x00000000
jump_label _5 reserved=0x00000000
jump_label _3 reserved=0x00000000
jump_label _4 reserved=0x00000000
jump_label _7 reserved=0x00000000

code
e802_main:
  PROC e802_main
  push TEST_MODEL_FLAG(1044) == 0
  push 0
  push 0
  COMM 0x011e
  PUSHREG
  EQ
  AND
  IF _1
  SET_MODEL_FLAG(1044)
  COMM 0x01e8
  push 1
  push 802
  COMM 0x0021
  PUSHREG
  COMM 0x0022
  PUSHREG
  COMM WAIT_FOR_TASK_REMOVAL
  push 0
  COMM 0x001e
  goto _1
_1:
  WAIT_FOR_CAMP_TASK(802)
  push 0
  COMM 0x011d
  SCREEN_FADE_B(0, 1)
  push 3
  push 802
  COMM 0x00ca
  push float32(1.0, bits=0x3f800000)
  push float32(1.2000000476837158, bits=0x3f99999a)
  push float32(1.0, bits=0x3f800000)
  push 0
  COMM 0x00b4
  push float32(0.18000000715255737, bits=0x3e3851ec)
  push float32(0.9200000166893005, bits=0x3f6b851f)
  push -float32(0.33000001311302185, bits=0x3ea8f5c3)
  push 0
  COMM 0x00b5
  push float32(0.20000000298023224, bits=0x3e4ccccd)
  push float32(0.10000000149011612, bits=0x3dcccccd)
  push float32(0.20000000298023224, bits=0x3e4ccccd)
  push 0
  COMM 0x00b6
  push 1
  push 0
  push float32(0.4699999988079071, bits=0x3ef0a3d7)
  push 0
  COMM 0x00bb
  push 9000
  push 180
  push 1600
  push 245
  push 0
  COMM 0x00bc
  push 0
  push 1
  push 17
  COMM 0x0014
  push -(80)
  push 0
  COMM 0x0048
  local_int[0] = BIND_MODEL_MOTION_SOUND(802, 4)
  ATTACH_WORLD_OBJECT_TO_SOURCE_VECTOR(local_int[0], READ_SECONDARY_WORLD_ID_VALUE(string(str_01pos_01)))
  ADD_EFFECT_UNIT_TO_WORLD(READ_SECONDARY_WORLD_ID_VALUE(string(str_01cam_01)))
  push local_int[0]
  COMM 0x00ae
  push float32(0.4000000059604645, bits=0x3ecccccd)
  push float32(0.5, bits=0x3f000000)
  push float32(0.5, bits=0x3f000000)
  push float32(0.8999999761581421, bits=0x3f666666)
  push float32(1.0, bits=0x3f800000)
  push float32(1.100000023841858, bits=0x3f8ccccd)
  push 0
  push local_int[0]
  COMM 0x00af
  push -float32(0.36000001430511475, bits=0x3eb851ec)
  push float32(0.6000000238418579, bits=0x3f19999a)
  push -float32(0.18000000715255737, bits=0x3e3851ec)
  push 0
  push local_int[0]
  COMM 0x00b0
  SCREEN_FADE_A(0, 10)
_3:
  push 1
  COMM 0x011e
  PUSHREG
  IF _4
  push 4
  push 0
  COMM 0x011e
  PUSHREG
  EQ
  IF _5
  SCREEN_FADE_B(0, 15)
  WAIT_FOR_TIMER_LIMIT(15)
  SCREEN_FADE_A(0, 15)
  WAIT_FOR_TIMER_LIMIT(15)
  push 0
  COMM 0x011d
  goto _5
_5:
  WAIT_FOR_TIMER_START()
  goto _3
_4:
  push 1
  push 0
  COMM 0x011e
  PUSHREG
  EQ
  IF _7
  WAIT_FOR_TIMER_LIMIT(1)
  goto _7
_7:
  SCREEN_FADE_B(0, 10)
  WAIT_FOR_TIMER_LIMIT(10)
  RESET_DRAW_EFFECTS()
  RESET_FIELD_EFFECTS()
  DESTROY_WORLD_UNIT(local_int[0])
  COMM 0x0023
  push 0
  COMM 0x011d
  return
end

messages msg1
  message MSG_TEST speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      font "テスト中..."
      newline
      control f1 04
    endpage
  endmessage
end

strings count=16
  string str_01pos_01 "01pos_01"
  string str_01cam_01 "01cam_01"
end
