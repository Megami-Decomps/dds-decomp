flw0 2
profile dds1

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=0 float=0

procedure e912_main reserved=0x00000000
procedure e912_first reserved=0x00000000
procedure e912_dead reserved=0x00000000

code
e912_main:
  PROC e912_main
  MESSAGE_REQUEST_AND_POLL(message(MSG_000))
  return
e912_first:
  PROC e912_first
  COMM 0x003e
  push 1
  COMM 0x01ce
  push 80
  push 283
  push 1
  COMM 0x0197
  WAIT_FOR_TIMER_LIMIT(5)
  push 18
  push 283
  push 1
  COMM 0x01b2
  push 18
  push 317
  push 1
  COMM 0x01b2
  push 18
  push 318
  push 1
  COMM 0x01b2
  push 18
  push 319
  push 1
  COMM 0x01b2
  push 18
  push 320
  push 1
  COMM 0x01b2
  push 18
  push 321
  push 1
  COMM 0x01b2
  push 18
  push 322
  push 1
  COMM 0x01b2
  WAIT_FOR_TIMER_LIMIT(10)
  SCREEN_FADE_A(1, 24)
  push -(24)
  push 80
  COMM 0x0198
  COMM 0x003f
  return
e912_dead:
  PROC e912_dead
  COMM 0x003e
  push 0
  COMM 0x01ce
  push 100
  push 283
  push 1
  COMM 0x0197
  push -(13)
  push 100
  COMM 0x0198
  SCREEN_FADE_B(1, 0)
  WAIT_FOR_TIMER_LIMIT(20)
  return
end

messages msg1
  message MSG_000 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      font "テスト中..."
      newline
      control f1 04
    endpage
  endmessage
end

strings
  zero 240
end
