section 3 type=3 stride=0x1 count=1284 offset=0x574
  msg1
  message ANATO_01 speaker=none
    page
      control f2 08 ff ff
      font "エーイチ、その光に"
      glyphs 89bf
      font "れるな!"
      newline
      control f1 04
    endpage
  endmessage
  message ANATO_02 speaker=0
    page
      control f2 08 ff ff
      font "これは結界…"
      newline
      font "あの女のやりそうなことだ"
      font "。"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "それにしても"
      glyphs 86f0
      font "めかしい…"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "こもってばかりおるから"
      newline
      font "今様のものを知る"
      glyphs 88b6
      font "がないのだろう。"
      newline
      control f1 04
    endpage
  endmessage
  message ANATO_03 speaker=0
    page
      control f2 08 ff ff
      font "さて…"
      newline
      font "かような子"
      glyphs 88b7
      font "だまし、"
      newline
      font "私が一息に解いて見せよう"
      font "!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "エーイチ!"
      newline
      font "しかと見ておけ…"
      newline
      font "これがオリエントの神、ア"
      font "ナトの力だ!!"
      newline
      control f1 04
    endpage
  endmessage
  message ANATO_04 speaker=0
    page
      control f2 08 ff ff
      font "ここから先は私も"
      glyphs 888a
      font "に行こう。"
      newline
      font "あの女に無"
      glyphs 8696 8697
      font "を"
      glyphs 88b9
      font "びねばならんのでな…"
      newline
      glyphs 81e6 81e6 81e6 81e6 81e6
      font "…"
      newline
      control f1 04
    endpage
  endmessage
  message AMA_01 speaker=1
    page
      control f2 08 ff ff
      font "アナト!"
      newline
      font "よくもこの"
      glyphs 84d1
      font "へぬけぬけと…"
      newline
      control f1 04
    endpage
  endmessage
  message AMA_02 speaker=1
    page
      control f2 08 ff ff
      font "そなたによって"
      glyphs 85d2
      font "されたのは"
      newline
      font "我が"
      glyphs 86f7 85d1
      font "ばかりでない!"
      newline
      control f1 04
    endpage
  endmessage
  message AMA_03 speaker=1
    page
      control f2 08 ff ff
      font "我が名と…"
      newline
      font "そして大"
      glyphs 85b1 859d 88b0 8685
      font "の神々が"
      newline
      glyphs 85d2
      font "されたのだ!"
      newline
      control f1 04
    endpage
  endmessage
  message AMA_04 speaker=1
    page
      control f2 08 ff ff
      glyphs 84a2
      font "えがたきに"
      glyphs 84a2
      font "え、"
      glyphs 88ba
      font "びがたきを"
      glyphs 88ba
      font "び、"
      newline
      font "我々日本は再び日の出ずる"
      font "時を待った。"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "そして機は満ちた…"
      newline
      control f1 04
    endpage
  endmessage
  message AMA_05 speaker=1
    page
      control f2 08 ff ff
      font "この"
      glyphs 88bb 87fc
      font "を今こそ晴らさん!!"
      newline
      glyphs 859d 88b0 8685
      font "の怒りと"
      glyphs 86ca
      font "しみを"
      newline
      glyphs 83f1 83f2
      font "の"
      glyphs 88bc
      font "にて思い知るがいいわーっ"
      font "!!"
      newline
      control f1 04
    endpage
  endmessage
  speaker 0
    font "アナト"
  endspeaker
  speaker 1
    font "アマテラス"
  endspeaker
end
