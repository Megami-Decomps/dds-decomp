section 3 type=3 stride=0x1 count=1385 offset=0x34c
  msg1
  message MSG_KEITAI speaker=none
    page
      control f2 08 ff ff
      control f2 07 06 ff
      control f2 02 06 ff
      font "或る日金太が歩いていると"
      newline
      font "美しいお姫様が逃げてきた"
      newline
      font "「悪い人にねぇ今追われて"
      font "いるの"
      newline
      font " お願い金太守ってぇ!」"
      newline
      font "金太守って"
      newline
      font "金太守って"
      newline
      font "きんたまもって!"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_KEITAI_01 speaker=none
    page
      control f2 08 ff ff
      control f2 07 11 ff
      font "誰も「神」に立ち向かうこ"
      font "とはできなかった。"
      newline
      font "無論、あらゆる祈りの言葉"
      font "も通じなかった。"
      newline
    endpage
  endmessage
  message MSG_KEITAI_02 speaker=none
    page
      control f2 08 ff ff
      control f2 07 11 ff
      font "「神」は破壊の限りを尽く"
      font "し、"
      newline
      font "世界は混沌に打ちひしがれ"
      font "ていた。"
      newline
      font "復活を望む死者たちの墓は"
      font "暴かれ、"
      newline
      font "獣たちは互いに牙を剥き、"
      newline
      font "生き残った人間は絶望と不"
      font "信に"
      newline
      font "重く沈んだ。"
      newline
    endpage
  endmessage
  message MSG_KEITAI_03 speaker=none
    page
      control f2 08 ff ff
      control f2 07 11 ff
      font "野火が消え、無明の夜を迎"
      font "えた時、"
      newline
      font "一匹の蛇が地に横たわる屍"
      font "より"
      newline
      font "這い出てきた。"
      newline
      font "蛇は体をくねらせて丘を登"
      font "り、"
      newline
      font "焼け焦げたかん木の脇にと"
      font "ぐろを卷いた。"
      newline
      font "そして音をもたげて待った"
      font "。"
      newline
    endpage
  endmessage
  message MSG_KEITAI_04 speaker=none
    page
      control f2 08 ff ff
      control f2 07 11 ff
      font "「神」は蛇に向かって言っ"
      font "た。"
      newline
    endpage
  endmessage
  message MSG_KEITAI_05 speaker=none
    page
      control f2 08 ff ff
      control f2 07 11 ff
      font "呪"
      newline
      font "わ"
      newline
      font "れ"
      newline
      font "て"
      newline
      font "あ"
      newline
      font "れ"
      newline
    endpage
  endmessage
  message MSG_KEITAI_06 speaker=none
    page
      control f2 08 ff ff
      control f2 07 11 ff
      font "これが「神」の言葉の、そ"
      font "の始まりであった。"
      newline
      font "蛇は暗雲に閉ざされた大地"
      font "に向けて"
      newline
      font "降りていった。"
      newline
      font "蛇は幾多の災い、幾多の試"
      font "練をもたらすべく、"
      newline
      font "憎悪の渦卷く世界へと進ん"
      font "でいった。"
      newline
    endpage
  endmessage
  message MSG_KEITAI_07 speaker=none
    page
      control f2 08 ff ff
      control f2 07 11 ff
      control f2 02 06 ff
      font "気軽に読めるメルマガ小説"
      newline
      font "毎日発刊★長編小説"
      newline
      font "登録して会員になろう!!"
      newline
      font " "
      newline
      font "会員登録はこちら!!"
      newline
      control f1 04
    endpage
  endmessage
end

