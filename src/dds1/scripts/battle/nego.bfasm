  COMM MESSAGE_REQUEST_AND_POLL
  PUSHIS 30
  PUSHIS 0
  PUSHLIX 0x0002
  COMM 0x00ce
  PUSHLIX 0x0002
  COMM 0x00cf
  PUSHLIX 0x0002
  COMM 0x00d0
  PUSHIS 1
  MINUS
  POPLIX 0x0002
  END
RemunareMoneyAndGoods:
  PROC RemunareMoneyAndGoods
  PUSHIS 1
  PUSHIS 3
  COMM 0x000a
  PUSHREG
  SUB
  POPLIX 0x0024
  PUSHIS 0
  PUSHLIX 0x0024
  EQ
  IF _65
  JUMP RemunareMoney
  GOTO _64
_65:
  PUSHIS 1
  PUSHLIX 0x0024
  EQ
  IF _66
  JUMP RemunareMag
  GOTO _64
_66:
  JUMP RemunareItem
  GOTO _64
_64:
  END
RemunareMoney:
  PROC RemunareMoney
  PUSHLIX 0x0004
  COMM 0x0028
  PUSHREG
  POPLIX 0x0025
  PUSHIS 0
  PUSHLIX 0x0025
  PUSHIS 2
  COMM SET_MESSAGE_WINDOW_GEOMETRY
  PUSHIS 0
  PUSHIS 11
  PUSHLIX 0x0002
  COMM 0x00cd
  PUSHMSG DUMMY_SUCCESS_MONEY
  COMM MESSAGE_REQUEST_AND_POLL
  END
RemunareMag:
  PROC RemunareMag
  PUSHLIX 0x0004
  COMM 0x0028
  PUSHREG
  POPLIX 0x0026
  PUSHIS 0
  PUSHLIX 0x0026
  PUSHIS 2
  COMM SET_MESSAGE_WINDOW_GEOMETRY
  PUSHIS 0
  PUSHIS 11
  PUSHLIX 0x0002
  COMM 0x00cd
  PUSHMSG DUMMY_SUCCESS_MAG
  COMM MESSAGE_REQUEST_AND_POLL
  END
RemunareItem:
  PROC RemunareItem
  PUSHIS 0
  PUSHLIX 0x0004
  COMM 0x0027
  PUSHREG
  POPLIX 0x0027
  PUSHIS 3
  PUSHLIX 0x0027
  PUSHIS 2
  COMM SET_MESSAGE_WINDOW_GEOMETRY
  PUSHIS 0
  PUSHIS 11
  PUSHLIX 0x0002
  COMM 0x00cd
  PUSHMSG DUMMY_SUCCESS_ITEM
  COMM MESSAGE_REQUEST_AND_POLL
  END
RemunareInfo:
  PROC RemunareInfo
  PUSHIS 0
  PUSHIS 11
  PUSHLIX 0x0002
  COMM 0x00cd
  PUSHMSG DUMMY_SUCCESS_INFO
  COMM MESSAGE_REQUEST_AND_POLL
  END
RaptureMain:
  PROC RaptureMain
  PUSHIS 0
  POPLIX 0x0000
  PUSHLIX 0x0006
  POPLIX 0x0028
  PUSHIS 1
  PUSHLIX 0x0028
  EQ
  IF _68
  JUMP RaptureJoin
  GOTO _67
_68:
  PUSHIS 2
  PUSHLIX 0x0028
  EQ
  IF _69
  JUMP RaptureMoneyAndGoods
  GOTO _67
_69:
  JUMP RaptureInfo
  GOTO _67
_67:
  END
RaptureJoin:
  PROC RaptureJoin
  PUSHIS 37
  POPLIX 0x000a
  JUMP NegoFail
  END
RaptureMoneyAndGoods:
  PROC RaptureMoneyAndGoods
  PUSHIS 1
  PUSHIS 3
  COMM 0x000a
  PUSHREG
  SUB
  POPLIX 0x0029
  PUSHIS 0
  PUSHLIX 0x0029
  EQ
  IF _71
  JUMP RaptureMoney
  GOTO _70
_71:
  PUSHIS 1
  PUSHLIX 0x0029
  EQ
  IF _72
  JUMP RaptureMag
  GOTO _70
_72:
  JUMP RaptureItem
  GOTO _70
_70:
  END
RaptureMoney:
  PROC RaptureMoney
  PUSHIS 38
  POPLIX 0x000a
  JUMP NegoFail
  END
RaptureMag:
  PROC RaptureMag
  PUSHIS 39
  POPLIX 0x000a
  JUMP NegoFail
  END
RaptureItem:
  PROC RaptureItem
  PUSHIS 40
  POPLIX 0x000a
  JUMP NegoFail
  END
RaptureInfo:
  PROC RaptureInfo
  PUSHIS 41
  POPLIX 0x000a
  JUMP NegoFail
  END
end

