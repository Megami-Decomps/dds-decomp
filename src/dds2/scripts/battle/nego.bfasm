    jump RaptureMoney
  } else {
  _71:
    if (local_int[41] == 1) {
      jump RaptureMag
    } else {
    _72:
      jump RaptureItem
      goto _70
    }
  }
_70:
  return
RaptureMoney:
  PROC RaptureMoney
  local_int[10] = 38
  jump NegoFail
  return
RaptureMag:
  PROC RaptureMag
  local_int[10] = 39
  jump NegoFail
  return
RaptureItem:
  PROC RaptureItem
  local_int[10] = 40
  jump NegoFail
  return
RaptureInfo:
  PROC RaptureInfo
  local_int[10] = 41
  jump NegoFail
  return
end

