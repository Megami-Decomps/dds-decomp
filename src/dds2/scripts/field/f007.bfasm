    endpage
  endmessage
  message fred_007_003_01 speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Why did Roland and Adil have to die!?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "We have to fight! We can't let"
      newline
      text "them die for nothing!"
      newline
      control f1 04
    endpage
  endmessage
  message fred_007_003_02 speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The Society wants to stop the sun"
      newline
      text "too, right? Do you think we can"
      newline
      text "talk with them and work together?"
      newline
      control f1 04
    endpage
  endmessage
  message npc05_007_003_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "This is it! We'll do our best!"
      newline
      control f1 04
    endpage
  endmessage
  message npc05_007_003_02 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "You're taking an airplane to some"
      newline
      text "old facility?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Uh, I don't really think I can"
      newline
      text "help you with that."
      newline
      control f1 04
    endpage
  endmessage
  message npc06_007_003_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "When I heard Roland had died..."
      newline
      text "I thought we were through."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "...But, Fred's right."
      newline
      control f1 04
    endpage
  endmessage
  message npc06_007_003_02 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "You're going to the sun!?"
      newline
      text "...Will that really work?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Well, you have our support;"
      newline
      text "we're counting on you."
      newline
      control f1 04
    endpage
  endmessage
  message npc07_007_003_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Roland, Adil, and the others are"
      newline
      text "going to the promised land, right?"
      newline
      control f1 04
    endpage
  endmessage
  message npc07_007_003_02 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "...The promised land is starting"
      newline
      text "to sound pretty good."
      newline
      control f1 04
    endpage
  endmessage
  message npc08_007_003_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "He's definitely Greg's son..."
      newline
      text "You can tell because he still"
      newline
      text "has hope for the future."
      newline
      control f1 04
    endpage
  endmessage
  message npc08_007_003_02a speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "You guys..."
      newline
      control f1 04
    endpage
  endmessage
  message npc08_007_003_02b speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I'm sorry... I wish we could do more"
      newline
      text "on our own, instead of relying on you..."
      newline
      control f1 04
    endpage
  endmessage
  message npc09_007_003_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "What the hell was that!?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I saw it!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "It was really dark, but..."
      newline
      text "But, I saw it flying in that direction!"
      newline
      control f1 04
    endpage
  endmessage
