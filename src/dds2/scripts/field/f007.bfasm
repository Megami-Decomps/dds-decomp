  message roald_007_001_01a speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Adil and some of the guys are going to"
      newline
      text "cause a disturbance outside the prison."
      newline
      text "We'll use it to get inside."
