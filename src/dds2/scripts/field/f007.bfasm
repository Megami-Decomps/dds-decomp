messages msg1
  message DONT_GO_OUTSIDE_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Hey, whoa..."
      newline
      text "You're just gonna run off after"
      newline
      text "you get what you want?"
      newline
      control f1 04
    endpage
  endmessage
  message DONT_GO_OUTSIDE_02 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Get back here!"
      newline
      text "I'll pretend I didn't see that..."
      newline
      control f1 04
    endpage
  endmessage
  message GO_OUTSIDE speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Leave the area?"
      newline
      control f1 04
    endpage
  endmessage
  select YESNO_SEL
    option
      control f2 08 ff ff
      text "Yes."
    endoption
    option
      control f2 08 ff ff
      text "No."
    endoption
  endselect
  message aljira_007_001_01a speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "That dome must be what protects"
      newline
      text "the city from solar data..."
      newline
      control f1 04
    endpage
  endmessage
  message aljira_007_001_01b speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "It might allow them to live, but"
      newline
      text "what good is life inside a giant"
      newline
      text "cage?"
      newline
      control f1 04
    endpage
  endmessage
  message aljira_007_001_02a speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Be proud, huh..."
      newline
      control f1 04
    endpage
  endmessage
  message aljira_007_001_02b speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Gale actually impressed me with"
      newline
      text "that one."
      newline
      control f1 04
    endpage
  endmessage
  message aljira_007_001_03a speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Before, I never hesitated to pull"
      newline
      text "the trigger... Aim, fire. Aim, fire."
      newline
      text "It was almost mechanical."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I cursed this Atma..."
      newline
      text "I hated watching myself devour"
      newline
      text "others like an animal..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "But, without this power, we wouldn't"
      newline
      text "have learned to cry and laugh."
      newline
      control f1 04
    endpage
  endmessage
  message aljira_007_001_03b speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "What am I supposed to do?"
      newline
      text "...I can't even hate myself."
      newline
      control f1 04
    endpage
  endmessage
  message aljira_007_001_03c speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "If none of this had happened,"
      newline
      text "I wouldn't be able to appreciate"
      newline
      text "you all as comrades!"
      newline
      control f1 04
    endpage
  endmessage
  message gale_007_001_01a speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Why would the Society become demons"
      newline
      text "with full knowledge of the risks?"
      newline
      control f1 04
    endpage
  endmessage
  message gale_007_001_01b speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "They're either unhappy with the"
      newline
      text "status quo, or unable to maintain it."
      newline
      control f1 04
    endpage
  endmessage
  message gale_007_001_02 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Serph, I believe I have lied"
      newline
      text "to Fred."
      newline
      control f1 04
    endpage
  endmessage
  select gale_007_001_02_SEL
    option
      control f2 08 ff ff
      text "It was the right thing to do."
    endoption
    option
      control f2 08 ff ff
      text "Lupa would forgive you."
    endoption
  endselect
  message gale_007_001_02_ans0a speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I see."
      newline
      control f1 04
    endpage
  endmessage
  message gale_007_001_02_ans0b speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Tears, honor... I believe I've"
      newline
      text "started to understand the rest"
      newline
      text "of you."
      newline
      control f1 04
    endpage
  endmessage
  message gale_007_001_02_ans1a speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I can only hope so..."
      newline
      control f1 04
    endpage
  endmessage
  message gale_007_001_02_ans1b speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "It's a strange feeling..."
      newline
      text "Perhaps now I'm a little closer"
      newline
      text "to the rest of you."
      newline
      control f1 04
    endpage
  endmessage
  message gale_007_001_03 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Angel..."
      newline
      text "Could she really be... that Angel?"
      newline
      control f1 04
    endpage
  endmessage
  message ciero_007_001_01a speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Fred and de others would turn to"
      newline
      text "stone if dey were in de sunlight..."
      newline
      control f1 04
    endpage
  endmessage
  message ciero_007_001_01b speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "How's dat work, anyway?"
      newline
      control f1 04
    endpage
  endmessage
  message ciero_007_001_02a speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Parents are s'posed to look like"
      newline
      text "deir kids, ja?"
      newline
      control f1 04
    endpage
  endmessage
  message ciero_007_001_02b speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "...He don't look anything like Lupa."
      newline
      control f1 04
    endpage
  endmessage
  message ciero_007_001_03a speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "So de Junkyard was just an experiment"
      newline
      text "to create de demon virus, ja?"
      newline
      control f1 04
    endpage
  endmessage
  message ciero_007_001_03b speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Dat's horrible... How can dey just"
      newline
      text "use people like dat?"
      newline
      control f1 04
    endpage
  endmessage
  message ciero_007_001_03c speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "...But, are we really people?"
      newline
      control f1 04
    endpage
  endmessage
  message roald_007_001_01a speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Adil and some of the guys are going to"
      newline
      text "cause a disturbance outside the prison."
      newline
      text "We'll use it to get inside."
      newline
      control f1 04
    endpage
  endmessage
  message roald_007_001_01b speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I sent a few men inside after our"
      newline
      text "informant contacted us."
      newline
      control f1 04
    endpage
  endmessage
  message roald_007_001_01c speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "If I can get ahold of them, we should be"
      newline
      text "able to get more information."
      newline
      control f1 04
    endpage
  endmessage
  message roald_007_001_02a speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "So it wasn't just Colonel Beck..."
      newline
      text "Greg was in the Junkyard, too."
      newline
      control f1 04
    endpage
  endmessage
  message roald_007_001_02b speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "...Thank you."
      newline
      control f1 04
    endpage
  endmessage
  message roald_007_001_02c speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "You're not programs."
      newline
      text "As far as I'm concerned, you're"
      newline
      text "as human as any of us."
      newline
      control f1 04
    endpage
  endmessage
  message roald_007_001_03a speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I actually assumed the spy was some"
      newline
      text "kind of plot against us... But, I never"
      newline
      text "suspected Angel."
      newline
      control f1 04
    endpage
  endmessage
  message roald_007_001_03b speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "It doesn't look like we have very"
      newline
      text "much leverage at this point."
      newline
      control f1 04
    endpage
  endmessage
  message fred_007_001_01 speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Hang on, Timmy..."
      newline
      text "We're almost there."
      newline
      control f1 04
    endpage
  endmessage
  message fred_007_001_02 speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I'll always remember him."
      newline
      text "No matter what happens..."
      newline
      control f1 04
    endpage
  endmessage
  message fred_007_001_03a speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "So Cuvier wants to turn people"
      newline
      text "into demons... and feed us to them."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Angel wants to turn everyone into"
      newline
      text "demons and have a battle royale..."
      newline
      control f1 04
    endpage
  endmessage
  message fred_007_001_03b speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I don't like either of those options!"
      newline
      control f1 04
    endpage
  endmessage
  message npc06_007_001_01a speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "You need to hurry."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "God won't show mercy to those who"
      newline
      text "sit back and do nothing..."
      newline
      control f1 04
    endpage
  endmessage
  message npc06_007_001_01b speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "That big black ball in the sky"
      newline
      text "is no God of mine!"
      newline
      control f1 04
    endpage
  endmessage
  message npc07_007_001_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "This is the prison?"
      newline
      text "It looks more like some kind of"
      newline
      text "weird factory..."
      newline
      control f1 04
    endpage
  endmessage
  message npc07_007_001_02a speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "That kid didn't cry when he found"
      newline
      text "out Greg, his father, died..."
      newline
      control f1 04
    endpage
  endmessage
  message npc07_007_001_02b speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "...But this might be a little"
      newline
      text "too much for him."
      newline
      control f1 04
    endpage
  endmessage
  message npc07_007_001_03a speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Nirvana... That's a land without"
      newline
      text "confusion or war, right?"
      newline
      text "The ideal paradise..."
      newline
      control f1 04
    endpage
  endmessage
  message npc07_007_001_03b speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "People who imagine stuff like that"
      newline
      text "are delusional."
      newline
      control f1 04
    endpage
  endmessage
  message npc08_007_001_01a speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "It's so bright..."
      newline
      control f1 04
    endpage
  endmessage
  message npc08_007_001_01b speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I never thought I'd get to see"
      newline
      text "the sun again in my lifetime..."
      newline
      control f1 04
    endpage
  endmessage
  message npc08_007_001_02 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "There are still some Karma Soldiers"
      newline
      text "in the area... I'll do what I can"
      newline
      text "to stop them."
      newline
      control f1 04
    endpage
  endmessage
  message npc09_007_001_01a speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The Karma Society must know"
      newline
      text "about us already."
      newline
      control f1 04
    endpage
  endmessage
  message npc09_007_001_01b speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "This gate should take you to"
      newline
      text "the city. Go to the Society's"
      newline
      text "Corporate Office!"
      newline
      control f1 04
    endpage
  endmessage
  message npc09_007_001_02a speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "A supervised demon/human society?"
      newline
      text "Ha! I'd rather die..."
      newline
      control f1 04
    endpage
  endmessage
  message npc09_007_001_02b speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The weak may fall..."
      newline
      text "But, we'll keep living as humans."
      newline
      control f1 04
    endpage
  endmessage
  message npc10_007_001_01a speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The Lokapala were founded by"
      newline
      text "Fred's father, Greg."
      newline
      control f1 04
    endpage
  endmessage
  message npc10_007_001_01b speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "He was a good man, but two years ago"
      newline
      text "he died fighting so his men could"
      newline
      text "escape."
      newline
      control f1 04
    endpage
  endmessage
  message npc11_007_001_01a speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Thanks!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Beat the Cyber Shaman, too!"
      newline
      control f1 04
    endpage
  endmessage
  message npc11_007_001_01b speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The Cyber Shaman made the sun black."
      newline
      text "She must be a bad person!"
      newline
      control f1 04
    endpage
  endmessage
  message npc12_007_001_01 speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The Society decided that I didn't"
      newline
      text "look very appetizing..."
      newline
      control f1 04
    endpage
  endmessage
  message npc13_007_001_01 speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Thank you!"
      newline
      text "I don't know how I could ever"
      newline
      text "thank you enough!"
      newline
      control f1 04
    endpage
  endmessage
  message npc14_007_001_01 speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The Society must be crazy..."
      newline
      text "Did they think nobody would realize"
      newline
      text "what they were doing!?"
      newline
      control f1 04
    endpage
  endmessage
  message npc15_007_001_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "There are demons out there that"
      newline
      text "can put a curse on you..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "If that happens, you're super"
      newline
      text "vulnerable to death spells."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "We'd be in trouble if you died,"
      newline
      text "so I wanted to tell you about that."
      newline
      control f1 04
    endpage
  endmessage
  message npc16_007_001_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "There are demons out there that"
      newline
      text "can mute you..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "If that happens, it's a lot easier"
      newline
      text "for them to drain your MP."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "We'd be in trouble if you died,"
      newline
      text "so I wanted to tell you about that."
      newline
      control f1 04
    endpage
  endmessage
  message npc17_007_001_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "........."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> His eyes are closed."
      newline
      control f1 10
      control f2 08 ff ff
      control f1 04
    endpage
  endmessage
  message aljira2_007_002_01a speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Tears fall... but I'm not sad"
      newline
      text "anymore."
      newline
      control f1 04
    endpage
  endmessage
  message aljira2_007_002_01b speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I wish you could see us, Serph..."
      newline
      text "Everyone's a Tribe now."
      newline
      control f1 04
    endpage
  endmessage
  message ciero_007_002_01 speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Now dere's just four of us..."
      newline
      control f1 04
    endpage
  endmessage
  message roald_007_002_01a speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I sent some men to the power plant"
      newline
      text "to talk to the workers there."
      newline
      control f1 04
    endpage
  endmessage
  message roald_007_002_01b speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "...I don't want our first sunrise"
      newline
      text "in five years to be the last one."
      newline
      control f1 04
    endpage
  endmessage
  message fred_007_002_01a speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "It's not just the four of you..."
      newline
      text "Roland and I are here too."
      newline
      control f1 04
    endpage
  endmessage
  message fred_007_002_01b speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Serph and Gale inspired the others."
      newline
      text "You have a lot of new comrades!"
      newline
      control f1 04
    endpage
  endmessage
  message npc05_007_002_01a speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "He died because he tried to be"
      newline
      text "human, even though he was an AI..."
      newline
      control f1 04
    endpage
  endmessage
  message npc05_007_002_01b speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "But he's not an AI anymore..."
      newline
      text "He'll be remembered as a hero."
      newline
      control f1 04
    endpage
  endmessage
  message npc06_007_002_01a speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "So... The world could end after"
      newline
      text "the next sunrise, huh?"
      newline
      control f1 04
    endpage
  endmessage
  message npc06_007_002_01b speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "That's really too bad..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "That's why people should live life"
      newline
      text "to the fullest--so they never"
      newline
      text "have any regrets!"
      newline
      control f1 04
    endpage
  endmessage
  message npc07_007_002_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "We used orange, just like you guys."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "That should prove our dedication."
      newline
      control f1 04
    endpage
  endmessage
  message npc08_007_002_01a speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Nirvana... the promised land."
      newline
      control f1 04
    endpage
  endmessage
  message npc08_007_002_01b speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "It's a world unclouded by darkness."
      newline
      text "...That's kind of how I feel now."
      newline
      control f1 04
    endpage
  endmessage
  message npc09_007_002_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Fred's starting to sound a lot"
      newline
      text "like his father."
      newline
      control f1 04
    endpage
  endmessage
  message sera_007_003_01 speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "There's an airport, but it isn't"
      newline
      text "used much anymore."
      newline
      control f1 04
    endpage
  endmessage
  message gale_007_003_01a speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "You may cry if you like, Sera."
      newline
      control f1 04
    endpage
  endmessage
  message gale_007_003_01b speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "But, don't allow despair to take hold."
      newline
      text "You must find the strength to continue."
      newline
      control f1 04
    endpage
  endmessage
  message gale_007_003_02a speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Fred doesn't realize how dangerous"
      newline
      text "our task will be."
      newline
      control f1 04
    endpage
  endmessage
  message gale_007_003_02b speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "We will have to face Angel..."
      newline
      control f1 04
    endpage
  endmessage
  message ciero_007_003_01 speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I'll take you on a cruise after"
      newline
      text "dis is all over, ja?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "By den, all we'd have to worry"
      newline
      text "about is getting eaten by a sea"
      newline
      text "monster. Hee hee..."
      newline
      control f1 04
    endpage
  endmessage
  message ciero_007_003_02a speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Another fight with Angel?"
      newline
      control f1 04
    endpage
  endmessage
  message ciero_007_003_02b speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Sheesh, it's gonna be a tough one!"
      newline
      control f1 04
    endpage
  endmessage
  message fred_007_003_01 speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Why did Roland and Adil have to die!?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "We have to fight! We can't let"
      newline
      text "them die for nothing!"
      newline
      control f1 04
    endpage
  endmessage
  message fred_007_003_02 speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The Society wants to stop the sun"
      newline
      text "too, right? Do you think we can"
      newline
      text "talk with them and work together?"
      newline
      control f1 04
    endpage
  endmessage
  message npc05_007_003_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "This is it! We'll do our best!"
      newline
      control f1 04
    endpage
  endmessage
  message npc05_007_003_02 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "You're taking an airplane to some"
      newline
      text "old facility?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Uh, I don't really think I can"
      newline
      text "help you with that."
      newline
      control f1 04
    endpage
  endmessage
  message npc06_007_003_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "When I heard Roland had died..."
      newline
      text "I thought we were through."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "...But, Fred's right."
      newline
      control f1 04
    endpage
  endmessage
  message npc06_007_003_02 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "You're going to the sun!?"
      newline
      text "...Will that really work?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Well, you have our support;"
      newline
      text "we're counting on you."
      newline
      control f1 04
    endpage
  endmessage
  message npc07_007_003_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Roland, Adil, and the others are"
      newline
      text "going to the promised land, right?"
      newline
      control f1 04
    endpage
  endmessage
  message npc07_007_003_02 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "...The promised land is starting"
      newline
      text "to sound pretty good."
      newline
      control f1 04
    endpage
  endmessage
  message npc08_007_003_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "He's definitely Greg's son..."
      newline
      text "You can tell because he still"
      newline
      text "has hope for the future."
      newline
      control f1 04
    endpage
  endmessage
  message npc08_007_003_02a speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "You guys..."
      newline
      control f1 04
    endpage
  endmessage
  message npc08_007_003_02b speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I'm sorry... I wish we could do more"
      newline
      text "on our own, instead of relying on you..."
      newline
      control f1 04
    endpage
  endmessage
  message npc09_007_003_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "What the hell was that!?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I saw it!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "It was really dark, but..."
      newline
      text "But, I saw it flying in that direction!"
      newline
      control f1 04
    endpage
  endmessage
