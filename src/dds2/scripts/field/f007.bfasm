      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "We'd be in trouble if you died,"
      newline
      text "so I wanted to tell you about that."
      newline
      control f1 04
    endpage
  endmessage
  message npc16_007_001_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "There are demons out there that"
      newline
      text "can mute you..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "If that happens, it's a lot easier"
