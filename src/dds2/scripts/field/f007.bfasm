messages msg1
  message DONT_GO_OUTSIDE_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Hey, whoa..."
      newline
      text "You're just gonna run off after"
      newline
      text "you get what you want?"
      newline
      control f1 04
    endpage
  endmessage
  message DONT_GO_OUTSIDE_02 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Get back here!"
      newline
      text "I'll pretend I didn't see that..."
      newline
      control f1 04
    endpage
  endmessage
  message GO_OUTSIDE speaker=none
    page
      control f2 08 ff ff
