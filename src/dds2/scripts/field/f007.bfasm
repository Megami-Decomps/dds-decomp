  message aljira_007_001_02b speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Gale actually impressed me with"
      newline
      text "that one."
      newline
      control f1 04
    endpage
  endmessage
  message aljira_007_001_03a speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Before, I never hesitated to pull"
      newline
      text "the trigger... Aim, fire. Aim, fire."
      newline
      text "It was almost mechanical."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I cursed this Atma..."
      newline
      text "I hated watching myself devour"
      newline
      text "others like an animal..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "But, without this power, we wouldn't"
      newline
      text "have learned to cry and laugh."
      newline
      control f1 04
    endpage
  endmessage
  message aljira_007_001_03b speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "What am I supposed to do?"
      newline
      text "...I can't even hate myself."
      newline
      control f1 04
    endpage
  endmessage
  message aljira_007_001_03c speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "If none of this had happened,"
      newline
      text "I wouldn't be able to appreciate"
      newline
      text "you all as comrades!"
      newline
      control f1 04
    endpage
  endmessage
  message gale_007_001_01a speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Why would the Society become demons"
      newline
      text "with full knowledge of the risks?"
