      control f2 08 ff ff
      text "We took pride in things we could"
      newline
      text "never control, and now we brought"
      newline
      text "about the end of everything..."
      newline
      control f1 04
    endpage
  endmessage
  message TORIGER_026_001_08c speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Maybe we do deserve annihilation."
      newline
      control f1 04
    endpage
  endmessage
  select TORIGER_026_001_08_SEL
    option
      control f2 08 ff ff
      text "Live, and fix your mistakes."
    endoption
    option
      control f2 08 ff ff
      text "Maybe you're right."
    endoption
  endselect
  message TORIGER_026_001_08_ans0a speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I'm being lectured by an AI..."
      newline
      control f1 04
    endpage
  endmessage
  message TORIGER_026_001_08_ans0b speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "You're right. If I survive, I should"
      newline
      text "live a life that atones for my past."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "...For the sake of everything I lost."
      newline
      control f1 04
    endpage
  endmessage
  message TORIGER_026_001_08_ans1 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Then I'll await the morning, with"
      newline
      text "regret for what I've done..."
      newline
      control f1 04
    endpage
  endmessage
  message gale_026_020_01a speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Some might blame you for the end"
      newline
      text "of the world, and hate you for it."
      newline
      control f1 04
    endpage
  endmessage
  message gale_026_020_01b speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "But..."
      newline
      control f1 04
    endpage
  endmessage
  select gale_026_020_01_SEL
    option
      control f2 08 ff ff
      text "I shouldn't hate them, right?"
    endoption
    option
      control f2 08 ff ff
      text "Yeah... I know..."
    endoption
  endselect
  message gale_026_020_01_ans0a speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "As long as you understand, it is fine."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I'll remain on your side, even if"
      newline
      text "the whole world turns against you."
      newline
      control f1 04
    endpage
  endmessage
  message gale_026_020_01_ans0b speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "It's pointless to hate people..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I can help you carry the burden"
      newline
      text "caused by the hatred of others."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "That should make it easier on you."
      newline
      control f1 04
    endpage
  endmessage
  message gale_026_020_01_ans1a speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Don't worry, Sera."
      newline
      text "Your friends do not feel that way."
      newline
      control f1 04
    endpage
  endmessage
  message gale_026_020_01_ans1b speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "This is something that one person"
      newline
      text "cannot take sole responsibility for."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "...Even you, Sera. Do not hate others,"
      newline
      text "or blame yourself."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I'll remain on your side, even if"
      newline
      text "the whole world turns against you."
      newline
      control f1 04
    endpage
  endmessage
  message ciero_026_020_01a speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Tch..."
      newline
      text "De reason doesn't matter!"
      newline
      control f1 04
    endpage
  endmessage
  message ciero_026_020_01b speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "We support Sera because it's de"
      newline
      text "right thing to do, ja?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Dis all woulda happened wit'"
      newline
      text "or wit'out Sera. You can't blame"
      newline
      text "her for it!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I mean, look at de people here."
      newline
      text "Honestly, dey're good for nothin'."
      newline
      control f1 04
    endpage
  endmessage
  message ciero_026_020_01c speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "If I was God, I woulda destroyed"
      newline
      text "it all a long time ago, ja?"
      newline
      control f1 04
    endpage
  endmessage
