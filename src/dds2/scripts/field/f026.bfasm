messages msg1
  message ABOUT_EGG speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Aheh... Hyeheeheehee..."
      newline
      text "Inside... It's like nothing"
      newline
      text "you've ever seen... Aha!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Everyone's..."
      newline
      text "They're gone! Hee hee hee..."
      newline
      text "The voice took everyone away!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Can't you hear the voice?"
      newline
      text "See...? It's crying..."
      newline
      control f1 04
    endpage
  endmessage
  message PRE_BATTLE_DARKZONE speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> An unknown presence can be felt"
      newline
      text "beyond the hall."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> Continue onward?"
      newline
      control f1 04
    endpage
  endmessage
  message BATTLE_005 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Aha... heeheehee..."
      newline
      text "I ha ha... must return..."
      newline
      text "to my body hee hee hee..."
      newline
      control f1 04
    endpage
  endmessage
  message BATTLE_023 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Something's emerging from"
      newline
      text "the vortex!"
      newline
      control f1 04
    endpage
  endmessage
  message GET_RING speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Obtained "
      control f2 02 05 ff
      text "Dragon Ring"
      control f2 02 01 ff
      newline
      text "from the defeated enemies."
      newline
      control f1 04
    endpage
  endmessage
  message PRE_BATTLE_WARPZONE speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> An unknown presence can be felt"
      newline
      text "beyond the door."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> Enter and continue?"
      newline
      control f1 04
    endpage
  endmessage
  message BATTLE_028_01 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Don't come... any closer..."
      newline
      control f1 04
    endpage
  endmessage
  message BATTLE_028_02 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Stay AWAAAAAY!!!"
      newline
      control f1 04
    endpage
  endmessage
  message BATTLE_048_01 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Grrr... Eat..."
      newline
      text "Will..."
      newline
      control f1 04
    endpage
  endmessage
  message BATTLE_048_02 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "............is PURE!"
      newline
      control f1 04
