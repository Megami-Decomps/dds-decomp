warpscr_050_03:
  PROC warpscr_050_03
  RESTORE_CAMERA_NODE_MODE()
  SET_SOLAR_OVERLAY_MODE(0)
  COMM 0x021f
  RELEASE_CURRENT_BGM()
  LOAD_ARCHIVE_SOUND_BANK_AND_WAIT(37)
  START_SCENE_BGM(128)
  ENABLE_FIELD_MODELS(26, 54, string(md_hoji_02_28), 0)
  DISABLE_FIELD_MODELS(26, 54, string(md_hoji_01_28), 0)
  global_int[0] = READ_CURRENT_WORLD_OBJECT_ID()
  PREPARE_UNIT_MOTION_STATE(global_int[0], 0, 0, 0, 1)
  local_int[67] = CREATE_LINKED_CAMERA_VIEWER(6, 293)
  push float32(2.200000047683716, bits=0x400ccccd)
  push float32(2.200000047683716, bits=0x400ccccd)
  push float32(2.200000047683716, bits=0x400ccccd)
  push local_int[67]
  COMM 0x001b
  ATTACH_WORLD_OBJECT_TO_SOURCE_VECTOR(local_int[67], READ_SECONDARY_WORLD_ID_VALUE(string(str_01pos_03_13)))
  APPLY_FIELD_MODEL_LIGHTING(local_int[67])
  ADD_FLAGGED_EFFECT_UNIT_TO_WORLD(READ_SECONDARY_WORLD_ID_VALUE(string(str_01cam_02_3)))
  START_CAMERA_PATH_MOVE(READ_SECONDARY_WORLD_ID_VALUE(string(str_01cam_02_4)), READ_SECONDARY_WORLD_ID_VALUE(string(str_01cam_02_MOTION_2)))
  SCREEN_FADE_A(0, 30)
  push READ_SECONDARY_WORLD_ID_VALUE(string(str_01cam_02_5))
  COMM 0x0055
  ACTIVATE_MESSAGE_PANEL()
  MESSAGE_REQUEST_AND_POLL(message(URIEL))
  FINISH_SCRIPT_MESSAGE_WINDOW()
  PREPARE_UNIT_MOTION_STATE(local_int[67], 4, 3, 15, 2)
  WAIT_FOR_TIMER_LIMIT(30)
  START_ARCHIVE_SOUND(37, 0)
  WAIT_FOR_TIMER_LIMIT(5)
  push 0
  push float32(0.9259999990463257, bits=0x3f6d0e56)
  push 0
  COMM 0x00ea
  push 100
  push 128
  push 128
  push 128
  COMM 0x00eb
  push -(170)
  push 40
  push 500
  COMM 0x00ec
  push 0
  COMM 0x00ed
  WAIT_FOR_TIMER_LIMIT(10)
  STOP_ARCHIVE_SOUND(37, 0)
  DEFER_BATTLE_EXIT(1, 26, 503)
  SUBMIT_EVENT(791)
  return
  return
after_btl_054:
  PROC after_btl_054
  RESTORE_CAMERA_NODE_MODE()
  SET_SOLAR_OVERLAY_MODE(4)
  SET_MODEL_FLAG(1728)
  if (TEST_MODEL_FLAG(1729) == 1 && TEST_MODEL_FLAG(1730) == 1) {
    SET_MODEL_FLAG(253)
    SET_MODEL_FLAG(722)
  }
_720:
  ENABLE_FIELD_MODELS(26, 54, string(md_hoji_01_29), 0)
  DISABLE_FIELD_MODELS(26, 54, string(md_hoji_02_29), 0)
  WAIT_FOR_TIMER_LIMIT(30)
  ACTIVATE_MESSAGE_PANEL()
  MESSAGE_REQUEST_AND_POLL(message(URIEL_ESCAPE))
  FINISH_SCRIPT_MESSAGE_WINDOW()
  SET_SOLAR_OVERLAY_MODE(1)
  RELEASE_CURRENT_OBJECT()
  return
