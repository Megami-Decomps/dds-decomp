  while (1) {
    if (ACTION_WINDOW_REQUEST_AND_POLL(1) == 1) {
      RESTORE_CAMERA_NODE_MODE()
      SET_SOLAR_OVERLAY_MODE(6)
      ACTIVATE_MESSAGE_PANEL()
      MESSAGE_REQUEST_AND_POLL(message(MR_JOHNNY_02))
      FINISH_SCRIPT_MESSAGE_WINDOW()
      SCREEN_FADE_B(0, 20)
      WAIT_FOR_TIMER_LIMIT(20)
      SET_SOLAR_OVERLAY_MODE(0)
      DISABLE_FIELD_MODELS(26, 1, string(md_01all_01), 0)
      RUN_FIELD_TRANSITION_SELECTOR(100)
