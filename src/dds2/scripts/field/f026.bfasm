      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I'll remain on your side, even if"
      newline
      text "the whole world turns against you."
      newline
      control f1 04
    endpage
  endmessage
  message ciero_026_020_01a speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Tch..."
      newline
      text "De reason doesn't matter!"
      newline
      control f1 04
    endpage
  endmessage
  message ciero_026_020_01b speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "We support Sera because it's de"
      newline
      text "right thing to do, ja?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Dis all woulda happened wit'"
      newline
      text "or wit'out Sera. You can't blame"
      newline
      text "her for it!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I mean, look at de people here."
      newline
      text "Honestly, dey're good for nothin'."
      newline
      control f1 04
    endpage
  endmessage
  message ciero_026_020_01c speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "If I was God, I woulda destroyed"
      newline
      text "it all a long time ago, ja?"
      newline
      control f1 04
    endpage
  endmessage
