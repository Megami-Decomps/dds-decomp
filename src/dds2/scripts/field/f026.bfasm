warpscr_050_03:
  PROC warpscr_050_03
  RESTORE_CAMERA_NODE_MODE()
  SET_SOLAR_OVERLAY_MODE(0)
  COMM 0x021f
  COMM 0x0216
  push 37
  COMM 0x0217
  push 128
  COMM 0x0210
  ENABLE_FIELD_MODELS(26, 54, string(md_hoji_02_28), 0)
  DISABLE_FIELD_MODELS(26, 54, string(md_hoji_01_28), 0)
  global_int[0] = READ_CURRENT_WORLD_OBJECT_ID()
  PREPARE_UNIT_MOTION_STATE(global_int[0], 0, 0, 0, 1)
  push 293
  push 6
  COMM 0x0015
  PUSHREG
  POPLIX 0x0043
  push float32(2.200000047683716, bits=0x400ccccd)
  push float32(2.200000047683716, bits=0x400ccccd)
  push float32(2.200000047683716, bits=0x400ccccd)
  push local_int[67]
  COMM 0x001b
  result = READ_SECONDARY_WORLD_ID_VALUE(string(str_01pos_03_13))
  ATTACH_WORLD_OBJECT_TO_SOURCE_VECTOR(local_int[67], result)
  push local_int[67]
  COMM 0x021e
  result = READ_SECONDARY_WORLD_ID_VALUE(string(str_01cam_02_3))
  ADD_FLAGGED_EFFECT_UNIT_TO_WORLD(result)
  result = READ_SECONDARY_WORLD_ID_VALUE(string(str_01cam_02_MOTION_2))
  push result
  push string(str_01cam_02_4)
  COMM READ_SECONDARY_WORLD_ID_VALUE
  PUSHREG
  COMM 0x0013
  SCREEN_FADE_A(0, 30)
  result = READ_SECONDARY_WORLD_ID_VALUE(string(str_01cam_02_5))
  push result
  COMM 0x0055
  ACTIVATE_MESSAGE_PANEL()
  MESSAGE_REQUEST_AND_POLL(message(URIEL))
  FINISH_SCRIPT_MESSAGE_WINDOW()
  PREPARE_UNIT_MOTION_STATE(local_int[67], 4, 3, 15, 2)
  WAIT_FOR_TIMER_LIMIT(30)
  push 0
  push 37
  COMM 0x01f3
  WAIT_FOR_TIMER_LIMIT(5)
  push 0
  push float32(0.9259999990463257, bits=0x3f6d0e56)
  push 0
  COMM 0x00ea
  push 100
  push 128
  push 128
  push 128
  COMM 0x00eb
  push -(170)
  push 40
  push 500
  COMM 0x00ec
  push 0
  COMM 0x00ed
  WAIT_FOR_TIMER_LIMIT(10)
  push 0
  push 37
  COMM 0x01f4
  push 503
  push 26
  push 1
  COMM 0x0097
  push 791
  COMM 0x0067
  return
  return
after_btl_054:
