messages msg1
  message ABOUT_EGG speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Aheh... Hyeheeheehee..."
      newline
      text "Inside... It's like nothing"
      newline
      text "you've ever seen... Aha!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Everyone's..."
      newline
      text "They're gone! Hee hee hee..."
      newline
      text "The voice took everyone away!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Can't you hear the voice?"
      newline
      text "See...? It's crying..."
      newline
      control f1 04
    endpage
  endmessage
  message PRE_BATTLE_DARKZONE speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> An unknown presence can be felt"
      newline
      text "beyond the hall."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> Continue onward?"
      newline
      control f1 04
    endpage
  endmessage
  message BATTLE_005 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Aha... heeheehee..."
      newline
      text "I ha ha... must return..."
      newline
      text "to my body hee hee hee..."
      newline
      control f1 04
    endpage
  endmessage
  message BATTLE_023 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Something's emerging from"
      newline
      text "the vortex!"
      newline
      control f1 04
    endpage
  endmessage
  message GET_RING speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Obtained "
      control f2 02 05 ff
      text "Dragon Ring"
      control f2 02 01 ff
      newline
      text "from the defeated enemies."
      newline
      control f1 04
    endpage
  endmessage
  message PRE_BATTLE_WARPZONE speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> An unknown presence can be felt"
      newline
      text "beyond the door."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> Enter and continue?"
      newline
      control f1 04
    endpage
  endmessage
  message BATTLE_028_01 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Don't come... any closer..."
      newline
      control f1 04
    endpage
  endmessage
  message BATTLE_028_02 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Stay AWAAAAAY!!!"
      newline
      control f1 04
    endpage
  endmessage
  message BATTLE_048_01 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Grrr... Eat..."
      newline
      text "Will..."
      newline
      control f1 04
    endpage
  endmessage
  message BATTLE_048_02 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "............is PURE!"
      newline
      control f1 04
    endpage
  endmessage
  message HINT_WARP_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Can't you hear it?"
      newline
      text "...From the vortex?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "It's so sad and painful..."
      newline
      text "I heard that voice, and I wanted"
      newline
      text "to comfort it......"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "...And then I was here."
      newline
      control f1 04
    endpage
  endmessage
  message WALL_REACTION speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> The path disappeared, and is now"
      newline
      text "impassable."
      newline
      control f1 04
    endpage
  endmessage
  message DOOR_REACTION speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> The door is broken..."
      newline
      control f1 04
    endpage
  endmessage
  message BURIEDMAN_RE_01 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Don't... come..."
      newline
      control f1 04
    endpage
  endmessage
  message BURIEDMAN_RE_02 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Staaaaay baaaack..."
      newline
      control f1 04
    endpage
  endmessage
  message BURIEDMAN_RE_03 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Go... Back..."
      newline
      control f1 04
    endpage
  endmessage
  message BURIEDMAN_RE_04 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Ugh... Heeheeheh heh..."
      newline
      text "It's devouring... my mind..."
      newline
      text "I can feel it...!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Stay back... Gooooo..."
      newline
      control f1 04
    endpage
  endmessage
  message BURIEDMAN_RE_05 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Argh... uhhhh..."
      newline
      text "Heeeeelp meeee!"
      newline
      control f1 04
    endpage
  endmessage
  message BURIEDMAN_RE_06 speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Ngh..."
      newline
      text "Hnghnghnghnghng..."
      newline
      control f1 04
    endpage
  endmessage
  message BURIEDMAN_NO_RE speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> There's a body inside the wall."
      newline
      control f1 04
    endpage
  endmessage
  message BEFORE_EGG speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Sad, bitter crying can be heard"
      newline
      text "on the other side."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> Open the door?"
      newline
      control f1 04
    endpage
  endmessage
  message GO_OPERATE_ROOM speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Heat is waiting."
      newline
      text "There's no time to turn back..."
      newline
      control f1 04
    endpage
  endmessage
  message URIEL speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Where is this..."
      newline
      text "Who... am I?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "These stone dolls..."
      newline
      text "I have seen them before."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Yes, we took the betrayers and"
      newline
