      control f2 08 ff ff
      control f2 07 07 ff
      control f2 02 01 ff
      text "Hey, look there..."
      newline
      text "Isn't that another key card?"
      newline
      control f1 04
    endpage
  endmessage
  message CARD_03 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f2 02 01 ff
      text "> Obtained "
      control f2 02 05 ff
      text "Lv. 3 Key Card"
      control f2 02 01 ff
      text "."
      newline
      control f1 04
    endpage
  endmessage
  message SITAI_EVE_03 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f2 02 01 ff
      text "That corpse used to be a soldier..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "They didn't just use prisoners."
      newline
      text "Society members who went insane"
      newline
      text "ended up in cells, too."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Looks like the Karma Society can't"
      newline
      text "handle people who fully give in"
      newline
      text "to the demon virus."
      newline
      control f1 04
    endpage
  endmessage
  message SITAI_EVE_04 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f2 02 01 ff
      text "There's no point in sticking around."
      newline
      text "We need to find the control room."
      newline
      control f1 04
    endpage
  endmessage
  message SITAI_INAI speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f2 02 01 ff
      text "> There's nothing here anymore."
      newline
      control f1 04
    endpage
  endmessage
  message ROALD_02 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f2 02 01 ff
      text "...This is the command room!?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "This is disgusting..."
      newline
      text "It's in terrible condition."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "...Is something there?"
      newline
      control f1 04
    endpage
  endmessage
