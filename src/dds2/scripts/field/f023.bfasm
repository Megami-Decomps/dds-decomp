    endpage
  endmessage
  message KEIBI_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f2 02 01 ff
      text "What? A jailbreak?"
      newline
      control f1 04
    endpage
  endmessage
  message KEIBI_02 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f2 02 01 ff
      text "After we play with them, why don't"
      newline
      text "we throw 'em in the processing"
      newline
      text "machine?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Then we can have our way with them"
      newline
      text "twice!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Oooh, I can't wait to hear that"
      newline
      text "grinding noise again..."
      newline
      control f1 04
    endpage
  endmessage
  message KEIBI_03 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f2 02 01 ff
      text "Heh... Exactly what I was thinking."
      newline
      control f1 04
    endpage
  endmessage
