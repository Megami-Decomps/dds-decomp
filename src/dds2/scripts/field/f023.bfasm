  message KUBANDA_BATTLE_01 speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f2 02 01 ff
      text "Who the hell're you?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Wait... You're those Asuras that"
      newline
      text "escaped from purgatory!"
      newline
      control f1 04
    endpage
  endmessage
  message KUBANDA_BATTLE_02 speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f2 02 01 ff
      text "I don't know how you got bodies"
      newline
      text "in this world, but I'm gonna watch"
      newline
      text "'em rot away to nothing!"
      newline
      control f1 04
    endpage
  endmessage
  message KUBANDA_BATTLE_03 speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f2 02 01 ff
      text "You won't get out of here alive."
      newline
    endpage
  endmessage
  message KUBANDA_011_01 speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f2 02 01 ff
      text "You broke outta the cell, huh?"
      newline
      text "We must have... rats."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Hyeh heh... But that doesn't matter."
      newline
      text "It's been a long time since I've felt"
      newline
      text "the thrill of the hunt!"
      newline
      control f1 04
    endpage
  endmessage
  message KUBANDA_011_02 speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f2 02 01 ff
      text "What are you doing over there?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "You're just gonna run away?"
      newline
      text "Yah ha ha! Fast food!"
      newline
      control f1 04
    endpage
  endmessage
  message SPY02_DOOR_01 speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f2 02 01 ff
      text "...You don't sound like the Jailer."
      newline
      text "Hey, how's the weather today?"
      newline
      control f1 04
    endpage
  endmessage
  select SPY02_DOOR_SEL
    option
      control f2 08 ff ff
      text "Terrible, bright sunlight."
    endoption
    option
      control f2 08 ff ff
      text "Unbearable solar noise."
    endoption
    option
      control f2 08 ff ff
      text "Nothing's changed, stop asking."
    endoption
  endselect
  message SPY02_DOOR_02 speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f2 02 01 ff
      text "...Yeah."
      newline
      text "That Cuvier Syndrome's a bitch."
      newline
      control f1 04
    endpage
  endmessage
  message SPY02_DOOR_03 speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f2 02 01 ff
      text "Come in."
      newline
      control f1 04
    endpage
  endmessage
  message SPY02_DOOR_04 speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f2 02 01 ff
      text "...You're right. I'll never see"
      newline
      text "the light of day again, anyway."
      newline
      control f1 04
    endpage
  endmessage
  message SPY02_DOOR_05 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f2 02 01 ff
      text "> There's no response."
      newline
      text "The cell must be empty."
      newline
      control f1 04
    endpage
  endmessage
  message TUKAMARU_01 speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f2 02 01 ff
      text "Stay put until I find out what"
      newline
      text "Madame wants to do with you."
      newline
      control f1 04
    endpage
  endmessage
  message TUKAMARU_02 speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f2 02 01 ff
      text "Breeha ha ha ha ha ha!"
      newline
      text "You guys escaped from that empty,"
      newline
      text "worthless junk heap..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "but you can't even get out of a simple"
      newline
      text "jail cell!?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I guess AI's are no match for"
      newline
      text "the real thing!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Breeha ha ha ha ha ha!!"
      newline
      control f1 04
    endpage
  endmessage
  message SPY_012_00 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f2 02 01 ff
      text "Hey... It's me."
      newline
      text "You guys still alive?"
      newline
      control f1 04
    endpage
  endmessage
  message SPY_012_01_1 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f2 02 01 ff
      text "The Jailer is the real problem,"
      newline
      text "obviously."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "As long as he's around, there's no way"
      newline
      text "we can release the prisoners."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "But, we came up with a plan."
      newline
      text "Listen..."
      newline
      control f1 04
    endpage
  endmessage
  message SPY_012_01_2 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f2 02 01 ff
      text "Even though the people of the Society"
      newline
      text "turned into demons, most of them still"
      newline
      text "don't want to eat flesh that's raw."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Cannibalism doesn't appeal to many"
      newline
      text "humans--apparently not even demonized"
      newline
      text "ones."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "So, they use this factory to process"
      newline
      text "human carcasses into canned food."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Which, of course, the Jailer eats."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "If we can do something with his"
      newline
      text "food, we may be able to catch"
      newline
      text "him off guard."
      newline
      control f1 04
    endpage
  endmessage
  message SPY_012_02 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f2 02 01 ff
      text "Another one of us is finding out"
      newline
      text "what can be done with the food."
      newline
      text "I'll open the door--hurry!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "He should be in one of the cells"
      newline
      text "to the east."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "When you knock on his door, he'll"
      newline
      text "ask you about the weather."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Tell him about the \"unbearable"
      newline
      text "solar noise,\" and he'll let you in."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Did you understand all that?"
      newline
      control f1 04
    endpage
  endmessage
  message SPY_012_03 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f2 02 01 ff
      text "I need to hide before someone"
      newline
      text "finds me. Good luck!"
      newline
      control f1 04
    endpage
  endmessage
  message SPY_012_04 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f2 02 01 ff
      text "I told you to watch out for"
      newline
      text "the Jailer! ...I can't keep busting"
      newline
      text "you out like this."
      newline
      control f1 04
    endpage
  endmessage
  message SPY_012_05_1 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f2 02 01 ff
      text "In case you forgot, I'll tell you"
      newline
      text "the plan again..."
      newline
      control f1 04
    endpage
  endmessage
  message SPY_012_05_2 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f2 02 01 ff
      text "You met up with the other guy,"
      newline
      text "right?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "If we can pull this off, we should"
      newline
      text "be able to release the prisoners."
      newline
      control f1 04
    endpage
  endmessage
  message SPY_012_06 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f2 02 01 ff
      text "We're counting on you."
      newline
      control f1 04
    endpage
  endmessage
  message SPY_013_01 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f2 02 01 ff
