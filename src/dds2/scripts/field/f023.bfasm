  endmessage
  message SPY_012_01_2 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f2 02 01 ff
      text "Even though the people of the Society"
      newline
      text "turned into demons, most of them still"
      newline
      text "don't want to eat flesh that's raw."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Cannibalism doesn't appeal to many"
      newline
      text "humans--apparently not even demonized"
      newline
      text "ones."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "So, they use this factory to process"
      newline
      text "human carcasses into canned food."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Which, of course, the Jailer eats."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "If we can do something with his"
      newline
      text "food, we may be able to catch"
      newline
      text "him off guard."
      newline
      control f1 04
    endpage
  endmessage
  message SPY_012_02 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      control f2 02 01 ff
      text "Another one of us is finding out"
      newline
      text "what can be done with the food."
      newline
      text "I'll open the door--hurry!"
      newline
      control f1 04
    endpage
    page
