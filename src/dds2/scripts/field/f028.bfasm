      control f2 03 02 ff
      text "."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> Plants are very rare in this world."
      newline
      text "They can be traded in at MAD MART for"
      newline
      text "money."
      newline
      control f1 04
    endpage
  endmessage
