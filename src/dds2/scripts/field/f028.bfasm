      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Let's go."
      newline
      control f1 04
    endpage
  endmessage
  message FIRST_KONTAKT_06 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Hm..."
      newline
      text "Perhaps."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "For one thing to live, another thing"
      newline
      text "must be killed."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "God, or whoever is responsible,"
      newline
      text "deserves respect for creating such"
      newline
      text "a system."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "It reveals that we cannot take"
      newline
      text "all matters into our own hands."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "We need only to focus on doing our"
      newline
      text "best--a simple, yet profound way to"
      newline
      text "live, is it not?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Now, let's go."
      newline
      control f1 04
    endpage
  endmessage
  message BATTLE_033 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
