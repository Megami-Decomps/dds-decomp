  message FIRST_KONTAKT_05 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Of course."
      newline
      text "You are the leader, after all."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
