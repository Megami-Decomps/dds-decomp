messages msg1
  message FIRST_KONTAKT_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "It's the Cyber Shaman!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Tell the others, immediately!"
      newline
      control f1 04
    endpage
