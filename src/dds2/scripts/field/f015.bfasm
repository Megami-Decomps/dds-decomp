    result = READ_SECONDARY_WORLD_ID_VALUE(string(str_01cam_10))
    ADD_FLAGGED_EFFECT_UNIT_TO_WORLD(result)
    SCREEN_FADE_A(0, 5)
    WAIT_FOR_TIMER_LIMIT(5)
    push 98
    COMM 0x0214
    push 0
    push string(str_01path_01_2)
