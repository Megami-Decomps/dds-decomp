      control f2 02 01 ff
      newline
      text "skill from Lupa."
      newline
      control f1 04
    endpage
  endmessage
  message JINANAS_SKILL speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Argilla received the "
      control f2 02 05 ff
      text "Seraph Lore"
      control f2 02 01 ff
      newline
      text "skill from Jinana."
      newline
      control f1 04
    endpage
  endmessage
  message TEST speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Test"
      newline
      control f1 04
    endpage
  endmessage
  message npc01_015_001_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Om Mani Padme Hm..."
      newline
      text "(Pearl of the Holy Lotus)"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Man and Woman... Yourself and others..."
      newline
      text "I finally understand the meaning"
      newline
      text "of human existence..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Discover what lies at the end"
      newline
      text "of our struggle, Seraph..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "...and feel what is truly"
      newline
      text "important."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Though I could never be like"
      newline
      text "the two of you..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I'm proud that my body could give"
      newline
      text "birth to you, Sera... my child."
      newline
      control f1 04
    endpage
  endmessage
  message npc02_015_001_01 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "All solar data is created by God"
      newline
      text "and returns to God... That's"
      newline
      text "the essence of metempsychosis."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I was so mistaken..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Seraph, please calm God's anger"
      newline
      text "and guide life along its new path."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> Obtained "
      control f2 02 05 ff
      control f2 03 01 ff
      control f2 02 01 ff
      text "."
      newline
      control f1 10
      control f2 08 ff ff
      control f1 04
    endpage
  endmessage
  message npc02_015_001_02 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "All solar data is created by God"
      newline
      text "and returns to God... That's"
      newline
      text "the essence of metempsychosis."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I was so mistaken..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Seraph, please calm God's anger"
      newline
      text "and guide life along its new path."
      newline
      control f1 04
    endpage
  endmessage
  message npc03_015_001_01 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I should thank you..."
      newline
      text "Thank you, for saving Jenna's soul."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> Obtained "
      control f2 02 05 ff
      control f2 03 01 ff
      control f2 02 01 ff
      text "."
      newline
      control f1 10
      control f2 08 ff ff
      control f1 04
    endpage
  endmessage
  message npc03_015_001_02 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I should thank you..."
      newline
      text "Thank you, for saving Jenna's soul."
      newline
      control f1 04
    endpage
  endmessage
  message npc04_015_001_01 speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "It's been a while, fellow members"
      newline
      text "of the Embryon."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Thank you for guiding Fred and Roland."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I hope that my power will aid you"
      newline
      text "now, in your time of great need."
      newline
      control f1 04
    endpage
  endmessage
  message npc05_015_001_01 speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Tears cried for others..."
      newline
      text "Sadness felt on another's behalf"
      newline
      text "is the only way to overcome strife..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Argilla..."
      newline
      text "Did I make the right choice?"
      newline
      control f1 04
    endpage
  endmessage
  message gale_015_001_01a speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The solar data of the fallen returns"
      newline
      text "to God."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I was able to comprehend"
      newline
      text "metempsychosis once I felt David's"
      newline
      text "consciousness within me."
      newline
      control f1 04
    endpage
  endmessage
  message gale_015_001_01b speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "However, I never thought I would"
      newline
      text "encounter you in such a form..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "The data of all things travels"
      newline
      text "endlessly between here and earth,"
      newline
      text "in a cycle of reincarnation."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "The fact that you two were able to"
      newline
      text "become one seems to signify"
      newline
      text "something outside of that cycle..."
      newline
      control f1 04
    endpage
  endmessage
  message gale_015_001_01c speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Let us ascertain the meaning of this,"
      newline
      text "Sera... Serph..."
      newline
      control f1 04
    endpage
  endmessage
  message aljira_015_001_01a speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I'm glad we got to see each other"
      newline
      text "again, Serph... Sera..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Serph, I asked you a question"
      newline
      text "back in the Junkyard..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I asked you why any of us"
      newline
      text "were alive..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Seeing you two together, I think"
      newline
      text "I'm starting to understand."
      newline
      control f1 04
    endpage
  endmessage
  message aljira_015_001_01b speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I owe you so much..."
      newline
      text "Thank you."
      newline
      control f1 04
    endpage
  endmessage
  message heat_015_002_01a speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Heh..."
      newline
      text "I guess you do belong together..."
      newline
      control f1 04
    endpage
  endmessage
  message heat_015_002_01b speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Go on, Sera... Serph..."
      newline
      control f1 04
    endpage
  endmessage
  message roald_015_002_01a speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "It's about time the Embryon got"
      newline
      text "back together again..."
      newline
      control f1 04
    endpage
  endmessage
  message roald_015_002_01b speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I'm actually kinda tired..."
      newline
      text "I think I'll just stay back and"
      newline
      text "cheer you on from here."
      newline
      control f1 04
    endpage
  endmessage
  message npc03_015_002_01 speaker=9
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "This is the shop."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "The shop's wherever I decide it is."
      newline
      text "Yeah, even if I'm dead..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "This is serious business, remember"
      newline
      text "that."
      newline
      control f1 04
    endpage
  endmessage
  message npc04_015_002_01 speaker=10
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "It's good to see you, but I wish"
      newline
      text "my husband and I were in better"
      newline
      text "condition..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "If I knew this was going to happen,"
      newline
      text "I would have spent more time with"
      newline
      text "my daughter... *sob*"
      newline
      control f1 04
    endpage
  endmessage
  message ciero_015_002_01a speaker=11
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Man, did you see my awesome"
      newline
      text "death scene?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "...It's kind of embarrassing to"
      newline
      text "see you guys so soon after, though."
      newline
      control f1 04
    endpage
  endmessage
  message ciero_015_002_01b speaker=11
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Maybe if I fired dat laser from"
      newline
      text "my mouth like before, I could've"
      newline
      text "survived a bit longer..."
      newline
      control f1 04
    endpage
  endmessage
  message ciero_015_002_01c speaker=11
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Oh well!"
      newline
      text "It's still good to see"
      newline
      text "everyone again, ja?"
      newline
      control f1 04
    endpage
  endmessage
  message heat_IN_015_002_01a speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I'm glad you paid attention to"
      newline
      text "the last thing I said."
      newline
      control f1 04
    endpage
  endmessage
  message heat_IN_015_002_01b speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I never wanted you guys to get this"
      newline
      text "close, though..."
      newline
      text "At least you're kind of cute, I guess."
      newline
      control f1 04
    endpage
  endmessage
  message heat_IN_015_002_01c speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Don't worry, Sera."
      newline
      text "I won't hurt you, anymore."
      newline
      control f1 04
    endpage
  endmessage
  message roald_IN_015_002_01a speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I normally wouldn't get involved,"
      newline
      text "but I can take Heat's place just"
      newline
      text "this once..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "If we can change the earth back to"
      newline
      text "normal, Fred should be able to"
      newline
      text "take it from there."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "He's a great kid..."
      newline
      text "...way more responsible than me."
      newline
      control f1 04
    endpage
  endmessage
  message roald_IN_015_002_01b speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I'm sure Fred's new world will have"
      newline
      text "far fewer mistakes than ours."
      newline
      control f1 04
    endpage
  endmessage
  message EXITWARP speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Leave the area?"
      newline
      control f1 04
    endpage
  endmessage
  select EXITWARP_SEL
    option
      control f2 08 ff ff
      text "Yes."
    endoption
    option
      control f2 08 ff ff
      text "No."
