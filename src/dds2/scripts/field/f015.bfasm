    result = READ_SECONDARY_WORLD_ID_VALUE(string(str_01move_01))
    push result
    COMM 0x006b
    WAIT_FOR_TIMER_LIMIT(30)
    SCREEN_FADE_B(1, 30)
    WAIT_FOR_TIMER_LIMIT(30)
    push 102
    COMM 0x020f
    return
    goto _269
  _269:
    WAIT_FOR_TIMER_START()
  }
