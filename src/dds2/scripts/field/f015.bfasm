  message npc03_015_001_01 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I should thank you..."
      newline
      text "Thank you, for saving Jenna's soul."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> Obtained "
      control f2 02 05 ff
      control f2 03 01 ff
      control f2 02 01 ff
