messages msg1
  message PARTY_IN_HEAT speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Argilla, Cielo, Gale, and Heat"
      newline
      text "joined the party."
      newline
      control f1 04
    endpage
  endmessage
  message PARTY_IN_ROALD speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Argilla, Cielo, Gale, and Roland"
      newline
      text "joined the party."
      newline
      control f1 04
    endpage
  endmessage
  message ANGELS_SKILL speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Seraph received the "
      control f2 02 05 ff
      text "Reincarnate"
      control f2 02 01 ff
      newline
      text "skill from Angel."
      newline
      control f1 04
    endpage
  endmessage
  message LOOPAS_SKILL speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Gale received the "
      control f2 02 05 ff
