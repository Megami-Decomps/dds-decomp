  message FLD_ICE_BREAK speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Destroy it?"
      newline
      control f1 04
    endpage
  endmessage
  select FLD_ICE_BREAK_SEL
    option
      control f2 08 ff ff
      text "Yes."
    endoption
    option
      control f2 08 ff ff
      text "No."
    endoption
  endselect
  speaker 0
