messages msg1
  message PARTY_IN_HEAT speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Argilla, Cielo, Gale, and Heat"
      newline
      text "joined the party."
      newline
      control f1 04
    endpage
  endmessage
  message PARTY_IN_ROALD speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Argilla, Cielo, Gale, and Roland"
      newline
      text "joined the party."
      newline
      control f1 04
    endpage
  endmessage
  message ANGELS_SKILL speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Seraph received the "
      control f2 02 05 ff
      text "Reincarnate"
      control f2 02 01 ff
      newline
      text "skill from Angel."
      newline
      control f1 04
    endpage
  endmessage
  message LOOPAS_SKILL speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Gale received the "
      control f2 02 05 ff
      text "Pyriphlegethon"
      control f2 02 01 ff
      newline
      text "skill from Lupa."
      newline
      control f1 04
    endpage
  endmessage
  message JINANAS_SKILL speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Argilla received the "
      control f2 02 05 ff
      text "Seraph Lore"
      control f2 02 01 ff
      newline
      text "skill from Jinana."
      newline
      control f1 04
    endpage
  endmessage
  message TEST speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Test"
      newline
      control f1 04
    endpage
  endmessage
  message npc01_015_001_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Om Mani Padme Hm..."
      newline
      text "(Pearl of the Holy Lotus)"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Man and Woman... Yourself and others..."
      newline
      text "I finally understand the meaning"
      newline
      text "of human existence..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Discover what lies at the end"
      newline
      text "of our struggle, Seraph..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "...and feel what is truly"
      newline
      text "important."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Though I could never be like"
      newline
      text "the two of you..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I'm proud that my body could give"
      newline
      text "birth to you, Sera... my child."
      newline
      control f1 04
    endpage
  endmessage
  message npc02_015_001_01 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "All solar data is created by God"
      newline
      text "and returns to God... That's"
      newline
      text "the essence of metempsychosis."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I was so mistaken..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Seraph, please calm God's anger"
      newline
      text "and guide life along its new path."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> Obtained "
      control f2 02 05 ff
      control f2 03 01 ff
      control f2 02 01 ff
      text "."
      newline
      control f1 10
      control f2 08 ff ff
      control f1 04
    endpage
  endmessage
