messages msg1
  message CIERO_JOIN speaker=none
    page
      control f2 08 ff ff
      text "> Cielo joined the party."
      newline
      control f1 04
    endpage
  endmessage
  message hungry speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Serph and the party feel hungry..."
      newline
      control f1 04
    endpage
  endmessage
  message hungry02 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> They grew weak from hunger."
      newline
      control f1 04
    endpage
  endmessage
  message ALJIRA_QUESTION speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Bat and the Brutes will"
      newline
      text "probably come after Sera again."
      newline
      text "What do we do, Serph?"
      newline
      control f1 04
    endpage
  endmessage
  message GAIL_DECIDE speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I have devised a plan."
      newline
      text "It is time that we trapped them."
      newline
      control f1 04
    endpage
  endmessage
  message GAIL_DECIDE2 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The problem is how we will ensure"
      newline
      text "Sera's safety. We must also choose"
      newline
      text "an ideal location for the trap."
      newline
      control f1 04
    endpage
  endmessage
  message CIERO_LOOK speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "An ideal location?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I know de perfect place!"
      newline
      text "I noticed it from de air on de way"
      newline
      text "here."
      newline
      control f1 04
    endpage
  endmessage
  message SHIP_INFO speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> They received information on"
      newline
      text "a huge vessel's remains."
      newline
      control f1 04
    endpage
  endmessage
  message npc01_012_001_01a speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Apparently, Angel will be commanding"
      newline
      text "the pursuit unit herself."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "But don't worry... I won't let her"
      newline
      text "get anywhere near you."
      newline
      control f1 04
    endpage
  endmessage
  message npc01_012_001_01b speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Where I come from, we'd lay down our"
      newline
      text "lives if it meant saving our comrades."
      newline
      control f1 04
    endpage
  endmessage
  message npc02_012_001_01 speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "We started our assault on the facility,"
      newline
      text "but we couldn't get very far."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "The soldiers inside are putting up"
      newline
      text "quite a fight..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "They destroyed the consoles that"
      newline
      text "control the gates."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "...Our explosives couldn't even"
      newline
      text "dent those things!"
      newline
      control f1 04
    endpage
  endmessage
  message npc02_012_001_02 speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "You opened the gates?"
      newline
      text "Wow... You guys are amazing."
      newline
      control f1 04
    endpage
  endmessage
  message npc03_012_001_01 speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I tried talking to the guys inside,"
      newline
      text "but as you can see, it didn't do"
      newline
      text "much good."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Are they planning to die along"
      newline
      text "with the city!?"
      newline
      control f1 04
    endpage
  endmessage
  message npc04_012_001_01 speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I picked up a Karma Society signal,"
      newline
      text "and it sounds like Madame Margot"
      newline
      text "is dead!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "The Chief Director took over, and"
      newline
      text "she's ordered them to shutting down"
      newline
      text "the electricity."
      newline
      control f1 04
    endpage
  endmessage
  message aljira_012_002_01a speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "It looks like we'll have to use"
      newline
      text "force..."
      newline
      control f1 04
    endpage
  endmessage
  message aljira_012_002_01b speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Time to get serious."
      newline
      control f1 04
    endpage
  endmessage
  message aljira_012_002_01c speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Fred, take care of Sera."
      newline
      control f1 04
    endpage
  endmessage
  message ciero_012_002_01 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "De old lady died!?"
      newline
      text "What de heck's goin' on?"
      newline
      control f1 04
    endpage
  endmessage
  message roald_012_002_01 speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Is the Society insane!?"
      newline
      text "...Expect some company, Gale."
      newline
      control f1 04
    endpage
  endmessage
  message fred3_012_002_01 speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Leave it to me..."
      newline
      text "I'll be right behind you guys,"
      newline
      text "keeping Sera safe."
      newline
      control f1 04
    endpage
  endmessage
  message npc05_012_002_01 speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "So that's the Cyber Shaman, huh?"
      newline
      text "She doesn't look scary at all..."
      newline
      control f1 04
    endpage
  endmessage
  message sera_012_002_01 speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "......"
      newline
      control f1 04
    endpage
  endmessage
  message sera_012_002_02 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> She's unconscious."
      newline
      control f1 04
    endpage
  endmessage
  message sera_012_002_03 speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Leave it to me..."
      newline
      text "I'll be right behind you guys,"
      newline
      text "keeping Sera safe."
      newline
      control f1 04
    endpage
  endmessage
  message EXITWARP speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Leave the area?"
      newline
      control f1 04
    endpage
  endmessage
  select EXITWARP_SEL
    option
      control f2 08 ff ff
      text "Yes."
    endoption
    option
      control f2 08 ff ff
      text "No."
    endoption
  endselect
  message FLDHUNTEXITWARP speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Will you stop the Field Hunt and"
      newline
      text "leave the area?"
      newline
      control f1 04
    endpage
  endmessage
  select FLDHUNTEXITWARP_SEL
    option
      control f2 08 ff ff
      text "Yes."
    endoption
    option
      control f2 08 ff ff
      text "No."
    endoption
  endselect
  message HOSEKI speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> A strange object hovers in midair."
      newline
      text "Touch it?"
      newline
      control f1 04
    endpage
  endmessage
  select HOSEKI_SEL
    option
      control f2 08 ff ff
      text "Yes."
    endoption
    option
      control f2 08 ff ff
      text "No."
    endoption
  endselect
  message HOSEKI_NOGET speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> You decided not to touch it."
      newline
      control f1 04
    endpage
  endmessage
  message HOSEKI_GET speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Obtained "
      control f2 02 05 ff
      control f2 03 01 ff
      control f2 02 01 ff
      text " x "
      control f2 03 02 ff
      text "."
      newline
      control f1 04
    endpage
  endmessage
  message TAKARA speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> There is a box emitting light from"
      newline
      text "its panel. Open it?"
      newline
      control f1 04
    endpage
  endmessage
  select TAKARA_SEL
    option
      control f2 08 ff ff
      text "Yes."
    endoption
    option
      control f2 08 ff ff
      text "No."
    endoption
  endselect
  message TAKARA_NOGET speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> You decided not to open it."
      newline
      control f1 04
    endpage
  endmessage
  message TAKARA_STILLGET speaker=none
    page
      control f2 08 ff ff
