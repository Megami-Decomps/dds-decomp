      newline
      control f1 04
    endpage
  endmessage
  message AREA42_NPC01_01 speaker=12
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Yeeeeeeek!!"
      newline
      text "Please, don't eat me!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "*cough*"
      newline
      text "Oh, it's you, sir."
      newline
      text "Don't scare me like that."
      newline
      control f1 04
    endpage
  endmessage
  message AREA45_NPC01_01 speaker=12
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "D-Don't touch that breaker!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "He'll escape if we turn the power"
      newline
      text "back on."
      newline
      control f1 04
    endpage
  endmessage
  message AREA45_NPC01_03 speaker=12
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Remember... I tried to stop you."
      newline
      text "Don't blame me if anything bad"
      newline
      text "happens!"
      newline
      control f1 04
    endpage
  endmessage
