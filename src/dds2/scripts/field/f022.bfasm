  message npc01_022_002_01 speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "We can't hold 'em any longer..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "We have to withdraw! Now!"
      newline
      control f1 04
    endpage
  endmessage
  message npc02_022_002_01 speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Tell the guys outside that the enemy"
      newline
      text "is closing in on us..."
      newline
      control f1 04
    endpage
  endmessage
  message npc02_022_002_02 speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Tell the guys outside that the enemy"
      newline
      text "is closing in on us..."
      newline
      control f1 04
