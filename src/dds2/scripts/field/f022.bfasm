messages msg1
  select YES_NO
    option
      control f2 08 ff ff
      text "Yes."
    endoption
    option
      control f2 08 ff ff
      text "No."
    endoption
  endselect
  message DOA_OPEN1 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Go outside?"
      newline
      control f1 04
    endpage
  endmessage
  message SWT_OFF_MSG speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> The switch is off."
      newline
      control f1 04
    endpage
  endmessage
  message SWT_ON_MSG speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> The switch is already on."
      newline
      control f1 04
    endpage
  endmessage
  message SWT_R_MSG speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> The right switch is on."
      newline
      control f1 04
    endpage
  endmessage
  message SWT_L_MSG speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> The left switch is on."
      newline
      control f1 04
    endpage
  endmessage
  select OFF_ON
    option
      control f2 08 ff ff
      text "Activate the switch."
    endoption
    option
      control f2 08 ff ff
      text "Do nothing."
    endoption
  endselect
  select ON_OFF
    option
      control f2 08 ff ff
      text "Turn the switch off."
    endoption
    option
      control f2 08 ff ff
      text "Do nothing."
    endoption
  endselect
  select R_L
    option
      control f2 08 ff ff
      text "Activate the left switch."
    endoption
    option
      control f2 08 ff ff
      text "Do nothing."
    endoption
  endselect
  select L_R
    option
      control f2 08 ff ff
      text "Activate the right switch."
    endoption
    option
      control f2 08 ff ff
      text "Do nothing."
    endoption
  endselect
  message KAKUHEKI_MSG speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> The barrier is closed."
      newline
      control f1 04
    endpage
  endmessage
  message SHURIKOU_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Remember, you couldn't have gotten"
      newline
      text "through here without my hard work."
      newline
      control f1 04
    endpage
  endmessage
  message SHURIKOU_01_02 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "There's gonna be more switches"
      newline
      text "as you continue on. You need to"
      newline
      text "activate them to proceed."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "My little bro should be around here"
      newline
      text "somewhere... So just let him know"
      newline
      text "if you have any trouble."
      newline
      control f1 04
    endpage
  endmessage
  message FE01_G_STOP01 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Serph, wait."
      newline
      text "There's something up ahead."
      newline
      control f1 04
    endpage
  endmessage
  message FE01_G_STOP02 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The Karma Society..."
      newline
      control f1 04
    endpage
  endmessage
  message FE01_A_STOP01 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "How is that possible?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "The Society isn't supposed to"
      newline
      text "know about this tunnel..."
      newline
      control f1 04
    endpage
  endmessage
  message FE01_G_STOP03 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Serph, we need to alert the Lokapala"
      newline
      text "about the enemy's presence."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I'm worried about Fred, but the others"
      newline
      text "will need an escape route as well."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Let us speak with the repairman."
      newline
      control f1 04
    endpage
  endmessage
  message FE02_KARMA01 speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Whoa!! D-Damn you, Lokapala!"
      newline
      control f1 04
    endpage
  endmessage
  message FE02_KARMA02 speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "We don't know when you made this"
      newline
      text "tunnel, but you ain't getting into"
      newline
      text "Karma City!"
      newline
      control f1 04
    endpage
  endmessage
  message FE02_KARMA03 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Obtained "
      control f2 02 05 ff
      control f2 03 01 ff
      control f2 02 01 ff
      text "."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      control f2 18 01 ff
      text "> "
      control f2 03 01 ff
      text " is called a"
      newline
      control f2 02 05 ff
      text "Karma Ring"
      control f2 02 01 ff
      text ", and enhances"
      newline
      text "character stats."
      newline
      control f1 04
    endpage
  endmessage
  message FE02_KARMA04 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Obtained "
      control f2 02 05 ff
      control f2 03 01 ff
      control f2 02 01 ff
      text " and "
      newline
      control f2 02 05 ff
      control f2 03 02 ff
      control f2 02 01 ff
      text "."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      control f2 18 01 ff
      text "> These are called"
      newline
      control f2 02 05 ff
      text "Karma Rings"
      control f2 02 01 ff
      text ", and they enhance"
      newline
      text "character stats."
      newline
      control f1 04
    endpage
  endmessage
  message FE02_KARMA05 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Obtained "
      control f2 02 05 ff
      control f2 03 01 ff
      control f2 02 01 ff
      text ", "
      newline
      control f2 02 05 ff
      control f2 03 02 ff
      control f2 02 01 ff
      text ", and"
      newline
      control f2 02 05 ff
      control f2 03 03 ff
      control f2 02 01 ff
      text "!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      control f2 18 01 ff
      text "> These are called"
      newline
      control f2 02 05 ff
      text "Karma Rings"
      control f2 02 01 ff
      text ", and they enhance"
      newline
      text "character stats."
      newline
      control f1 04
    endpage
  endmessage
  message FE02_KARMA06 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Some Karma Rings give additional"
      newline
      text "bonus effects when equipped!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> To equip Karma Rings, simply"
      newline
      text "access them using the Item command"
      newline
      text "in the main menu."
      newline
      control f1 04
    endpage
  endmessage
  message FE25_G_TWOSWITCH speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I see..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "It won't open unless multiple"
      newline
      text "switches are activated."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "...This is quite a hassle."
      newline
      control f1 04
    endpage
  endmessage
  message FE03_SHURIKOU_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Back already?"
      newline
      text "Is something wrong?"
      newline
      control f1 04
    endpage
  endmessage
  message FE03_ARJIRA_01 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I can't bear the thought of those"
      newline
      text "kids being devoured."
      newline
      control f1 04
    endpage
  endmessage
  message FE03_GAIL_01 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "If you do not set up defenses,"
      newline
      text "the Society will devour everyone."
      newline
      control f1 04
    endpage
  endmessage
  message FE03_SHURIKOU_02 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Are you serious!?"
      newline
      text "Dammit!"
      newline
      control f1 04
    endpage
  endmessage
  message FE03_SHURIKOU_03 speaker=0
    page
