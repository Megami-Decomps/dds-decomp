      newline
      control f1 04
    endpage
  endmessage
  message npc03_022_011_01 speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "You wanna know why we retreated?"
      newline
      text "...Ask someone else. I don't wanna"
      newline
      text "think about it."
      newline
      control f1 04
    endpage
  endmessage
  message npc04_022_011_01 speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "We thought the repairman was back..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "So we pulled him up."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "...But, it was just the upper half"
      newline
      text "of his body... Those bastards used"
      newline
      text "him as bait!"
      newline
      control f1 04
    endpage
  endmessage
  message npc05_022_011_01 speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
