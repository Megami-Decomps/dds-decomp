messages msg1
  message NOW_CAMERA speaker=none
    page
      control f2 08 ff ff
      text "> Camera"
      control f2 03 01 ff
      newline
    endpage
  endmessage
  select CHG_CAMERA
    option
      control f2 08 ff ff
      text "> Next camera"
    endoption
    option
      control f2 08 ff ff
      text "> Previous camera"
    endoption
  endselect
  message EXITWARP speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Leave the area?"
      newline
      control f1 04
    endpage
  endmessage
  select EXITWARP_SEL
    option
