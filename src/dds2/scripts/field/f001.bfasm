        WAIT_FOR_STREAM_IDLE()
        UPDATE_FIELD_LOOK_AT_SEGMENT()
        ADD_EFFECT_UNIT_TO_WORLD(-(1))
        SCREEN_FADE_A(0, 15)
        WAIT_FOR_TIMER_LIMIT(15)
        SET_MODEL_FLAG(barrier_completion_flag)
        if (barrier_map_entry_id != -(1)) {
          ENABLE_FIELD_MAP_ENTRY(0, 0, barrier_map_entry_id)
        }
      _197:
        RELEASE_CURRENT_OBJECT()
        SET_SOLAR_OVERLAY_MODE(3)
        return
      }
    _199:
      FINISH_SCRIPT_MESSAGE_WINDOW()
      SCREEN_FADE_B(0, 10)
      WAIT_FOR_TIMER_LIMIT(10)
      UPDATE_FIELD_LOOK_AT_SEGMENT()
      ADD_EFFECT_UNIT_TO_WORLD(-(1))
      SCREEN_FADE_A(0, 10)
      WAIT_FOR_TIMER_LIMIT(10)
      RELEASE_CURRENT_OBJECT()
      SET_SOLAR_OVERLAY_MODE(3)
      goto _201
    }
  _201:
    goto _203
  _203:
    WAIT_FOR_TIMER_START()
  }
_196:
  goto _205
_205:
  return
  return
end

