  message FROST_OUT speaker=11
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "You stupid, lazy hee ho's..."
      newline
      text "You're so ignorant."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Do you heemember the number of"
      newline
      text "answers you ho'd correctly?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "If you want to hee-see me, then"
      newline
      text "get 100 questions right, and bring"
      newline
      text "the certificate, ho."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Bring some curry bread, too."
      newline
      text "Hee ho, you hear me?"
      newline
      text "Frost, hee-out!"
      newline
      control f1 04
    endpage
  endmessage
