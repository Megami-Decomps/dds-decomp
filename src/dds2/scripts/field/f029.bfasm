messages msg1
  select YES_NO
    option
      control f2 08 ff ff
      text "Yes."
    endoption
    option
      control f2 08 ff ff
      text "No."
    endoption
  endselect
  message KYOSEI_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "What is a child of man doing"
      newline
      text "wandering around up here?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Wait..."
      newline
      text "You are no longer human."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "The blood of battle is warming in"
      newline
      text "my veins... I have no choice but"
      newline
      text "to challenge you!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I hereby order you to fight."
      newline
      text "Prove your mettle, curious mortal!"
      newline
      control f1 04
    endpage
  endmessage
  message KYOSEI_02 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Wh-What am I doing here?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I was a Corporal in the Brutes..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "But, I was also born Girimehkala."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "No, I'm a knight..."
      newline
      text "On a crusade."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "There's too much solar data here."
      newline
      text "I can't maintain my self..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I need to eliminate unnecessary data."
      newline
      text "Yeah, that'll work..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "...Unnecessary solar data like you!"
      newline
      control f1 04
    endpage
  endmessage
  message KYOSEI_03 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I am called Samael,"
      newline
      text "the one who carries the burden of"
      newline
      text "God's intentions."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Man and woman are not yet to"
      newline
      text "become one."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "By God's will, your mind and body"
      newline
      text "must be split asunder once more!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Ingest once more the fruit of"
      newline
      text "knowledge, and realize your sin."
      newline
      control f1 04
    endpage
  endmessage
  message FROST_01 speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Hee hee, you really brought"
      newline
      text "the certificate, ho!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Hee-eautiful!"
      newline
      text "*clap clap*"
      newline
      text "Hee-honderful!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "But..."
      newline
      control f1 04
    endpage
  endmessage
  message FROST_02 speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I'm gonna kill you."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Why?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "...Eh, no reason!"
      newline
      control f1 04
    endpage
  endmessage
  message FROST_03 speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Life, hee..."
      newline
      text "Life, ho..."
      newline
      text "Hee ho is not fair!"
      newline
      control f1 04
    endpage
  endmessage
  message FROST_07 speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Heep ho...!"
      newline
      text "W-Wait a hee!"
      newline
      control f1 04
    endpage
  endmessage
  message FROST_08 speaker=3
    page
      control f2 08 ff ff
      text "That was just a little hee-joke!"
      newline
      text "Don't rush off... Don't be so"
      newline
      text "rude, hee ho."
      newline
      control f1 04
    endpage
  endmessage
  message FROST_09 speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Calm... Calm down, ho..."
      newline
      text "Hee... Just a joke..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "From this day forward, you and I"
      newline
      text "are hee homeboys..."
      newline
      control f1 04
    endpage
  endmessage
  message FROST_10 speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "......Psych, ho!"
      newline
      control f1 04
    endpage
  endmessage
  message FROST_11 speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Heeyonara!"
      newline
      text "Adios, amiho!"
      newline
      control f1 04
    endpage
  endmessage
  message BOSS_01 speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "OnE... oNe ThiNG..."
      newline
      text "It's eAT... OR BE eaTen..."
      newline
      control f1 04
