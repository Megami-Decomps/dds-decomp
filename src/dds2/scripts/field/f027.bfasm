      control f1 04
    endpage
  endmessage
  message FLD_BLUEICE speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> A blue wall stands in the way."
      newline
      text "You cannot pass through it."
      newline
      control f1 04
    endpage
  endmessage
  message FLD_REDICE speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> A red wall stands in the way."
      newline
      text "You cannot pass through it."
      newline
      control f1 04
    endpage
  endmessage
  message FLD_YERWICE speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> A yellow wall stands in the way."
      newline
      text "You cannot pass through it."
      newline
      control f1 04
    endpage
  endmessage
  message FLD_ICE_BREAK speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Destroy it?"
      newline
      control f1 04
    endpage
  endmessage
  select FLD_ICE_BREAK_SEL
    option
      control f2 08 ff ff
      text "Yes."
    endoption
    option
      control f2 08 ff ff
      text "No."
    endoption
  endselect
  message AYASIIKEHAI speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> A strong presence can be felt"
      newline
      text "behind the door."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> Enter the room?"
      newline
      control f1 04
    endpage
  endmessage
  select INFTEST1_SEL
    option
      control f2 08 ff ff
      text "Yes."
    endoption
    option
      control f2 08 ff ff
      text "No."
    endoption
  endselect
  message AYASIOTO speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> There's a sound coming from behind"
      newline
      text "the door."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> Enter?"
      newline
      control f1 04
    endpage
  endmessage
  message NPC_01 speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "We'll keep them busy."
      newline
      text "Hurry up and shut this place down!"
      newline
      control f1 04
    endpage
  endmessage
  message NPC_02 speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The Society pulled back for now,"
      newline
      text "but they won't be gone long."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "We'll fight 'em for as long as"
      newline
      text "it takes."
      newline
      control f1 04
    endpage
  endmessage
  message KARUMA_MAKE speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Why did we worry... about our jobs...?"
      newline
      control f1 04
    endpage
  endmessage
  message KARUMA_MAKE_DEAD speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> He is already dead."
      newline
      control f1 04
    endpage
  endmessage
  message KOTTIDESU speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I understand that you want to help"
      newline
      text "Roland."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "But, for now, we must keep moving."
      newline
      control f1 04
    endpage
  endmessage
  message TOJITERU speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> The door is locked shut."
      newline
      control f1 04
    endpage
  endmessage
  speaker 0
    text "Johnny"
  endspeaker
  speaker 1
    text "Roland"
  endspeaker
  speaker 2
    text "Karma Soldier"
  endspeaker
  speaker 3
