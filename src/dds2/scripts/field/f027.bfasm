      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Living beings have a need to"
      newline
      text "compensate for the lives that have"
      newline
      text "supported them."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
