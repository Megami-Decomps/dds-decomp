    endoption
    option
      control f2 08 ff ff
      text "We need to prepare."
    endoption
  endselect
  message SEL_NO_ROA speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I see... Well, let's hurry up."
      newline
      text "There isn't a lot of time."
      newline
      control f1 04
    endpage
  endmessage
  message SEL_YES_ROA speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Alright, let's get moving."
      newline
      control f1 04
    endpage
  endmessage
  message MODORE speaker=1
    page
      control f2 08 ff ff
