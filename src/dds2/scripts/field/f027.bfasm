      newline
      text "unavoidable, and enemies that"
      newline
      text "must be defeated..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "...and one day, we ourselves"
      newline
      text "may all be defeated."
      newline
      control f1 04
    endpage
  endmessage
