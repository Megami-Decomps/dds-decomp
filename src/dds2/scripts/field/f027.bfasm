  message BATTLEDOOR_OPEN speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> The partition was destroyed!"
      newline
      control f1 04
    endpage
  endmessage
  message ATTIGA_KOTTIGA speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Dammit!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "The two partitions seem to be"
      newline
      text "connected."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "When I open the one in the front,"
      newline
      text "the back one closes."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "...And same thing the other way;"
      newline
      text "what a pain in the ass."
      newline
      control f1 04
    endpage
  endmessage
  message ARUJI_MODOTTEKITA speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Huh? We're back where we started."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "How are we supposed to make any"
      newline
      text "progress?"
      newline
      control f1 04
    endpage
  endmessage
  message SOTTIDEGUTI speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Hey, that's the exit."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "We're supposed to be going to"
      newline
      text "the control room."
      newline
      control f1 04
    endpage
  endmessage
  message KARUMA_LAST_01 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Wait!"
      newline
      control f1 04
    endpage
  endmessage
  message KARUMA_LAST_02 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "We can't allow you to pass."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Now you'll see what guards are"
      newline
      text "really made of!"
      newline
      control f1 04
    endpage
  endmessage
