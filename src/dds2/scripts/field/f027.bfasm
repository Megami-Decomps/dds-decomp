messages msg1
  message gyousyounin speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "This is the shop."
      newline
      text "Wherever I set up shop, that's where"
      newline
      text "the shop is, got it?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "This is serious business--remember"
      newline
      text "that."
      newline
      control f1 04
    endpage
  endmessage
  message ROARUDO_KAKUNI speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "This is our first line of defense,"
      newline
      text "Gale."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "If the Lokapala can't hold the enemy"
      newline
      text "back, they'll slowly withdraw."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "While they delay the enemy,"
      newline
      text "we'll head to the control room."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "It's crawling with demons in there."
      newline
      text "Once we go in, there's no turning"
      newline
      text "back."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Are you ready?"
      newline
      control f1 04
    endpage
  endmessage
  message ROARUDO_KAKUNI_HUTA speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "It's crawling with demons in there."
      newline
      text "Once we go in, there's no turning"
