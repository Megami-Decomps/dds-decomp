  message gale_027_054_01_ans1a speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Very well."
      newline
      text "You will lead the Embryon."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Sera..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
