  endmessage
  message KAKUHEKI_AYASI speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> A strong presence can be felt"
      newline
      text "from the other side."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> Open the door?"
      newline
