      control f1 04
    endpage
  endmessage
  message aljira_027_054_01a speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I had so many questions..."
      newline
      text "But, they don't really matter"
      newline
      text "anymore."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I'm myself, now."
      newline
      text "I can make my own decisions."
      newline
      control f1 04
    endpage
  endmessage
  message aljira_027_054_01b speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Good luck, Sera..."
      newline
      control f1 04
    endpage
  endmessage
  message gale_027_054_01 speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Sera, does your life mean anything?"
      newline
      control f1 04
    endpage
  endmessage
  select gale_027_054_01_SEL
    option
      control f2 08 ff ff
      text "...What do you mean, Gale?"
    endoption
    option
      control f2 08 ff ff
      text "I don't know... but I'm ready."
    endoption
  endselect
  message gale_027_054_01_ans0 speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "There are many lives supporting you."
      newline
      text "I believe there is meaning in that."
      newline
      control f1 04
    endpage
  endmessage
  message gale_027_054_01_ans1a speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Very well."
      newline
      text "You will lead the Embryon."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Sera..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I'll tell you one thing that I was able to"
      newline
      text "comprehend..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Lives link to one another,"
      newline
      text "and the world continues."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Living beings have a need to"
      newline
      text "compensate for the lives that have"
      newline
      text "supported them."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "There are fights that prove"
      newline
      text "unavoidable, and enemies that"
      newline
      text "must be defeated..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "...and one day, we ourselves"
      newline
      text "may all be defeated."
      newline
      control f1 04
    endpage
  endmessage
  message gale_027_054_01_ans1b speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "But, you mustn't hate anyone."
      newline
      text "...Not even yourself."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "If you can do that, something will"
      newline
      text "change... And only you can find out"
      newline
      text "what that is."
      newline
      control f1 04
    endpage
  endmessage
  message ciero_027_054_01a speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Welcome back, Sera."
      newline
      control f1 04
    endpage
  endmessage
  message ciero_027_054_01b speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I had a lot to tell you..."
      newline
      text "But, now dat you're here, I can't"
      newline
      text "think of anything."
      newline
      control f1 04
    endpage
  endmessage
  message fred_027_054_01a speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I don't really know what to say,"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "but I'll tell you this..."
      newline
      control f1 04
    endpage
  endmessage
  message fred_027_054_01b speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Try your best."
      newline
      control f1 04
    endpage
  endmessage
