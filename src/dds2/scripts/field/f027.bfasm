      control f2 08 ff ff
      control f2 07 07 ff
      text "What the hell are you guys doing?"
      newline
      control f1 04
    endpage
  endmessage
  message KARUMA_BUKKOWASI_02 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "It's too late..."
      newline
      text "And, you're about to die, anyway!"
      newline
      control f1 04
    endpage
  endmessage
