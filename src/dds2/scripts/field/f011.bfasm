messages msg1
  message DONT_GO_BACK speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "There's nothing we can do, now."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "We need to go to the power plant."
      newline
      control f1 04
    endpage
  endmessage
  message BROKEN_GYRO speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> It was shot down."
      newline
      text "It doesn't seem operational."
      newline
      control f1 04
    endpage
  endmessage
  message PARTY_OUT speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Serph left the party."
      newline
      control f1 04
    endpage
  endmessage
  message PARTY_IN speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Serph joined the party."
      newline
      control f1 04
    endpage
  endmessage
  message aljira_011_001_01a speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Heat, Sera..."
      newline
      control f1 04
    endpage
  endmessage
  message aljira_011_001_01b speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "What's the real reason that"
      newline
      text "we were created, anyway...?"
      newline
      control f1 04
    endpage
  endmessage
  message gale_011_001_01a speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Are those your true feelings, Jenna..."
      newline
      text "...Angel?"
      newline
      control f1 04
    endpage
  endmessage
  message gale_011_001_01b speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "...Who is... David?"
      newline
      control f1 04
    endpage
  endmessage
  message ciero_011_001_01a speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "De sky's blue like de ocean..."
      newline
      text "We all be laughin'..."
      newline
      text "Nobody's killing each other..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I think dat's how we all pictured"
      newline
      text "Nirvana would be."
      newline
      control f1 04
    endpage
  endmessage
  message ciero_011_001_01b speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "How'd it turn out like dis?"
      newline
      control f1 04
    endpage
  endmessage
  message roald_011_001_01a speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I don't want extreme order, or"
      newline
      text "extreme chaos..."
      newline
      text "I prefer walking the middle ground."
      newline
      control f1 04
    endpage
  endmessage
  message roald_011_001_01b speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Let's find Sera."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Humanity's karma is too great for"
      newline
      text "one person to bear alone..."
      newline
      control f1 04
    endpage
  endmessage
  message npc05_011_001_01 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> He put up a good fight..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> ...But now he's dead."
      newline
      control f1 04
    endpage
  endmessage
  message aljira2_011_002_01a speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I know what you're going to say..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "\"What would Serph do?\""
      newline
      control f1 04
    endpage
  endmessage
  message aljira2_011_002_01b speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I know that, but..."
      newline
      control f1 04
    endpage
  endmessage
  message ciero_011_002_01 speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I bet Sera was so happy to see Serph"
      newline
      text "again... And den..."
      newline
      control f1 04
    endpage
  endmessage
  message roald_011_002_01a speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "There're too many electronics for"
      newline
      text "it to run solely on backup power."
      newline
      control f1 04
    endpage
  endmessage
  message roald_011_002_01b speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "If we blow the power plant, that should"
      newline
      text "be enough to stop the transmission."
      newline
      control f1 04
    endpage
  endmessage
  message fred_011_002_01 speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Be proud of your emotions, Gale..."
      newline
      text "...right?"
      newline
      control f1 04
    endpage
  endmessage
  message npc05_011_002_01 speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I hear he died..."
      newline
      text "...I was pretty harsh before."
      newline
      text "I'm sorry."
      newline
      control f1 04
    endpage
  endmessage
  message npc06_011_002_01 speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "It's easy to say that you stand"
      newline
      text "for something, but now it's time"
      newline
      text "to put our lives on the line."
      newline
      control f1 04
    endpage
  endmessage
  message sera_011_003_01a speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "......"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "The Nirvana everyone imagined"
      newline
      text "was a world I created before"
      newline
      text "the Junkyard..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I created friends using the images"
      newline
      text "of people who I knew and cared about."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "They told me to erase everyone when"
      newline
      text "I created the Junkyard... But, I couldn't"
      newline
      text "do it."
      newline
      control f1 04
    endpage
  endmessage
  message sera_011_003_01b speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I'm sorry Heat..."
      newline
      text "I'm sorry Argilla..."
      newline
      text "...everyone..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "It's cruel, isn't it...?"
      newline
      text "You can blame me..."
      newline
      control f1 04
    endpage
  endmessage
  message gale_011_003_01a speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Nobody bears a grudge against"
      newline
      text "you, Sera."
      newline
      control f1 04
    endpage
  endmessage
  message gale_011_003_01b speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "You can stop God..."
      newline
      text "You can give us light."
      newline
      control f1 04
    endpage
  endmessage
  message gale_011_003_02a speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "So the Junkyard was the remains of"
      newline
      text "Sera's dream..."
      newline
      control f1 04
    endpage
  endmessage
  message gale_011_003_02b speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Varin was correct... but in a way,"
      newline
      text "also mistaken."
      newline
      control f1 04
    endpage
  endmessage
  message ciero_011_003_01a speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "It's hard not to worry about"
      newline
      text "Heat and Serph..."
      newline
      control f1 04
    endpage
  endmessage
  message ciero_011_003_01b speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "But, right now, we need to worry"
      newline
      text "about stopping dat thing!"
      newline
      control f1 04
    endpage
  endmessage
  message ciero_011_003_02a speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "It's okay, Sera..."
      newline
      control f1 04
    endpage
  endmessage
  message ciero_011_003_02b speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "It might have started out like dat,"
      newline
      text "but now we're just ourselves, ja?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Heat and Argilla chose deir own"
      newline
      text "paths..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Just like us."
      newline
      control f1 04
    endpage
  endmessage
  message fred_011_003_01 speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I'll keep an eye on the Society people"
      newline
      text "from here. Good luck."
      newline
      control f1 04
    endpage
  endmessage
  message fred_011_003_02 speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I can't believe you were modeled"
      newline
      text "after such a sleaze bag..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "But, Sera was just a kid then--"
      newline
      text "well, she's still a kid, right?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "It just proves that you can't"
      newline
      text "trust adults..."
      newline
      control f1 04
    endpage
  endmessage
  message KENKYUIN_011_003_01a speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
