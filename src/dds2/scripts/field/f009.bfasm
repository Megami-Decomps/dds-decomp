      control f1 04
    endpage
  endmessage
  message ciero_009_003_02a speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "While you were gone, Argilla and"
      newline
      text "Roland died, bro..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I feel sad..."
      newline
      control f1 04
    endpage
  endmessage
  message ciero_009_003_02b speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "...But, it kinda feels like dey're"
      newline
      text "not really gone."
      newline
      control f1 04
    endpage
  endmessage
  message fred_009_003_01 speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Roland... Argilla..."
      newline
      control f1 04
    endpage
  endmessage
  message fred_009_003_02 speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Once someone dies, that's it."
      newline
      text "It's stupid to hope for more."
      newline
      control f1 04
    endpage
  endmessage
  message npc05_009_003_01 speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The world's going to disappear"
      newline
      text "at sunrise...? Wh-What could cause"
      newline
      text "something like that!?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Th-There's... There's nowhere"
