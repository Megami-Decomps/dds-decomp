  message sera_009_003_01 speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I'm fine..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I could feel everyone's solar data"
      newline
      text "stabbing into me..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "But, something is still missing."
      newline
      control f1 04
    endpage
  endmessage
  message gale_009_003_01 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Remember what you see here..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "That fire is the light of life,"
      newline
      text "which we must carry on."
      newline
      control f1 04
    endpage
  endmessage
  message gale_009_003_02a speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Argilla once asked you what it meant"
      newline
      text "to live."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I would also wonder what it means"
      newline
      text "to die."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Is simply existing considered life?"
      newline
      text "In that case, would disappearing"
      newline
      text "be considered death?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Is life really nothing more than"
      newline
      text "data--words with representations?"
      newline
      control f1 04
    endpage
  endmessage
  message gale_009_003_02b speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Then, what have we been living for?"
      newline
      control f1 04
    endpage
  endmessage
  message ciero_009_003_01a speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Come on..."
      newline
      control f1 04
    endpage
  endmessage
  message ciero_009_003_01b speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
