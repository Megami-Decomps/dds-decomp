      text "we can go!"
      newline
      control f1 04
    endpage
  endmessage
  message npc06_009_003_01 speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "How can we escape the sun itself?"
      newline
      text "It sees everything!"
      newline
      control f1 04
    endpage
  endmessage
  message npc06_009_003_02 speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Nobody ever told us what to do"
      newline
      text "in this type of situation..."
