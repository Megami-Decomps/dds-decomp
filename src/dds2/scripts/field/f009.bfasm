messages msg1
  message hungry speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> The party was hungry."
      newline
      control f1 04
    endpage
  endmessage
  message hungry02 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> The party grew weak from hunger."
      newline
      control f1 04
    endpage
  endmessage
  message aljira_009_001_01a speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "This is Nirvana?"
      newline
      control f1 04
    endpage
  endmessage
  message aljira_009_001_01b speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "This isn't the paradise I wanted"
      newline
      text "to see with Jinana!"
      newline
      control f1 04
    endpage
  endmessage
  message aljira_009_001_02a speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Wherever we go, there's always"
      newline
      text "fighting... Is that part of"
      newline
      text "being alive?"
      newline
      control f1 04
    endpage
  endmessage
  message aljira_009_001_02b speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "But then, why do we protect our"
      newline
      text "comrades, or fall in love?"
      newline
      control f1 04
    endpage
  endmessage
  message gale_009_001_01a speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Humans pillage the environment,"
      newline
      text "ignore reality, and degenerate"
      newline
      text "themselves..."
      newline
      control f1 04
    endpage
  endmessage
  message gale_009_001_01b speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "They are irredeemable."
      newline
      control f1 04
    endpage
  endmessage
  message gale_009_001_02a speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "So, these are the true results"
      newline
      text "of a supervised paradise."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "The general public becomes easily"
      newline
      text "influenced as their ability to think"
      newline
      text "is suspended."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Any sublime ideals fade, and"
      newline
      text "individual conscience is erased"
      newline
      text "to alleviate feelings of guilt."
      newline
      control f1 04
    endpage
  endmessage
  message gale_009_001_02b speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I can understand your goal, Jenna,"
      newline
      text "but that is too cruel..."
      newline
      control f1 04
    endpage
  endmessage
  message ciero_009_001_01 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "'ey brudda, isn't dis thing called"
      newline
      text "a tree? I never seen one before..."
      newline
      control f1 04
    endpage
  endmessage
  message ciero_009_001_02a speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "No way deir plan can work!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Dey're turning people into demons,"
      newline
      text "but dey don't even have enough"
      newline
      text "food for 'em!?"
      newline
      control f1 04
    endpage
  endmessage
  message ciero_009_001_02b speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Dat old woman must be senile, ja?"
      newline
      control f1 04
    endpage
  endmessage
  message roald_009_001_01a speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Most of the world's plants"
      newline
      text "have died."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Carbon dioxide is starting to build up,"
      newline
      text "since there isn't any greenery to"
      newline
      text "convert it."
      newline
      control f1 04
    endpage
  endmessage
  message roald_009_001_01b speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Pretty soon, we won't be able to"
      newline
      text "live outside anymore."
      newline
      control f1 04
    endpage
  endmessage
  message roald_009_001_02a speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Humans don't admit their mistakes"
      newline
      text "that easily..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "...The longer they've lived,"
      newline
      text "the harder it gets."
      newline
      control f1 04
    endpage
  endmessage
  message roald_009_001_02b speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I'm sure Madame Cuvier knows"
      newline
      text "the consequences; she just chooses"
      newline
      text "to ignore them."
      newline
      control f1 04
    endpage
  endmessage
  message npc05_009_001_01 speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The Technical Director started"
      newline
      text "a rebellion!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Not only that, but the prisoners"
      newline
      text "have risen to action as well!"
      newline
      text "What's going to happen next?"
      newline
      control f1 04
    endpage
  endmessage
  message npc06_009_001_01 speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Madame and the Director even have"
      newline
      text "different names for Atma users--"
      newline
      text "Avatar Tuners or Those Who Devour."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I think I'll side with whoever"
      newline
      text "uses cooler sounding words."
      newline
      control f1 04
    endpage
  endmessage
  message npc07_009_001_01 speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I heard the Society is working on"
      newline
      text "a way to restructure the human genome"
      newline
      text "so we can live outside."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Humanity has overcome so many"
      newline
      text "obstacles throughout history, we"
      newline
      text "can't let the sun beat us."
      newline
      control f1 04
    endpage
  endmessage
  message npc07_009_001_02 speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The Nirvana Plan? That must be"
      newline
      text "some kind of joke... There's no"
      newline
      text "reason to make us all suffer."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "As long as we can control God,"
      newline
      text "there shouldn't be any problem."
      newline
      control f1 04
    endpage
  endmessage
  message npc08_009_001_01a speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "We made it past the competition..."
      newline
      text "Living here is our right!"
      newline
      control f1 04
    endpage
  endmessage
  message npc08_009_001_01b speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Good thing we made an effort to learn. "
      newline
      control f1 04
    endpage
  endmessage
  message npc08_009_001_02a speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "We never should have started"
      newline
      text "letting outsiders in... This was"
      newline
      text "one of humanity's last sanctuaries!"
      newline
      control f1 04
    endpage
  endmessage
  message npc08_009_001_02b speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "What the hell are those Society"
      newline
      text "morons thinking?"
      newline
      control f1 04
    endpage
  endmessage
  message npc09_009_001_01 speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "This is the only city left that"
      newline
      text "still has real, living plants."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Foliage is a luxury only the elite few"
      newline
      text "can enjoy."
      newline
      control f1 04
    endpage
  endmessage
  message npc09_009_001_02a speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I bet the Lokapala are here"
      newline
      text "to steal our tree..."
      newline
      control f1 04
    endpage
  endmessage
  message npc09_009_001_02b speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "If that's what they're here for,"
      newline
      text "then I'll fight 'em off myself!"
      newline
      control f1 04
    endpage
  endmessage
  message npc10_009_001_01 speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I feel sorry for the people outside"
      newline
      text "who lost their lives..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "...But there's nothing I can do."
      newline
      control f1 04
    endpage
  endmessage
  message npc10_009_001_02_01 speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "James..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Are you angry that I chose to live"
      newline
      text "in the city, while you remained"
      newline
      text "an outsider...?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Did I... do the right thing?"
      newline
      control f1 04
    endpage
  endmessage
  message npc10_009_001_02_02a speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Yes, my name is Amelia..."
      newline
      text "How did you know my name?"
      newline
      control f1 04
    endpage
  endmessage
  message npc10_009_001_02_02b speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "He... He said, \"Please be happy?\""
      newline
      control f1 04
    endpage
  endmessage
  message npc10_009_001_02_02c speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "James..."
      newline
      text "...Thank you, James."
      newline
      control f2 14 1a 01
    endpage
  endmessage
  message npc10_009_001_02_03 speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I don't know who you are, but"
      newline
      text "thank you..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> Obtained "
      control f2 02 05 ff
      control f2 03 01 ff
      control f2 02 01 ff
      text "."
      newline
      control f1 10
      control f2 08 ff ff
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I'm going to leave this city, and"
      newline
      text "try to find happiness."
      newline
      control f1 04
    endpage
  endmessage
  message npc10_009_001_02_04 speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I'm leaving this city, like I"
      newline
      text "should have done long ago."
      newline
      control f1 04
    endpage
  endmessage
  message npc10_009_001_03 speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "James..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Are you angry that I chose to live"
      newline
      text "in the city, while you remained"
      newline
      text "an outsider...?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Did I... do the right thing?"
      newline
      control f1 04
    endpage
  endmessage
  message npc11_009_001_01 speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The dome makes life very convenient."
      newline
      text "I'm not afraid of the sun at all"
      newline
      text "anymore."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "We can sunbathe, take walks through"
      newline
      text "the woods... This is definitely"
      newline
      text "the ultimate paradise."
      newline
      control f1 04
    endpage
  endmessage
  message aljira2_009_002_01a speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I'm starting to feel sorry for them..."
      newline
      control f1 04
    endpage
  endmessage
  message aljira2_009_002_01b speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Don't tell me you're enjoying it."
      newline
      control f1 04
    endpage
  endmessage
  message ciero_009_002_01 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "De world's gonna end!"
      newline
      text "Don't you all get it?"
      newline
      text "C'mon!"
      newline
      control f1 04
    endpage
  endmessage
  message roald_009_002_01a speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I suppose you could scare civilians"
      newline
      text "and then use their confusion as"
      newline
      text "a tactical diversion..."
      newline
      control f1 04
    endpage
  endmessage
  message roald_009_002_01b speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "That's what you were going for,"
      newline
      text "right Gale?"
      newline
      control f1 04
    endpage
  endmessage
  message fred_009_002_01 speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Is it wrong to think this is funny?"
      newline
      control f1 04
    endpage
  endmessage
  message npc05_009_002_01 speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The world's going to disappear"
      newline
      text "at sunrise...? Wh-What could cause"
      newline
      text "something like that!?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Th-There's... There's nowhere"
      newline
      text "we can go!"
      newline
      control f1 04
    endpage
  endmessage
  message npc06_009_002_01 speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "How can we escape the sun itself?"
      newline
      text "It sees everything!"
      newline
      control f1 04
    endpage
  endmessage
  message npc07_009_002_01a speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I have to grab what's important"
      newline
      text "and get out of here..."
      newline
      control f1 04
    endpage
  endmessage
  message npc07_009_002_01b speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Yeah! The tree!"
      newline
      text "I gotta save the tree!"
      newline
      control f1 04
    endpage
  endmessage
  message npc08_009_002_01 speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "They said the dome would save us!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Paradise my ass... I'm gonna sue!"
      newline
      control f1 04
    endpage
  endmessage
  message sera_009_003_01 speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I'm fine..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I could feel everyone's solar data"
      newline
      text "stabbing into me..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "But, something is still missing."
      newline
      control f1 04
    endpage
  endmessage
  message gale_009_003_01 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Remember what you see here..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "That fire is the light of life,"
      newline
      text "which we must carry on."
      newline
      control f1 04
    endpage
  endmessage
  message gale_009_003_02a speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Argilla once asked you what it meant"
      newline
      text "to live."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I would also wonder what it means"
      newline
      text "to die."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Is simply existing considered life?"
      newline
      text "In that case, would disappearing"
      newline
      text "be considered death?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Is life really nothing more than"
      newline
      text "data--words with representations?"
      newline
      control f1 04
    endpage
  endmessage
  message gale_009_003_02b speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Then, what have we been living for?"
      newline
      control f1 04
    endpage
  endmessage
  message ciero_009_003_01a speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Come on..."
      newline
      control f1 04
    endpage
  endmessage
  message ciero_009_003_01b speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Someone has to put an end"
      newline
      text "to dis, ja?"
      newline
      control f1 04
    endpage
  endmessage
  message ciero_009_003_02a speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "While you were gone, Argilla and"
      newline
      text "Roland died, bro..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I feel sad..."
      newline
      control f1 04
    endpage
  endmessage
  message ciero_009_003_02b speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "...But, it kinda feels like dey're"
      newline
      text "not really gone."
      newline
      control f1 04
    endpage
  endmessage
  message fred_009_003_01 speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Roland... Argilla..."
      newline
      control f1 04
    endpage
  endmessage
  message fred_009_003_02 speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Once someone dies, that's it."
      newline
      text "It's stupid to hope for more."
      newline
      control f1 04
    endpage
  endmessage
  message npc05_009_003_01 speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The world's going to disappear"
      newline
      text "at sunrise...? Wh-What could cause"
      newline
      text "something like that!?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Th-There's... There's nowhere"
      newline
      text "we can go!"
      newline
      control f1 04
    endpage
  endmessage
  message npc06_009_003_01 speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "How can we escape the sun itself?"
      newline
      text "It sees everything!"
      newline
      control f1 04
    endpage
  endmessage
  message npc06_009_003_02 speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Nobody ever told us what to do"
      newline
      text "in this type of situation..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I blame the educational system!"
      newline
      control f1 04
    endpage
  endmessage
  message npc07_009_003_01a speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Oh my god... The power plant!"
      newline
      text "Without that, we're doomed!"
      newline
      control f1 04
    endpage
  endmessage
  message npc07_009_003_01b speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "W-Wait, I know! I'll burn the tree!"
      newline
      text "Ha ha, yeah! Fire is the symbol"
      newline
      text "of civilization!"
      newline
      control f1 04
    endpage
  endmessage
  message npc07_009_003_02 speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I was gonna burn this tree, but..."
      newline
      text "No matter how hard I scrape, it just"
      newline
      text "won't light..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I wish I'd gone camping as a kid..."
      newline
      control f1 04
    endpage
  endmessage
  message npc08_009_003_01 speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "What's that, some kinda crater?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I am SO going to sue!"
      newline
      control f1 04
    endpage
  endmessage
  message npc08_009_003_02a speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I'd never lower myself to such"
      newline
      text "a primitive level."
      newline
      control f1 04
    endpage
  endmessage
  message npc08_009_003_02b speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I'm refined!"
      newline
      control f1 04
    endpage
  endmessage
  message npc09_009_003_01a speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I can't believe how helpless we"
      newline
      text "are without electricity..."
      newline
      control f1 04
    endpage
  endmessage
  message npc09_009_003_01b speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I used to think I could take care"
      newline
      text "of myself, but I can't really do"
      newline
      text "much of anything."
      newline
      control f1 04
    endpage
  endmessage
