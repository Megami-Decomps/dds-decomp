      control f1 04
    endpage
  endmessage
  message npc10_009_001_03 speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "James..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Are you angry that I chose to live"
      newline
      text "in the city, while you remained"
