  endmessage
  message TAKARA_GET2 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Obtained "
      control f2 02 05 ff
      control f2 03 01 ff
      control f2 02 01 ff
      text " x "
      control f2 03 02 ff
      text "."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> Plants are very rare in this world."
      newline
      text "They can be traded in at MAD MART for"
      newline
      text "money."
      newline
      control f1 04
    endpage
  endmessage
  message SUN_TAKARA speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
