messages msg1
  message BIG_MAP speaker=none
    page
      control f2 08 ff ff
      text "> Which area would you like to go to?"
      newline
    endpage
  endmessage
  select BIG_MAP_SEL
    option
      control f2 08 ff ff
      text "> Muladhara"
    endoption
    option
      control f2 08 ff ff
      text "> Svadisthana"
    endoption
    option
      control f2 08 ff ff
      text "> Ajnu"
    endoption
    option
      control f2 08 ff ff
      text "> After the battle"
    endoption
    option
      control f2 08 ff ff
      text "> Manipura"
    endoption
    option
      control f2 08 ff ff
      text "> Next page "
    endoption
  endselect
  select BIG_MAP_SEL2
    option
      control f2 08 ff ff
      text "> Previous page"
    endoption
    option
      control f2 08 ff ff
      text "> Muladhara (underground layer)"
    endoption
    option
      control f2 08 ff ff
      text "> Anahata Solid Citadel Front gate"
    endoption
    option
      control f2 08 ff ff
      text "> Point 136    "
    endoption
    option
      control f2 08 ff ff
      text "> Near by Solid's Castle"
    endoption
    option
      control f2 08 ff ff
      text "> Next page "
    endoption
  endselect
  select BIG_MAP_SEL3
    option
      control f2 08 ff ff
      text "> Previous page"
    endoption
    option
      control f2 08 ff ff
      text "> Sahasrara (front of Karma Temple)"
    endoption
    option
      control f2 08 ff ff
      text "> Front of ship ruins"
    endoption
    option
      control f2 08 ff ff
      text "> New base"
    endoption
  endselect
  message sera_013_001_01a speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The song I taught you was one that"
      newline
      text "Angel used to sing."
      newline
      control f1 04
    endpage
  endmessage
  message sera_013_001_01b speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "It always sounded sad..."
      newline
      control f1 04
    endpage
  endmessage
  message gale_013_001_01a speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Condemning mankind for its sins..."
      newline
      text "Jenna, what could you gain from"
      newline
      text "all that sadness?"
      newline
      control f1 04
    endpage
  endmessage
  message gale_013_001_01b speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Have you forgotten what Karma means?"
      newline
      control f1 04
    endpage
  endmessage
  message ciero_013_001_01a speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Wait... Huh?"
      newline
      control f1 04
    endpage
  endmessage
  message ciero_013_001_01b speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "So Sera created us before de"
      newline
      text "Junkyard was made, ja?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "But... Dere's no model for Gale,"
      newline
      text "and Lupa and Varin were real live"
      newline
      text "people... right?"
      newline
      control f1 04
    endpage
  endmessage
  message ciero_013_001_01c speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "How would you explain dat!?"
      newline
      control f1 04
    endpage
  endmessage
  message fred_013_001_01a speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Dad taught me never to say"
      newline
      text "goodbye."
      newline
      control f1 04
    endpage
  endmessage
  message fred_013_001_01b speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "So..."
      newline
      control f1 04
    endpage
  endmessage
  message fred_013_001_01c speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I'll see you guys around."
      newline
      control f1 04
    endpage
  endmessage
  message EXITWARP speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Leave the area?"
      newline
      control f1 04
    endpage
  endmessage
  select EXITWARP_SEL
    option
      control f2 08 ff ff
      text "Yes."
    endoption
    option
      control f2 08 ff ff
      text "No."
    endoption
  endselect
  message FLDHUNTEXITWARP speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Will you stop the Field Hunt and"
      newline
      text "leave the area?"
      newline
      control f1 04
    endpage
  endmessage
  select FLDHUNTEXITWARP_SEL
    option
      control f2 08 ff ff
      text "Yes."
    endoption
    option
      control f2 08 ff ff
      text "No."
    endoption
  endselect
  message HOSEKI speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> A strange object hovers in midair."
      newline
      text "Touch it?"
      newline
      control f1 04
    endpage
  endmessage
  select HOSEKI_SEL
    option
      control f2 08 ff ff
      text "Yes."
    endoption
    option
      control f2 08 ff ff
      text "No."
    endoption
  endselect
  message HOSEKI_NOGET speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> You decided not to touch it."
      newline
      control f1 04
    endpage
  endmessage
  message HOSEKI_GET speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Obtained "
      control f2 02 05 ff
      control f2 03 01 ff
      control f2 02 01 ff
      text " x "
      control f2 03 02 ff
      text "."
      newline
      control f1 04
    endpage
  endmessage
  message TAKARA speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> There is a box emitting light from"
      newline
      text "its panel. Open it?"
      newline
      control f1 04
    endpage
  endmessage
  select TAKARA_SEL
    option
      control f2 08 ff ff
      text "Yes."
    endoption
    option
      control f2 08 ff ff
      text "No."
    endoption
  endselect
  message TAKARA_NOGET speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> You decided not to open it."
      newline
      control f1 04
    endpage
  endmessage
  message TAKARA_STILLGET speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> It's empty."
      newline
      control f1 04
    endpage
  endmessage
  message TAKARA_GET speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Obtained "
      control f2 02 05 ff
      control f2 03 01 ff
      control f2 02 01 ff
      text " x "
      control f2 03 02 ff
      text "."
      newline
