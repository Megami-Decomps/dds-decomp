messages msg1
  select YES_NO
    option
      control f2 08 ff ff
      text "Yes."
    endoption
    option
      control f2 08 ff ff
      text "No."
    endoption
  endselect
  message KYOSEI_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "?A%(-.-)%A?"
      newline
      control f1 04
    endpage
  endmessage
  message BOSS_05 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I'M a CoLoNeL... CoLoNeL BECK..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I'Ve HAd eNOugH of THiS BullShit!"
      newline
      text "I'lL TeAR yOU guyS apARt..."
      newline
      control f1 04
    endpage
  endmessage
  message BOSS_05B speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I'M geTTiNG tHE heLL oUT Of HeRe!"
      newline
    endpage
  endmessage
  message BOSS_09 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "You are not the one..."
      newline
      text "...who is to judge."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I cannot forgive..."
      newline
      text "...one of contrary existence."
      newline
      control f1 04
    endpage
  endmessage
  message BOSS_08 speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I am Satan, the one who stands"
      newline
      text "below God the judge."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I see you have chosen to retaliate,"
      newline
      text "just as that man did..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Then prepare, Seraph,"
      newline
      text "to receive God's eternal punishment"
      newline
      text "of damnation!"
      newline
      control f1 04
    endpage
  endmessage
  message SATAN_AFTER speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Satan's Solar Data dispersed..."
      newline
      text "Will all the solar datas be absorbed"
      newline
      text "by God to repeat metempsychosis?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> Seraph heard the faint words"
      newline
      text "of Satan's Solar Data."
      newline
      control f1 04
    endpage
  endmessage
  message SATAN_AFTER_02 speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "...What do you intend to accomplish"
      newline
      text "by avoiding... God's justice...?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Where will you go...?"
      newline
      control f1 04
    endpage
  endmessage
  message SATAN_AFTER_03 speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "For every generation, in every world,"
      newline
      text "the final question of life is always"
      newline
      text "the same."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Though the God that spirit praised"
      newline
      text "is different from the God of"
      newline
      text "this world..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "The ultimate answer lies within you."
      newline
      text "Now go, Seraph..."
      newline
      control f1 04
    endpage
  endmessage
  message BOSS_06 speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "It's been a long while since"
      newline
      text "the dharma vanished from people's"
      newline
      text "hearts and the adharma took hold..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I must cleanse this impurity."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "If you wish to change my mind,"
      newline
      text "then show me the strength of"
      newline
      text "your dharma!"
      newline
      control f1 04
    endpage
  endmessage
  message BOSS_06B speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "You are not worthy to face me."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Leave at once."
      newline
      control f1 04
    endpage
  endmessage
  message BOSS_07 speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I am Nataraja, the destroyer of all."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I shall ascertain if you are "
      newline
      text "worthy to face Brahman."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "If you cannot defeat me, then"
      newline
      text "your world does not deserve to exist."
      newline
      control f1 04
    endpage
  endmessage
