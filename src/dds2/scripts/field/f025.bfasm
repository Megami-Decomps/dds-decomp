messages msg1
  message FIRST_ENCOUNT speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Intruders!"
      newline
      text "Hey, it's those Asuras!"
      newline
      control f1 04
    endpage
  endmessage
  message ANGEL_SOL_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Y-You guys are the ones who devour?"
      newline
      text "Madame's soldiers completely took"
      newline
      text "over inside..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "You need to get to the EGG--"
      newline
      text "that's where Sera is!"
      newline
      control f1 04
    endpage
  endmessage
  message ANGEL_SOL_02 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "........."
      newline
      control f1 04
    endpage
  endmessage
  message ANGEL_SOL_03 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> It appears that he's dead."
      newline
      control f1 04
    endpage
  endmessage
  message DEAD_BODY speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> He's already dead."
      newline
      control f1 04
    endpage
  endmessage
  message CHECK_BODY speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Inspect the corpse?"
      newline
      control f1 04
    endpage
  endmessage
  message FIND_SOMETHING speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> There's something in his pocket!"
      newline
      control f1 04
    endpage
  endmessage
  message ITEM_GET speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Obtained "
      control f2 02 05 ff
      control f2 03 01 ff
      control f2 02 01 ff
      text " x "
      control f2 03 02 ff
      text "."
      newline
      control f1 04
    endpage
  endmessage
  message ITEM_NO_GET speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> It's just a dead body."
      newline
      control f1 04
    endpage
  endmessage
  message BATTLE_DOOR speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> A strong presence can be felt from"
      newline
      text "inside the room."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> Go inside?"
      newline
      control f1 04
    endpage
  endmessage
  message MADAM_07_SOL speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "You're here already!?"
      newline
      control f1 04
    endpage
  endmessage
  message RESEARCHER_RUNAWAY speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Wh--Aaaaahhhhh!!"
      newline
      control f1 04
    endpage
  endmessage
  message GET_RING speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Obtained "
      control f2 02 05 ff
      text "Skull Ring"
      control f2 02 01 ff
      newline
      text "from the defeated enemies."
      newline
      control f1 04
    endpage
  endmessage
  message MAN_KEY_A_01_01 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "P-Please..."
      newline
      text "Don't kill me..."
      newline
      control f1 04
    endpage
  endmessage
  message MAN_KEY_A_01_02 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "...Ohhh..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "You're the--"
      newline
      control f1 04
    endpage
  endmessage
  message MAN_KEY_A_01_03 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I shouldn't have run away earlier."
      newline
      text "I just... I guess I just lost"
      newline
      text "my head, you know?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "The Director told us to cooperate,"
      newline
      text "so..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "My security card's only level 1,"
      newline
      text "but I hope you can still use it."
      newline
      control f1 04
    endpage
  endmessage
  message GET_KEY_A speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Obtained "
      control f2 02 05 ff
      text "Security Card 01"
      control f2 02 01 ff
      text "."
      newline
      control f1 04
    endpage
  endmessage
  message MAN_KEY_A_02 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Madame's soldiers moved in fast,"
      newline
      text "but there must be some researchers"
      newline
      text "who are still alive..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "You won't get too far without"
      newline
      text "security cards. Ask the remaining"
      newline
      text "researchers about them."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "...I need to make sure I'm not caught."
      newline
      control f1 04
    endpage
  endmessage
  message MAN_KEY_A_03 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Oh, good! You have a level 2 card,"
      newline
      text "so there must still be survivors."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Sera's in this building somewhere."
      newline
      text "You need to hurry!"
      newline
      control f1 04
    endpage
  endmessage
  message MAN_KEY_A_04 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "You got the level 3 card, too?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Sera's in this building somewhere."
      newline
      text "You need to hurry!"
      newline
      control f1 04
    endpage
  endmessage
  message MAN_KEY_A_05 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Huh? You have the level 3 card--"
      newline
      text "Oh, you need a password?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "You should probably ask whoever"
      newline
      text "gave you that card."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Think that might help?"
      newline
      control f1 04
    endpage
  endmessage
  message MAN_KEY_A_06 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "He told you to look at the level 3"
      newline
      text "security card?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "That's probably a hint."
      newline
      text "Did you check it yet?"
      newline
      control f1 04
    endpage
  endmessage
  message MAN_KEY_A_09 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "So you got the level 3 card, and"
      newline
      text "he told you to look at it?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I wonder what that means..."
      newline
      text "I can't really think of anything."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Hm... Did you try it?"
      newline
      control f1 04
    endpage
  endmessage
  message MAN_KEY_A_07 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Good, you have the level 4 card."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Sera's in this building somewhere."
      newline
      text "You need to hurry!"
      newline
      control f1 04
    endpage
  endmessage
  message MAN_KEY_A_08 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "So you have the level 4 card, but"
      newline
      text "you need another password?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Maybe you should check on the card,"
      newline
      text "like last time."
      newline
      control f1 04
    endpage
  endmessage
  message MAN_KEY_A_10 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "You finally have the level 5 card..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Sera's in this building somewhere."
      newline
      text "You need to hurry!"
      newline
      control f1 04
    endpage
  endmessage
  message MAN_KEY_A_11 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "You have the level 5 card, and--"
      newline
      text "Huh? There was a note on the corpse?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "\"A=1 B=2 C=3 Z=26\""
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "That seems like it might be"
      newline
      text "a code of some kind."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Why don't you take some time"
      newline
      text "to think about it?"
      newline
      control f1 04
    endpage
  endmessage
  message MAN_KEY_A_12 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "You have the level 5--"
      newline
      text "Still need the password, huh?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "You should really just ask the person"
      newline
      text "who gave you the security card..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Do you remember who gave it to you?"
      newline
      control f1 04
    endpage
  endmessage
  message MAN_KEY_A_13 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "You have the level 5--"
      newline
      text "Still need the password, huh?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Were there any other hints?"
      newline
      text "...Huh? A corpse with a note?"
      newline
      control f1 04
