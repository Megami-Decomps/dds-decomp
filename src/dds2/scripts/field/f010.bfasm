messages msg1
  select YES_NO
    option
      control f2 08 ff ff
      text "Yes."
    endoption
    option
      control f2 08 ff ff
      text "No."
    endoption
  endselect
  message hungry speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> The party was hungry."
      newline
      control f1 04
    endpage
  endmessage
  message hungry02 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> The party grew weak from hunger."
      newline
      control f1 04
    endpage
  endmessage
  message aljira_010_001_01a speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I wonder where Heat is..."
      newline
      control f1 04
    endpage
  endmessage
  message aljira_010_001_01b speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "We shouldn't assume that he died"
      newline
      text "in the explosion. ...We can't."
      newline
      control f1 04
    endpage
  endmessage
  message gale_010_001_01 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Strange..."
      newline
      text "Security seems to be lacking."
      newline
      control f1 04
    endpage
  endmessage
  message gale_010_001_02a speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The light security was a trick"
