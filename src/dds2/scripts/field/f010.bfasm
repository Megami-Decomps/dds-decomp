      newline
      text "to study God."
      newline
      control f1 04
    endpage
  endmessage
  message npc10_010_003_01b speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "When the world was destroyed five"
      newline
      text "years ago, Madame established"
      newline
      text "the Karma Society as we now know it."
      newline
      control f1 04
    endpage
  endmessage
  message npc10_010_003_01c speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "She's survived many hardships..."
      newline
      control f1 04
    endpage
  endmessage
