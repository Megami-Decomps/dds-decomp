  message npc06_010_002_01 speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Madame is a very compassionate person."
      newline
      text "She'll do whatever it takes to"
      newline
      text "continue the human race..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
