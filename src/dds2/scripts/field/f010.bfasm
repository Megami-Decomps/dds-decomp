messages msg1
  select YES_NO
    option
      control f2 08 ff ff
      text "Yes."
    endoption
    option
      control f2 08 ff ff
      text "No."
    endoption
  endselect
  message hungry speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> The party was hungry."
      newline
      control f1 04
    endpage
  endmessage
  message hungry02 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> The party grew weak from hunger."
      newline
      control f1 04
    endpage
  endmessage
  message aljira_010_001_01a speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I wonder where Heat is..."
      newline
      control f1 04
    endpage
  endmessage
  message aljira_010_001_01b speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "We shouldn't assume that he died"
      newline
      text "in the explosion. ...We can't."
      newline
      control f1 04
    endpage
  endmessage
  message gale_010_001_01 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Strange..."
      newline
      text "Security seems to be lacking."
      newline
      control f1 04
    endpage
  endmessage
  message gale_010_001_02a speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The light security was a trick"
      newline
      text "to relax our guard..."
      newline
      control f1 04
    endpage
  endmessage
  message gale_010_001_02b speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "However, allowing the enemy to"
      newline
      text "succeed is one way of achieving"
      newline
      text "our own goal..."
      newline
      control f1 04
    endpage
  endmessage
  message ciero_010_001_01 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "We need to save Sera, brudda!"
      newline
      text "She's probably real lonely."
      newline
      control f1 04
    endpage
  endmessage
  message ciero_010_001_02a speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "What's with dose jerks?"
      newline
      control f1 04
    endpage
  endmessage
  message ciero_010_001_02b speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Dey really annoy me, y'know?"
      newline
      control f1 04
    endpage
  endmessage
  message roald_010_001_01a speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "This is the Administrative District,"
      newline
      text "where the Karma Society's head office"
      newline
      text "is located."
      newline
      control f1 04
    endpage
  endmessage
  message roald_010_001_01b speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The information we were given seems"
      newline
      text "to be correct, but... I'm not sure"
      newline
      text "that's a good thing."
      newline
      control f1 04
    endpage
  endmessage
  message roald_010_001_02 speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "This is the Administrative District,"
      newline
      text "where the Karma Society's head office"
      newline
      text "is located."
      newline
      control f1 04
    endpage
  endmessage
  message npc05_010_001_01a speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "So many people look up to the Chief"
      newline
      text "Director... It must be her charisma."
      newline
      control f1 04
    endpage
  endmessage
  message npc05_010_001_01b speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I wonder if she's really"
      newline
      text "a hermaphrodite..."
      newline
      control f1 04
    endpage
  endmessage
  message npc06_010_001_01a speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I could've sworn I heard a gunshot"
      newline
      text "up there..."
      newline
      control f1 04
    endpage
  endmessage
  message npc06_010_001_01b speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "No way the prisoners could escape on"
      newline
      text "their own... I hope it's not a rebellion,"
      newline
      text "or anything like that."
      newline
      control f1 04
    endpage
  endmessage
  message npc07_010_001_01a speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I came to register my newborn son,"
      newline
      text "but they're closed already..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I guess he won't have a name for"
      newline
      text "a few more days..."
      newline
      control f1 04
    endpage
  endmessage
  message npc07_010_001_01b speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Hey, great timing! Why don't you"
      newline
      text "name my son? ...I actually hadn't"
      newline
      text "decided on one yet."
      newline
      control f1 04
    endpage
  endmessage
  select npc07_010_001_01_SEL
    option
      control f2 08 ff ff
      text "Serph's a good name."
    endoption
    option
      control f2 08 ff ff
      text "Name him Heat."
    endoption
    option
      control f2 08 ff ff
      text "Gale would be adequate."
    endoption
    option
      control f2 08 ff ff
      text "'ow 'bout Cielo?"
    endoption
  endselect
  message npc07_010_001_01_ans0a speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Serph, huh?"
      newline
      text "Serph..."
      newline
      text "Sounds pretty intense, doesn't it?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Okay, Serph it is, then!"
      newline
      control f1 04
    endpage
  endmessage
  message npc07_010_001_01_ans0b speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I really appreciate it. Here,"
      newline
      text "take this!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> Obtained "
      control f2 02 05 ff
      control f2 03 01 ff
      control f2 02 01 ff
      text "."
      newline
      control f1 10
      control f2 08 ff ff
      control f1 04
    endpage
  endmessage
  message npc07_010_001_01_ans0_2a speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Serph, huh?"
      newline
      text "Serph..."
      newline
      text "Sounds pretty intense, doesn't it?"
      newline
      control f1 04
    endpage
  endmessage
  message npc07_010_001_01_ans0_2b speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Cool, I like it."
      newline
      control f1 04
    endpage
  endmessage
  message npc07_010_001_01_ans1a speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Heat... ...Heat."
      newline
      text "I bet the girls would really go"
      newline
      text "for a guy named Heat... Heh..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Sure, let's name him Heat."
      newline
      control f1 04
    endpage
  endmessage
  message npc07_010_001_01_ans1b speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I really appreciate it. Here,"
      newline
      text "take this!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "> Obtained "
      control f2 02 05 ff
      control f2 03 01 ff
      control f2 02 01 ff
      text "."
      newline
      control f1 10
      control f2 08 ff ff
      control f1 04
    endpage
  endmessage
  message npc07_010_001_01_ans1_2a speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Heat... ...Heat."
      newline
      text "I bet the girls would really go"
      newline
      text "for a guy named Heat... Heh..."
      newline
      control f1 04
    endpage
  endmessage
  message npc07_010_001_01_ans1_2b speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "What a straightforward name..."
      newline
      control f1 04
    endpage
  endmessage
  message npc07_010_001_01_ans2a speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Gale..."
      newline
      text "Sounds pretty dashing; maybe a"
      newline
      text "little intelligent, too..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I like it. Gale it is."
      newline
      control f1 04
    endpage
  endmessage
  message npc07_010_001_01_ans2b speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I really appreciate it. Here,"
      newline
      text "take this!"
      newline
