  message npc05_010_003_01 speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Hand over the Cyber Shaman!"
      newline
      text "Do you WANT the world to die!?"
      newline
      control f1 04
    endpage
  endmessage
  message npc06_010_003_01 speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "It-It's the... Cyber Shaman..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I know you probably h-hate us..."
      newline
      text "but, can you do something to stop"
      newline
      text "God?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I know we did horrible things..."
      newline
      text "...But we really thought it was for"
      newline
      text "the best interest of society!"
      newline
      control f1 04
    endpage
  endmessage
  message npc06_010_003_02a speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Before the Cyber Shaman project"
      newline
      text "began, there were telepathic ability"
      newline
      text "tests..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "A lot of talented children went mad..."
      newline
      text "...and died."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I remember this one really bright kid"
      newline
      text "from South America or the Caribbean"
      newline
      text "or something..."
      newline
      control f1 04
    endpage
  endmessage
  message npc06_010_003_02b speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "He was an early Shaman candidate."
      newline
      text "...Heh, I can still see that little"
      newline
      text "guy's dreadlocks."
      newline
      control f1 04
    endpage
  endmessage
  message npc07_010_003_01 speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "A bunch of people tried to push"
      newline
      text "their way through, but the guards"
      newline
      text "turned them away."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Yeah, humans against demons..."
      newline
      text "They didn't stand a chance."
      newline
      control f1 04
    endpage
  endmessage
  message npc07_010_003_02 speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Jenna Angel was going to spread"
      newline
      text "the demon virus worldwide by having"
      newline
      text "Sera communicate with the Sun..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "But, I think people still could"
      newline
      text "have escaped underground."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "...Why would she think something"
      newline
      text "like that could lead to enlightenment?"
      newline
      control f1 04
    endpage
  endmessage
  message npc08_010_003_01 speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I can't believe Madame is gone..."
      newline
      text "It's all come crashing down."
      newline
      control f1 04
    endpage
  endmessage
  message npc08_010_003_02 speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Madame Cuvier had found a way"
      newline
      text "for the human race to survive..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "What happened?"
      newline
      text "How could it turn out like this?"
      newline
      control f1 04
    endpage
  endmessage
  message npc09_010_003_01a speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I knew the people you were all"
      newline
      text "modeled after."
      newline
      control f1 04
    endpage
  endmessage
  message npc09_010_003_01b speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Serph was responsible for the Cyber"
      newline
      text "Shaman's mental well-being."
      newline
      control f1 04
    endpage
