      control f2 08 ff ff
      text "Heat monitered her physical"
      newline
      text "health."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Argilla was a nurse who worked"
      newline
      text "under Heat."
      newline
      control f1 04
    endpage
  endmessage
  message npc09_010_003_01c speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Serph wanted Argilla out of his"
      newline
      text "way, so he brainwashed her to keep"
      newline
      text "an eye on Heat..."
      newline
      control f1 04
    endpage
  endmessage
  message npc10_010_003_01a speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The Karma Society was completely"
      newline
      text "different, in the beginning."
