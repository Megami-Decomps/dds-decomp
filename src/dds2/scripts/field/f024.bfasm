messages msg1
  message GEIRU_AYAAHIMU speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Hm... No reception."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Thinking back to the Jailer's reaction,"
      newline
      text "it seems that the head of the Karma"
      newline
      text "Society wishes to speak with us."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Either way, we must continue."
      newline
      text "Be careful, Serph."
      newline
      control f1 04
    endpage
  endmessage
  message TRP_HOUKOKU_01 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Alpha 1, this is Bravo 2..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "The Asuras just passed my position,"
      newline
      text "right on schedule. I'll continue"
      newline
      text "observation..."
      newline
      control f1 04
    endpage
  endmessage
  message TRP_HOUKOKU_02 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "What? Capture them?"
      newline
      text "But, my orders were to..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Ah, I see."
      newline
      text "Understood."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Bravo 2, over and out."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I'll show 'em they don't belong"
      newline
      text "in our world..."
      newline
      control f1 04
    endpage
  endmessage
  message START_EN01 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Freeze!"
      newline
      control f1 04
    endpage
  endmessage
  message START_EN02 speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Hands on your head, and get down"
      newline
      text "on your knees! Now!"
      newline
      control f1 04
    endpage
  endmessage
  message START_EN03 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Hmph..."
      newline
      text "They don't look so tough."
      newline
      control f1 04
    endpage
  endmessage
  message START_EN04 speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "They're just the dregs of a failed"
      newline
      text "experiment..."
      newline
      control f1 04
    endpage
  endmessage
  message START_EN05 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Heh, that's true."
      newline
      control f1 04
    endpage
  endmessage
  message START_EN05_01 speaker=2
    page
      control f2 08 ff ff
      text "...And they wanted to put these"
      newline
      text "in our heads? Ha! No thanks."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Hurry up, you freaks. You've got"
      newline
      text "valuable programs in your brains,"
      newline
      text "right?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Well, bow down to us humans, or I'll"
      newline
      text "blow 'em all to AI heaven."
      newline
      control f1 04
    endpage
  endmessage
  select BAT_SEL
    option
      control f2 08 ff ff
      text "And, if we refuse?"
    endoption
    option
      control f2 08 ff ff
      text "(Attack them while they talk)"
    endoption
  endselect
  message START_EN06 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I see..."
      newline
      text "I'll blow you to hell and back, you"
      newline
      text "machine-headed freak!"
      newline
      control f1 04
    endpage
  endmessage
  message METATRON_BATT speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Obtained "
      control f2 02 05 ff
      text "Divine Ring"
      control f2 02 01 ff
      text "."
      newline
      control f1 04
    endpage
  endmessage
  message KARUMA_SYOKUIN_01 speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Uh... Well, er..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I-I'm just a government official"
      newline
      text "who got left behind! I don't have"
      newline
      text "anything to do with this!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "G-G-Go fight somewhere else!"
      newline
      control f1 04
    endpage
  endmessage
  select SITUMON
    option
      control f2 08 ff ff
      control f2 07 07 ff
      text "Where is Sera?"
    endoption
    option
      control f2 08 ff ff
      text "Why are you running?"
    endoption
    option
      control f2 08 ff ff
      text "Who were those soldiers?"
    endoption
    option
      control f2 08 ff ff
      text "That's enough from you."
    endoption
  endselect
  message KARUMA_SYOKUIN_03 speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Th-The Cyber Shaman!?"
      newline
      text "She's in a medical room l-located"
      newline
      text "above this b-building..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "That's all I know! I swear!"
      newline
      control f1 04
    endpage
  endmessage
  message KARUMA_SYOKUIN_04 speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Madame ordered an immediate evacuation!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I h-heard it's because the prisoners"
      newline
      text "have r-risen to action... The soldiers"
      newline
      text "moved to th-the upper floors..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "That's why the lower fl-floors were"
      newline
      text "so empty... Okay?"
      newline
      control f1 04
    endpage
  endmessage
  message KARUMA_SYOKUIN_05 speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Oh... th-them?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "They're a t-top-notch special forces"
      newline
      text "unit. They're s-sort of considered"
      newline
      text "outcasts among the other soldiers."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I th-think they're downstairs,"
      newline
      text "b-but I have no idea why."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "They t-tend to do their own thing,"
      newline
      text "so it's probably s-something like"
      newline
      text "that."
      newline
      control f1 04
    endpage
  endmessage
  message KARUMA_SYOKUIN_06 speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I'll tell you anything..."
      newline
      text "Just don't kill me!"
      newline
      control f1 04
    endpage
  endmessage
  message KARUMA_SYOKUIN_07 speaker=4
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Y-You're going to spare my life?"
      newline
      text "Th-Thanks..."
      newline
      control f1 04
    endpage
  endmessage
  message SYOKUIN_SIE_01 speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Maybe we can get some info from"
      newline
      text "dis guy, ja?"
      newline
      control f1 04
    endpage
  endmessage
  message YOKOKARA speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Serph was shot in the side!"
      newline
      control f1 04
    endpage
  endmessage
  message bingo speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "BULLSEYE!"
      newline
      control f1 04
    endpage
  endmessage
  message EN01_01 speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Alpha 1, this is Delta 3."
      newline
      text "We made contact, just as planned."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Roger, leave these ass-hats to me."
      newline
      control f1 04
    endpage
  endmessage
  message AFBASTSYOKUIN_GI_01 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "We desire information more than"
      newline
      text "battle."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "You may choose... Satisfy our minds,"
      newline
      text "or satisfy our hunger."
      newline
      control f1 04
    endpage
  endmessage
  message KARUMA_03_01AFT speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The Cy-Cyber Shaman is..."
      newline
      control f1 04
    endpage
  endmessage
  message KARUMA_03_02AFT speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "The Chief and... and--"
      newline
      control f1 04
    endpage
  endmessage
  message KARUMA_03_02AFT_01 speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "...Yeargh!"
      newline
      control f1 04
    endpage
  endmessage
  message KARUMA_03_03AFT speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "W-We were told to follow that red--"
      newline
      control f1 04
    endpage
  endmessage
  select SITUMON_FEIKU
    option
      control f2 08 ff ff
      control f2 07 07 ff
      text "Where is Sera?"
    endoption
    option
      control f2 08 ff ff
      text "Who gives your orders?"
    endoption
    option
      control f2 08 ff ff
      text "Why were you ordered to capture us?"
    endoption
  endselect
  message KARUMA_AFT speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> The Karma Soldier was shot!"
      newline
      control f1 04
    endpage
  endmessage
  message AFBAST_ATAMA_01 speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "M-Minds, minds! Please!"
      newline
      control f1 04
    endpage
  endmessage
  message EN02_01 speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Wow, talk about persistent..."
      newline
      text "You weren't devoured yet?"
      newline
      control f1 04
    endpage
  endmessage
  message EN02_02 speaker=7
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "We're the renegade TPV special unit."
      newline
      control f1 04
    endpage
  endmessage
  message EN02_03 speaker=6
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Seeing blood and hearing flesh"
      newline
      text "tear apart is more important to us"
      newline
      text "than that old woman's orders!"
      newline
      control f1 04
    endpage
  endmessage
  message TRIEN03_01_SIERO speaker=5
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Whoa... Dey switched de doors!"
      newline
      control f1 04
    endpage
  endmessage
  message EN03_01_GEIRU_ODO speaker=0
    page
      control f2 08 ff ff
      text "It seems we walked right into"
      newline
      text "their trap..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "An impressive effort on their part."
      newline
      control f1 04
    endpage
  endmessage
  message EN03_01 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Something can be heard from"
      newline
      text "the dead soldier's transceiver."
      newline
      control f1 04
    endpage
  endmessage
  message EN03_01_MUSE speaker=8
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Echo 5, this is Alpha 1."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "What happened? Did you get them?"
      newline
      text "Answer me, Echo 5!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "...Useless--"
      newline
      control f1 04
    endpage
  endmessage
  message EN03_01MUSEKIRE speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> The transmission was cut off."
      newline
      control f1 04
    endpage
  endmessage
  message START_GEIRU speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "It sounds like Sera is on a higher"
      newline
      text "level of this building."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Let's head to the top, Serph."
      newline
      control f1 04
    endpage
  endmessage
  message KARUMA_MAKE_DEAD speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> He's already dead."
      newline
      control f1 04
    endpage
  endmessage
  message ANG_KARMA_DEAD_01 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> It's the corpse of a soldier"
      newline
      text "wearing a blue arm band."
      newline
      control f1 04
    endpage
  endmessage
  message ANG_KARMA_DEAD_02 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> It's the corpse of a soldier"
      newline
      text "wearing a blue arm band. It's riddled"
      newline
      text "with bullet wounds."
      newline
      control f1 04
    endpage
  endmessage
  message MADAMU_KARMA_01 speaker=9
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "...We're currently engaged with"
      newline
      text "the rebellion forces."
      newline
      text "We need backup! I repeat, send backup!"
      newline
      control f1 04
    endpage
  endmessage
  message MADAMU_KARMA_01_01 speaker=9
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Dammit..."
      newline
      text "Why don't they send the Tribhvana?"
      newline
      text "They're the elite freaking squad...!"
      newline
      control f1 04
    endpage
  endmessage
  message MADAMU_KARMA_02 speaker=9
    page
      control f2 08 ff ff
      text "There's no point in complaining..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "The unit and that red Asura guy"
      newline
      text "were sent to capture the remaining"
      newline
      text "Asuras."
      newline
      control f1 04
    endpage
  endmessage
  message MADAMU_KARMA_03 speaker=9
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Wh-What!?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "You're the wanted Asura!"
      newline
      control f1 04
    endpage
  endmessage
  message GABURI_01 speaker=10
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "This city isn't my city..."
      newline
      control f1 04
    endpage
  endmessage
  message GABURI_02 speaker=10
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Where is the savior?"
      newline
      text "Where is the millenium?"
      newline
      control f1 04
    endpage
  endmessage
  message GABURI_03 speaker=10
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I thirst..."
      newline
      text "I must quench this thirst!"
      newline
      control f1 04
    endpage
  endmessage
  message GABURI_FIN speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Gabriel disappeared."
      newline
      control f1 04
    endpage
  endmessage
  message gyousyounin speaker=11
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "This is the shop. If I set up the shop,"
      newline
      text "then that's where the shop is."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "This is serious business, my friend."
      newline
      control f1 04
    endpage
  endmessage
  message aljira_024_026_01 speaker=12
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Who do you think they were talking"
      newline
      text "about?"
      newline
      control f1 04
