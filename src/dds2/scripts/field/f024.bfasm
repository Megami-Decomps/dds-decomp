messages msg1
  message GEIRU_AYAAHIMU speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Hm... No reception."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Thinking back to the Jailer's reaction,"
      newline
      text "it seems that the head of the Karma"
      newline
      text "Society wishes to speak with us."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Either way, we must continue."
      newline
      text "Be careful, Serph."
      newline
      control f1 04
    endpage
  endmessage
  message TRP_HOUKOKU_01 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Alpha 1, this is Bravo 2..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "The Asuras just passed my position,"
      newline
      text "right on schedule. I'll continue"
      newline
      text "observation..."
      newline
      control f1 04
    endpage
  endmessage
  message TRP_HOUKOKU_02 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "What? Capture them?"
      newline
      text "But, my orders were to..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Ah, I see."
      newline
      text "Understood."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Bravo 2, over and out."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I'll show 'em they don't belong"
      newline
      text "in our world..."
      newline
      control f1 04
    endpage
  endmessage
  message START_EN01 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Freeze!"
      newline
      control f1 04
    endpage
  endmessage
  message START_EN02 speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Hands on your head, and get down"
      newline
      text "on your knees! Now!"
      newline
      control f1 04
    endpage
  endmessage
  message START_EN03 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Hmph..."
      newline
      text "They don't look so tough."
      newline
      control f1 04
    endpage
  endmessage
  message START_EN04 speaker=3
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "They're just the dregs of a failed"
      newline
      text "experiment..."
      newline
      control f1 04
    endpage
  endmessage
  message START_EN05 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Heh, that's true."
      newline
      control f1 04
    endpage
  endmessage
  message START_EN05_01 speaker=2
    page
      control f2 08 ff ff
      text "...And they wanted to put these"
      newline
      text "in our heads? Ha! No thanks."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Hurry up, you freaks. You've got"
      newline
      text "valuable programs in your brains,"
      newline
      text "right?"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "Well, bow down to us humans, or I'll"
      newline
      text "blow 'em all to AI heaven."
      newline
      control f1 04
    endpage
  endmessage
  select BAT_SEL
    option
      control f2 08 ff ff
      text "And, if we refuse?"
    endoption
    option
      control f2 08 ff ff
      text "(Attack them while they talk)"
    endoption
  endselect
  message START_EN06 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I see..."
      newline
      text "I'll blow you to hell and back, you"
      newline
      text "machine-headed freak!"
      newline
      control f1 04
    endpage
  endmessage
  message METATRON_BATT speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "> Obtained "
      control f2 02 05 ff
      text "Divine Ring"
      control f2 02 01 ff
      text "."
      newline
      control f1 04
    endpage
  endmessage
