flw0 2
profile dds2

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=0 float=0

procedure e916_main reserved=0x00000000
procedure e916_first reserved=0x00000000
procedure e916_dead reserved=0x00000000

code
e916_main:
  PROC e916_main
  MESSAGE_REQUEST_AND_POLL(message(MSG_000))
  return
e916_first:
  PROC e916_first
  COMM 0x003e
  WAIT_FOR_TIMER_LIMIT(12)
  SCREEN_FADE_A(1, 24)
  push float32(0.9829999804496765, bits=0x3f7ba5e3)
  push -float32(0.006000000052154064, bits=0x3bc49ba6)
  push -float32(0.12399999797344208, bits=0x3dfdf3b6)
  push -float32(0.028999999165534973, bits=0x3ced9168)
  push float32(56469.5, bits=0x475c9580)
  push -float32(475.5, bits=0x43edc000)
  push -float32(1703.0999755859375, bits=0x44d4e333)
  COMM 0x01d5
  push float32(0.9629999995231628, bits=0x3f76872b)
  push float32(0.00800000037997961, bits=0x3c03126f)
  push -float32(0.21899999678134918, bits=0x3e604189)
  push -float32(0.0860000029206276, bits=0x3db020c5)
  push -float32(2872.300048828125, bits=0x453384cd)
  push float32(331.0, bits=0x43a58000)
  push -float32(2531.10009765625, bits=0x451e319a)
  COMM 0x01d6
  push 8
  push 40
  COMM 0x01d7
  WAIT_FOR_TIMER_LIMIT(75)
  COMM 0x003f
  WAIT_FOR_TIMER_LIMIT(12)
  return
e916_dead:
  PROC e916_dead
  COMM 0x003e
  SCREEN_FADE_B(1, 24)
  WAIT_FOR_TIMER_LIMIT(30)
  return
end

messages msg1
  message MSG_000 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      font "テスト中..."
      newline
      control f1 04
    endpage
  endmessage
end

strings
  zero 240
end
