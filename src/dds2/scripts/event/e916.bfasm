flw0 2
profile dds2

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=0 float=0

procedure e916_main reserved=0x00000000
procedure e916_first reserved=0x00000000
procedure e916_dead reserved=0x00000000

code
e916_main:
  PROC e916_main
  PUSHMSG MSG_000
  COMM MESSAGE_REQUEST_AND_POLL
  END
e916_first:
  PROC e916_first
  COMM 0x003e
  PUSHIS 12
  COMM WAIT_FOR_TIMER_LIMIT
  PUSHIS 24
  PUSHIS 1
  COMM SCREEN_FADE_A
  PUSHF 0x3f7ba5e3
  PUSHF 0x3bc49ba6
  MINUS
  PUSHF 0x3dfdf3b6
  MINUS
  PUSHF 0x3ced9168
  MINUS
  PUSHF 0x475c9580
  PUSHF 0x43edc000
  MINUS
  PUSHF 0x44d4e333
  MINUS
  COMM 0x01d5
  PUSHF 0x3f76872b
  PUSHF 0x3c03126f
  PUSHF 0x3e604189
  MINUS
  PUSHF 0x3db020c5
  MINUS
  PUSHF 0x453384cd
  MINUS
  PUSHF 0x43a58000
  PUSHF 0x451e319a
  MINUS
  COMM 0x01d6
  PUSHIS 8
  PUSHIS 40
  COMM 0x01d7
  PUSHIS 75
  COMM WAIT_FOR_TIMER_LIMIT
  COMM 0x003f
  PUSHIS 12
  COMM WAIT_FOR_TIMER_LIMIT
  END
e916_dead:
  PROC e916_dead
  COMM 0x003e
  PUSHIS 24
  PUSHIS 1
  COMM 0x0010
  PUSHIS 30
  COMM WAIT_FOR_TIMER_LIMIT
  END
end

messages msg1
  message MSG_000 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      font "テスト中..."
      newline
      control f1 04
    endpage
  endmessage
end

strings
  zero 240
end
