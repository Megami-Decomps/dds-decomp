flw0 2
profile dds2

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=0 float=0

procedure e640_001 reserved=0x00000000
jump_label _2 reserved=0x00000000
jump_label _1 reserved=0x00000000

code
e640_001:
  PROC e640_001
  SET_MODEL_FLAG(38)
  push 0
  push 9
  COMM 0x0194
  COMM 0x01e8
  SCREEN_FADE_A(0, 0)
  RESET_DRAW_EFFECTS()
  RESET_FIELD_EFFECTS()
  WAIT_FOR_TASK_REMOVAL(CREATE_POLYGON_MOVIE(640, 1))
  if (global_int[200] == 0) {
    SET_MODEL_FLAG(502)
    CLEAR_MODEL_FLAG(503)
  } else {
  _2:
    CLEAR_MODEL_FLAG(502)
    SET_MODEL_FLAG(503)
    goto _1
  }
_1:
  RESET_DRAW_EFFECTS()
  RESET_FIELD_EFFECTS()
  COMM 0x002e
  return
end

messages
end

strings
  zero 240
end
