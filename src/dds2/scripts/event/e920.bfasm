messages msg1
  message MSG_UBERUR_DEAD_001 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "How could we humans lose!?"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_KAASII_DEAD_001 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Wha--? Damn you, bastards!"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_GANGAA_DEAD_001 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "I don't believe this..."
      newline
      control f1 04
    endpage
  endmessage
  message MSG_UBERUR_DEAD_002 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "This is the power of the Asura...?"
      newline
      text "Dammit, we have to redeem"
      newline
      text "ourselves..."
      newline
      control f1 04
    endpage
  endmessage
  message MSG_KAASII_DEAD_002 speaker=1
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "What's up with these guys!?"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_GANGAA_DEAD_002 speaker=2
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "You'll pay for this!"
      newline
      control f1 04
    endpage
  endmessage
  speaker 0
    text "Ubelluris"
  endspeaker
  speaker 1
    text "Cu Sith"
  endspeaker
  speaker 2
    text "Ganga"
  endspeaker
end

strings
  zero 240
end
