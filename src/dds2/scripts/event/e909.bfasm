flw0 2
profile dds2

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=0 float=0

procedure e909_main reserved=0x00000000
procedure e909_dead reserved=0x00000000

code
e909_main:
  PROC e909_main
  MESSAGE_REQUEST_AND_POLL(message(MSG_000))
  return
e909_dead:
  PROC e909_dead
  COMM 0x003e
  push 0
  COMM 0x01ce
  push 100
  push 272
  push 1
  COMM 0x0197
  push -(24)
  push 100
  COMM 0x0198
  return
end

messages msg1
  message MSG_000 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      font "テスト中..."
      newline
      control f1 04
    endpage
  endmessage
end

strings
  zero 240
end
