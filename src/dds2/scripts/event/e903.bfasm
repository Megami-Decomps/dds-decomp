flw0 2
profile dds2

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=0 float=0

procedure e903_main reserved=0x00000000
procedure e903_dead reserved=0x00000000
jump_label _2 reserved=0x00000000
jump_label _1 reserved=0x00000000

code
e903_main:
  PROC e903_main
  PUSHMSG MSG_AGUNI_DEAD_00
  COMM MESSAGE_REQUEST_AND_POLL
  END
e903_dead:
  PROC e903_dead
  PUSHIS 30
  COMM WAIT_FOR_TIMER_LIMIT
  COMM 0x003e
  COMM ACTIVATE_MESSAGE_PANEL
  PUSHF 0x3f6a3d71
  PUSHF 0x3cfdf3b6
  MINUS
  PUSHF 0x3ec10625
  MINUS
  PUSHF 0x3d27ef9e
  PUSHF 0x42a6cccd
  MINUS
  PUSHF 0x42b5999a
  MINUS
  PUSHF 0x434c0000
  MINUS
  COMM 0x01d5
  PUSHF 0x3f67ef9e
  PUSHF 0x3c54fdf4
  PUSHF 0x3ecb4396
  MINUS
  PUSHF 0x3d83126f
  MINUS
  PUSHF 0x423a6666
  MINUS
  PUSHF 0x41fb3333
  MINUS
  PUSHF 0x43528000
  MINUS
  COMM 0x01d6
  PUSHIS 35
  PUSHIS 40
  COMM 0x01d7
  PUSHMSG MSG_AGUNI_DEAD_00
  COMM MESSAGE_REQUEST_AND_POLL
  PUSHIS 1
  COMM 0x0161
  PUSHREG
  EQ
  IF _2
  PUSHIS 98
  PUSHIS 263
  PUSHIS 1
  COMM 0x0197
  GOTO _1
_2:
  PUSHIS 99
  PUSHIS 1
  PUSHIS 0
  COMM 0x0197
  GOTO _1
_1:
  PUSHMSG MSG_AGUNI_DEAD_01
  COMM MESSAGE_REQUEST_AND_POLL
  COMM FINISH_SCRIPT_MESSAGE_WINDOW
  PUSHIS 100
  PUSHIS 263
  PUSHIS 1
  COMM 0x0197
  PUSHIS 5
  COMM WAIT_FOR_TIMER_LIMIT
  PUSHIS 15
  PUSHIS 263
  PUSHIS 1
  COMM 0x01ea
  PUSHIS 13
  PUSHIS 263
  PUSHIS 1
  COMM 0x01b2
  PUSHIS 24
  MINUS
  PUSHIS 100
  COMM 0x0198
  END
end

messages msg1
  message MSG_AGUNI_DEAD_00 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "--the hell!? I can't lose!"
      newline
      text "I'm stronger than you!"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_AGUNI_DEAD_01 speaker=0
    page
      control f2 08 ff ff
      text "This isn't over."
      newline
      text "Next time, I'll devour you!"
      newline
      control f1 04
    endpage
  endmessage
  speaker 0
    text "Agni"
  endspeaker
end

strings
  zero 240
end
