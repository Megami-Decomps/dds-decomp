flw0 2
profile dds2

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=0 float=0

procedure e903_main reserved=0x00000000
procedure e903_dead reserved=0x00000000
jump_label _2 reserved=0x00000000
jump_label _1 reserved=0x00000000

code
e903_main:
  PROC e903_main
  MESSAGE_REQUEST_AND_POLL(message(MSG_AGUNI_DEAD_00))
  return
e903_dead:
  PROC e903_dead
  WAIT_FOR_TIMER_LIMIT(30)
  COMM 0x003e
  ACTIVATE_MESSAGE_PANEL()
  push float32(0.9150000214576721, bits=0x3f6a3d71)
  push -float32(0.03099999949336052, bits=0x3cfdf3b6)
  push -float32(0.37700000405311584, bits=0x3ec10625)
  push float32(0.04100000113248825, bits=0x3d27ef9e)
  push -float32(83.4000015258789, bits=0x42a6cccd)
  push -float32(90.80000305175781, bits=0x42b5999a)
  push -float32(204.0, bits=0x434c0000)
  COMM 0x01d5
  push float32(0.906000018119812, bits=0x3f67ef9e)
  push float32(0.013000000268220901, bits=0x3c54fdf4)
  push -float32(0.3970000147819519, bits=0x3ecb4396)
  push -float32(0.06400000303983688, bits=0x3d83126f)
  push -float32(46.599998474121094, bits=0x423a6666)
  push -float32(31.399999618530273, bits=0x41fb3333)
  push -float32(210.5, bits=0x43528000)
  COMM 0x01d6
  push 35
  push 40
  COMM 0x01d7
  MESSAGE_REQUEST_AND_POLL(message(MSG_AGUNI_DEAD_00))
  push 1
  COMM 0x0161
  PUSHREG
  EQ
  IF _2
  push 98
  push 263
  push 1
  COMM 0x0197
  goto _1
_2:
  push 99
  push 1
  push 0
  COMM 0x0197
  goto _1
_1:
  MESSAGE_REQUEST_AND_POLL(message(MSG_AGUNI_DEAD_01))
  FINISH_SCRIPT_MESSAGE_WINDOW()
  push 100
  push 263
  push 1
  COMM 0x0197
  WAIT_FOR_TIMER_LIMIT(5)
  push 15
  push 263
  push 1
  COMM 0x01ea
  push 13
  push 263
  push 1
  COMM 0x01b2
  push -(24)
  push 100
  COMM 0x0198
  return
end

messages msg1
  message MSG_AGUNI_DEAD_00 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "--the hell!? I can't lose!"
      newline
      text "I'm stronger than you!"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_AGUNI_DEAD_01 speaker=0
    page
      control f2 08 ff ff
      text "This isn't over."
      newline
      text "Next time, I'll devour you!"
      newline
      control f1 04
    endpage
  endmessage
  speaker 0
    text "Agni"
  endspeaker
end

strings
  zero 240
end
