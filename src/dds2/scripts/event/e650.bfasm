flw0 2
profile dds2

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=0 float=0

procedure e650_001 reserved=0x00000000
jump_label _2 reserved=0x00000000
jump_label _1 reserved=0x00000000

code
e650_001:
  PROC e650_001
  SET_MODEL_FLAG(48)
  CLEAR_PROCESS_CONTROL_FLAG()
  SCREEN_FADE_A(0, 0)
  RESET_DRAW_EFFECTS()
  RESET_FIELD_EFFECTS()
  WAIT_FOR_TASK_REMOVAL(CREATE_POLYGON_MOVIE(650, 1))
  RESET_DRAW_EFFECTS()
  RESET_FIELD_EFFECTS()
  if (TEST_MODEL_FLAG(2959) == 1) {
    WAIT_FOR_TASK_REMOVAL(CREATE_POLYGON_MOVIE(650, 2))
  } else {
  _2:
    WAIT_FOR_TASK_REMOVAL(CREATE_POLYGON_MOVIE(650, 3))
    goto _1
  }
_1:
  RESET_DRAW_EFFECTS()
  RESET_FIELD_EFFECTS()
  CALL_EVENT(event(e651))
  COMM 0x002e
  return
end

messages
end

strings
  zero 240
end
