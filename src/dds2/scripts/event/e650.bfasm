flw0 2
profile dds2

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=0 float=0

procedure e650_001 reserved=0x00000000
jump_label _2 reserved=0x00000000
jump_label _1 reserved=0x00000000

code
e650_001:
  PROC e650_001
  SET_MODEL_FLAG(48)
  CLEAR_PROCESS_CONTROL_FLAG()
  SCREEN_FADE_A(0, 0)
  RESET_DRAW_EFFECTS()
  RESET_FIELD_EFFECTS()
  result = CREATE_POLYGON_MOVIE(650, 1)
  WAIT_FOR_TASK_REMOVAL(result)
  RESET_DRAW_EFFECTS()
  RESET_FIELD_EFFECTS()
  push 1
  push 2959
  COMM TEST_MODEL_FLAG
  PUSHREG
  EQ
  IF _2
  result = CREATE_POLYGON_MOVIE(650, 2)
  WAIT_FOR_TASK_REMOVAL(result)
  goto _1
_2:
  result = CREATE_POLYGON_MOVIE(650, 3)
  WAIT_FOR_TASK_REMOVAL(result)
  goto _1
_1:
  RESET_DRAW_EFFECTS()
  RESET_FIELD_EFFECTS()
  CALL_EVENT(event(e651))
  COMM 0x002e
  return
end

messages
end

strings
  zero 240
end
