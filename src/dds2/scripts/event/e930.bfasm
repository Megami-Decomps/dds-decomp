flw0 2
profile dds2

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=0 float=0

procedure e930_main reserved=0x00000000
procedure e930_first reserved=0x00000000

code
e930_main:
  PROC e930_main
  MESSAGE_REQUEST_AND_POLL(message(MSG_SERA_00))
  return
e930_first:
  PROC e930_first
  COMM 0x003e
  push 99
  push 2
  push 0
  COMM 0x0197
  ACTIVATE_MESSAGE_PANEL()
  MESSAGE_REQUEST_AND_POLL(message(MSG_SERA_00))
  FINISH_SCRIPT_MESSAGE_WINDOW()
  push 0
  push 99
  COMM 0x0198
  push 100
  push 2
  push 0
  COMM 0x0197
  push 75
  push 18
  push 2
  push 0
  COMM 0x01a1
  WAIT_FOR_TIMER_LIMIT(5)
  push 16
  push 2
  push 0
  COMM 0x01b2
  WAIT_FOR_TIMER_LIMIT(25)
  push int32(65551)
  COMM 0x000b
  WAIT_FOR_TIMER_LIMIT(110)
  ACTIVATE_MESSAGE_PANEL()
  MESSAGE_REQUEST_AND_POLL(message(MSG_SERA_01))
  FINISH_SCRIPT_MESSAGE_WINDOW()
  push 0
  push 100
  COMM 0x0198
  COMM 0x01a4
  COMM 0x003f
  WAIT_FOR_TIMER_LIMIT(8)
  return
end

messages msg1
  message MSG_SERA_00 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Lives link to one another,"
      newline
      text "and the world continues..."
      newline
      control f1 04
    endpage
  endmessage
  message MSG_SERA_01 speaker=0
    page
      control f2 08 ff ff
      text "I won't run anymore, Serph."
      newline
      control f1 04
    endpage
  endmessage
  speaker 0
    text "Sera"
  endspeaker
end

strings
  zero 240
end
