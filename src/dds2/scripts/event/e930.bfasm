flw0 2
profile dds2

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=0 float=0

procedure e930_main reserved=0x00000000
procedure e930_first reserved=0x00000000

code
e930_main:
  PROC e930_main
  PUSHIS 0
  COMM 0x0000
  END
e930_first:
  PROC e930_first
  COMM 0x003e
  PUSHIS 99
  PUSHIS 2
  PUSHIS 0
  COMM 0x0197
  COMM 0x0001
  PUSHIS 0
  COMM 0x0000
  COMM 0x0002
  PUSHIS 0
  PUSHIS 99
  COMM 0x0198
  PUSHIS 100
  PUSHIS 2
  PUSHIS 0
  COMM 0x0197
  PUSHIS 75
  PUSHIS 18
  PUSHIS 2
  PUSHIS 0
