end

messages msg1
  message MSG_SERA_00 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Lives link to one another,"
      newline
      text "and the world continues..."
      newline
      control f1 04
    endpage
  endmessage
  message MSG_SERA_01 speaker=0
    page
      control f2 08 ff ff
      text "I won't run anymore, Serph."
      newline
      control f1 04
    endpage
  endmessage
  speaker 0
    text "Sera"
  endspeaker
end

strings
  zero 240
end
