flw0 2
profile dds2

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=1 float=0

procedure e802_main reserved=0x00000000
jump_label _2 reserved=0x00000000
jump_label _1 reserved=0x00000000
jump_label _3 reserved=0x00000000

code
e802_main:
  PROC e802_main
  push 802
  COMM 0x00c8
  SCREEN_FADE_B(0, 1)
  push 3
  push 802
  COMM 0x00ca
  push float32(0.699999988079071, bits=0x3f333333)
  push float32(0.6499999761581421, bits=0x3f266666)
  push float32(0.6499999761581421, bits=0x3f266666)
  push 0
  COMM 0x00b4
  push float32(0.30000001192092896, bits=0x3e99999a)
  push float32(0.30000001192092896, bits=0x3e99999a)
  push float32(0.30000001192092896, bits=0x3e99999a)
  push 0
  COMM 0x00b5
  push float32(0.30000001192092896, bits=0x3e99999a)
  push float32(0.30000001192092896, bits=0x3e99999a)
  push float32(0.30000001192092896, bits=0x3e99999a)
  push 0
  COMM 0x00b6
  push float32(0.1599999964237213, bits=0x3e23d70a)
  push float32(0.3499999940395355, bits=0x3eb33333)
  push float32(0.4099999964237213, bits=0x3ed1eb85)
  push 0
  COMM 0x00bb
  push 9000
  push 130
  push 1100
  push 255
  push 0
  COMM 0x00bc
  push 0
  push 1
  push 175
  COMM 0x0014
  push -(105)
  push 0
  COMM 0x0048
  push 4
  push 802
  COMM 0x00c9
  PUSHREG
  POPLIX 0x0000
  result = TEST_MODEL_FLAG(1065)
  if (result) {
    result = READ_SECONDARY_WORLD_ID_VALUE(string(str_01pos_01))
    ATTACH_WORLD_OBJECT_TO_SOURCE_VECTOR(local_int[0], result)
  } else {
  _2:
    result = READ_SECONDARY_WORLD_ID_VALUE(string(str_01pos_02))
    ATTACH_WORLD_OBJECT_TO_SOURCE_VECTOR(local_int[0], result)
    goto _1
  }
_1:
  push local_int[0]
  COMM 0x00ae
  push float32(0.3499999940395355, bits=0x3eb33333)
  push float32(0.30000001192092896, bits=0x3e99999a)
  push float32(0.30000001192092896, bits=0x3e99999a)
  push float32(0.8500000238418579, bits=0x3f59999a)
  push float32(0.800000011920929, bits=0x3f4ccccd)
  push float32(0.75, bits=0x3f400000)
  push 0
  push local_int[0]
  COMM 0x00af
  push -float32(0.05000000074505806, bits=0x3d4ccccd)
  push float32(0.800000011920929, bits=0x3f4ccccd)
  push -float32(0.10000000149011612, bits=0x3dcccccd)
  push 0
  push local_int[0]
  COMM 0x00b0
  SCREEN_FADE_A(0, 10)
  push 0
  push 1065
  COMM TEST_MODEL_FLAG
  PUSHREG
  EQ
  IF _3
  SET_MODEL_FLAG(1065)
  result = READ_SECONDARY_WORLD_ID_VALUE(string(str_01cam_02))
  ADD_FLAGGED_EFFECT_UNIT_TO_WORLD(result)
  PREPARE_UNIT_MOTION_STATE(local_int[0], 23, 3, 15, 1)
  push 0
  push 25
  push 0
  push string(str_01pos_01_2)
  COMM READ_SECONDARY_WORLD_ID_VALUE
  PUSHREG
  push local_int[0]
  COMM 0x0017
  result = READ_SECONDARY_WORLD_ID_VALUE(string(str_01cam_02_MOTION))
  push result
  push string(str_01cam_02_2)
  COMM READ_SECONDARY_WORLD_ID_VALUE
  PUSHREG
  COMM 0x0013
  WAIT_FOR_TIMER_LIMIT(100)
  result = READ_SECONDARY_WORLD_ID_VALUE(string(str_01pos_03))
  ATTACH_WORLD_OBJECT_TO_SOURCE_VECTOR(local_int[0], result)
  push local_int[0]
  COMM 0x0123
  push 0
  push 20
  push 0
  push string(str_01pos_04)
  COMM READ_SECONDARY_WORLD_ID_VALUE
  PUSHREG
  push local_int[0]
  COMM 0x0017
  result = READ_SECONDARY_WORLD_ID_VALUE(string(str_01cam_03))
  ADD_FLAGGED_EFFECT_UNIT_TO_WORLD(result)
  result = READ_SECONDARY_WORLD_ID_VALUE(string(str_01cam_03_MOTION))
  push result
  push string(str_01cam_03_2)
  COMM READ_SECONDARY_WORLD_ID_VALUE
  PUSHREG
  COMM 0x0013
  WAIT_FOR_UNIT_MOTION(local_int[0])
  PREPARE_UNIT_MOTION_STATE(local_int[0], 0, 20, 20, 1)
  result = READ_SECONDARY_WORLD_ID_VALUE(string(str_01cam_03_3))
  push result
  COMM 0x0055
  goto _3
_3:
  SCREEN_FADE_B(0, 10)
  WAIT_FOR_TIMER_LIMIT(10)
  RESET_DRAW_EFFECTS()
  RESET_FIELD_EFFECTS()
  push local_int[0]
  COMM 0x0016
  COMM 0x0023
  push 0
  COMM 0x011d
  return
end

messages msg1
  message MSG_TEST speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      font "テスト中..."
      newline
      control f1 04
    endpage
  endmessage
end

strings
  string str_01pos_01 "01pos_01"
  string str_01pos_02 "01pos_02"
  string str_01cam_02 "01cam_02"
  string str_01pos_01_2 "01pos_01"
  string str_01cam_02_2 "01cam_02"
  string str_01cam_02_MOTION "01cam_02_MOTION"
  string str_01pos_03 "01pos_03"
  string str_01pos_04 "01pos_04"
  string str_01cam_03 "01cam_03"
  string str_01cam_03_2 "01cam_03"
  string str_01cam_03_MOTION "01cam_03_MOTION"
  string str_01cam_03_3 "01cam_03"
  zero 22
end
