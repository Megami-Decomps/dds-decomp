flw0 2
profile dds2

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=1 float=0

procedure e919_main reserved=0x00000000
procedure e919_dead reserved=0x00000000
jump_label _2 reserved=0x00000000
jump_label _1 reserved=0x00000000

code
e919_main:
  PROC e919_main
  MESSAGE_REQUEST_AND_POLL(message(MSG_000))
  return
e919_dead:
  PROC e919_dead
  COMM 0x0161
  PUSHREG
  POPLIX 0x0000
  COMM 0x003e
  if (local_int[0] == 270) {
    push 1
    COMM 0x01ce
    push 99
    push local_int[0]
    push 1
    COMM 0x0197
    push -(24)
    push 99
    COMM 0x0198
  } else {
  _2:
    push 0
    COMM 0x01ce
    push 100
    push local_int[0]
    push 1
    COMM 0x0197
    push -(24)
    push 100
    COMM 0x0198
    goto _1
  }
_1:
  return
end

messages msg1
  message MSG_000 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      font "テスト中..."
      newline
      control f1 04
    endpage
  endmessage
end

strings
  zero 240
end
