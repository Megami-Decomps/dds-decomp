flw0 2
profile dds2

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=1 float=0

procedure e907_main reserved=0x00000000
procedure e907_dead reserved=0x00000000
jump_label _2 reserved=0x00000000
jump_label _3 reserved=0x00000000
jump_label _1 reserved=0x00000000

code
e907_main:
  PROC e907_main
  MESSAGE_REQUEST_AND_POLL(message(MSG_000))
  return
e907_dead:
  PROC e907_dead
  COMM 0x0161
  PUSHREG
  POPLIX 0x0000
  COMM 0x003e
  if (local_int[0] == 98) {
    push 2
    COMM 0x01ce
    push 98
    push 310
    push 1
    COMM 0x0197
    push 0
    push 98
    COMM 0x0198
    push 3
    COMM 0x01ce
    push 80
    push 310
    push 1
    COMM 0x0197
  } else {
  _2:
    if (local_int[0] == 99) {
      push 1
      COMM 0x01ce
      push 99
      push 309
      push 1
      COMM 0x0197
      push 0
      push 99
      COMM 0x0198
      push 3
      COMM 0x01ce
      push 80
      push 309
      push 1
      COMM 0x0197
    } else {
    _3:
      push 0
      COMM 0x01ce
      push 100
      push 308
      push 1
      COMM 0x0197
      push 0
      push 100
      COMM 0x0198
      push 3
      COMM 0x01ce
      push 80
      push 308
      push 1
      COMM 0x0197
      local_int[0] = 100
      goto _1
    }
  }
_1:
  push -(24)
  push 80
  COMM 0x0198
  return
end

messages msg1
  message MSG_000 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      font "テスト中..."
      newline
      control f1 04
    endpage
  endmessage
end

strings
  zero 240
end
