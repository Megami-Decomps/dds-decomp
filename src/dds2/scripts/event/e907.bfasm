flw0 2
profile dds2

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=1 float=0

procedure e907_main reserved=0x00000000
procedure e907_dead reserved=0x00000000
jump_label _2 reserved=0x00000000
jump_label _3 reserved=0x00000000
jump_label _1 reserved=0x00000000

code
e907_main:
  PROC e907_main
  PUSHIS 0
  COMM 0x0000
  END
e907_dead:
  PROC e907_dead
  COMM 0x0161
  PUSHREG
  POPLIX 0x0000
  COMM 0x003e
  PUSHIS 98
  PUSHLIX 0x0000
  EQ
  IF _2
  PUSHIS 2
  COMM 0x01ce
  PUSHIS 98
  PUSHIS 310
  PUSHIS 1
  COMM 0x0197
  PUSHIS 0
  PUSHIS 98
  COMM 0x0198
  PUSHIS 3
  COMM 0x01ce
  PUSHIS 80
  PUSHIS 310
  PUSHIS 1
  COMM 0x0197
  GOTO _1
_2:
  PUSHIS 99
  PUSHLIX 0x0000
  EQ
  IF _3
  PUSHIS 1
  COMM 0x01ce
  PUSHIS 99
  PUSHIS 309
  PUSHIS 1
  COMM 0x0197
  PUSHIS 0
  PUSHIS 99
  COMM 0x0198
  PUSHIS 3
  COMM 0x01ce
  PUSHIS 80
  PUSHIS 309
  PUSHIS 1
  COMM 0x0197
  GOTO _1
_3:
  PUSHIS 0
  COMM 0x01ce
  PUSHIS 100
  PUSHIS 308
  PUSHIS 1
  COMM 0x0197
  PUSHIS 0
  PUSHIS 100
  COMM 0x0198
  PUSHIS 3
  COMM 0x01ce
  PUSHIS 80
  PUSHIS 308
  PUSHIS 1
  COMM 0x0197
  PUSHIS 100
  POPLIX 0x0000
  GOTO _1
_1:
  PUSHIS 24
  MINUS
  PUSHIS 80
  COMM 0x0198
  END
end

messages msg1
  message MSG_000 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      font "テスト中..."
      newline
      control f1 04
    endpage
  endmessage
end

strings
