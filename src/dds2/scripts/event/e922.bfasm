flw0 2
profile dds2

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=0 float=0

procedure e922_main reserved=0x00000000
procedure e922_bind reserved=0x00000000
procedure e922_dead reserved=0x00000000
jump_label _2 reserved=0x00000000
jump_label _3 reserved=0x00000000
jump_label _1 reserved=0x00000000
jump_label _6 reserved=0x00000000
jump_label _5 reserved=0x00000000

code
e922_main:
  PROC e922_main
  MESSAGE_REQUEST_AND_POLL(message(MSG_BIND1))
  return
e922_bind:
  PROC e922_bind
  COMM 0x003e
  push 0
  push 2067
  COMM TEST_MODEL_FLAG
  PUSHREG
  EQ
  IF _6
  SET_MODEL_FLAG(2067)
  COMM 0x01d4
  ACTIVATE_MESSAGE_PANEL()
  MESSAGE_REQUEST_AND_POLL(message(MSG_BIND1))
  goto _5
_6:
  push 1
  push 2095
  COMM TEST_MODEL_FLAG
  PUSHREG
  EQ
  IF _2
  SET_MODEL_FLAG(2096)
  goto _1
_2:
  push 1
  push 2094
  COMM TEST_MODEL_FLAG
  PUSHREG
  EQ
  IF _3
  SET_MODEL_FLAG(2095)
  goto _1
_3:
  push 1
  push 2067
  COMM TEST_MODEL_FLAG
  PUSHREG
  EQ
  IF _1
  SET_MODEL_FLAG(2094)
  goto _1
_1:
  COMM 0x01d4
  ACTIVATE_MESSAGE_PANEL()
  MESSAGE_REQUEST_AND_POLL(message(MSG_BIND2))
  goto _5
_5:
  FINISH_SCRIPT_MESSAGE_WINDOW()
  return
e922_dead:
  PROC e922_dead
  COMM 0x003e
  push 0
  COMM 0x01ce
  push 100
  push 311
  push 1
  COMM 0x0197
  push -(24)
  push 100
  COMM 0x0198
  return
end

messages msg1
  message MSG_BIND1 speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      text "Heh heh heh..."
      newline
      text "Go directly to jail!"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_BIND2 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Fools! Most people would learn"
      newline
      text "from their mistakes!"
      newline
      control f1 04
    endpage
  endmessage
  speaker 0
    text "Kumbhanda"
  endspeaker
end

strings
  zero 240
end
