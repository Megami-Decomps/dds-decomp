flw0 2
profile dds2

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=0 float=0

procedure e922_main reserved=0x00000000
procedure e922_bind reserved=0x00000000
procedure e922_dead reserved=0x00000000
jump_label _2 reserved=0x00000000
jump_label _3 reserved=0x00000000
jump_label _1 reserved=0x00000000
jump_label _6 reserved=0x00000000
jump_label _5 reserved=0x00000000

code
e922_main:
  PROC e922_main
  PUSHIS 0
  COMM 0x0000
  END
e922_bind:
  PROC e922_bind
  COMM 0x003e
  PUSHIS 0
  PUSHIS 2067
  COMM 0x0007
  PUSHREG
  EQ
  IF _6
  PUSHIS 2067
  COMM 0x0008
  COMM 0x01d4
  COMM 0x0001
  PUSHIS 0
  COMM 0x0000
  GOTO _5
_6:
  PUSHIS 1
  PUSHIS 2095
  COMM 0x0007
  PUSHREG
  EQ
  IF _2
  PUSHIS 2096
  COMM 0x0008
  GOTO _1
_2:
  PUSHIS 1
  PUSHIS 2094
  COMM 0x0007
  PUSHREG
  EQ
  IF _3
  PUSHIS 2095
  COMM 0x0008
  GOTO _1
_3:
  PUSHIS 1
  PUSHIS 2067
  COMM 0x0007
  PUSHREG
  EQ
  IF _1
  PUSHIS 2094
  COMM 0x0008
  GOTO _1
_1:
  COMM 0x01d4
  COMM 0x0001
  PUSHIS 1
  COMM 0x0000
  GOTO _5
_5:
  COMM 0x0002
  END
e922_dead:
  PROC e922_dead
  COMM 0x003e
  PUSHIS 0
  COMM 0x01ce
  PUSHIS 100
  PUSHIS 311
  PUSHIS 1
  COMM 0x0197
  PUSHIS 24
  MINUS
  PUSHIS 100
  COMM 0x0198
  END
end

messages msg1
  message MSG_BIND1 speaker=0
    page
      control f2 08 ff ff
      control f2 07 06 ff
      text "Heh heh heh..."
      newline
      text "Go directly to jail!"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_BIND2 speaker=0
    page
      control f2 08 ff ff
      control f2 07 07 ff
      text "Fools! Most people would learn"
      newline
      text "from their mistakes!"
      newline
      control f1 04
    endpage
  endmessage
  speaker 0
    text "Kumbhanda"
  endspeaker
end

strings
  zero 240
end
