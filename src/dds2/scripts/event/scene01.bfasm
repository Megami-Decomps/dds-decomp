section 3 type=3 stride=0x1 count=1128 offset=0x33c
  msg1
  message M01_01 speaker=none
    page
      control f2 08 ff ff
      font "エーイチ、エーイチ…"
      newline
      font "目を覚ますのだ…"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "デビルハーツを持つ者とし"
      font "て"
      newline
      font "再びこの"
      glyphs 85a5 84c8 85a6
      font "に覚"
      glyphs 85a7
      font "するのだ…"
      newline
      control f1 04
    endpage
  endmessage
  message M01_02 speaker=0
    page
      control f2 08 ff ff
      font "おお、気付いたか…"
      newline
      font "我が名はアナト。"
      newline
      glyphs 85a8
      font "えあるオリエントの地"
      glyphs 85a9
      font "神だ。"
      newline
      control f1 04
    endpage
  endmessage
  message M01_03 speaker=0
    page
      control f2 08 ff ff
      font "お前の"
      glyphs 85aa
      font "は"
      glyphs 85ab
      font "いておる。"
      newline
      font "なかなか"
      glyphs 85ac
      font "が立つそうじゃないか…"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "その"
      glyphs 85ac
      font "を見込んで、一つ"
      glyphs 85b0
      font "みがある。"
      newline
      control f1 04
    endpage
  endmessage
  message M01_04_01 speaker=0
    page
      control f2 08 ff ff
      font "日本の主神、アマテラスの"
      font "ことだ。"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "最"
      glyphs 85bf
      font "、アマテラスの"
      glyphs 85c0 85c1
      font "に"
      newline
      font "不穏な動きがあると"
      glyphs 85ab
      font "く。"
      newline
      control f1 04
    endpage
  endmessage
  message M01_04_02 speaker=0
    page
      control f2 08 ff ff
      font "なんでも…"
      newline
      font "神"
      glyphs 85c3 82a8 85c4 85c5
      font "の"
      glyphs 85c6 82a9
      font "を"
      glyphs 85d7
      font "し出し"
      newline
      glyphs 85a5 84c8 85a6
      font "を我が物にせんと"
      glyphs 8ad9
      font "んでいるらしい"
      newline
      control f1 04
    endpage
  endmessage
  message M01_05 speaker=0
    page
      control f2 08 ff ff
      font "そこで、だ。"
      newline
      control f1 04
    endpage
  endmessage
  message M01_06 speaker=0
    page
      control f2 08 ff ff
      font "上野動物園にいるアマテラ"
      font "スを"
      glyphs 85b6
      font "し出し…"
      newline
      control f1 04
    endpage
  endmessage
  message M01_07 speaker=0
    page
      control f2 08 ff ff
      font "その息の"
      glyphs 85b8
      font "を止めて欲しい!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      font "お前には易い"
      glyphs 85bc
      font "事だろう。"
      newline
      control f1 04
    endpage
  endmessage
  message M01_08 speaker=0
    page
      control f2 08 ff ff
      font "では、"
      glyphs 85b0
      font "んだぞ…"
      newline
      control f1 04
    endpage
  endmessage
  speaker 0
    font "アナト"
  endspeaker
end
