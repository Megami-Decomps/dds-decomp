section 3 type=3 stride=0x1 count=695 offset=0x348
  msg1
  message TAKE_01 speaker=0
    page
      control f2 08 ff ff
      font "神"
      glyphs 85c3
      font "は見つかりましたかな!"
      newline
      control f1 04
    endpage
  endmessage
  message SUSA_01 speaker=1
    page
      control f2 08 ff ff
      font "焦んなくていいぜ…"
      newline
      control f1 04
    endpage
  endmessage
  message TAKE_02 speaker=0
    page
      control f2 08 ff ff
      font "悪魔なり、"
      glyphs 88f3
      font "なり、ゴミ"
      glyphs 88f4
      font "なり…"
      newline
      glyphs 85ab
      font "けるものには何でも"
      glyphs 85ab
      font "く!"
      newline
      font "これ、物事の"
      glyphs 88f5
      font "本ですぞ!"
      newline
      control f1 04
    endpage
  endmessage
  message SUSA_02 speaker=1
    page
      control f2 08 ff ff
      font "見たとこアンタも日本人だ"
      font "ろ?"
      newline
      glyphs 88f6
      font "貴のために一"
      glyphs 88f7 88f8
      font "ぐなんて"
      newline
      font "すっげー名誉なことだぜ…"
      newline
      control f1 04
    endpage
  endmessage
  message TAKE_03 speaker=0
    page
      control f2 08 ff ff
      font "そうです、そうです!"
      newline
      font "大変名誉なことですぞ!"
      newline
      control f1 04
    endpage
  endmessage
  message SUSA_03 speaker=1
    page
      control f2 08 ff ff
      font "…というわけだ。がんばっ"
      font "てくれ。"
      newline
      control f1 04
    endpage
  endmessage
  speaker 0
    font "タ"
    glyphs 81c2
    font "ミカ"
    glyphs 81d6
    font "チ"
  endspeaker
  speaker 1
    font "スサノオ"
  endspeaker
