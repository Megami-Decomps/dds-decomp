flw0 2
profile dds2

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=2 float=0

procedure e803_main reserved=0x00000000
jump_label _2 reserved=0x00000000
jump_label _1 reserved=0x00000000
jump_label _3 reserved=0x00000000

code
e803_main:
  PROC e803_main
  WAIT_FOR_CAMP_TASK(803)
  SCREEN_FADE_B(0, 1)
  push 3
  push 803
  COMM 0x00ca
  push float32(0.699999988079071, bits=0x3f333333)
  push float32(0.699999988079071, bits=0x3f333333)
  push float32(0.699999988079071, bits=0x3f333333)
  push 0
  COMM 0x00b4
  push float32(0.30000001192092896, bits=0x3e99999a)
  push float32(0.30000001192092896, bits=0x3e99999a)
  push float32(0.30000001192092896, bits=0x3e99999a)
  push 0
  COMM 0x00b5
  push float32(0.25, bits=0x3e800000)
  push float32(0.25, bits=0x3e800000)
  push float32(0.30000001192092896, bits=0x3e99999a)
  push 0
  COMM 0x00b6
  push float32(0.1599999964237213, bits=0x3e23d70a)
  push float32(0.3499999940395355, bits=0x3eb33333)
  push float32(0.4099999964237213, bits=0x3ed1eb85)
  push 0
  COMM 0x00bb
  push 9000
  push 130
  push 1100
  push 255
  push 0
  COMM 0x00bc
  push 0
  push 1
  push 54
  COMM 0x0014
  push -(115)
  push 0
  COMM 0x0048
  local_int[1] = BIND_MODEL_MOTION_SOUND(803, 4)
  local_int[0] = BIND_MODEL_MOTION_SOUND(803, 5)
  ATTACH_WORLD_OBJECT_TO_SOURCE_VECTOR(local_int[1], READ_SECONDARY_WORLD_ID_VALUE(string(str_01pos_01)))
  if (TEST_MODEL_FLAG(1066)) {
    ATTACH_WORLD_OBJECT_TO_SOURCE_VECTOR(local_int[0], READ_SECONDARY_WORLD_ID_VALUE(string(str_01pos_02)))
    ADD_EFFECT_UNIT_TO_WORLD(READ_SECONDARY_WORLD_ID_VALUE(string(str_01cam_01)))
  } else {
  _2:
    ATTACH_WORLD_OBJECT_TO_SOURCE_VECTOR(local_int[0], READ_SECONDARY_WORLD_ID_VALUE(string(str_01pos_03)))
    goto _1
  }
_1:
  push local_int[0]
  COMM 0x00ae
  push float32(0.10000000149011612, bits=0x3dcccccd)
  push float32(0.7699999809265137, bits=0x3f451eb8)
  push -float32(0.05000000074505806, bits=0x3d4ccccd)
  push float32(0.6000000238418579, bits=0x3f19999a)
  push float32(0.800000011920929, bits=0x3f4ccccd)
  push float32(0.800000011920929, bits=0x3f4ccccd)
  push 0
  push local_int[0]
  COMM 0x00af
  push float32(0.4000000059604645, bits=0x3ecccccd)
  push float32(0.44999998807907104, bits=0x3ee66666)
  push float32(0.44999998807907104, bits=0x3ee66666)
  push 0
  push local_int[0]
  COMM 0x00b0
  push local_int[1]
  COMM 0x00ae
  push float32(0.10000000149011612, bits=0x3dcccccd)
  push float32(0.7699999809265137, bits=0x3f451eb8)
  push -float32(0.05000000074505806, bits=0x3d4ccccd)
  push float32(0.6000000238418579, bits=0x3f19999a)
  push float32(0.800000011920929, bits=0x3f4ccccd)
  push float32(0.800000011920929, bits=0x3f4ccccd)
  push 0
  push local_int[1]
  COMM 0x00af
  push float32(0.4000000059604645, bits=0x3ecccccd)
  push float32(0.44999998807907104, bits=0x3ee66666)
  push float32(0.44999998807907104, bits=0x3ee66666)
  push 0
  push local_int[1]
  COMM 0x00b0
  SCREEN_FADE_A(0, 10)
  push TEST_MODEL_FLAG(1066) == 0
  push 0
  push 0
  COMM 0x011e
  PUSHREG
  EQ
  AND
  IF _3
  SET_MODEL_FLAG(1066)
  PREPARE_UNIT_MOTION_STATE(local_int[0], 23, 3, 15, 1)
  START_UNIT_MOVE_TO_POSITION_OBJECT(local_int[0], READ_SECONDARY_WORLD_ID_VALUE(string(str_01pos_02_2)), 0, 25, 0)
  ADD_FLAGGED_EFFECT_UNIT_TO_WORLD(READ_SECONDARY_WORLD_ID_VALUE(string(str_01cam_02)))
  START_CAMERA_PATH_MOVE(READ_SECONDARY_WORLD_ID_VALUE(string(str_01cam_02_2)), READ_SECONDARY_WORLD_ID_VALUE(string(str_01cam_02_MOTION)))
  WAIT_FOR_UNIT_MOTION(local_int[0])
  PREPARE_UNIT_MOTION_STATE(local_int[0], 0, 10, 10, 1)
  push READ_SECONDARY_WORLD_ID_VALUE(string(str_01cam_02_3))
  COMM 0x0055
  WAIT_FOR_TIMER_LIMIT(15)
  goto _3
_3:
  SCREEN_FADE_B(0, 10)
  WAIT_FOR_TIMER_LIMIT(10)
  RESET_DRAW_EFFECTS()
  RESET_FIELD_EFFECTS()
  DESTROY_WORLD_UNIT(local_int[0])
  COMM 0x0023
  push 0
  COMM 0x011d
  return
end

messages msg1
  message MSG_TEST speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      font "テスト中..."
      newline
      control f1 04
    endpage
  endmessage
end

strings
  string str_01pos_01 "01pos_01"
  string str_01pos_02 "01pos_02"
  string str_01cam_01 "01cam_01"
  string str_01pos_03 "01pos_03"
  string str_01pos_02_2 "01pos_02"
  string str_01cam_02 "01cam_02"
  string str_01cam_02_2 "01cam_02"
  string str_01cam_02_MOTION "01cam_02_MOTION"
  string str_01cam_02_3 "01cam_02"
  zero 24
end
