flw0 2
profile dds2

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=0 float=0

procedure e913_main reserved=0x00000000
procedure e913_dead reserved=0x00000000
jump_label _2 reserved=0x00000000
jump_label _1 reserved=0x00000000

code
e913_main:
  PROC e913_main
  MESSAGE_REQUEST_AND_POLL(message(MSG_000))
  return
e913_dead:
  PROC e913_dead
  push 0
  COMM 0x01cf
  PUSHREG
  EQ
  IF _2
  COMM 0x003e
  push 3
  COMM 0x01ce
  push 83
  push 302
  push 1
  COMM 0x0197
  push -(24)
  push 83
  COMM 0x0198
  goto _1
_2:
  COMM 0x003e
  push 2
  COMM 0x01ce
  push 82
  push 303
  push 1
  COMM 0x0197
  push -(24)
  push 82
  COMM 0x0198
  goto _1
_1:
  return
end

messages msg1
  message MSG_000 speaker=none
    page
      control f2 08 ff ff
      control f2 07 07 ff
      font "テスト中..."
      newline
      control f1 04
    endpage
  endmessage
end

strings
  zero 240
end
