flw0 2
profile dds2

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=0 float=0

procedure e654_001 reserved=0x00000000
procedure at3_play reserved=0x00000000

code
e654_001:
  PROC e654_001
  SET_MODEL_FLAG(52)
  COMM 0x01e8
  SCREEN_FADE_A(0, 0)
  RESET_DRAW_EFFECTS()
  RESET_FIELD_EFFECTS()
  push 19
  COMM 0x011b
  result = CREATE_SCRIPT_TASK(procedure(at3_play), -(1))
  result = CREATE_POLYGON_MOVIE(654, 1)
  WAIT_FOR_TASK_REMOVAL(result)
  SCREEN_FADE_A(0, 0)
  RESET_DRAW_EFFECTS()
  RESET_FIELD_EFFECTS()
  COMM 0x0157
  COMM 0x002e
  return
at3_play:
  PROC at3_play
  COMM 0x016b
  COMM 0x011c
  return
end

messages
end

strings
  zero 240
end
