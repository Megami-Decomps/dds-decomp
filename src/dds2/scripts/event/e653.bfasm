flw0 2
profile dds2

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=0 float=0

procedure e653_001 reserved=0x00000000
jump_label _2 reserved=0x00000000
jump_label _1 reserved=0x00000000

code
e653_001:
  PROC e653_001
  SET_MODEL_FLAG(51)
  CLEAR_PROCESS_CONTROL_FLAG()
  SCREEN_FADE_A(0, 0)
  RESET_DRAW_EFFECTS()
  RESET_FIELD_EFFECTS()
  push 0
  push 338
  COMM TEST_MODEL_FLAG
  PUSHREG
  EQ
  IF _2
  result = CREATE_POLYGON_MOVIE(653, 1)
  WAIT_FOR_TASK_REMOVAL(result)
  goto _1
_2:
  result = CREATE_POLYGON_MOVIE(653, 2)
  WAIT_FOR_TASK_REMOVAL(result)
  goto _1
_1:
  RESET_DRAW_EFFECTS()
  RESET_FIELD_EFFECTS()
  result = CREATE_POLYGON_MOVIE(653, 3)
  WAIT_FOR_TASK_REMOVAL(result)
  RESET_DRAW_EFFECTS()
  RESET_FIELD_EFFECTS()
  COMM 0x0051
  CALL_EVENT(event(e654))
  COMM 0x002e
  return
end

messages
end

strings
  zero 240
end
