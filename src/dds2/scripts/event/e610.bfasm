flw0 2
profile dds2

header word00=0x00000000 word0c=0x00000000 word18=0x00000000 word1c=0x00000000
locals int=0 float=0

procedure e610_001 reserved=0x00000000

code
e610_001:
  PROC e610_001
  SET_MODEL_FLAG(8)
  SET_MODEL_FLAG(131)
  SET_MODEL_FLAG(130)
  SET_MODEL_FLAG(1024)
  SET_MODEL_FLAG(1025)
