_2692:
  if (TEST_MODEL_FLAG(3041) == 1) {
    CLEAR_MODEL_FLAG(3041)
    AI_SELECT_SKILL(56)
    AI_SELECT_ACTION_TARGETS()
    return
  }
_2694:
  AI_SELECT_TABLE_ACTION()
  return
end

