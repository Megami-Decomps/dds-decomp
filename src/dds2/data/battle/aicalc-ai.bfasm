    } else {
    _2687:
      if (local_int[108] < 25 + 25 + 25) {
        AI_SELECT_SKILL(182)
        AI_SELECT_ACTION_TARGETS()
        return
      } else {
      _2688:
        if (local_int[108] < 25 + 25 + 25 + 25) {
          AI_SELECT_SKILL(183)
