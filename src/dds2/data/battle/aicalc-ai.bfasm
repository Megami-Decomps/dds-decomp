messages msg1
  message MSG_000 speaker=32768
    page
      control f2 08 ff ff
      control f2 07 06 ff
      text "......"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_CHERUN002 speaker=32768
    page
      control f2 08 ff ff
      control f2 07 06 ff
      text "Hmph, impressive!"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_CHERUN004 speaker=32768
    page
      control f2 08 ff ff
      control f2 07 06 ff
      text "Your own shadow will"
      newline
      text "decapitate you!"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_CHERUN005 speaker=32768
    page
      control f2 08 ff ff
      control f2 07 06 ff
      text "My mind and body are not"
      newline
      text "of this world!"
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "In the name of the dark god,"
      newline
      text "I call forth forbidden power..."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I shall become a sword and rend your"
      newline
      text "corpse asunder!"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_HEKATO004 speaker=32768
    page
      control f2 08 ff ff
      control f2 07 06 ff
      text "LET'S SEE WHAT YOU'RE CAPABLE OF..."
      newline
      text "CAN YOU HANDLE THIS?"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_HEKATO005 speaker=32768
    page
      control f2 08 ff ff
      control f2 07 06 ff
      text "I SEE... NOT BAD."
      newline
      control f1 04
    endpage
    page
      control f2 08 ff ff
      text "I'LL DOUBLE MY POWER, THEN."
      newline
      control f1 04
    endpage
  endmessage
  message MSG_HEKATO006a speaker=32768
    page
      control f2 08 ff ff
      control f2 07 06 ff
      text "I'M SURPRISED YOU LIVED THROUGH"
      newline
      text "THAT... BUT, NOBODY CAN WITHSTAND"
      newline
      text "THIS NEXT ONE!"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_HEKATO006b speaker=32768
    page
      control f2 08 ff ff
      control f2 07 06 ff
      text "TRIPLE POWER!!"
      newline
      control f1 04
    endpage
  endmessage
  message MSG_HEKATO007a speaker=32768
    page
      control f2 08 ff ff
      control f2 07 06 ff
      text "THEIR STRENGTH AND MOVEMENT..."
      newline
      text "I CAN'T BELIEVE IT... AS IF THEY"
      newline
      text "WERE ASURA...!"
