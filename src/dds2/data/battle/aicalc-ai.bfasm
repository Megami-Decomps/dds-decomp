  }
_2685:
  return
AI_SURUTO:
  PROC AI_SURUTO
  local_int[109] = RANDOM_ONE_TO(100)
  if_not (TEST_MODEL_FLAG(3040) == 0) goto _2692
  if (AI_UNIT_HP_AT_OR_BELOW_RATE(50) == 1 && AI_ENEMY_COUNT_AT_MOST(1) == 1) {
    SET_MODEL_FLAG(3040)
